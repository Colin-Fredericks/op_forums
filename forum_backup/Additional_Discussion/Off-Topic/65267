x 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">Unless I'm way off, it's The Question, but I didn't know he was a full-fledged mystic immortal. I caught the Phantom Stranger reference for Judas, too.</div></div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/><i>- If you must be ridiculous, I must ridicule you.<br /> - Those that can give up essential liberties in exchange for temporary safety deserve neither liberty nor safety. -- Benjamin Franklin</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/375-papa-bear","name":"Papa Bear","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar375_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1920"}]},"thankedby":[]},{"date":"2014-09-03T08:05:03-07:00","id":247860,"title":"","content":"You are correct.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/271-jimb","name":"JimB","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar271_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2293"}]},"thankedby":[]},{"date":"2014-09-03T10:49:48-07:00","id":248002,"title":"","content":"On the subject of Spider-Woman's Cover: give Peter a bit more ass and this would be an equally atrocious image of Spider-Man XD:<br /> <br /> <a href=\"http://postimage.org/\" target=\"_blank\"><img src=\"http://s15.postimg.org/tvq146oez/2838806_1.jpg\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/></a><br /> <br /> Now, for something else: For anyone who enjoyed the Incredible Hercules book (that one with Amadeus Cho as Herc's sidekick), I highly recommend the current (written by the same guy, Fred Van Lente) Valiant title Archer &amp; Armstrong. Just don't try to take it seriously as some sort of political statement, because it has over-the-top ridiculousness like<br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"><br /> &quot;The One Percent&quot; as an actual cult of greed-demon Mammon, complete with cultist masks, conspiracies, capitalism/business-based jargon and so on. A secret society within the Catholic Church with ninja nuns descended (or at least taking inspiration) from Lilith instead of Eve and other stuff like that. I guess some stuff can feels offensive depending on one's background <span style=\"font-size:10px\">(for instance, Archer comes from a fundamentalist christian community and his upbringing is not portrayed is generally portrayed in a negative light, though other, more open-minded religious characters are there to provide contrast)</span> </div></div> </div> </div><br /> <br /> but as I said everything is so over the top...I didn't get anything but comedy and wacky comicbook hijinks out of it. The pseudo political-statement sort of plot feels just like the flavor of the story to me. Satire at most.<br /> <br /> Anyway the book is fun, funny and takes things more from history, as opposed to mythology in Herc's book <span style=\"font-size:10px\">(except for issue zero, which is an origin story for Armstrong that came out around the time of regular issue 10, in which it is revealed what Armstrong and his brothers have to do with the Epic of Gilgamesh)</span>, mostly in the fact that Armstrong is a really old immortal poet, drunkard and party-animal and has personally met a lot of famous people throughout history.<br /> <br /> And in case anyone is wondering, yes, the book does present credible challenges to the heroes, despite one of the titular characters apparently being <i>immortal </i>immortal, not just ageless.<br /> <br /> I've read the first arc with the religious/political stuff...and it seems the next arc involves invading Area 51 and getting mixed in alien/military-based shenanigans while trying to find-out the origins of Archer's powers. So, you see what I say about it being mostly wacky ^_^<br /> <br /> I'll finish by saying that the book is fun enough that I'll probably give a chance to the other titles of this Valiant revival, and that includes the uber-90s <i>Bloodshot</i>, despite me having grown to hate the 90s style of super-hero comics.","signature":"<hr class=\"b-divider\"/><br/>You need a picture altered to fit your Exalted character, or just looking for some visual inspiration? Check out the twice-reborn <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/266-photoshop-exaltification\" target=\"_blank\"> Exaltification thread</a>. And here is my <a href=\"http://danelsan.deviantart.com/\" target=\"_blank\">Deviantart page</a><br /> <br /> S\u00f8ren Kierkegaard + Kim Kardashian = <a href=\"https://twitter.com/KimKierkegaard\" target=\"_blank\">Brilliance</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/868-danelsan","name":"danelsan","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar868_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1492"}]},"thankedby":[]},{"date":"2014-09-04T05:44:57-07:00","id":248765,"title":"","content":"<a href=\"http://screenrant.com/marvel-comics-death-of-wolverine/\" target=\"_blank\">Death of Wolverine</a><br /> <i><br /> Wolverine was immortal, or close to it thanks to his regeneration and slow aging. He has escaped certain death countless times, and not even writer Mark Millar and artist Steve McNiven\u2019s disturbing, future-set Old Man Logan could finish him off. Today, however, Marvel has announced that the Ol\u2019 Canuknuckle Head\u2019s final card will be punched this September.<br /> <br /> EW reports that Wolverine will be killed off in an upcoming 4-part Marvel limited series, appropriately title Death of Wolverine. Issue #1 will premiere September 3rd, 2014. The series will be written by Charles Soule and drawn by Steve McNiven. The \u201c3 Months to Live\u201d arc of this June\u2019s Wolverine solo series will culminate in the character\u2019s demise on September 24th. According to Marvel executive editor Michael Marts:<br /> \u201cFor a long time, no matter who Wolverine was battling, he\u2019s been the eternal victor. He almost always comes out on top. Now he finally comes up against an adversary that he cannot win against, he cannot fight. What does that mean for this character who\u2019s been around for hundred years?\u201d<br /> How permanent will the Death of Wolverine prove to be? Could this be a Death of Superman-esque attempt to not only revamp the character but make him relevant to the comic book audience in a new way? As impermanent as comic book deaths has proven to be in the past, Marts asserts that Marvel\u2019s creative team has made this decision \u201cfrom a standpoint of finality, of closure.\u201d He elaborated about the ripple effect this will have, saying: \u201cYou\u2019re gonna be entering into a world without Wolverine. That affects not only his teammates, but also the Marvel Universe at large. We\u2019ve got a lot of things in the works already.\u201d</i><br /> ---------------------------------<br /> <br /> In other words, he won't be dead for long...<br />","signature":"<hr class=\"b-divider\"/><br/><i>Mankind was once an endangered species. It will likely be so again. And mankind will only have itself to blame.</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/144-shadowflame","name":"Shadowflame","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar144_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1223"}]},"thankedby":[]},{"date":"2014-09-04T06:42:45-07:00","id":248787,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shadowflame</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/65267-let-s-talk-comics?p=248765#post248765\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Marts asserts that Marvel\u2019s creative team has made this decision \u201cfrom a standpoint of finality, of closure.\u201d He elaborated about the ripple effect this will have, saying: \u201cYou\u2019re gonna be entering into a world without Wolverine. That affects not only his teammates, but also the Marvel Universe at large. We\u2019ve got a lot of things in the works already.\u201d[/I]<br /> ---------------------------------<br /> <br /> In other words, he won't be dead for long...</div> </div> </div> </div>Yup, we all heard the same things about Jean Grey, Bucky Barnes, Jason Todd, etc, etc, etc.................ad infinitum, ad nauseam...........y'all know the drill.<br />","signature":"<hr class=\"b-divider\"/><br/><i>- If you must be ridiculous, I must ridicule you.<br /> - Those that can give up essential liberties in exchange for temporary safety deserve neither liberty nor safety. -- Benjamin Franklin</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/375-papa-bear","name":"Papa Bear","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar375_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1920"}]},"thankedby":[]},{"date":"2014-09-04T07:25:34-07:00","id":248823,"title":"","content":"I thought there was an actual, official statement released that he'll be back in 2016, around the same time the next Wolverine movie comes out.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/271-jimb","name":"JimB","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar271_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2293"}]},"thankedby":[]},{"date":"2014-09-04T07:41:15-07:00","id":248841,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JimB</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/65267-let-s-talk-comics?p=248823#post248823\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I thought there was an actual, official statement released that he'll be back in 2016, around the same time the next Wolverine movie comes out.</div> </div> </div> </div>Coordinating his return with a new movie!?!???!!!! What brilliant marketing!!!!!!!!.............the first 10 or 15 times they did it. After that, it's become stale.<br /> <br /> Can you tell I've become a bit jaded about the whole thing?","signature":"<hr class=\"b-divider\"/><br/><i>- If you must be ridiculous, I must ridicule you.<br /> - Those that can give up essential liberties in exchange for temporary safety deserve neither liberty nor safety. -- Benjamin Franklin</i>","edited":{"userid":375,"user_link":"https://forum.theonyxpath.com/member/375-papa-bear","user":"Papa Bear","date":". 09-04-2014, 10:45 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/375-papa-bear","name":"Papa Bear","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar375_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1920"}]},"thankedby":[]},{"date":"2014-09-04T08:39:33-07:00","id":248889,"title":"","content":"One of the things I like about Invincible is the willingness to shake the status quo for real (hell, it gets shaked so often it is hard to say there even is such a status anymore XD) and keeping dead people <i>dead</i> (though Robert Kirkman did slip a couple times into the tired &quot;fake death&quot; shock tactic/twist, but it was resolved quickly - like from one issue to the next. no actual resurrections, though).","signature":"<hr class=\"b-divider\"/><br/>You need a picture altered to fit your Exalted character, or just looking for some visual inspiration? Check out the twice-reborn <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/266-photoshop-exaltification\" target=\"_blank\"> Exaltification thread</a>. And here is my <a href=\"http://danelsan.deviantart.com/\" target=\"_blank\">Deviantart page</a><br /> <br /> S\u00f8ren Kierkegaard + Kim Kardashian = <a href=\"https://twitter.com/KimKierkegaard\" target=\"_blank\">Brilliance</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/868-danelsan","name":"danelsan","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar868_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1492"}]},"thankedby":[]},{"date":"2014-09-04T13:00:30-07:00","id":249085,"title":"","content":"They are/were making money hand-over-fist thanks to how popular Wolverine has become thanks to the movies(even though Fox gets the money for the movies it boosted all other Marvel sales of him). You don't really need an official announcement just the fact that lot of cash is involved..","signature":"<hr class=\"b-divider\"/><br/>Forever and always forward.<br /> Don't ask why that came to mind or that I felt the need to post it.<br /> I see the incorporeally challenged.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/787-sorwen","name":"Sorwen","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"228"}]},"thankedby":[]},{"date":"2014-09-04T13:45:54-07:00","id":249118,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Sorwen</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/65267-let-s-talk-comics?p=249085#post249085\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">(even though Fox gets the money for the movies it boosted all other Marvel sales of him)</div> </div> </div> </div>Hmmm, I wonder if Fox's contract is due up by 2015..........<br />","signature":"<hr class=\"b-divider\"/><br/><i>- If you must be ridiculous, I must ridicule you.<br /> - Those that can give up essential liberties in exchange for temporary safety deserve neither liberty nor safety. -- Benjamin Franklin</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/375-papa-bear","name":"Papa Bear","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar375_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1920"}]},"thankedby":[]},{"date":"2014-09-04T14:32:44-07:00","id":249174,"title":"","content":"I went to the comic shop today, and by coincidence the guys there were talking about this. Now, I have no idea if any of this is true, but the story they were telling is back when Marvel filed for bankruptcy, Fox used their superior position to essentially get a reverse George Lucas deal, so they get royalties on pretty much any and all X-Men merchandise. Disney isn't cool with this, so they're trying to starve Fox out by having Marvel cut as much X-Men property as possible so Fox will lose money on the deal and revert the movie rights back to Marvel, so Disney won't have to pay Bill O'Reilly and Megyn Kelly every time someone buys a Wolverine poster.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/271-jimb","name":"JimB","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar271_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2293"}]},"thankedby":[]},{"date":"2014-09-04T16:00:15-07:00","id":249259,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JimB</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/65267-let-s-talk-comics?p=249174#post249174\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I went to the comic shop today, and by coincidence the guys there were talking about this. Now, I have no idea if any of this is true, but the story they were telling is back when Marvel filed for bankruptcy, Fox used their superior position to essentially get a reverse George Lucas deal, so they get royalties on pretty much any and all X-Men merchandise. Disney isn't cool with this, so they're trying to starve Fox out by having Marvel cut as much X-Men property as possible so Fox will lose money on the deal and revert the movie rights back to Marvel, so Disney won't have to pay Bill O'Reilly and Megyn Kelly every time someone buys a Wolverine poster.</div> </div> </div> </div>Wouldn't Marvel be losing money in that situation though?<br /> <br /> Though, I guess I wouldn't put it past them though....but it does seem like a cutting off your nose to spite your face situation...in a way.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://mrgone.rocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2014-09-04T18:24:10-07:00","id":249340,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mr Gone</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/65267-let-s-talk-comics?p=249259#post249259\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Wouldn't Marvel be losing money in that situation though?</div> </div> </div> </div>Yeah, but Disney has the war coffers to back it up, and Marvel is replacing the X-obsession with Avengers and Inhumans.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/271-jimb","name":"JimB","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar271_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2293"}]},"thankedby":[]},{"date":"2014-09-05T00:42:55-07:00","id":249628,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Papa Bear</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/65267-let-s-talk-comics?p=249118#post249118\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hmmm, I wonder if Fox's contract is due up by 2015..........</div> </div> </div> </div>The contract lasts until Fox stops using the X-men brand this applies to Spiderman and Fantastic Four. It's why the FF movie was rushed and why we kept hearing about it. It's something that was made to keep the copyright. Unless the movie bombs though to a great extent there's no reason to sell back the rights. Rights are pretty dumb though. Because the non-comicbook merchandise has to be shared and Disney is aggressively promoting non-comic book versions of the universe they won't make another X-men animated series or another Spiderman one. (In fact, Spectacular spiderman got canned awhile back because of this dispute with Sony). These rights were pretty much strongarmed away and there is very little they can do about it. It's just not as profitable to share the money so they'll use properties they completely own.","signature":"","edited":{"userid":116,"user_link":"https://forum.theonyxpath.com/member/116-epimetheus","user":"Epimetheus","date":". 09-05-2014, 03:45 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/116-epimetheus","name":"Epimetheus","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1758"}]},"thankedby":[]},{"date":"2014-09-05T04:03:54-07:00","id":249682,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JimB</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/65267-let-s-talk-comics?p=249340#post249340\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Yeah, but Disney has the war coffers to back it up, and Marvel is replacing the X-obsession with Avengers and Inhumans.</div> </div> </div> </div>It has seemed that way lately I suppose.... and yea, I guess Disney does have lots of cash...and that Star Wars money now. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://mrgone.rocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2014-09-05T06:56:13-07:00","id":249751,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Epimetheus</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/65267-let-s-talk-comics?p=249628#post249628\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> The contract lasts until Fox stops using the X-men brand this applies to Spiderman and Fantastic Four. It's why the FF movie was rushed and why we kept hearing about it. It's something that was made to keep the copyright. Unless the movie bombs though to a great extent there's no reason to sell back the rights. Rights are pretty dumb though. Because the non-comicbook merchandise has to be shared and Disney is aggressively promoting non-comic book versions of the universe they won't make another X-men animated series or another Spiderman one. (In fact, Spectacular spiderman got canned awhile back because of this dispute with Sony). These rights were pretty much strongarmed away and there is very little they can do about it. It's just not as profitable to share the money so they'll use properties they completely own.</div> </div> </div> </div>Not totally accurate. <a href=\"http://en.wikipedia.org/wiki/Ultimate_Spider-Man_%28TV_series%29\" target=\"_blank\">Ultimate Spider-Man</a> is the unofficial replacement for Spectacular Spider-Man, but it's on a Disney owned channel. Though, from what little I've seen of it, it's no where near the quality.","signature":"<hr class=\"b-divider\"/><br/><i>- If you must be ridiculous, I must ridicule you.<br /> - Those that can give up essential liberties in exchange for temporary safety deserve neither liberty nor safety. -- Benjamin Franklin</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://