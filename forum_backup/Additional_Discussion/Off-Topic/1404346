/0/6/0/4/5/avatar4433_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"4202"}]},"thankedby":[]},{"date":"2020-07-31T18:01:13-07:00","id":1405710,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>atamajakki</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1405706#post1405706\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">(Asians Represent just won the Gold ENnie for Best Podcast!)</div> </div> </div> </div>Cool. Good for them.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1208-grumpy-rpg-reviews","name":"Grumpy RPG Reviews","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1208_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1888"}]},"thankedby":[]},{"date":"2020-07-31T18:07:21-07:00","id":1405714,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>atamajakki</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1405706#post1405706\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">(Asians Represent just won the Gold ENnie for Best Podcast!)</div> </div> </div> </div>Congratulations to them.<br />","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-08-02T11:49:23-07:00","id":1405976,"title":"","content":"Thus far I have found Al-Qadim more informative than Kindred of the East. I really wish the latter podcast had someone of East Asian decent who has experience with World of Darkness because right now it's a little over-reliant on insight from Adam aka WerewolfFeels to provide context which is necessary for deeper analysis than dunking on the obvious cringe.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":8}],"user":{"link":"https://forum.theonyxpath.com/member/535-bastet","name":"Bastet","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar535_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"337"}]},"thankedby":[]},{"date":"2020-08-02T15:32:51-07:00","id":1406011,"title":"","content":"Some things I want to point out.<br /> <br /> A) Other cultures also do mishmashes of Western culture and other cultures as well. I remember reading a translation of a Karl May novel (just to deal first with two Western cultures, although the Germans have often said they aren't a Western culture) because a German student asked me to read it and explain why it wasn't popular in America. When I told him, first all Americans who aren't the children of German immigrants or Native Americans are depicted as evil or stupid and secondly all Western towns are depicted as swarming with Jews mainly just milling about being sinister in a vague undefined way. &quot;So cultural chauvinism.&quot; was his response. I read a highly detailed scholarly article on Arab views of other Asians. The scholar showed in great detail and with hundreds of examples that the Arabs were Orientalist in their views of non-Arab Asians. And that those Arabs most aware of the idea of &quot;Orientalism&quot; were generally the worst offenders. Note: the author did list multiple exceptions and lauded their educational work. Going into East Asian views of non-Asians and other Asians could cause way too much trouble/bitterness. The idea that those outside of your culture deserve respect and you should also respect their cultures is a Western idea that hasn't really caught on much outside the West.<br /> <br /> B) The tendency to promote respect for the Other is ancient in the West and comes from art, play, and amusement. The first great work in the Western tradition is the Iliad. The Trojans (non-Greeks) are treated with more respect than the Greeks. Sure, Homer depicts the Trojans as Greeks and has them worship the Greek gods. The Ramayana (a work of similar importance to India) depicts foreigners as monkeys and demons. That sort of thing is typical in most of the planet. Homer, who I have heard denounced as a bigot, is exceptional in his respect of people from other cultures. But only exceptional among non-Westerners. The Greek dramatists often made non-Greeks the hero. Even the Barbarian witch Medea was shown respect. The Songs of Deeds, the Arthurian Legends, and Chivalric romances often had Muslin heroes and heroines. The examples of Westerners as heroes in Islamic literature are few and far between.<br /> <br /> Please note, serious scholarly authors among the Christians of Europe were as hostile as the Muslims were. It was the imaginative authors of popular romances that explored tolerance.<br /> The whole point of translating the Arabian Nights was to understand the tellers of the tales better. The Enlightenment embraced Sherazade as a heroine of exceptional courage, compassion, and wisdom. A worthy model for all humanity. She sought to heal and liberate her foe, restoring his humanity and sanity to him. Modern anti-Orientalism reduces Sherazade to a cheap tramp.<br /> <br /> This is typical of those attacking Orientalists. They are proudly bigoted. Where any clear or fair reading of the 18th, 19th, and 20th-century Orientalists show people who wanted to show the West the wonders and wisdom of other peoples (even if many of them were involved in empire-building) the anti-Orientalists have only embraced destructive ideas and have generally discouraged cultural exchange and intercultural respect.<br /> <br /> C) the 20th and 21st-century fiction and game writers most accused of Orientalism are often writers who promoted respect between cultures. Pearl S. Buck, the daughter of missionaries, spent most of her literary career desperately trying to combat anti-Chinese racism and Western Imperialism in China through her stories about Chinese peasants. She's routinely dismissed as racist trash. I've read books that have denounced the character of Spock in Star Trek as a vast racist and Orientalist crime against humanity for which the USA should lose its independence and the right to participate in the arts forever. Clearly, the authors were totally ignorant of the context and originality of the character. But they were anti-Orientalists in good standing.<br /> <br /> #######################<br /> <br /> Let's remember to do better in the future, and to attempt to be respectful, even when we know we will never be respected. But there is no reason to disrespect our own past unless it was malicious. The works in question were meant to be fun and exciting. Like most early D&amp;D they're meant to reflect pulp fantasy ala Weird Tales, they were never designed to be anything like realistic representations of life in Southwest Asia or North Africa. In fact, they wanted to stay away from that in order to be less likely to offend.<br /> <br /> That clearly didn't work.","signature":"","edited":{"userid":857,"user_link":"https://forum.theonyxpath.com/member/857-astromancer","user":"Astromancer","date":". 08-03-2020, 09:09 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/857-astromancer","name":"Astromancer","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar857_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2195"}]},"thankedby":[]},{"date":"2020-08-05T17:27:16-07:00","id":1406527,"title":"","content":"Weird Tales have a history of being incredibly racist. That's probably why it's not working well as a template for adventure rpgs. That's why Exalted went through the trouble to scrub out a lot of shit from the pulp inspirations it has, and it still is far from ideal nonetheless. Don't forget which group of countries had influence in other parts of the world, and why - the British, the French, the Germans, they didn't go thousands of miles abroad for pleasant social visits. It was to make the rest of the world theirs, and the attitudes that this engendered are still sitting high and mighty to this day, but somehow, have become invisible to the ones holding them.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]},{"date":"2020-08-05T18:20:29-07:00","id":1406543,"title":"","content":"I know next to nothing about this stuff, but...I flipped thru a copy of the Land of Fate boxed set for Al-Qadim once and I was impressed that they made the Loregiver a woman (well, a girl, technically).","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"","name":"Guest","avatar":"https://forum.theonyxpath.com/core/images/default/default_avatar_large.png","title":"","rank":0,"rank-name":"","custom":[]},"thankedby":[]},{"date":"2020-08-18T03:09:43-07:00","id":1408880,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>LostLight</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1404943#post1404943\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The way I see it, trying to erase those books from the web is the virtual equivilent of &quot;book burning&quot;, and I have seen enough people who actively support that idea (not necessrly anyone in this thread)</div> </div> </div> </div>That's apparently not what the podcasters actually want either.<br /> They think the books should be freely available as part of an online archive with some explanation as to why they've been consigned to history. I support the creation of such a site, because it wouldn't necessarily just be a dumping ground for problematic old supplements but might also help out a few books you can't buy anymore because they fell into a legal rights limbo. <br /> <br />","signature":"<hr class=\"b-divider\"/><br/><b><a href=\"https://swordofcreation.net/\" target=\"_blank\">Sword of Creation</a> a hub for Exalted related content</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":8}],"user":{"link":"https://forum.theonyxpath.com/member/7-lioness","name":"Lioness","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7_2.png","title":"Moderator","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"5443"}]},"thankedby":[]},{"date":"2020-08-18T06:56:23-07:00","id":1408916,"title":"","content":"I just discovered the podcast. I will point out some issues from the first part I am listening too.<br /> <br /> <br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">The intro fiction they read is not from the perspective of the Europeans it is supposed to be from the perspective of the Wan Gui.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">Kindred of the East was 2nd ed not 3rd.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">They have a lot of glaring mistakes about the setting. That is actually quite common I have found in Whitewolf Fans who only specialize in one setting seem to have a lot of incorrect knowledge about misremembered facts of the other settings.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">13 survivors not 12.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">Ventrue are not super strong.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">And they turned off their comment feature...</span></span><br /> <br /> <br /> <br /> <br /> But now I need to nap before work.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/754-eldagusto","name":"Eldagusto","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar754_2.gif","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"6435"}]},"thankedby":[]},{"date":"2020-08-18T09:20:28-07:00","id":1408945,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eldagusto</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1408916#post1408916\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I just discovered the podcast. I will point out some issues from the first part I am listening too.<br /> <br /> <br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">The intro fiction they read is not from the perspective of the Europeans it is supposed to be from the perspective of the Wan Gui.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">Kindred of the East was 2nd ed not 3rd.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">They have a lot of glaring mistakes about the setting. That is actually quite common I have found in Whitewolf Fans who only specialize in one setting seem to have a lot of incorrect knowledge about misremembered facts of the other settings.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">13 survivors not 12.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">Ventrue are not super strong.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">And they turned off their comment feature...</span></span><br /> <br /> <br /> <br /> <br /> But now I need to nap before work.</div> </div> </div> </div>To be fair turning off comments on Youtube is the only way to stay sane.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 08-18-2020, 12:41 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":7}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-08-18T12:51:09-07:00","id":1408987,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lioness</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1408880#post1408880\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">That's apparently not what the podcasters actually want either.<br /> They think the books should be freely available as part of an online archive with some explanation as to why they've been consigned to history.</div> </div> </div> </div>I mean, they're old books. Generally speaking old, out of date TSR books aren't ever reprinted with very few of exceptions for anniversary core books or a few modules but even then that basically doesn't really happen. So far as I know, there were never and were never going to be plans to reprint the old Oriental Adventures or Al-Qadim books. So those books were always going to be consigned to history, for the same reason why the original run of Dark Sun or Spelljammer or Greyhawk or Ravenloft books or countless other setting books have been consigned to history.","signature":"","edited":{"userid":741,"user_link":"https://forum.theonyxpath.com/member/741-anubisxy","user":"AnubisXy","date":". 08-18-2020, 03:59 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2020-08-18T12:56:40-07:00","id":1408988,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1408987#post1408987\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I mean, they're old books. Generally speaking old, out of date TSR books aren't ever reprinted with very few of exceptions for anniversary core books or a few modules but even then that basically doesn't really happen. So far as I know, there were never and were never going to be plans to reprint the old Oriental Adventures or Al-Qadim books. So those books were always going to be consigned to history, for the same reason why the original Dark Sun or Spelljammer or Greyhawk or Ravenloft books or countless other setting books have been consigned to history.</div> </div> </div> </div>... What, buying the PDFs on DTRPG and the Guild doesn't count?","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-size:14px\"><a href=\"https://tinyurl.com/2p8ss75f\" target=\"_blank\"><b>Chris H</b></a>/<b>EndDaysEngine</b> | <a href=\"https://www.patreon.com/EndDaysEngine\" target=\"_blank\"><b>Patreon</b></a></span>| <b>He/His </b>| <b>Currently Writing</b>: <i>[Redacted], [Redacted]</i><br /> <br /> <b>CofD booklists: </b><a href=\"https://goo.gl/DRdB7h\" target=\"_blank\">Beast</a> I <a href=\"https://goo.gl/x1FPpM\" target=\"_blank\">Changeling</a> | <a href=\"https://goo.gl/ZSCx5U\" target=\"_blank\">Demon</a> | <a href=\"http://shorturl.at/syDK9\" target=\"_blank\">Deviant</a> | <a href=\"https://goo.gl/Mh5M6m\" target=\"_blank\">Geist</a> l <a href=\"https://goo.gl/gSjfm5\" target=\"_blank\">Hunter</a> l <a href=\"https://goo.gl/qj5aX9\" target=\"_blank\">Mage</a> | <a href=\"https://goo.gl/2HCpjg\" target=\"_blank\">Mummy</a> | <a href=\"https://goo.gl/68yRHY\" target=\"_blank\">Promethean</a> | <a href=\"https://goo.gl/a4mjqA\" target=\"_blank\">Vampire</a> | <a href=\"https://goo.gl/hrULtN\" target=\"_blank\">Werewolf</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/4433-second-chances","name":"Second Chances","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4433_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"4202"}]},"thankedby":[]},{"date":"2020-08-18T13:18:27-07:00","id":1408993,"title":"","content":"Yes, right now the 1985 Oriental Adventures it's still for sale on DTRPG with the following disclaimer.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> We (Wizards) recognize that some of the legacy content available on this website does not reflect the values of the Dungeons &amp; Dragons franchise today. Some older content may reflect ethnic, racial, and gender prejudice that were commonplace in American society at that time. These depictions were wrong then and are wrong today. This content is presented as it was originally created, because to do otherwise would be the same as claiming these prejudices never existed. Dungeons &amp; Dragons teaches that diversity is a strength, and we strive to make our D&amp;D products as welcoming and inclusive as possible. This part of our work will never end. </div> </div> </div><br />","signature":"<hr class=\"b-divider\"/><br/><b><a href=\"https://swordofcreation.net/\" target=\"_blank\">Sword of Creation</a> a hub for Exalted related content</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/7-lioness","name":"Lioness","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7_2.png","title":"Moderator","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"5443"}]},"thankedby":[]},{"date":"2020-08-18T13:37:56-07:00","id":1408997,"title":"","content":"So they wanted Wizards to have the material available while having a notice about how it's problematic? Basically, they wanted Wizards to keep doing the thing they've been doing for years. Okay.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2020-08-18T13:57:00-07:00","id":1408998,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1408997#post1408997\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So they wanted Wizards to have the material available while having a notice about how it's problematic? Basically, they wanted Wizards to keep doing the thing they've been doing for years.</div> </div> </div> </div>No, the disclaimer is a month old and in response to the podcast. This is the dreaded book burning.","signature":"<hr class=\"b-divider\"/><br/><b><a href=\"https://swordofcreation.net/\" target=\"_blank\">Sword of Creation</a> a hub for Exalted related content</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":7}],"user":{"link":"https://forum.theonyxpath.com/member/7-lioness","name":"Lioness","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7_2.png","title":"Moderator","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"5443"}]},"thankedby":[]},{"date":"2020-08-18T14:32:47-07:00","id":1409010,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eldagusto</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1408916#post1408916\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I just discovered the podcast. I will point out some issues from the first part I am listening too.<br /> <br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">The intro fiction they read is not from the perspective of the Europeans it is supposed to be from the perspective of the Wan Gui.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">Kindred of the East was 2nd ed not 3rd.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">They have a lot of glaring mistakes about the setting. That is actually quite common I have found in Whitewolf Fans who only specialize in one setting seem to have a lot of incorrect knowledge about misremembered facts of the other settings.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">13 survivors not 12.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">Ventrue are not super strong.</span></span><br /> <span style=\"color:#000000\"><span style=\"font-family:Arial\">And they turned off their comment feature...</span></span><br /> <br /> But now I need to nap before work.</div> </div> </div> </div>This is supposed to be an examination of the racist and damaging elements in the work. Objecting they got the number of Antediluvians wrong, or they named the wrong edition, or they didn't get the Ventrue disciplines right has to be a massive intentional missing the point.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.youtube.com/BogMod\" target=\"_blank\">https://www.youtube.com/BogMod</a> I play a lot of videogames.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":9}],"user":{"link":"https://forum.theonyxpath.com/member/131-bogmod","name":"BogMod","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar131_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"136"}]},"thankedby":[]},{"date":"2020-08-18T16:37:54-07:00","id":1409034,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>BogMod</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1409010#post1409010\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> This is supposed to be an examination of the racist and damaging elements in the work. Objecting they got the number of Antediluvians wrong, or they named the wrong edition, or they didn't get the Ventrue disciplines right has to be a massive intentional missing the point.</div> </div> </div> </div>Hey cool story bro I\u2019m pointing out there are nuances missed when you have a professed expert of the subject who is missing basics of the setting. It also shows they arrived at the review with the intent to crap on it before they ever looked at it.<br /> <br /> I\u2019m allowed to give my opinion on the subject. Or are you trying to tell an Asian that he doesn\u2019t have a right to comment and critique? Do I not know my place or something?<br /> <br /> What they did get correct is the layout looks like a gaudy menu and the character for qi \u6c14 or \u6c23 in traditional has a proper stroke order if you learned charter writing.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/754-eldagusto","name":"Eldagusto","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar754_2.gif","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"6435"}]},"thankedby":[]},{"date":"2020-08-18T18:10:54-07:00","id":1409045,"title":"","content":"Yeah, if all your going to do is punch down at least do your homework. Like I said, low effort content.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/3953-dwight","name":"Dwight","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3953_2.jpeg","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"2355"}]},"thankedby":[]},{"date":"2020-08-18T18:56:40-07:00","id":1409048,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eldagusto</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1404346-al-qadim-oriental-adventures-and-problems?p=1409034#post1409034\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hey cool story bro I\u2019m pointing out there are nuances missed when you have a professed expert of the subject who is missing basics of the setting. It also shows they arrived at the review with the intent to crap on it before they ever looked at it.<br /> <br /> I\u2019m allowed to give my opinion on the subject