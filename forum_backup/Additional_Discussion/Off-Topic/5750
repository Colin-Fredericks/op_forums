ly.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12892-kammerer","name":"Kammerer","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12892_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2017"},{"key":"Posts:","value":"1191"}]},"thankedby":[]},{"date":"2019-11-30T08:24:12-08:00","id":1351869,"title":"","content":"I saw Knives Out yesterday and highly enjoyed it!! The less you know going in the better so I won't say much... But I really liked it!!","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://mrgone.rocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2019-12-01T19:43:51-08:00","id":1352096,"title":"","content":"Ford vs Ferrari was amazing.","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#333333\"><span style=\"font-family:&amp;quot\"><span style=\"font-size:16px\">&quot;Steel isn't strong, boy. Flesh is stronger.&quot;</span></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"t