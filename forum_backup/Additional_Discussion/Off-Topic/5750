de.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> Well I've never been the best at noticing this stuff on the first view and its been decades the last time I've seen Howard the duck. I only spotted the most obvious ones such as Cosmo at the mining outpost live exhibition </div></div> </div> </div><br /> <br /> <br /> On the whole the movie was very entertaining and though it deviates from cartoon canon its Ok in my opinion. You can't really cram SL's started in the 60's silver age of comics into 2h feature film without making it look like a clip show as a result though admittedly the character backgrounds could have been fleshed a bit more but with long standing characters its often a trade off between cool action scenes and on-going story or characters having talking head-drama and enough flashbacks to be counted as PSTD but the insert at the end promised more GoG-films so I'm hoping the future films will place more light on the character history and personas now that the team (and their heroism et all) have been established.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1700-blue-fox","name":"Blue Fox","avatar":"https://forum.