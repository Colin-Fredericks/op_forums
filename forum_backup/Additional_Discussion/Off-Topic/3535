0/6/0/4/5/avatar177_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10857"}]},"thankedby":[]},{"date":"2019-07-19T18:23:00-07:00","id":1326138,"title":"","content":"I love Steven Universe. I love that there\u2019s a cartoon out there that\u2019s shamelessly about emotions and connections and love, that it\u2019s explicitly queer as hell. I love how beautiful it is. I love how genuine the creator is. I love the music. I\u2019m a little emotional over the movie trailer and new song, if you can\u2019t tell.","signature":"<hr class=\"b-divider\"/><br/>Remi. she/her. game designer.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/281-atamajakki","name":"atamajakki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar281_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5487"}]},"thankedby":[]},{"date":"2019-07-19T20:34:31-07:00","id":1326175,"title":"","content":"I love Onyx Path's April Fool's Day PDF, Dudes of Legend.<br /> <br /> I only wish it were another 100 pages.","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#333333\"><span style=\"font-family:&amp;quot\"><span style=\"font-size:16px\">&quot;Steel isn't strong, boy. Flesh is stronger.&quot;</span></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/95-fat-larry","name":"Fat Larry","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar95_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1337"}]},"thankedby":[]},{"date":"2019-07-19T23:23:30-07:00","id":1326202,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>atamajakki</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/3535-you-know-what-i-love-mk-i?p=1326138#post1326138\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I love Steven Universe. I love that there\u2019s a cartoon out there that\u2019s shamelessly about emotions and connections and love, that it\u2019s explicitly queer as hell. I love how beautiful it is. I love how genuine the creator is. I love the music. I\u2019m a little emotional over the movie trailer and new song, if you can\u2019t tell.</div> </div> </div> </div>It\u2019s such a great show. Can\u2019t wait for the movie.","signature":"<hr class=\"b-divider\"/><br/>Going by Willow now, or Wil for short. She/Her/Hers.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/269-charlaquin","name":"Charlaquin","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar269_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10831"}]},"thankedby":[]},{"date":"2019-07-21T07:31:03-07:00","id":1326462,"title":"","content":"That I had the guts to quit a profession that no longer fit who I am, and what I want in life.<br /> <br /> Goodbye, standup. Hello, new thing.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:times new roman\"><span style=\"color:#0000CD\"><span style=\"font-size:12px\"><b>\u201cNobody is purely good or purely evil. Mo</b></span><b>st of us are in-between. There are moths that explore the day and butterflies that play at night.\u201d </b><br /> - Suzy Kassem, Rise Up and Salute The Sun<br /> <b>(She/Her)</b></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/380-azraelfirestorm","name":"AzraelFirestorm","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar380_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1718"}]},"thankedby":[]},{"date":"2019-07-21T07:47:50-07:00","id":1326464,"title":"","content":"Tell us about the new thing?","signature":"<hr class=\"b-divider\"/><br/>He/him","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/177-thecountalucard","name":"TheCountAlucard","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar177_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10857"}]},"thankedby":[]},{"date":"2019-07-21T08:42:36-07:00","id":1326469,"title":"","content":"Had a couple of rough weeks and that made me think. Sure, things are not always easy and I have some issues to solve, but you know what?<br /> <br /> I'm where I want to be, I'm doing what I want to do, and I have a clear path ahead like I never had. I'm making little steps and the road is still uncertain and reaaaaaally long, but it feels good. I'm making new friends and getting to know lots of people who see the kind of person I am, see what I'm striving to achieve, and appreciate me for it. I just have to keep doing this and I might manage to achieve my goals after all.<br /> <br /> I'm happy, folks. Like I haven't been in a long time. And nothing circumstances can do or people who don't care about me say can take it away from me.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/815620-cinder-s-comprehensive-collection-of-creations\" target=\"_blank\">Cinder's Comprehensive Collection of Creations</a> - Homebrew Hub<br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/1172470-cinder-writes-about-beast-the-primordial\" target=\"_blank\">I write about Beast: The Primordial a lot</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/38-cinder","name":"Cinder","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar38_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1408"}]},"thankedby":[]},{"date":"2019-07-21T16:18:34-07:00","id":1326554,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>TheCountAlucard</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/3535-you-know-what-i-love-mk-i?p=1326464#post1326464\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Tell us about the new thing?</div> </div> </div> </div>I may or may not be (I am) developing a TTRPG influenced by the works of John Milton and William Blake, with an absurdist postmodern twist. It's still in early development, but the setting is growing, and the new system I'm building for it is looking good so far.<br /> <br /> I never thought I'd have it in me, but here we are!<br /> <br /> I might be doing yet another thing, but I'm waiting to see how it goes before announcing much. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:times new roman\"><span style=\"color:#0000CD\"><span style=\"font-size:12px\"><b>\u201cNobody is purely good or purely evil. Mo</b></span><b>st of us are in-between. There are moths that explore the day and butterflies that play at night.\u201d </b><br /> - Suzy Kassem, Rise Up and Salute The Sun<br /> <b>(She/Her)</b></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/380-azraelfirestorm","name":"AzraelFirestorm","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar380_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1718"}]},"thankedby":[]},{"date":"2019-07-25T17:14:46-07:00","id":1327504,"title":"","content":"Trump gave a speech in front of a phony Presidential Seal that featured a two-headed eagle (like on Russian coats of arms) clutching a bag of golf clubs in one talon (instead of arrows), a wad of cash in the other (instead of an olive branch), and the banner dangling from its beak read &quot;45 es un titere&quot; (&quot;45 is a puppet&quot;).<br /> <br /> \u200b<i>And he didn't even notice.</i><br /> <br /> That shit is <b>delightful</b>.","signature":"<hr class=\"b-divider\"/><br/>He/him","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/177-thecountalucard","name":"TheCountAlucard","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar177_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10857"}]},"thankedby":[]},{"date":"2019-07-26T12:07:46-07:00","id":1327625,"title":"","content":"I\u2019ve now submitted more words for Changeling: the Lost than any other single gameline (although, if Dark Eras counts as a gameline, they are tied). Not what I expected when I got my first gig, but 100% not complaining.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-size:14px\"><a href=\"https://tinyurl.com/2p8ss75f\" target=\"_blank\"><b>Chris H</b></a>/<b>EndDaysEngine</b> | <a href=\"https://www.patreon.com/EndDaysEngine\" target=\"_blank\"><b>Patreon</b></a></span>| <b>He/His </b>| <b>Currently Writing</b>: <i>[Redacted], [Redacted]</i><br /> <br /> <b>CofD booklists: </b><a href=\"https://goo.gl/DRdB7h\" target=\"_blank\">Beast</a> I <a href=\"https://goo.gl/x1FPpM\" target=\"_blank\">Changeling</a> | <a href=\"https://goo.gl/ZSCx5U\" target=\"_blank\">Demon</a> | <a href=\"http://shorturl.at/syDK9\" target=\"_blank\">Deviant</a> | <a href=\"https://goo.gl/Mh5M6m\" target=\"_blank\">Geist</a> l <a href=\"https://goo.gl/gSjfm5\" target=\"_blank\">Hunter</a> l <a href=\"https://goo.gl/qj5aX9\" target=\"_blank\">Mage</a> | <a href=\"https://goo.gl/2HCpjg\" target=\"_blank\">Mummy</a> | <a href=\"https://goo.gl/68yRHY\" target=\"_blank\">Promethean</a> | <a href=\"https://goo.gl/a4mjqA\" target=\"_blank\">Vampire</a> | <a href=\"https://goo.gl/hrULtN\" target=\"_blank\">Werewolf</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/4433-second-chances","name":"Second Chances","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4433_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"4202"}]},"thankedby":[]},{"date":"2019-08-05T13:38:39-07:00","id":1329490,"title":"","content":"My work is expanding in some fun ways.<br /> <br /> I'm not working on a new system. I'm building 3 of them. Why? Because I don't have to write as I've played.<br /> <br /> I'd gotten so used to playing with &quot;one size fits most&quot; systems that whole game lines blurred into each other until they were inseparable for me. I was losing the ability to see individual games for what they are, as themselves. <br /> <br /> I get the tendency to make systems like that. It's a popular way to do things, and it provides some flexibility for different game styles. It works, and it makes sense, especially for extensive game lines that might want some crossover potential.<br /> <br /> That's not what I'm doing right now, though. With one exception, all of the worlds I'm building stand alone. They are just themselves. The mechanics (and even dice) for each wholly different from the others. I'm looking at games with fresh eyes again, and diving in.<br /> <br /> I freaking love that.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:times new roman\"><span style=\"color:#0000CD\"><span style=\"font-size:12px\"><b>\u201cNobody is purely good or purely evil. Mo</b></span><b>st of us are in-between. There are moths that explore the day and butterflies that play at night.\u201d </b><br /> - Suzy Kassem, Rise Up and Salute The Sun<br /> <b>(She/Her)</b></span></span>","edited":{"userid":380,"user_link":"https://forum.theonyxpath.com/member/380-azraelfirestorm","user":"AzraelFirestorm","date":". 08-05-2019, 04:43 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/380-azraelfirestorm","name":"AzraelFirestorm","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar380_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1718"}]},"thankedby":[]},{"date":"2019-08-06T13:07:21-07:00","id":1329637,"title":"","content":"David Cronenberg's stare.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:times new roman\"><span style=\"color:#0000CD\"