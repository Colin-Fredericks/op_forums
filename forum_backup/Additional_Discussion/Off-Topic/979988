0/6/0/4/5/avatar298_5.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"3487"}]},"thankedby":[]},{"date":"2016-11-01T08:00:01-07:00","id":996590,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Jen</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996580#post996580\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Sooooooo what would an ideal Conservative Gamers thread look like ? What kinda of content will I see in it ?</div> </div> </div> </div>A safe space. Presumably if you were against conservatives or some of their viewpoints you wouldn't want to see it except for informational purposes but you wouldn't post much more than asking for private conversations to understand more about beliefs because it would make them feel unwelcome, uncomfortable or challenged.","signature":"","edited":{"userid":886,"user_link":"https://forum.theonyxpath.com/member/886-nofather","user":"nofather","date":". 11-01-2016, 11:11 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2016-11-01T08:12:03-07:00","id":996596,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>nofather</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996590#post996590\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> A safe space. Presumably if you were against conservatives or some of their viewpoints you wouldn't want to see it but you wouldn't post because it would make them feel unwelcome, uncomfortable or challenged.</div> </div> </div> </div><br /> My bad. I'll leave y'all to it.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8492-dxanders","name":"dxanders","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"378"}]},"thankedby":[]},{"date":"2016-11-01T08:25:38-07:00","id":996606,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>dxanders</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996596#post996596\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">My bad. I'll leave y'all to it.</div> </div> </div> </div>The problem with that is that a lot of the comments had the right to be questioned, as doing so was still respecting the conversation. Heavy Arms was very informative at things and there was a lot of back and forth for a while. Some posts practically demanded to be challenged, like when Hitler and the persecution of Christians came into the picture.<br /> <br /> I find there's some irony in it, just observing things. I posted a bit but not much, I think. Among the conservative posters there is a desire for a safe space, but they don't like the idea of safe spaces, as Frishman said, 'it has created this idea that you're allowed to run from topics which make you uncomfortable, but in actuality a &quot;Safe Space&quot; should be a location where topics of any stripe can be discussed by speakers of any agenda without threat of ridicule or censorship.' There's a negative view of such things, that they are not what they're supposed to be.<br /> <br /> The references to flagging were interesting, too. I am not a moderator, but based on posts that got red texted, and posts from people who wanted red text replies to other comments, it does look like there was an aversion to using the Flag button to report posts they found inappropriate. Whether that's because they just didn't like using it, or just didn't know and expected mods to react without warning as if they were reading all the posts, who could say.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2016-11-01T08:40:29-07:00","id":996622,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Charlaquin</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996302#post996302\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Well. Opposition to same-sex marriage <i>is</i> homophobic. Not everyone who holds homophobic views is actively hateful towards gay people. This seems more of an issue of &amp;quot;homophobe&amp;quot; being a label that applies to the person as a whole instead of to their behavior.</div> </div> </div> </div>I would like to add here that the opposition of same-sex marriage is also very much violating the first amendment of the US Constitution for allowing people to have freedom of religion. There are religions that are perfectly fine with marrying two people of the same sex and so the government stopping that is a violation of their constitutional rights. <br /> <br /> It's reasons such as this and the clear hypocrisy that Mike Pence showed during his time as Indiana's Governor as to why I really cannot support the Republican party, despite being rather conservative on a number of issues.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/851-paradim","name":"Paradim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar851_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"695"}]},"thankedby":[]},{"date":"2016-11-01T08:43:38-07:00","id":996625,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>nofather</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996606#post996606\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> The problem with that is that a lot of the comments had the right to be questioned, as doing so was still respecting the conversation. Heavy Arms was very informative at things and there was a lot of back and forth for a while. Some posts practically demanded to be challenged, like when Hitler and the persecution of Christians came into the picture.<br /> <br /> I find there's some irony in it, just observing things. I posted a bit but not much, I think. Among the conservative posters there is a desire for a safe space, but they don't like the idea of safe spaces, as Frishman said, 'it has created this idea that you're allowed to run from topics which make you uncomfortable, but in actuality a &quot;Safe Space&quot; should be a location where topics of any stripe can be discussed by speakers of any agenda without threat of ridicule or censorship.' There's a negative view of such things, that they are not what they're supposed to be.<br /> <br /> The references to flagging were interesting, too. I am not a moderator, but based on posts that got red texted, and posts from people who wanted red text replies to other comments, it does look like there was an aversion to using the Flag button to report posts they found inappropriate. Whether that's because they just didn't like using it, or just didn't know and expected mods to react without warning as if they were reading all the posts, who could say.</div> </div> </div> </div><br /> I think it may have been Luis Carlos' assertions that pushed everything over the rails, but I'm happy retreating at this point.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/8492-dxanders","name":"dxanders","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"378"}]},"thankedby":[]},{"date":"2016-11-01T08:58:13-07:00","id":996635,"title":"","content":"The off-topic forum doesn't seem to have been very busy lately I'd expect some conservatives to come back and talk if they felt comfortable about it. Some may have headed off to the other forum mentioned, therpgsite.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2016-11-01T10:22:04-07:00","id":996673,"title":"","content":"My genuine curiosity is what would an ideal thread for conservative gamers actually do?<br /> <br /> Is it supposed to be for specifically conservative gamers to discuss gaming? Why then does politics enter the equation if the topic is just gaming?<br /> <br /> Is it supposed to be for discussing conservatism <i>in</i> gaming? A more focused topic but one that also doesn't benefit from a segregation of political input.<br /> <br /> Is it supposed to be for conservatives discussing conservative politics? Why then attach the caveat of conservative gamers? As one's identity as a gamer is then subordinate to one's identity as a conservative in the discussion. <br /> <br /> Is it supposed to be for conservative discussing conservative politics and no one who isn't &quot;conservative&quot; is allowed to contribute? What is the minimum threshold of conservatism to be permitted participation? What benefit is to be had from insulating oneself from criticism? All ideas are under attack everywhere all of the time. Arm yourself or get off the field.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2507-caitiff-primogen","name":"Caitiff Primogen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2507_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2014"},{"key":"Posts:","value":"1351"}]},"thankedby":[]},{"date":"2016-11-01T12:48:57-07:00","id":996766,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Caitiff Primogen</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996673#post996673\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Is it supposed to be for conservative discussing conservative politics and no one who isn't &quot;conservative&quot; is allowed to contribute? What is the minimum threshold of conservatism to be permitted participation? What benefit is to be had from insulating oneself from criticism? All ideas are under attack everywhere all of the time. Arm yourself or get off the field.</div> </div> </div> </div>That's essentially how I feel about it, and why I felt the need to comment.<br /> <br /> They put ideas on a public forum and we challenged them.","signature":"<hr class=\"b-divider\"/><br/>We don't allow mages to cast spells, since this is the most unbalancing rule of all.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/5226-jachra","name":"Jachra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5226_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2015"},{"key":"Posts:","value":"265"}]},"thankedby":[]},{"date":"2016-11-01T13:21:01-07:00","id":996777,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Caitiff Primogen</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996673#post996673\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Is it supposed to be for conservative discussing conservative politics and no one who isn't &quot;conservative&quot; is allowed to contribute? What is the minimum threshold of conservatism to be permitted participation? What benefit is to be had from insulating oneself from criticism? All ideas are under attack everywhere all of the time. Arm yourself or get off the field.</div> </div> </div> </div>I imagine they were hoping for the same kind of respectful interchange that you see in other &quot;topical&quot; threads such as the LGBT thread, the thread for people dealing with mental health issues, the thread for bronies, a thread for trans individuals, etc. In those threads, people tend to be fairly respectful, not overly combative. I don't think anyone wanted &quot;safe spaces&quot; or to insulate themselves from criticism, but they were hoping to be able to air their opinions and get treated in a respectful manner without getting dog-piled and shouted out of the thread.<br /> <br /> That's what looks like is what ended up happening and now we have people smugly patting themselves on the back for being able to drive the conservatives out.<br /> <br /> Ah well, it was fun while it lasted.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2016-11-01T13:44:30-07:00","id":996784,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996777#post996777\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I imagine they were hoping for the same kind of respectful interchange that you see in other &quot;topical&quot; threads such as the LGBT thread, the thread for people dealing with mental health issues, the thread for bronies, a thread for trans individuals, etc. In those threads, people tend to be fairly respectful, not overly combative. I don't think anyone wanted &quot;safe spaces&quot; or to insulate themselves from criticism, but they were hoping to be able to air their opinions and get treated in a respectful manner without getting dog-piled and shouted out of the thread.<br /> <br /> That's what looks like is what ended up happening and now we have people smugly patting themselves on the back for being able to drive the conservatives out.<br /> <br /> Ah well, it was fun while it lasted.</div> </div> </div> </div><br /> I'm kind of sad the thread went downhill. It's not often I can discuss politics with people who I disagree with without it turning into a &quot;who's the bigger idiot&quot; contest. <br /> <br />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2016-11-01T14:27:17-07:00","id":996810,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996777#post996777\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I imagine they were hoping for the same kind of respectful interchange that you see in other &quot;topical&quot; threads such as the LGBT thread, the thread for people dealing with mental health issues, the thread for bronies, a thread for trans individuals, etc. In those threads, people tend to be fairly respectful, not overly combative. I don't think anyone wanted &quot;safe spaces&quot; or to insulate themselves from criticism, but they were hoping to be able to air their opinions and get treated in a respectful manner without getting dog-piled and shouted out of the thread.</div> </div> </div> </div>That's what a safe space is. It doesn't insulate from criticism. It works to keep the people within it safe from feeling uncomfortable, unsafe, or unwelcome.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2016-11-01T15:50:49-07:00","id":996854,"title":"","content":"If that's what a safe place is, then we need another term for the practice of insulating from criticism in the name of not being offended. Because the latter is a very real thing, too; and it's what I tend to think of first when I hear \u201csafe space\u201d. Probably because of this: <div class=\"videocontainer with-aspect-ratio videocontainer-horizontal\" style=\"aspect-ratio: 16/9;\"> <a class=\"video-frame\" href=\"https://www.youtube.com/watch?v=sXQkXXBqj_U\" data-code=\"sXQkXXBqj_U\" data-provider=\"youtube\" data-height=\"0\" data-width=\"0\" itemprop=\"video\"> <div class=\"videothumbnail\" style=\"\"> <img src=\"https://img.youtube.com/vi/sXQkXXBqj_U/maxresdefault.jpg\" alt=\"\" /> <div class=\"videothumbnailoverlay\"></div> </div> </a> </div>","signature":"<hr class=\"b-divider\"/><br/><div style=\"margin-left:40px\"> <div align=\"center\">My hacks: <a href=\"http://tinyurl.com/dwtrin\" target=\"_blank\"><span style=\"color:#0000FF\">Trinity Continuum</span></a>, <a href=\"http://tinyurl.com/dwscion\" target=\"_blank\"><span style=\"color:#008000\">Scion</span></a>, <a href=\"http://tinyurl.com/dwExalt\" target=\"_blank\"><span style=\"color:#DAA520\">Exalted</span></a>, <a href=\"http://tinyurl.com/dwcwod\" target=\"_blank\"><span style=\"color:#800000\">World of Darkness</span></a>, <a href=\"http://tinyurl.com/dwnwod\" target=\"_blank\"><span style=\"color:#FF0000\">Chronicles of Darkness</span></a></div> </div>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/421-dataweaver","name":"Dataweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar421_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"8420"}]},"thankedby":[]},{"date":"2016-11-01T15:54:40-07:00","id":996856,"title":"","content":"The term you're thinking of is <a href=\"https://en.wikipedia.org/wiki/Echo_chamber_(media)\" target=\"_blank\">echo chamber</a>. An enclosed system where different or competing views are censored, disallowed or otherwise underrepresented.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2016-11-01T17:06:23-07:00","id":996892,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>nofather</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996810#post996810\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">That's what a safe space is. It doesn't insulate from criticism. It works to keep the people within it safe from feeling uncomfortable, unsafe, or unwelcome.</div> </div> </div> </div>So you're saying that, outside of &quot;safe spaces&quot; people shouldn't expect to have their opinions treated with a modicum of respect? That has highly unfortunate implications, though it does tend to accentuate how hyper-partisan politics is becoming.<br /> <br /> It used to be that if you were talking (or posting) in the public square, you could expect that people would not come in get aggressive and &quot;thread crap&quot; to drive the posters of a particular thread off and then pat themselves on the back afterwards.<br /> <br /> Though admittedly with the loss of civility, especially on the internet, I suppose one should simply assume that Caitiff is correct and &quot;All ideas are under attack everywhere all of the time. Arm yourself or get off the field.&quot; - If you can't take the heat, get out of the kitchen (public square) because it's your fault you handle it. <br /> <br /> In which case, if you have a belief that runs counter to the majority, you had better shut up and stay silent or you'll be dog-piled and driven off. That's not a good thing for public discourse in the public square. All it does it create an echo chamber effect because people with minority opinions feel unwelcome and aren't willing tospeak up.","signature":"","edited":{"userid":741,"user_link":"https://forum.theonyxpath.com/member/741-anubisxy","user":"AnubisXy","date":". 11-01-2016, 08:18 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2016-11-01T18:00:31-07:00","id":996910,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996892#post996892\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So you're saying that, outside of &quot;safe spaces&quot; people shouldn't expect to have their opinions treated with a modicum of respect? That has highly unfortunate implications, though it does tend to accentuate how hyper-partisan politics is becoming.</div> </div> </div> </div>No. Perhaps the problem is that some people think being treated with respect means being unquestioned, while others just mean that they appreciate but may disagree and are free to do so. You were complaining that people were being dog-piled and shouted out of the thread. Much of the statements were treated with respect, again outside of Hitler and the persecution of Christians. At that point it was more about correcting errors.<br /> <br /> You'll note that, for instance, Mangle77's post about being Pro Life, Gun Control or Death Penalty and their other beliefs weren't questioned beyond 'could you elaborate.' And Fat Larry's disagreement about 'Black writers write Black superhero comics because only they can 'get' Black people' didn't lead to them getting shouted of the thread.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> It used to be that if you were talking (or posting) in the public square, you could expect that people would not come in get aggressive and &quot;thread crap&quot; to drive the posters of a particular thread off and then pat themselves on the back afterwards. </div> </div> </div>Compare the previous stated beliefs to Luis' insistence that 'the horrible things we have been told about Catholic Inquisition are lies, exaggerations, or involving attenuating circumstances.' Even in a public square, people would get aggressive about correcting this.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> Though admittedly with the loss of civility, especially on the internet, I suppose one should simply assume that Caitiff is correct and &quot;All ideas are under attack everywhere all of the time. Arm yourself or get off the field.&quot; - If you can't take the heat, get out of the kitchen (public square) because it's your fault you handle it.<br /> <br /> In which case, if you have a belief that runs counter to the majority, you had better shut up and stay silent or you'll be dog-piled and driven off. That's not a good thing for public discourse in the public square. All it does it create an echo chamber effect because people with minority opinions feel unwelcome and aren't willing tospeak up. </div> </div> </div>Except for the banned, no one's been driven off. And even they haven't exactly been harangued out of the thread. You are still posting and every conservative who has posted here can post again.<br /> <br /> Oh and like Darksider said if you do feel like someone's attacking your beliefs or disrespecting you, Flag that post.","signature":"","edited":{"userid":886,"user_link":"https://forum.theonyxpath.com/member/886-nofather","user":"nofather","date":". 11-01-2016, 09:05 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2016-11-01T18:21:12-07:00","id":996916,"title":"","content":"The problem with the internet isn't a loss of civility, because civility never existed to lose. The problem is that it barrages us with information on a constant basis, and in order to manage that we self-select for the information that confirms and reinforces the beliefs we already hold. These arguments were never less vitriolic, we've just been given greater ability to withdraw from the real necessity of having them and wall ourselves off in Balkanized communities of homogeneous interest.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2507-caitiff-primogen","name":"Caitiff Primogen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2507_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2014"},{"key":"Posts:","value":"1351"}]},"thankedby":[]},{"date":"2016-11-01T19:18:26-07:00","id":996943,"title":"","content":"Are we going back to discussing topics instead of arguing them? I got another question. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /> <br /> <br /> Earlier in his thread, someone said they did not equate being against gay marriage with homophobia. Can one of conservatives explain this position? <br /> <br /> ( I hope I am not coming off as too defensive. I'm looking for understanding a different point of view, not an argument.)","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2016-11-02T11:06:29-07:00","id":997249,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=996943#post996943\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Are we going back to discussing topics instead of arguing them? I got another question. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /><br /> <br /> Earlier in his thread, someone said they did not equate being against gay marriage with homophobia. Can one of conservatives explain this position?<br /> <br /> ( I hope I am not coming off as too defensive. I'm looking for understanding a different point of view, not an argument.)</div> </div> </div> </div><br /> The argument as it was presented to me by my family was that they have no hatred for gay people, and feel they can have sex with any consenting person they want, but that they believe marriage is a religious institution that is between a man and a woman, so it's no more discriminatory against cats to keep a man from marrying a cat (their example, not mine). Of course I didn't agree with it, because it assumes that marriage was somehow invented by Christianity (it's not, it predates the religion in that area, and there are far spread groups beyond that religion's net who have never known its influence and yet have rituals for pairing individuals themselves). And it ignores that there are other religions in this country perfectly willing to perform a marriage, and the only thing that changes is now the government needs to <i>recognize that those marriages are valid</i>. No church has been forced to perform a marriage for everyone, the government, which is intended to be secular, is duty bound to honor the arrangement no matter what their faith is.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T11:23:57-07:00","id":997261,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solana</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997249#post997249\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> The argument as it was presented to me by my family was that they have no hatred for gay people, and feel they can have sex with any consenting person they want, but that they believe marriage is a religious institution that is between a man and a woman, so it's no more discriminatory against cats to keep a man from marrying a cat (their example, not mine). Of course I didn't agree with it, because it assumes that marriage was somehow invented by Christianity (it's not, it predates the religion in that area, and there are far spread groups beyond that religion's net who have never known its influence and yet have rituals for pairing individuals themselves). And it ignores that there are other religions in this country perfectly willing to perform a marriage, and the only thing that changes is now the government needs to <i>recognize that those marriages are valid</i>. No church has been forced to perform a marriage for everyone, the government, which is intended to be secular, is duty bound to honor the arrangement no matter what their faith is.</div> </div> </div> </div>Indeed. A marriage between a man and a cat is stopped because a cat is not legally capable of granting consent. And consent is pretty important.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/851-paradim","name":"Paradim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar851_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"695"}]},"thankedby":[]},{"date":"2016-11-02T11:24:50-07:00","id":997263,"title":"","content":"For the people talking about Safe Spaces, I'd point out that the intended purpose of a safe space is for a group that has suffered trauma or has otherwise been marginalized. A place for women who have been raped by men is a safe space because it gives them a place to talk about their trauma where they are not confronted by reminders of their abuser. Shelters for abused women came to exist because there was no real place for those women to go - an ordinary homeless shelter was not typically equipped to address their kinds of problems, the kind that come from assisting a traumatized mother and her children (as many of the women were often mothers). Safe spaces for minorities exist within these groups, too, like a meeting for transgender women of color to evoke the marginalized bit earlier. In most cases a transgender person of color is going to have a very different experience than a white transgender person will, they need a place where they can work through things on a support group level without having to deal with white transgender people 'speaking for them', in a sense.<br /> <br /> Most conservatives aren't going to face traumatic abuse for their conservative beliefs, if you're that mythical unicorn who grew up in an abusive liberal household that burned all of your bibles because the bible is evil - then certainly maybe a safe space is for you, but I don't think anyone in this thread has been outright called a monster, except Luis, and he's gone for good now. People can claim that beliefs you hold are 'monstrous', but that's really not the same thing as saying a gay person is fundamentally evil, or that marriage only applies if it's from my religion and its views. People criticizing your beliefs as being wrong or regressive is not a personal attack on you, it's an attack on your argument. I could be wrong, but I haven't seen a lot of 'If you believe in a god, then you're scum' in this thread, if there was such talk, the moderators would act on it, they have in other threads.<br /> <br /> So conservatives are not victims, and you certainly couldn't say they are marginalized, because broad conservative policies are being enacted every day in America - yes, they are being challenged, but that's not the same thing as being marginalized, because to challenge something you have to in some way <i>acknowledge it.</i><br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3},{"type":"\ud83d\udc4e","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T11:41:24-07:00","id":997276,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Paradim</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997261#post997261\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Indeed. A marriage between a man and a cat is stopped because a cat is not legally capable of granting consent. And consent is pretty important.</div> </div> </div> </div><br /> Presumably if we ever uplift cats to a sapient status, they'd still be against a marriage? I don't claim to speak for them, I'm only saying what was said to me by my family, which is conservative.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T12:03:16-07:00","id":997296,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solana</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997249#post997249\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> The argument as it was presented to me by my family was that they have no hatred for gay people, and feel they can have sex with any consenting person they want, but that they believe marriage is a religious institution that is between a man and a woman, so it's no more discriminatory against cats to keep a man from marrying a cat (their example, not mine). Of course I didn't agree with it, because it assumes that marriage was somehow invented by Christianity (it's not, it predates the religion in that area, and there are far spread groups beyond that religion's net who have never known its influence and yet have rituals for pairing individuals themselves). And it ignores that there are other religions in this country perfectly willing to perform a marriage, and the only thing that changes is now the government needs to <i>recognize that those marriages are valid</i>. No church has been forced to perform a marriage for everyone, the government, which is intended to be secular, is duty bound to honor the arrangement no matter what their faith is.</div> </div> </div> </div>I usually counter this one with, &quot;Then why do I go to the county courthouse to get the certificate instead of a church? Why can a judge make it a legally binding marriage without a priest? Why does it give use rights together on taxes, property, children, assets, etc in (what should be) a secular government?&quot; They're all rhetorical, of course, and I do not expect an answer, let alone one that could properly address them, but it's still slightly amusing to watch the wheels in their head spin.","signature":"<hr class=\"b-divider\"/><br/><i>- If you must be ridiculous, I must ridicule you.<br /> - Those that can give up essential liberties in exchange for temporary safety deserve neither liberty nor safety. -- Benjamin Franklin</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/375-papa-bear","name":"Papa Bear","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar375_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1920"}]},"thankedby":[]},{"date":"2016-11-02T12:04:42-07:00","id":997297,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solana</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997276#post997276\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> Presumably if we ever uplift cats to a sapient status, they'd still be against a marriage? I don't claim to speak for them, I'm only saying what was said to me by my family, which is conservative.</div> </div> </div> </div>.... That's a pretty big hypothetical with little chance of actually being relevant any time soon. Saying that... To engage on the hypothetical, I don't know. If uplifted cats are legally recognized as people that can give consent, and there are people (humans and uplifted cats alike) who want to be married, I don't see a very good reason as to why they can't be. That doesn't mean a good reason can't exist, but I don't know enough of the scenario being proposed to really say without more information. <br /> <br /> A single religion thinking its wrong isn't a good reason. Multiple religions thinking its wrong isn't a good reason. We have history of that being challenged with inter-racial marriage, and also with the arguments given against same sex marriage before the Supreme Court (such as addressing the argument that a marriage is for the purpose of having children, and then not being able to give an answer to the Justices why infertile people are still allowed to marry). <br /> <br /> I would probably ask your family to consider how they would feel if they were expected to hold to standards based on a religion they're not a member of. I'm not sure if specific examples that might be useful, but as a person who isn't Christian, I can easily say its rather restricting and pretty much oppressive.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/851-paradim","name":"Paradim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar851_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"695"}]},"thankedby":[]},{"date":"2016-11-02T12:10:28-07:00","id":997299,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Papa Bear</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997296#post997296\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I usually counter this one with, &amp;quot;Then why do I go to the county courthouse to get the certificate instead of a church? Why can a judge make it a legally binding marriage without a priest? Why does it give use rights together on taxes, property, children, assets, etc in (what should be) a secular government?&amp;quot; They're all rhetorical, of course, and I do not expect an answer, let alone one that could properly address them, but it's still slightly amusing to watch the wheels in their head spin.</div> </div> </div> </div>Yeah, it's important to make clear that marriage is a secular institution, in that there are a wide variety of benefits and responsibilities associated with the marriage license which is granted by the State. <br /> <br /> I fully agree that marriage can also be a religious institution, but when you get married at a church by a pastor, you still get a marriage license from a State authorized clerk or judge.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/851-paradim","name":"Paradim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar851_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"695"}]},"thankedby":[]},{"date":"2016-11-02T12:13:03-07:00","id":997300,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Paradim</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997297#post997297\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> .... That's a pretty big hypothetical with little chance of actually being relevant any time soon. Saying that... To engage on the hypothetical, I don't know. If uplifted cats are legally recognized as people that can give consent, and there are people (humans and uplifted cats alike) who want to be married, I don't see a very good reason as to why they can't be. That doesn't mean a good reason can't exist, but I don't know enough of the scenario being proposed to really say without more information.<br /> <br /> A single religion thinking its wrong isn't a good reason. Multiple religions thinking its wrong isn't a good reason. We have history of that being challenged with inter-racial marriage, and also with the arguments given against same sex marriage before the Supreme Court (such as addressing the argument that a marriage is for the purpose of having children, and then not being able to give an answer to the Justices why infertile people are still allowed to marry).<br /> <br /> I would probably ask your family to consider how they would feel if they were expected to hold to standards based on a religion they're not a member of. I'm not sure if specific examples that might be useful, but as a person who isn't Christian, I can easily say its rather restricting and pretty much oppressive.</div> </div> </div> </div>I think you may be preaching to the choir here? I mean, I'm transgender, which is why I come into conflict with them all the time. I was only trying to answer wonderandawe's question from the position that actual conservatives feel this way (I'm not saying all do, I'm not conservative and can't speak for everyone).<br /> <br /> If bother individuals are sapient and consenting I don't see a problem with anyone marrying whoever they want, really.<br /> <br /> That said, if that outrageous hypothetical ever 'does' come up, I know for a fact that a good deal of conservatives today would be opposed to it, if not in complete agreement on it. I don't think that's an outrageous claim to make. Cats being incapable of consent isn't going to be the issue with them, it'll be the fact that they are two different species.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T12:21:49-07:00","id":997303,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solana</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997300#post997300\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I think you may be preaching to the choir here? I mean, I'm transgender, which is why I come into conflict with them all the time. I was only trying to answer wonderandawe's question from the position that actual conservatives feel this way (I'm not saying all do, I'm not conservative and can't speak for everyone).<br /> <br /> If bother individuals are sapient and consenting I don't see a problem with anyone marrying whoever they want, really.<br /> <br /> That said, if that outrageous hypothetical ever 'does' come up, I know for a fact that a good deal of conservatives today would be opposed to it, if not in complete agreement on it. I don't think that's an outrageous claim to make. Cats being incapable of consent isn't going to be the issue with them, it'll be the fact that they are two different species.</div> </div> </div> </div>I hope I'm not coming across as aggressive or condescensing. x.x<br /> <br /> I would agree with you that conservatives probably would be against a human marrying an uplifted cat. My point to that specifically is that I would expect much the same from the process of inter-racial marriage being legalized and same sex marriage being legalized. That is, there would be a big hub bub, States would not recognize the legality of those marriages, they'd work up to the Supreme Court and the arguments would be determined to have merit or not. <br /> <br /> I presume there would probably be conservative uplifted cats who would be opposed to it as well.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/851-paradim","name":"Paradim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar851_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"695"}]},"thankedby":[]},{"date":"2016-11-02T13:24:59-07:00","id":997340,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solana</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997263#post997263\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So conservatives are not victims, and you certainly couldn't say they are marginalized, because broad conservative policies are being enacted every day in America - yes, they are being challenged, but that's not the same thing as being marginalized, because to challenge something you have to in some way <i>acknowledge it.</i></div> </div> </div> </div>I don't believe a single conservative (at least in this thread) has asked for a &quot;safe space.&quot;<br /> <br /> In fact, the only people who seem to have brought up space spaces in this thread are liberals who have done so primarily as a way to mock conservatives when conservative posters say, &quot;Hey, can people perhaps be a bit more respectful of our opinions and a bit less overtly hostile?&quot;<br /> <br /> &quot;Oh, so you guys want a 'safe space' then? Har har har, ain't that ironic? Well too bad! No safe space for you!&quot;<br /> <br /> I just think it would be nice if people stopped using &quot;space spaces&quot; as a truncheon to knock conservative posters with because by intentionally twisting the idea of a &quot;safe space&quot; as a way to attack conservative posters, it's just hurting the basic idea of the safe space in and of itself, which is not a good thing.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2016-11-02T13:31:06-07:00","id":997342,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Paradim</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997299#post997299\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Yeah, it's important to make clear that marriage is a secular institution, in that there are a wide variety of benefits and responsibilities associated with the marriage license which is granted by the State.<br /> <br /> I fully agree that marriage can also be a religious institution, but when you get married at a church by a pastor, you still get a marriage license from a State authorized clerk or judge.</div> </div> </div> </div>Ultimately the term &quot;marriage&quot; has a lot of religious ideas, concepts and elements intertwined throughout it due to the result of thousands of years of historical reasons. I believe the government should simply get out of &quot;marriage&quot; and instead perform civil unions - civil unions are a completely secular institution with no religious baggage at all and there would be less worries or fears or outcries from religious elements if the government was explicitly not in the business of recognizing a &quot;religious&quot; institution.<br /> <br /> If you want a religious marriage you go to a church (or wherever). But the government would only grant civil unions and only look at civil unions when it issues certificates or for tax or other purposes.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2016-11-02T13:34:57-07:00","id":997345,"title":"","content":"When I was a practicing Christian, I believed that legal customs concerning marriage were at best, human interpretations of a divine institution. That is to say that man can say whatever we like about marriage, but we can't change it from God's design. Mainstream culture could deviate from it and forgot about the real thing over time, but a true, sacred marriage would always be possible. So making gay marriage legal would be as threatening to marriage as making assault against God legal would cause danger to Him. It <i>would</i> mean that the state was endorsing sin (fornication, albeit the same as what was before), but since when <i>haven't</i> temporal authorities endorsed sin (particularly greed and bloodshed) and is it really the place of the state to prohibit sin in cases where the only victims are the perpetrators themselves? It may lead to an increased acceptance of such behaviour, but so far as I was concerned, Christians needed to stop adopting non-Christian standards morality just because that's what others were doing. After all, getting marginalised isn't and never has been evidence that one is wrong.<br /> <br /> To Wonderandawe, speaking as an ex-conservative on that particular matter, I very much believed in &quot;hate the sin, love the sinner&quot;. That still seems logical to me now, although I have different ideas about morality these days and so I don't object to the practices either. If merely objecting to what I considered fornication in that case is homophobic, then I was homophobic, although the idea that was it wrong would have seemed as well founded to me at the time as I presume you find calling homosexuality wrong based on interpretations of the scripture of one religion.<br /> <br /> I don't how much more I can explain that. Those were just the musings of one teenager. As a gay bastard, I had a personal interest in the topic. I can't speak for all doctrine based objection to gay marriage and I certainly can't speak for its secular critics.","signature":"","edited":{"userid":3523,"user_link":"https://forum.theonyxpath.com/member/3523-spencer-from-the-hills","user":"Spencer from The Hills","date":". 11-02-2016, 04:39 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/3523-spencer-from-the-hills","name":"Spencer from The Hills","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2014"},{"key":"Posts:","value":"546"}]},"thankedby":[]},{"date":"2016-11-02T14:00:01-07:00","id":997353,"title":"","content":"I grew up in a liberal Catholic and homosexuality was something that was never talked about. I think my first exposure to homosexuality was the movie, <a href=\"https://en.wikipedia.org/wiki/And_the_Band_Played_On_(film)\" target=\"_blank\">And the Band Played On</a>. I was too young to understand exactly what was going on in the bathhouses, but I understood that these two men loved each other. My first conversation I had with my father about homosexuality was when I was away at college. My father, who is a big Star Trek fan, expressed dismay that <a href=\"https://en.wikipedia.org/wiki/George_Takei\" target=\"_blank\">George Takei</a> came out of the closet. <br /> <br /> Yet, as liberal Catholics, my parents came at the question of gay marriage from the opposite direction. While they believe &quot;practicing&quot; homosexuality was wrong, they also strongly believed in the Separation of Church and State. &quot;Render therefore unto Caesar the things which are Caesar's; and unto God the things that are God's&quot;. It wasn't the government's place to disallow these people from getting married.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2016-11-02T14:08:04-07:00","id":997358,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997342#post997342\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Ultimately the term &quot;marriage&quot; has a lot of religious ideas, concepts and elements intertwined throughout it due to the result of thousands of years of historical reasons. I believe the government should simply get out of &quot;marriage&quot; and instead perform civil unions - civil unions are a completely secular institution with no religious baggage at all and there would be less worries or fears or outcries from religious elements if the government was explicitly not in the business of recognizing a &quot;religious&quot; institution.<br /> <br /> If you want a religious marriage you go to a church (or wherever). But the government would only grant civil unions and only look at civil unions when it issues certificates or for tax or other purposes.</div> </div> </div> </div>So... What happens when a religion is fine to marry a same sex couple and people of another religion don't think they should receive a civil union like they got? Because that validates the marriage of the first church still. <br /> <br /> What actually changes with the position you suggest? <br /> <br /> (Edit: It's an idea I've actually had before, but largely ended up abandoning. I'm curious as to your thoughts on it, though.) <br /> <br /> Also, you might want to look a little more into the history of marriage, because it's a lot less tied into religion through history than you might initially think and more about the transferring of property and political power than people think at first. Interesting stuff, honestly. Marriage has a lot of religious context now, but I can't think of a time where marriage didn't have a strong basis in secular law and politics.","signature":"","edited":{"userid":851,"user_link":"https://forum.theonyxpath.com/member/851-paradim","user":"Paradim","date":". 11-02-2016, 05:12 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/851-paradim","name":"Paradim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar851_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"695"}]},"thankedby":[]},{"date":"2016-11-02T14:15:23-07:00","id":997361,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Paradim</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997358#post997358\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So... What happens when a religion is fine to marry a same sex couple and people of another religion don't think they should receive a civil union like they got? Because that validates the marriage of the first church still.</div> </div> </div> </div>Because civil unions are not something religious. They're an entirely and solely secular contract. It would be like a religious group getting upset at someone taking a government backed student loan to attend college.<br /> <br /> You can have a civil union and then have a religious marriage. Or you could have a civil union and no religious marriage. You could even have a marriage and no civil union (but then you wouldn't be recognized as a couple by the law).<br /> <br /> A fair amount of opposition towards gay marriage comes from religious groups who believe that the government is redefining what marriage means, which I can't necessarily disagree. The government is determining what &quot;marriage&quot; means and who is allowed to get married. I think the path of least resistance would be to simply remove the government from marriage altogether and offer entirely secular contracts (civil unions between two consenting adults) to everybody.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2016-11-02T14:21:59-07:00","id":997368,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997340#post997340\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I don't believe a single conservative (at least in this thread) has asked for a &quot;safe space.&quot;</div> </div> </div> </div>Fortunately, this medium allows us to go back and verify whether any self-identified conservatives have brought up safe spaces or not. Looks like the first mention of safe spaces was by Frishman, as part of an at the time relatively civil discussion about political correctness. <a href=\"http://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=981429#post981429\">Link</a><br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997340#post997340\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">In fact, the only people who seem to have brought up space spaces in this thread are liberals who have done so primarily as a way to mock conservatives when conservative posters say, &quot;Hey, can people perhaps be a bit more respectful of our opinions and a bit less overtly hostile?&quot;</div> </div> </div> </div>That's another one we can verify. Let's see, looks like the first ironic use of the term &quot;Safe Space in the thread... Oh, what do you know, was also by Frishman, lamenting that people were challenging the views of the conservatives in the thread, and was also the second use of the phrase in the thread in general. <a href=\"http://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=981749#post981749\">Link</a><br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997340#post997340\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">&quot;Oh, so you guys want a 'safe space' then? Har har har, ain't that ironic? Well too bad! No safe space for you!&quot;</div> </div> </div> </div>Hmm... Can't seem to find any self-identified liberals saying anything like that. It does seem that Solana respectfully pointed out the contradiction in Frishman both using safe spaces as an example of why he opposes &quot;PC culture&quot; and as an ironic way to express that the thread was leading to more critique of conservative ideas than he has hoped. <a href=\"http://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=981757#post981757\">Link.</a> But oh. Wait. <a href=\"http://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=988506#post988506\">Here's</a> a post actually saying there are no safe spaces for conservatives. It was made by Primal Flame, the one who started the thread, and was also the very next mention of Safe Spaces after Solana and Frishman's discussion petered out almost a dozen pages earlier.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997340#post997340\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I just think it would be nice if people stopped using &quot;space spaces&quot; as a truncheon to knock conservative posters with because by intentionally twisting the idea of a &quot;safe space&quot; as a way to attack conservative posters, it's just hurting the basic idea of the safe space in and of itself, which is not a good thing.</div> </div> </div> </div>It's funny, because the record doesn't show that happening at all. It consistently shows conservative posters being the ones to broach the subject saying &quot;har har, isn't it ironic that safe spaces only seem to matter to liberals when it suits them&quot; and liberals responding with a confused &quot;you keep using that word. I don't think it means what you think it means.&quot;","signature":"<hr class=\"b-divider\"/><br/>Going by Willow now, or Wil for short. She/Her/Hers.","edited":{"userid":269,"user_link":"https://forum.theonyxpath.com/member/269-charlaquin","user":"Charlaquin","date":". 11-02-2016, 05:35 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/269-charlaquin","name":"Charlaquin","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar269_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10831"}]},"thankedby":[]},{"date":"2016-11-02T14:37:36-07:00","id":997378,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Charlaquin</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997368#post997368\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hmm... Can't seem to find any self-identified liberals saying anything like that. It does seem that Solana respectfully pointed out the contradiction in Frishman both using safe spaces as an example of why he opposes &quot;PC culture&quot; and as an ironic way to express that the thread was leading to more critique of conservative ideas than he has hoped.</div> </div> </div> </div>I could have stood to have been more respectful in that post, and actually received a warning from it, which I own.<br /> <br /> But it does bring to mind the issue that the conservatives in this thread don't have a unified position on what a respectful tone seems to be, so it's really hard to criticize a position without someone taking it as disrespectful toward people who have that position.","signature":"","edited":{"userid":11726,"user_link":"https://forum.theonyxpath.com/member/11726-solana","user":"Solana","date":".  Does* bring to mind, not doesn't* trying to post while watching a debate and work is a bad idea : \\ 11-02-2016, 05:49 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T14:43:27-07:00","id":997380,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solana</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997378#post997378\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">But it doesn't bring to mind the issue that the conservatives in this thread don't have a unified position on what a respectful tone seems to be, so it's really hard to criticize a position without someone taking it as disrespectful toward people who have that position.</div> </div> </div> </div>I don't think humanity in general has unified position on what a respectful tone is. <br />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2016-11-02T14:58:26-07:00","id":997390,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997340#post997340\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">In fact, the only people who seem to have brought up space spaces in this thread are liberals who have done so primarily as a way to mock conservatives when conservative posters say, &quot;Hey, can people perhaps be a bit more respectful of our opinions and a bit less overtly hostile?&quot;<br /> <br /> &quot;Oh, so you guys want a 'safe space' then? Har har har, ain't that ironic? Well too bad! No safe space for you!&quot;<br /> <br /> I just think it would be nice if people stopped using &quot;space spaces&quot; as a truncheon to knock conservative posters with because by intentionally twisting the idea of a &quot;safe space&quot; as a way to attack conservative posters, it's just hurting the basic idea of the safe space in and of itself, which is not a good thing.</div> </div> </div> </div>Oh I think you're talking about me. I wasn't being mocking, at least not intentionally. Apparently I come off as having an attitude sometimes, but I'm just trying to be clear. I guess I am sarcastic sometimes too, though.<br /> <br /> I think it would be what was wanted, I think it would come with its own problems, though, I was going to mention this in my first post but decided it was a bit long-winded, but back <a href=\"http://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=982173#post982173\">here</a>, Heavy Arms explains some of the problems with some safe spaces on this board, which has rules against attacks against groups of people. Though I wouldn't say that a conservative safe space would definitely infringe on that.","signature":"","edited":{"userid":886,"user_link":"https://forum.theonyxpath.com/member/886-nofather","user":"nofather","date":". 11-02-2016, 06:13 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2016-11-02T15:03:41-07:00","id":997393,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997361#post997361\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Because civil unions are not something religious. They're an entirely and solely secular contract. It would be like a religious group getting upset at someone taking a government backed student loan to attend college.<br /> <br /> You can have a civil union and then have a religious marriage. Or you could have a civil union and no religious marriage. You could even have a marriage and no civil union (but then you wouldn't be recognized as a couple by the law).<br /> <br /> A fair amount of opposition towards gay marriage comes from religious groups who believe that the government is redefining what marriage means, which I can't necessarily disagree. The government is determining what &amp;quot;marriage&amp;quot; means and who is allowed to get married. I think the path of least resistance would be to simply remove the government from marriage altogether and offer entirely secular contracts (civil unions between two consenting adults) to everybody.</div> </div> </div> </div>I largely thought that... But I don't think it would work very well in practice. And I think that's because there exists a real perception that Civil Unions are not equal to Marriages. I think you would get push back from both parties on it, because conservatives would argue that forcing them to get Civil Unions would demean their Marriages, while the other side would argue that refusing to call what should be recognized the same under the law a Marriage when Civil Unions are not considered in the same respect, is a false equivalency that treats them as second class citizens. <br /> <br /> And I'm not sure that argument doesn't have legs. Which is largely why I've dropped from my views that there is no difference between a Civil Union and a Marriage. I don't think history supports there being a difference and it worries me when a term gets so viciously argued on both sides. <br /> <br /> It can be argued that, so long the government treats them both the same, it shouldn't matter right? But the fact there's such an argument on the term strongly suggests that they are not viewed the same by society. And that can truly matter.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/851-paradim","name":"Paradim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar851_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"695"}]},"thankedby":[]},{"date":"2016-11-02T15:58:56-07:00","id":997414,"title":"","content":"I'm having a hard time finding my voice, so I apologize if I don't establish my point coherently, I am doing my best.<br /> <br /> You don't necessarily need to be religious to celebrate them, but marriages and their associated ceremonies are highly ritualized. I think it represents one of those messy areas where things start to overlap, and I have friends who argue that the government shouldn't get involved at all. That there shouldn't be tax stipulations, laws regarding income, etc. I don't necessarily agree with all of that, I'm not the best informed. I think those stipulations exist for a reason. Likewise I think of marriage is something that is important, even as an atheist/agnostic/what have you. My issue with the government not supporting gay marriage isn't just because it disadvantaged me. It was because that interpretation of marriage favored one religion, and it wasn't mine. Before I considered myself an atheist, I identified as pagan, a very eclectic pagan, but I belonged to a group, attended meetings, etc. I don't believe it is necessary for the government to strip away marriage in favor of civil unions, I'm not sure that would benefit society in the long run. Especially now, families and couples often need help to make things work - that's not to say single people don't suffer obstacles, 'cause we do, but I'd advocate for helping them in other ways, rather than stripping the provisions for marriages we have now. <br /> <br /> Gay marriage is a step forward, I think, because it means the government is not reinforcing one religion's concept of marriage, and I'm not the sort of atheist that wants everyone to just stop being religious tomorrow. I'd rather everyone get along and try to treat each other with respect.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T16:08:50-07:00","id":997419,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Paradim</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997393#post997393\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I largely thought that... But I don't think it would work very well in practice. And I think that's because there exists a real perception that Civil Unions are not equal to Marriages. I think you would get push back from both parties on it, because conservatives would argue that forcing them to get Civil Unions would demean their Marriages, while the other side would argue that refusing to call what should be recognized the same under the law a Marriage when Civil Unions are not considered in the same respect, is a false equivalency that treats them as second class citizens.<br /> <br /> And I'm not sure that argument doesn't have legs. Which is largely why I've dropped from my views that there is no difference between a Civil Union and a Marriage. I don't think history supports there being a difference and it worries me when a term gets so viciously argued on both sides.<br /> <br /> It can be argued that, so long the government treats them both the same, it shouldn't matter right? But the fact there's such an argument on the term strongly suggests that they are not viewed the same by society. And that can truly matter.</div> </div> </div> </div><br /> It's not just a perception, there are or have been actual legal differences between them in some states.<br /> <br /> Washington state for example has 'domestic partnerships' that are different from marriages. A series of legaslative changes brought them closer and closer together until same-sex marriage was fully made the same thing as other marriages in 2012. Domestic Partnerships still exist in the state as a not-quite married state for legal/tax reasons that requires at least one of the partners to be over 62 years of age (it has to do with retirement stuff). So Washington's civil union is absolutley not the same thing as a marriage to this day. Religious or not. That is why saying they are 'just as good' is not true.","signature":"<hr class=\"b-divider\"/><br/>(he/him/his)<br /> <br /> <a href=\"http://www.kickstarter.com/projects/200664283/demon-the-descent-prestige-edition\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://img513.imageshack.us/img513/4478/8vno.png\" border=\"0\" alt=\"\" /></a><br /> Backer #2010","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1329-elvesofzion","name":"ElvesofZion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1329_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1086"}]},"thankedby":[]},{"date":"2016-11-02T17:00:32-07:00","id":997442,"title":"","content":"Here's the thing, this isn't my thread. Or honestly any of ours. This thread wasn't made for me the same way the LGBT thread wasn't made for me. Or the same reason many of you don't post in the Anime thread or the mental health threadl its either not of your interest or you don't feel as though its your place to be. Its why I've not posted here and why this will be my last post ITT. By taking the thread and asking bizarre existential questions and creating your own echo chamber involving your ideas of conservatives you've actually ran all of them out of their thread. This is almost literally the definition of shitposting or thread-crapping as its known here as the last 3 pages have been a meta-discussion involving what conservatives think without actually having anyone here to voice their opinion that is an actual conservative. In addition, for every few posts a conservative has made there have been numerous posts from people questioning it. Now I can understand genuine curiosity or questions but when people ask that many questions it will make you feel as though you are being swamped and either make you not want to post or dig your heels in and cut off all real discourse.","signature":"<hr class=\"b-divider\"/><br/>pls respont","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/372-cerealkiller","name":"cerealkiller","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar372_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"340"}]},"thankedby":[]},{"date":"2016-11-02T17:29:04-07:00","id":997450,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>cerealkiller</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997442#post997442\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Here's the thing, this isn't my thread. Or honestly any of ours. This thread wasn't made for me the same way the LGBT thread wasn't made for me. Or the same reason many of you don't post in the Anime thread or the mental health threadl its either not of your interest or you don't feel as though its your place to be.</div> </div> </div> </div>I don't post in the anime thread because I have nothing constructive to say about anime, it is not an issue that effects me. Conservative view points are not comparable because they specifically relate to policy and society - things that as a human person I am involved in and which directly affect my existence, <b>especially</b> because I am transgender. If people in the mental health thread wanted to start a discussion on how they believe holistic remedies are preferable to tested pharmaceutical medicines, then I'd have words to say toward them too, because that would be a position that has a meaningful impact on my life and the lives of people who are swayed into believing it. Someone's sexual preference is none of my business, and has no effect on my life whatsoever, what shows a person finds meaningful likewise. They are not the same thing and you do yourself a disservice in pretending that they are. <br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> By taking the thread and asking bizarre existential questions </div> </div> </div>I legitimately don't know what you're talking about here. You're talking as though none of the questions in this thread have had any meaningful relevance to the current operations of society, and instead are just hypothetical naval gazing, which isn't true at all?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> and creating your own echo chamber involving your ideas of conservatives you've actually ran all of them out of their thread. </div> </div> </div>If the echo chamber came into being because they decided they don't want to defend their arguments or positions against public criticism, then that is an echo chamber they have created, not us. Only one person that I am aware of was banned in this thread, and it was for a mix of his behavior here and in other threads. If you are a conservative and you want to defend your position, you can do so without having yourself censored. No one is going to suspend you unless - again - you do what Luis did, and actively wax racist/homophobic. <br /> <br /> An actual example of an echo chamber would be if we made a Liberal thread, and then every time a conservative got involved with the thread and spouted dissenting opinion, we had the moderators ban them from the boards to prevent them having a voice. By criticizing the liberal criticisms in this thread you are advocating for echo chambers on their behalf whilst also implying they are wrong. <br /> <br /> Again, if people want to defend conservative positions here, they're welcome to do so, therefor it's not an echo chamber, they've chosen to not defend themselves if indeed they have all gone.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> This is almost literally the definition of shitposting or thread-crapping as its known here as the last 3 pages have been a meta-discussion involving what conservatives think without actually having anyone here to voice their opinion that is an actual conservative. </div> </div> </div>It's not actually, though, is it? Because the actual definition of a shitpost is post with no actual content that exists to get someone's attention in some way. In other words, you are accusing people in this thread of spouting nonsense that contains no content of value to discussion or these boards, and that's demonstrably untrue. Someone asked how conservatives can be against gay marriage whilst also not consider themselves homophobic, my family is conservative, I related what they told me when I asked them. That's something conservatives think within the last few pages. <br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> In addition, for every few posts a conservative has made there have been numerous posts from people questioning it. Now I can understand genuine curiosity or questions but when people ask that many questions it will make you feel as though you are being swamped and either make you not want to post or dig your heels in and cut off all real discourse. </div> </div> </div>Many conservative positions have real world consequences for people, many of the people on these boards have suffered those consequences. I'm not going to begrudge someone challenging a position in light of this, not even if they did so with me. <br /> <br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T17:43:59-07:00","id":997460,"title":"","content":"No you created this Echo chamber for the entire Forums by pretty much letting conservatives know they are not welcome.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/9486-jbrocky","name":"JBRocky","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9486_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"89"}]},"thankedby":[]},{"date":"2016-11-02T17:50:46-07:00","id":997465,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AzraelFirestorm</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=980005#post980005\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'm for Gary Johnson, because I only vote for politicians that I've physically touched. He was gentle, but firm.</div> </div> </div> </div><i>Oh l\u00e0 l\u00e0,</i> that's very suggestive.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12561-shawarbaaz","name":"Shawarbaaz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12561_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"467"}]},"thankedby":[]},{"date":"2016-11-02T17:54:09-07:00","id":997467,"title":"","content":"To be honest I used to be very conservative, but ever since I discovered that I was gay, I went down south.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12561-shawarbaaz","name":"Shawarbaaz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12561_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"467"}]},"thankedby":[]},{"date":"2016-11-02T18:28:21-07:00","id":997485,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JBRocky</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997460#post997460\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">No you created this Echo chamber for the entire Forums by pretty much letting conservatives know they are not welcome.</div> </div> </div> </div>I'm still finding it difficult to feel sympathy for a group of people because people on a message board with zero direct interaction questioned their positions. You know, speaking as someone who has to deal with being yelled at on the street, called a freak, and threatened with violence over things that are entirely none of their business.<br /> <br /> Again, if you disagree with a liberal position you are welcome to explain your position and why it's a better position to have, the liberal person is then allowed to either offer a rebuttal or accept it. This thread has an awful lot of: &quot;I'm entitled to my opinion, and that's the same thing as being right.&quot; sentiment, and it's a sentiment I've picked up from the people I've grown up with, too. The conservatives in my life have never been okay with someone questioning their position. They cling to them without facing censure because they're entitled to their views, and that means they never need to test them. <br /> <br /> I'd hardly call it an echo chamber when we are coming - to you - specifically to test our positions against yours, just because many conservatives have decided to go silent rather than put up is not a mark of lazy thinking on the part of the liberals. <br /> <br /> Because after all, that is what claiming echo chamber asserts. You're arguing that one group is only interested in hearing their view points echoed back at them because it's easier than actual critical thinking, but so far the liberals are coming into this thread in order to object and propose their own ideas, while the conservatives run off looking for boards where they won't be subject to criticism. <br /> <br /> So who is actually being intellectually lazy, here?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T19:34:47-07:00","id":997508,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JBRocky</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997460#post997460\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">No you created this Echo chamber for the entire Forums by pretty much letting conservatives know they are not welcome.</div> </div> </div> </div>If you post an opinion/political stance and view having it challenged in the form of debate the same as being run out of town, then who's really asking for an echo chamber?<br /> <br /> Note that the LGBT thread has been absolutely full of folks who aren't queer themselves asking questions and having them answered. There's room for a healthy debate here, just the same as there is in a hypothetical thread about liberal politics, but relentless personal attacks (or in our dear friend Luis' case, implying the fucking Inquisition wasn't really all that bad) are hardly the same thing, just the same as disrespecting the core idea of safe spaces and calling homosexuals sinners isn't exactly a healthy side of the conversation.","signature":"<hr class=\"b-divider\"/><br/>Remi. she/her. game designer.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/281-atamajakki","name":"atamajakki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar281_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5487"}]},"thankedby":[]},{"date":"2016-11-02T19:38:07-07:00","id":997510,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solana</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997485#post997485\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'm still finding it difficult to feel sympathy for a group of people because people on a message board with zero direct interaction questioned their positions. You know, speaking as someone who has to deal with being yelled at on the street, called a freak, and threatened with violence over things that are entirely none of their business.</div> </div> </div> </div>So somebody said mean things to you in real life, and that's why you're not going to have sympathy for a completely different group of people in a different venue. Okay.<br /> <br /> I think the biggest issue is that most of the positions getting staked out against conservatives in this thread tend to be more extreme ones, and many of the conservatives here don't particularly feel like defending those remarks. It would be like if, for example, I went into the LGBT thread and started trying to make people there defend the arguments made by NAMBLA and then called them intellectually lazy when they didn't respond.<br /> <br /> Many conservatives are fairly moderate and don't actually like a lot of the radical wackiness that comes from the conservative fringe. And I think a lot of conservatives who were in this thread just didn't particularly enjoy being treated as if they were part of the far right fringe elements, or feeling as though they were expected to try and defend those fringe elements of the conservative crowd.<br /> <br /> Ultimately I suspect that if the line of positions being staked out in this thread had focused more on say, economic issues or education issues or such there would be more conservatives interested in sticking around. But quite a few posters (including myself, I admit) painted with a broad brush and it's no surprise if conservative forum-goers didn't particularly feel like trying to defend the radical far right positions that had effectively been foisted off on them.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2016-11-02T20:11:24-07:00","id":997523,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997510#post997510\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Many conservatives are fairly moderate and don't actually like a lot of the radical wackiness that comes from the conservative fringe. And I think a lot of conservatives who were in this thread just didn't particularly enjoy being treated as if they were part of the far right fringe elements, or feeling as though they were expected to try and defend those fringe elements of the conservative crowd.</div> </div> </div> </div>Unfortunately it's that whole public group appearance dynamic effect. <br /> <br /> You don't hear much about the middle-of-the-road people of any group, large or small, because they're not making a lot of noise, nor are they getting a lot of press. Instead the attention goes to the ones making big statements, stupid statements, getting things in the news.<br /> <br /> It's not just an issue with conservatives, but with ANY group. Any time you have a group that anyone can be a part of just by saying they are, you've got a group that is going to get exactly that kind of fringer problem.<br />","signature":"<hr class=\"b-divider\"/><br/>Odd_Canuck is not a topical medication or food product and is not to be taken internally or seriously.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/31-odd_canuck","name":"Odd_Canuck","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar31_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1474"}]},"thankedby":[]},{"date":"2016-11-02T20:31:25-07:00","id":997530,"title":"","content":"Something that I think a lot of people, on all sides of a given issue political or otherwise, could stand to remind themselves of is that criticism =/= persecution. <br /> <br /> Cue debate over whether liberals or conservatives do this more, ignoring that neither need to be doing it at all.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2507-caitiff-primogen","name":"Caitiff Primogen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2507_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2014"},{"key":"Posts:","value":"1351"}]},"thankedby":[]},{"date":"2016-11-02T20:40:45-07:00","id":997534,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Caitiff Primogen</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997530#post997530\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Something that I think a lot of people, on all sides of a given issue political or otherwise, could stand to remind themselves of is that criticism =/= persecution.<br /> <br /> Cue debate over whether liberals or conservatives do this more, ignoring that neither need to be doing it at all.</div> </div> </div> </div>This would be more helpful if a decent chunk of people practicing outright hate speech didn't think they were offering helpful criticism people or &quot;just telling it how it is.&quot;","signature":"<hr class=\"b-divider\"/><br/>Remi. she/her. game designer.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/281-atamajakki","name":"atamajakki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar281_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5487"}]},"thankedby":[]},{"date":"2016-11-02T21:00:06-07:00","id":997541,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>atamajakki</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997534#post997534\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> This would be more helpful if a decent chunk of people practicing outright hate speech didn't think they were offering helpful criticism people or &quot;just telling it how it is.&quot;</div> </div> </div> </div>This is a fair corollary. There is a line between criticism and mere invective, a line that different people draw different places. We lack an objective measure of determining where that line <i>should</i> be, so we determine it subjectively based on an aggregate consensus among the value sets of those willing to enforce that consensus on the conversation.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/2507-caitiff-primogen","name":"Caitiff Primogen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2507_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2014"},{"key":"Posts:","value":"1351"}]},"thankedby":[]},{"date":"2016-11-02T21:42:43-07:00","id":997544,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997510#post997510\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So somebody said mean things to you in real life, and that's why you're not going to have sympathy for a completely different group of people in a different venue. Okay.</div> </div> </div> </div>It certainly helps when you take what I said, say something completely different, and then act like I said that instead, right?<br /> <br /> Except I didn't say that, I said that people acting like they're being pushed out, like they're being discriminated against in a way that has an important impact on their life, because someone said they're wrong on the internet, pales in comparison to people who are actively being harassed in real life, and having their well-being threatened because of it. I have no reason to believe they were a 'completely different group' the arguments they made were the same arguments conservatives have made on here and elsewhere. I don't have sympathy for people whining about being called wrong on the internet, period. Some of us have actual problems to deal with and it cheapens those problems when people on the internet act like they're in any way similar. <br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> I think the biggest issue is that most of the positions getting staked out against conservatives in this thread tend to be more extreme ones, and many of the conservatives here don't particularly feel like defending those remarks. It would be like if, for example, I went into the LGBT thread and started trying to make people there defend the arguments made by NAMBLA and then called them intellectually lazy when they didn't respond. </div> </div> </div>Except people in this thread could just as soon say they don't believe in those specific things you're referring to. More often we got people poking their head in to say &quot;Well, I sympathize with such and such, but since I just know it's going to be attacked I don't want to discuss it.&quot;<br /> <br /> As Charlaquin pointed out, the medium allows for going back, and the history of the thread shows that you're full of it. People like Frishman, Brother Wolf, etc, could defend those positions that they'd 'rather not talk about', but they don't. and loaded comparisons to NAMBLA doesn't work as a defense in light of those things.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> Many conservatives are fairly moderate and don't actually like a lot of the radical wackiness that comes from the conservative fringe. And I think a lot of conservatives who were in this thread just didn't particularly enjoy being treated as if they were part of the far right fringe elements, or feeling as though they were expected to try and defend those fringe elements of the conservative crowd. </div> </div> </div>A lot of the conservatives in this thread showed themselves to 'be' part of those fringe elements, and one of them got banned for it.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997510#post997510\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Ultimately I suspect that if the line of positions being staked out in this thread had focused more on say, economic issues or education issues or such there would be more conservatives interested in sticking around. But quite a few posters (including myself, I admit) painted with a broad brush and it's no surprise if conservative forum-goers didn't particularly feel like trying to defend the radical far right positions that had effectively been foisted off on them.</div> </div> </div> </div>Except again, many of them owned those positions and then said they didn't want to talk about them - let's all go find another board where we can show those colors in peace. You're doing that thing where you assume everyone is 'you', when the history of this thread does not support that. And if I seem hostile? Then it's probably because I don't appreciate being called a lazy shit poster, that's the sort of claim that demands a response.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T21:48:13-07:00","id":997546,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Caitiff Primogen</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997541#post997541\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">This is a fair corollary. There is a line between criticism and mere invective, a line that different people draw different places. We lack an objective measure of determining where that line <i>should</i> be, so we determine it subjectively based on an aggregate consensus among the value sets of those willing to enforce that consensus on the conversation.</div> </div> </div> </div>You deserve more likes, and I worry you don't get them because you are in many ways the least polarized individual in this thread.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T21:52:01-07:00","id":997547,"title":"","content":"I was the one who said shitposting so if you are going to attack anyone attack me.","signature":"<hr class=\"b-divider\"/><br/>pls respont","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/372-cerealkiller","name":"cerealkiller","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar372_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"340"}]},"thankedby":[]},{"date":"2016-11-02T22:31:38-07:00","id":997559,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solana</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997544#post997544\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Except I didn't say that, I said that people acting like they're being pushed out, like they're being discriminated against in a way that has an important impact on their life, because someone said they're wrong on the internet, pales in comparison to people who are actively being harassed in real life, and having their well-being threatened because of it. I have no reason to believe they were a 'completely different group' the arguments they made were the same arguments conservatives have made on here and elsewhere. I don't have sympathy for people whining about being called wrong on the internet, period. Some of us have actual problems to deal with and it cheapens those problems when people on the internet act like they're in any way similar.</div> </div> </div> </div>Again, you're suggesting that everyone who is conservative and disagrees with you is probably out literally harassing and threatening people's well-being in real life - that they're all &quot;part of the same group&quot; as it were. Now, I hate to break it to you, but while that's a great way to self-righteously pigeonhole people who disagree with you, it's also not terribly accurate.<br /> <br /> I mean, I know plenty of conservatives in real life who don't go around harassing or threatening people's lives. In fact, I don't know <i>any</i> conservatives who have ever done anything like that - while I'm sure it does happen, you probably shouldn't hold those kind of people up as representative of conservatives as a whole and talk about conservatives as if they're all part of the &quot;same group&quot; and all engage in those sorts of activities.<br /> <br /> It's rhetoric like that, painting all conservative posters as nothing more than real-life harassers and crybabies and whiners on the internet that makes conservatives feel unwelcome here. I mean, if your goal is to make it clear that conservative opinions, voices and posters are not welcome on the forum, then good job, keep it up, you're being quite successful at it.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2016-11-02T23:13:20-07:00","id":997568,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>cerealkiller</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997547#post997547\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I was the one who said shitposting so if you are going to attack anyone attack me.</div> </div> </div> </div>I did respond to you, and then another individual came on claiming echo chamber, and I responded to them - which Anubis was responding to and criticizing.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-02T23:18:06-07:00","id":997570,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997559#post997559\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Again, you're suggesting that everyone who is conservative and disagrees with you is probably out literally harassing and threatening people's well-being in real life - that they're all &quot;part of the same group&quot; as it were. Now, I hate to break it to you, but while that's a great way to self-righteously pigeonhole people who disagree with you, it's also not terribly accurate.</div> </div> </div> </div>You're trying really hard to put words in my mouth here. The only thing I said is that some people actually face harassment, claiming you are being harassed on a message board because someone disagreed with you is being silly. As someone who faces actual harassment, I have no sympathy for them. Never did I say: &quot;All conservatives are evil, I bet they go harassing trans people ALL THE TIME.&quot; <br /> <br /> Never did I say &quot;If you disagree with me on any point, you are transphobic and fuck you.&quot;<br /> <br /> What I did say, after you criticized me for lumping unrelated groups together, is that it is not unreasonable to assume the people who harassed me were conservative. Why? Because they were presenting conservative arguments to back up their position. It was a tangent, but it was a tangent that <b>you</b> created, Anubis. <br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> I mean, I know plenty of conservatives in real life who don't go around harassing or threatening people's lives. In fact, I don't know <i>any</i> conservatives who have ever done anything like that - while I'm sure it does happen, you probably shouldn't hold those kind of people up as representative of conservatives as a whole and talk about conservatives as if they're all part of the &quot;same group&quot; and all engage in those sorts of activities. </div> </div> </div>Again, taking what I said out of context and arguing against that instead of my actual point. Isn't there a word for that?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> It's rhetoric like that, painting all conservative posters as nothing more than real-life harassers and crybabies and whiners on the internet that makes conservatives feel unwelcome here. I mean, if your goal is to make it clear that conservative opinions, voices and posters are not welcome on the forum, then good job, keep it up, you're being quite successful at it. </div> </div> </div>It's too bad they have to do mental gymnastics to make me say the things you're claiming I said.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-03T06:05:05-07:00","id":997649,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997559#post997559\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I mean, I know plenty of conservatives in real life who don't go around harassing or threatening people's lives. In fact, I don't know <i>any</i> conservatives who have ever done anything like that - while I'm sure it does happen, you probably shouldn't hold those kind of people up as representative of conservatives as a whole and talk about conservatives as if they're all part of the &quot;same group&quot; and all engage in those sorts of activities.</div> </div> </div> </div>I live and work in an area in South Florida that can be considered very liberal. And there are a number of instances where liberals(they weren't wearing badges, but based on their comments, my coworkers experience with them, etc.) have harassed, threatened, and even beaten members of the LGBTQ community. Harassment, insults, and physical harm against LGBTQ people is not something conservatives have a monopoly on. An asshole is an asshole.<br /> <br /> I know that no one is saying this. Just thought I'd chime in. Anubis is doing a great job of expressing my feelings on a number of things.<br /> <br /> <br /> <br /> And...that's it. Going to bow out again. Enjoy your thread.","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#333333\"><span style=\"font-family:&amp;quot\"><span style=\"font-size:16px\">&quot;Steel isn't strong, boy. Flesh is stronger.&quot;</span></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/95-fat-larry","name":"Fat Larry","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar95_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1337"}]},"thankedby":[]},{"date":"2016-11-03T07:36:58-07:00","id":997681,"title":"","content":"So, I haven't said much here. But I am a registered Libertarian. What that generally means to me is that I am socially liberal and govern-mentally conservative. I think that personal freedoms are the most important function of government and that almost nothing else (certain protections of nature being an exception since there are things that cannot defend themselves that deserve defending that aren't people) should be done by the government. Is that conservative enough to count?<br /> <br /> I will gladly discuss any political or government topics that I take a 'conservative' stance on with anyone here, Liberal or Conservative.","signature":"<hr class=\"b-divider\"/><br/>(he/him/his)<br /> <br /> <a href=\"http://www.kickstarter.com/projects/200664283/demon-the-descent-prestige-edition\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://img513.imageshack.us/img513/4478/8vno.png\" border=\"0\" alt=\"\" /></a><br /> Backer #2010","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1329-elvesofzion","name":"ElvesofZion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1329_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1086"}]},"thankedby":[]},{"date":"2016-11-03T08:22:06-07:00","id":997714,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ElvesofZion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997681#post997681\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So, I haven't said much here. But I am a registered Libertarian. What that generally means to me is that I am socially liberal and govern-mentally conservative. I think that personal freedoms are the most important function of government and that almost nothing else (certain protections of nature being an exception since there are things that cannot defend themselves that deserve defending that aren't people) should be done by the government. Is that conservative enough to count?<br /> <br /> I will gladly discuss any political or government topics that I take a 'conservative' stance on with anyone here, Liberal or Conservative.</div> </div> </div> </div>I'm curious as to what positions you take that you see as being &quot;conservative&quot;? However you like to define the term and apply it. <br /> <br /> Also, what do you think of the Republican party (and/or Libertarian party or hell, Green party and Democrat party) as to how they fit against your views of what you think should be conservative policies?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/851-paradim","name":"Paradim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar851_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"695"}]},"thankedby":[]},{"date":"2016-11-03T08:42:02-07:00","id":997723,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Paradim</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997714#post997714\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I'm curious as to what positions you take that you see as being &quot;conservative&quot;? However you like to define the term and apply it.<br /> <br /> Also, what do you think of the Republican party (and/or Libertarian party or hell, Green party and Democrat party) as to how they fit against your views of what you think should be conservative policies?</div> </div> </div> </div><br /> I'd say the big tent pole conservative policies that I tend to back are:<br /> <br /> <b>1</b>. Small government with heavily restricted spending. Especially at the federal level. The US Constitution was written the way it was for a reason.<br /> <b>2.</b> I support the Bill of Rights. All 10 Amendments, including the 2nd amendment (generally seen as a conservative ideal).<br /> <b>3.</b> I support the legalization of drugs; which, although often seen as a liberal ideal, is actually in line with conservatism's smaller government, less regulations stance.<br /> <b>4. </b>Ideally, the concept of government marriage licenses would be completely removed and any two adults could enter into a legal contract with each other to share assets, act as legal proxy etc. This includes having more than one such arrangement with different combinations of people as long as the contracts do not conflict with each other (only one legal or medical proxy, assets must be divided in event of death etc.) Of course until that is possible all legal documents that the government currently has should be completely gender, sex, and orientation neutral as that really isn't any of their damn business. <br /> <br /> I'd have to have specifics to think of others right now, and my first point may have covered huge swaths of it.<br /> <br /> As for the parties:<br /> <br /> <b>Republican</b>: Never been a fan, I am too young to have dealt with the Party of Lincoln GOP. So they have always been much to focused on social conservatism for me. I am not religious (was raised in a mixed Protestant/Jewish household) and don't care for the majority of the figure heads in the party as they tend to lean towards ideals i don't agree with.<br /> <br /> <b>Democrat:</b> I considered myself a democrat when I was a teenager (leaning towards Green) but have come to see the general stance of the party as too anti-freedom and socialist for me now. I do usually prefer the Democrat candidates over GOP though.<br /> <br /> <b>Green:</b> As I said, I was kind of a Green Party supporter when I was younger, but that was based on pure environmentalism without any real understanding of policy or economic theory; I just liked going into the woods. The current front leading candidate is not someone I respect very much and the party has done a pretty terrible job of presenting themselves as a reasonable and competent alternative.<br /> <br /> <b>Libertarian:</b> I am registered as a Libertarian currently because the party platform tends to align the best with my ideals (of the options in the US at least). There is also an honesty there that I find refreshing. I will admit that Johnson is a bit of a goof and suffers greatly from foot in mouth syndrome. I have liked a few things Weld has said recently but haven't looked into him enough to say that I would back him independently.<br /> <br /> I think that's enough of a baseline. I am happy to talk any specific point that anyone wants to bring up.","signature":"<hr class=\"b-divider\"/><br/>(he/him/his)<br /> <br /> <a href=\"http://www.kickstarter.com/projects/200664283/demon-the-descent-prestige-edition\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://img513.imageshack.us/img513/4478/8vno.png\" border=\"0\" alt=\"\" /></a><br /> Backer #2010","edited":{"userid":1329,"user_link":"https://forum.theonyxpath.com/member/1329-elvesofzion","user":"ElvesofZion","date":".  Added another 'conservative' ideal I missed. 11-03-2016, 12:14 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1329-elvesofzion","name":"ElvesofZion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1329_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1086"}]},"thankedby":[]},{"date":"2016-11-03T10:25:34-07:00","id":997761,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solana</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997570#post997570\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> You're trying really hard to put words in my mouth here. The only thing I said is that some people actually face harassment, claiming you are being harassed on a message board because someone disagreed with you is being silly. As someone who faces actual harassment, I have no sympathy for them. Never did I say: &quot;All conservatives are evil, I bet they go harassing trans people ALL THE TIME.&quot;</div> </div> </div> </div>Again, you basically said, &quot;I was harassed by conservatives in real life. I'm not going to sympathize with conservatives here who feel their opinions are unwelcome on the forum.&quot; And when I pointed out that there are many degrees of conservatives and those extremists who harassed you in real life probably shouldn't be lumped in with the people you were speaking with online you said, &quot;I'm also not going to consider the conservatives who harassed me in real life to be part of a different group from the conservatives who are talking with me over the internet.&quot; <br /> <br /> Again, it seems like you are intentionally lumping the conservative posters in with the people who, in real life, actually threatened your life. Further, by your own words, it seems like you aren't going to be sympathetic to online conservative posters because some asshole in real life threatened you. <br /> <br /> If that's not how you <i>intended</i> for your words to come across, that's cool. But that's certainly <i>I</i> interpreted them (and judging by some of the PM's I have received I'm not the only one). Again, that's the sort of rhetoric which creates a fairly hostile and unwelcoming atmosphere for conservatives when you insist on lumping them all in with the extremists who decided to try and threaten your life and then say you refuse to feel sympathetic for them. <br /> <br /> You can accuse me of making mental gymnastics, but this is simply the way that I interpreted the words you wrote down. If that's not how you intended for them to be interpreted by people on the other side of the screen, then in the future I suggest you be a bit more careful with how you write so your message doesn't come across in a way that is different from what you intended.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2016-11-03T11:26:25-07:00","id":997785,"title":"","content":"@ElvesofZion<ul><li>What are your thoughts on government regulation, particularly in light of the past (Big Tobacco, Big Lead, etc) as well as events in the present, like Animal Agriculture, the food industry with sugar, the recent issues with pharmaceutical companies, economic crises created by banks, and outright predatory organizations like payday loans?</li> <li>How do you feel about Social Security?</li> <li>What are your thoughts on the increasingly automated workforce, and experts who claim a minimum standard of living will need to be implemented at some point?</li> <li>Do you believe that private companies should be free to regulate themselves? Is there a point where you feel the government needs to step in and protect the consumer?</li> <li>If it turns out that you don't believe in regulation, how do you reconcile the promise that capitalism will produce a superior product, when evidence exists to the contrary? (Fast food is of inferior nutritional value, devices are built to break down quickly because you'll need to go out and buy another one, safety and craftsmanship are sidelined when you can make a bigger profit with cheap labor, which leads to exporting jobs (bad for the local economy)).Advertisements do not create informed consumers, they often shore up an inferior product.</li> </ul>Thank you in advance.<br />","signature":"","edited":{"userid":11726,"user_link":"https://forum.theonyxpath.com/member/11726-solana","user":"Solana","date":". 11-03-2016, 03:21 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-03T11:26:51-07:00","id":997786,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997761#post997761\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">If that's not how you <i>intended</i> for your words to come across, that's cool.</div> </div> </div> </div>Except it clearly isn't because you aren't accepting <a href=\"https://forum.theonyxpath.com/member/11726-solana\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar11726_2.png');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"11726\" data-vbnamecard=\"11726\">Solana</a> attempt's to clarify and continue to double down on reading those posts in as negative, bad faith and lacking in rhetorical charity as possible. If you're concerned about the hostility of this thread, you're not helping because it distracting from constructive discussion and debate to pick a single passage and slam another poster over it repeatedly instead of actually showing any interest in seeing a more clear intent.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> But that's certainly <i>I</i> interpreted them (and judging by some of the PM's I have received I'm not the only one). </div> </div> </div>This is bullshit.'<br /> <br /> 1) PMs are a breeding ground for echo chambers, not constructive feedback on how to read another user's posts.<br /> <br /> 2) It's a cowardly rhetorical position to appeal to a mysterious group of people we can't see, we don't know, and we can't question to bolster you position. If you need to rely on this mysterious group of people to prove why your position is reasonable, you don't have a reasonable position.<br /> <br /> 3) The only way I feel is justified in interpreting this tactic is that you're trying to say that you think all conservatives <b>should</b> bare the sins of their extremists. You're clearly trying to admit that &quot;moderate&quot; conservatives are a lie, because behind the scenes away from public scrutiny, everyone's actually talking about how Alex Jones, Stormfront, and the WBC aren't extreme enough.<br /> <br /> And if that's not how you intended for your words to be interpreted by people on the other side of the screen, then in the future I suggest you be more careful as well.","signature":"","edited":{"userid":617,"user_link":"https://forum.theonyxpath.com/member/617-heavy-arms","user":"Heavy Arms","date":".  typo fest galore... 11-03-2016, 02:28 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":7}],"user":{"link":"https://forum.theonyxpath.com/member/617-heavy-arms","name":"Heavy Arms","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar617_2.jpeg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"12634"}]},"thankedby":[]},{"date":"2016-11-03T11:27:56-07:00","id":997787,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997761#post997761\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Again, you basically said, &quot;I was harassed by conservatives in real life. I'm not going to sympathize with conservatives here who feel their opinions are unwelcome on the forum.&quot; And when I pointed out that there are many degrees of conservatives and those extremists who harassed you in real life probably shouldn't be lumped in with the people you were speaking with online you said, &quot;I'm also not going to consider the conservatives who harassed me in real life to be part of a different group from the conservatives who are talking with me over the internet.&quot;<br /> <br /> Again, it seems like you are intentionally lumping the conservative posters in with the people who, in real life, actually threatened your life. Further, by your own words, it seems like you aren't going to be sympathetic to online conservative posters because some asshole in real life threatened you.<br /> <br /> If that's not how you <i>intended</i> for your words to come across, that's cool. But that's certainly <i>I</i> interpreted them (and judging by some of the PM's I have received I'm not the only one). Again, that's the sort of rhetoric which creates a fairly hostile and unwelcoming atmosphere for conservatives when you insist on lumping them all in with the extremists who decided to try and threaten your life and then say you refuse to feel sympathetic for them.<br /> <br /> You can accuse me of making mental gymnastics, but this is simply the way that I interpreted the words you wrote down. If that's not how you intended for them to be interpreted by people on the other side of the screen, then in the future I suggest you be a bit more careful with how you write so your message doesn't come across in a way that is different from what you intended.</div> </div> </div> </div><br /> Then you need to work on your reading comprehension, what I said was quite clear, and I'm done playing he said she said with you.<br /> <br /> Scurry off and enjoy your PM &quot;echo chamber&quot;.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-03T11:46:02-07:00","id":997799,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ElvesofZion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997723#post997723\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><b>2.</b> I support the Bill of Rights. All 10 Amendments, including the 2nd amendment (generally seen as a conservative ideal).</div> </div> </div> </div>Hoooold on a sec. You only support the first 10 amendments to the United States Constitution - <br /> <br /> 13th: Abolishes slavery<br /> 14th: Defines citizenship, gave non-whites a guaranteed right to vote<br /> 15th: Protected votes from restrictions on race, color, or previous condition of servitude<br /> 19th: Extends the franchise to women<br /> 23rd: Gives the citizens of DC a say in Presidential elections where they previously had none<br /> 24th: Prohibits poll taxes<br /> 26th: Extends the franchise to citizens 18 years of age, who previously could fight in wars but could not vote<br /> <br /> But you don't support those?","signature":"<hr class=\"b-divider\"/><br/>We don't allow mages to cast spells, since this is the most unbalancing rule of all.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/5226-jachra","name":"Jachra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5226_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2015"},{"key":"Posts:","value":"265"}]},"thankedby":[]},{"date":"2016-11-03T11:49:38-07:00","id":997801,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/5226-jachra\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar5226_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"5226\" data-vbnamecard=\"5226\">Jachra</a>: Uncool.<br /> <br /> The Bill of Rights is given special rhetorical position of the amendments. Avowing support of them in particular is not a statement of opposition to the rest of them. Slavery, to take the first example, is antithetical to Libertarianism and is safe to assume any self-identifying Libertarian has issue with any form of system surrendering of rights.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/617-heavy-arms","name":"Heavy Arms","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar617_2.jpeg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"12634"}]},"thankedby":[]},{"date":"2016-11-03T11:57:26-07:00","id":997807,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Heavy Arms</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997786#post997786\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">This is bullshit.'<br /> <br /> 1) PMs are a breeding ground for echo chambers, not constructive feedback on how to read another user's posts.<br /> <br /> 2) It's a cowardly rhetorical position to appeal to a mysterious group of people we can't see, we don't know, and we can't question to bolster you position. If you need to rely on this mysterious group of people to prove why your position is reasonable, you don't have a reasonable position.</div> </div> </div> </div>You can call it bullshit, but my point is that I'm not the only person who interpreted Solana's remarks in the way that I did. You are, of course, free to say that nobody else in the world thought Solana's rhetoric was unwelcoming or aggressive, and that I'm spouting lies and bullshit.<br /> <br /> Regardless it's pretty clear that most of the conservatives who were posting earlier have decided to vacate thread because of various unwelcoming and aggressive rhetoric. No big deal though, right? I mean, all those conservative posters were just &quot;intellectually lazy&quot; since they chose to get out of the kitchen when they couldn't handle the heat, so it's not a big loss.<br /> <br /> Honestly this thread is beyond salvaging at this point. I think threads are more interesting when you have a certain amount of back and forth between different people, but that's pretty clearly not going to happen anymore in this thread as it seems there aren't many conservatives left to post in it. Oh well, guess I'm out too. There's not much to be gained from sticking around beyond being told that my posts are &quot;bullshit&quot; and &quot;cowardly&quot; and that's enough heat to drive me out of the kitchen too.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2016-11-03T12:06:55-07:00","id":997812,"title":"","content":"This thread has been beyond salvaging since like page 5.","signature":"<hr class=\"b-divider\"/><br/>Going by Willow now, or Wil for short. She/Her/Hers.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/269-charlaquin","name":"Charlaquin","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar269_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10831"}]},"thankedby":[]},{"date":"2016-11-03T12:08:26-07:00","id":997813,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>AnubisXy</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997807#post997807\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> You can call it bullshit, but my point is that I'm not the only person who interpreted Solana's remarks in the way that I did. You are, of course, free to say that nobody else in the world thought Solana's rhetoric was unwelcoming or aggressive, and that I'm spouting lies and bullshit.<br /> <br /> Regardless it's pretty clear that most of the conservatives who were posting earlier have decided to vacate thread because of various unwelcoming and aggressive rhetoric. No big deal though, right? I mean, all those conservative posters were just &quot;intellectually lazy&quot; since they chose to get out of the kitchen when they couldn't handle the heat, so it's not a big loss.<br /> <br /> Honestly this thread is beyond salvaging at this point. I think threads are more interesting when you have a certain amount of back and forth between different people, but that's pretty clearly not going to happen anymore in this thread as it seems there aren't many conservatives left to post in it. Oh well, guess I'm out too. There's not much to be gained from sticking around beyond being told that my posts are &quot;bullshit&quot; and &quot;cowardly&quot; and that's enough heat to drive me out of the kitchen too.</div> </div> </div> </div><br /> If they're going to deliberately misinterpret something I said for the sake of justifying their persecution complex, then yes, no big deal. <b>That was the original point I was making.</b> We finally made it around the mountain. This thread is not an echo chamber (in stark contrast to patting each other on the back and talking about how censored you are in PMs) because at any point, any one of you could share your view or criticize what was said. As much as I've derided you for willfully taking things out of context, at least you had the dignity to stand up for what you felt. <br /> <br /> And the very fact that you are able to do so at all is evidence that this isn't an echo chamber, again, in stark contrast to all them PMs you be receivin', which we can't even see.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11726-solana","name":"Solana","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11726_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2016-11-03T12:49:15-07:00","id":997835,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Jachra</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997799#post997799\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hoooold on a sec. You only support the first 10 amendments to the United States Constitution -<br /> <br /> 13th: Abolishes slavery<br /> 14th: Defines citizenship, gave non-whites a guaranteed right to vote<br /> 15th: Protected votes from restrictions on race, color, or previous condition of servitude<br /> 19th: Extends the franchise to women<br /> 23rd: Gives the citizens of DC a say in Presidential elections where they previously had none<br /> 24th: Prohibits poll taxes<br /> 26th: Extends the franchise to citizens 18 years of age, who previously could fight in wars but could not vote<br /> <br /> But you don't support those?</div> </div> </div> </div><br /> As <a href=\"https://forum.theonyxpath.com/member/617-heavy-arms\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar617_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"617\" data-vbnamecard=\"617\">Heavy Arms</a> said, the first ten have specific politcal meaning. Especially in the context of liberal vs conservative views. The others (and those) I am open to discuss as well, but the exact nature of their writing may have things worth critquing, etc. Also I couldn't say I support all the amendments becasue I don't agree with the 18th Amendment (Prohibition). So for the purposes of discussion I only mentioned the Bill of Rights.<br /> <br /> <a href=\"https://forum.theonyxpath.com/member/11726-solana\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar11726_2.png');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"11726\" data-vbnamecard=\"11726\">Solana</a> , you gave me a tall order to respond to so it might take a while, but i am working on it.<br /> <br /> <a href=\"https://forum.theonyxpath.com/member/269-charlaquin\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar269_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"269\" data-vbnamecard=\"269\">Charlaquin</a> I am trying to keep/return the thread on track. Generally ignoring the AnubisXy/Solana thing.","signature":"<hr class=\"b-divider\"/><br/>(he/him/his)<br /> <br /> <a href=\"http://www.kickstarter.com/projects/200664283/demon-the-descent-prestige-edition\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://img513.imageshack.us/img513/4478/8vno.png\" border=\"0\" alt=\"\" /></a><br /> Backer #2010","edited":{"userid":1329,"user_link":"https://forum.theonyxpath.com/member/1329-elvesofzion","user":"ElvesofZion","date":".  missed a word 11-03-2016, 04:08 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1329-elvesofzion","name":"ElvesofZion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1329_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1086"}]},"thankedby":[]},{"date":"2016-11-03T13:01:25-07:00","id":997842,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ElvesofZion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/979988-any-conservative-gamers-around-yes-we-do-exist?p=997835#post997835\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <