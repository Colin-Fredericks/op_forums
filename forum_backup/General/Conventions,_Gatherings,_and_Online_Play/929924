-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">You heal 1 bashing damage after time passes. Make a perception roll.</div></div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/><b>My Games</b><br /> Mage 2E: The Supernal Suburbia (<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/929924-ic-mage-the-awakening-2e-the-supernal-suburbia\" target=\"_blank\">IC</a> / <a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/920977-ooc-mage-the-awakening-2e-the-supernal-suburbia\" target=\"_blank\">OOC</a>) - Storyteller","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8136-rwknoll","name":"rwknoll","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar8136_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2015"},{"key":"Posts:","value":"785"}]},"thankedby":[]},{"date":"2016-09-16T07:13:31-07:00","id":970669,"title":"","content":"<div align=\"center\"><b>LYNX</b></div> <div align=\"center\"><b>Active Sight: None<br /> Active Spells: Heightened Senses (Life 2; Potency 1, 1 week duration: +1 to Perception rolls); Body Control (Life 2; Potency 2, 1 week duration);<br /> Willpower: 2/5. Mana: 7/10</b><br /> <b>Conditions/Tilts: Inspired</b></div> <br /> <br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElements