e:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-26T18:27:04-07:00","id":181492,"title":"","content":"Also, Vykos' Blood Ape is voiced by Christopher Lee in this game.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-26T20:53:10-07:00","id":181603,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/54288-ic-exalted-2-5-forging-a-nation?p=181583#post181583\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">After the incident with the beggar Yi hailed a rickshaw and asked to be taken to the residence of that Nikoloi councilor he had seen earlier.</div> </div> </div> </div>Do you know what you've just done?!?!? I wonder how many people will be run over with a rickshaw and possibly killed now...<br /> <br /> Mighty ST, won't you spare the poor citizens?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1480-citanhyuga","name":"CitanHyuga","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1480_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"191"}]},"thankedby":[]},{"date":"2014-06-26T20:56:41-07:00","id":181607,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CitanHyuga</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=181603#post181603\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Do you know what you've just done?!?!? I wonder how many people will be run over with a rickshaw and possibly killed now...<br /> <br /> Mighty ST, won't you spare the poor citizens?</div> </div> </div> </div>I was thinking more people would die of fatigue running behind and beside me. Or taking arrows from the assassins.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2014-06-26T21:44:23-07:00","id":181650,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CitanHyuga</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=181603#post181603\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Do you know what you've just done?!?!? I wonder how many people will be run over with a rickshaw and possibly killed now...<br /> <br /> Mighty ST, won't you spare the poor citizens?</div> </div> </div> </div>I am feeling magnanimous today; I shall grant your request.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=181607#post181607\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I was thinking more people would die of fatigue running behind and beside me. Or taking arrows from the assassins.</div> </div> </div> </div>Those are valid concerns. Though, what if the assassins have in with the local Rickshaw-men chapter 33?<br /> <br /> DON'T EXPLAIN THE JOKE:<br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">Hyuga is referencing an IRL game that he ran, in which my Sidereal martial artist, Ascendant Sword, ran over a demonic customs crew with a rickshaw (while disguised as Eddie from Rocky Horror), with then resulted in a chase scene in which like, two dozen demons died by being run over with a Rickshaw. It was awesome. </div></div> </div> </div><br /> <br /> Anyways, rickshaws are deadly weapons! Though the people of Novalesk have yet to learn their true destructive potential. Yet.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-26T22:46:39-07:00","id":181677,"title":"","content":"Noodle: what are socially acceptable methods of travel in Novalesk/the capital? I don't want this to undermine my wandering preacher/holy man image.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2014-06-27T11:49:29-07:00","id":182133,"title":"","content":"Hiring a rickshaw or carriage is a socially acceptable method of travel in the city, but only really the citizenry would be able to afford to use it regularly. When you were travelling around before no one would bat an eye because Larissa was with you. Now...<br /> <br /> Now, you might get some raised eyebrows. But most will likely assume that you're the guest of someone important, and they sent it to get you. It may make you seem aloof, though.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-27T11:58:32-07:00","id":182137,"title":"","content":"Drat.<br /> <br /> Still, I lack the athletics charms to run the whole way myself, and I get the feeling that a non insignificant portion of my day is being taken up by getting from point A to point B.<br /> <br /> Also, how effective is all that social magic I am throwing around? Nothing seems to be coming of it, and I am starting to get the feeling that the golden lightbulb in my soul might be flickering. <img src=\"https://forum.theonyxpath.com/core/images/smilies/tongue.png\" border=\"0\" alt=\"\" title=\"Stick Out Tongue\" smilieid=\"5\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2014-06-27T21:40:06-07:00","id":182583,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=182137#post182137\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Drat.<br /> <br /> Still, I lack the athletics charms to run the whole way myself, and I get the feeling that a non insignificant portion of my day is being taken up by getting from point A to point B.<br /> <br /> Also, how effective is all that social magic I am throwing around? Nothing seems to be coming of it, and I am starting to get the feeling that the golden lightbulb in my soul might be flickering. <img src=\"https://forum.theonyxpath.com/core/images/smilies/tongue.png\" border=\"0\" alt=\"\" title=\"Stick Out Tongue\" smilieid=\"5\" class=\"inlineimg\" /></div> </div> </div> </div>Your magic is working. You haven't been interacting with the lower classes directly, though, which is why you haven't been seeing the effects. Eventually they'll put enough pressure on the citizens, councilors and patriarchs/matriarchs because of it. But even with mind-bendy magic, affecting nation-wide shifts in attitude take time when it is spread via word of mouth.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-27T22:13:29-07:00","id":182620,"title":"","content":"You wrote a lot of words, but all I read is, &quot;You need to develop stronger mind control charms.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2014-06-27T22:17:49-07:00","id":182623,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=182620#post182620\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">You wrote a lot of words, but all I read is, &quot;You need to develop stronger mind control charms.&quot;</div> </div> </div> </div>That is one way of interpreting it, I guess.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-27T22:21:36-07:00","id":182624,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Noodle</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=182623#post182623\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> That is one way of interpreting it, I guess.</div> </div> </div> </div><br /> Sorry, the internet is a terrible way to convey tone. I meant it to be a joke. Your explanation was what I suspected, but it is reassuring to have it confirmed. Thank you for that.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2014-06-27T22:28:18-07:00","id":182628,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=182624#post182624\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> Sorry, the internet is a terrible way to convey tone. I meant it to be a joke. Your explanation was what I suspected, but it is reassuring to have it confirmed. Thank you for that.</div> </div> </div> </div>You make a true statement! I knew it was a joke, and was attempting to run with it, though that tone was not carried through. Misunderstandings abound! Ah, the internet. <br /> <br /> You're welcome. I try to do what I can to address the concerns and questions of my group, so it's no issue.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-27T23:13:48-07:00","id":182655,"title":"","content":"Exthalion- The board's showing you having posted in the IC about 15 minutes ago, but the post isn't showing up for me. Did you delete it? Or should I let the admins know the board's eating posts?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-27T23:37:50-07:00","id":182676,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Noodle</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=182655#post182655\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Exthalion- The board's showing you having posted in the IC about 15 minutes ago, but the post isn't showing up for me. Did you delete it? Or should I let the admins know the board's eating posts?</div> </div> </div> </div>Deleted it. It was meant for a different thread.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2014-06-28T07:50:28-07:00","id":182867,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=182676#post182676\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Deleted it. It was meant for a different thread.</div> </div> </div> </div>Alright. I didn't want to miss out on any of Yi's shenanigans. <br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-28T17:08:39-07:00","id":183354,"title":"","content":"Alright, I am unsure of how to proceed here. I definitely want to try and work things out so that I have four hours or more a day for studying, but I don't want to hold back the action of anyone else that wants to go and do other stuff. Then you have the question of what I do with the rest of the time that Jensven is not studying. Would he be able to try and indulge his armorsmithing habit? Just curious.","signature":"<hr class=\"b-divider\"/><br/>I play forum games! Come check out the (mis?)adventures of<br /> Jensven Vargsmed and his canine companion, Shadow in &quot;Forging a Nation&quot; (<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation\" target=\"_blank\">OOC</a>,<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/54288-ic-exalted-2-5-forging-a-nation\" target=\"_blank\"> IC</a>)<br /> ...or the <a href=\"https://www.dropbox.com/s/w82hi22ad33hanu/Necro.doc?dl=0\" target=\"_blank\">Prodigal of Ashen Remorse</a> in &quot;Emerald Labyrinth&quot; (<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/402616-ooc-exalted-2-5-emerald-labyrinth\" target=\"_blank\">OOC</a>, <a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/416995-ic-exalted-2-5-the-emerald-labyrinth\" target=\"_blank\">IC</a>)","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1146-belkra","name":"Belkra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1146_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"341"}]},"thankedby":[]},{"date":"2014-06-30T15:00:05-07:00","id":185083,"title":"","content":"Novalesk may be moving into fast forward time shortly. I mean, you guys need time for Eugene to recruit and train up new troops. <br /> <br /> In the meantime, armorsmithing is an option. Or you could travel out to the front, I suppose, though that would clutter things up with only one thread.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-06-30T18:06:38-07:00","id":185274,"title":"","content":"Don't split the party. :-P","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1416-nutiketaiel","name":"NutiketAiel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1416_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"303"}]},"thankedby":[]},{"date":"2014-06-30T18:08:26-07:00","id":185275,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>NutiketAiel</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=185274#post185274\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Don't split the party. :-P</div> </div> </div> </div>Says the man that wants to split the party.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-07-01T05:19:31-07:00","id":185450,"title":"","content":"Going to the front would be a terrible idea at this point. I will not split the party any more than it already is. So, yeah....I can see Jensven wanting to find some place he can put hammer on anvil and then spend free time between his studies and going someplace natural and secluded to stay in shape/practice being an effective combat duo with Shadow. Also, getting to know his way around Novalesk proper would be something he would do idly. Knowing your way around a burg is a good way to know how to defend it.","signature":"<hr class=\"b-divider\"/><br/>I play forum games! Come check out the (mis?)adventures of<br /> Jensven Vargsmed and his canine companion, Shadow in &quot;Forging a Nation&quot; (<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation\" target=\"_blank\">OOC</a>,<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/54288-ic-exalted-2-5-forging-a-nation\" target=\"_blank\"> IC</a>)<br /> ...or the <a href=\"https://www.dropbox.com/s/w82hi22ad33hanu/Necro.doc?dl=0\" target=\"_blank\">Prodigal of Ashen Remorse</a> in &quot;Emerald Labyrinth&quot; (<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/402616-ooc-exalted-2-5-emerald-labyrinth\" target=\"_blank\">OOC</a>, <a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/416995-ic-exalted-2-5-the-emerald-labyrinth\" target=\"_blank\">IC</a>)","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1146-belkra","name":"Belkra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1146_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"341"}]},"thankedby":[]},{"date":"2014-07-02T06:24:38-07:00","id":186241,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Noodle</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=185275#post185275\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Says the man that wants to split the party.</div> </div> </div> </div>I'm playing a Sidereal. That makes me a mysterious hypocrite. So :-P","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1416-nutiketaiel","name":"NutiketAiel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1416_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"303"}]},"thankedby":[]},{"date":"2014-07-02T08:21:17-07:00","id":186302,"title":"","content":"I'm going to assume that 'Klaive is a one dot artifact. It has the same stats as a mundane straight sword and an affect that takes some work to gain any benefit from. I have also modified my sheet with the increased Lore rating despite still needing to actually spend the time increasing it in game time.<br /> <br /> If it is permissible for me to do armor crafting during the fast forward sequence I would like to have myself expend six peripheral motes for every roll interval (one day I would guess) so I can activate Craft Essence Triumphant. This will give me 3 automatic successes for every roll. I can easily respire this while sleeping.","signature":"<hr class=\"b-divider\"/><br/>I play forum games! Come check out the (mis?)adventures of<br /> Jensven Vargsmed and his canine companion, Shadow in &quot;Forging a Nation&quot; (<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation\" target=\"_blank\">OOC</a>,<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/54288-ic-exalted-2-5-forging-a-nation\" target=\"_blank\"> IC</a>)<br /> ...or the <a href=\"https://www.dropbox.com/s/w82hi22ad33hanu/Necro.doc?dl=0\" target=\"_blank\">Prodigal of Ashen Remorse</a> in &quot;Emerald Labyrinth&quot; (<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/402616-ooc-exalted-2-5-emerald-labyrinth\" target=\"_blank\">OOC</a>, <a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/416995-ic-exalted-2-5-the-emerald-labyrinth\" target=\"_blank\">IC</a>)","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1146-belkra","name":"Belkra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1146_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"341"}]},"thankedby":[]},{"date":"2014-07-02T09:56:57-07:00","id":186358,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Belkra</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=186302#post186302\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'm going to assume that 'Klaive is a one dot artifact. It has the same stats as a mundane straight sword and an affect that takes some work to gain any benefit from. I have also modified my sheet with the increased Lore rating despite still needing to actually spend the time increasing it in game time.<br /> <br /> If it is permissible for me to do armor crafting during the fast forward sequence I would like to have myself expend six peripheral motes for every roll interval (one day I would guess) so I can activate Craft Essence Triumphant. This will give me 3 automatic successes for every roll. I can easily respire this while sleeping.</div> </div> </div> </div><br /> Why not just use a short daiklave which is a one dot artifact and is apparently the size of a mundane sword?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2014-07-02T21:34:11-07:00","id":186815,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Belkra</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=186302#post186302\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'm going to assume that 'Klaive is a one dot artifact. It has the same stats as a mundane straight sword and an affect that takes some work to gain any benefit from. I have also modified my sheet with the increased Lore rating despite still needing to actually spend the time increasing it in game time.<br /> <br /> If it is permissible for me to do armor crafting during the fast forward sequence I would like to have myself expend six peripheral motes for every roll interval (one day I would guess) so I can activate Craft Essence Triumphant. This will give me 3 automatic successes for every roll. I can easily respire this while sleeping.</div> </div> </div> </div>That is correct. Not that it particularly matters, since you got the backgrounds for free, but yes. One dot.<br /> <br /> Also, that is permissible.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=186358#post186358\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Why not just use a short daiklave which is a one dot artifact and is apparently the size of a mundane sword?</div> </div> </div> </div>Because the Dark constellation Ess'Tee, infinite be his wisdom, works in mysterious ways. Lo, did the highest of Titans descend and say forth: &quot;No guys, there's totally a reason for that. Trust me.&quot;<br /> <br /> His will is eternal: Ess'Tee be praised!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-07-03T05:55:05-07:00","id":186992,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Noodle</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=186815#post186815\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Because the Dark constellation Ess'Tee, infinite be his wisdom, works in mysterious ways. Lo, did the highest of Titans descend and say forth: &quot;No guys, there's totally a reason for that. Trust me.&quot;<br /> <br /> His will is eternal: Ess'Tee be praised!</div> </div> </div> </div>Yeah, this mainly. A short daiklave wasn't one of the options according to story. We can worry about kitting out like &quot;Big Damn Heroes&quot; later. Right now, take what you can get, I say.","signature":"<hr class=\"b-divider\"/><br/>I play forum games! Come check out the (mis?)adventures of<br /> Jensven Vargsmed and his canine companion, Shadow in &quot;Forging a Nation&quot; (<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation\" target=\"_blank\">OOC</a>,<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/54288-ic-exalted-2-5-forging-a-nation\" target=\"_blank\"> IC</a>)<br /> ...or the <a href=\"https://www.dropbox.com/s/w82hi22ad33hanu/Necro.doc?dl=0\" target=\"_blank\">Prodigal of Ashen Remorse</a> in &quot;Emerald Labyrinth&quot; (<a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/402616-ooc-exalted-2-5-emerald-labyrinth\" target=\"_blank\">OOC</a>, <a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/416995-ic-exalted-2-5-the-emerald-labyrinth\" target=\"_blank\">IC</a>)","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1146-belkra","name":"Belkra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1146_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"341"}]},"thankedby":[]},{"date":"2014-07-11T10:51:45-07:00","id":194783,"title":"","content":"Soooo... I am posting about an artifact in the game line soon, but I wanted to hash out some details here.<br /> <br /> I wanted to make a set of goggles that would be able to see essence and essence lines and act as a microscope to zoom in and out adding to 2-die to craft rolls for fine details (like all encompassing sorcerer's sight+ microscope). I also wanted it to be upgrade-able to include up to 4-9 additional features (like night vision, memory storage data, analytic observation, text translation, disguise capabilities,etc.) <i>I am thinking of it like high-tech glasses like ones we have with cameras, screens, etc.</i><br /> <br /> It would require a new craft-artifact set of rolls each time you wanted to add a component as if crafting a new artifact with that ability. If you failed to roll at any point, you would have to restart from scratch on the upgrade and fix the line before re-use of the essence line in the artifact, but it would not affect an ability already in the goggles (unless a bad botch happened or something). <br /> <br /> I wasn't sure what level artifact this would be exactly. I was thinking it would be a level 3, but I was not certain. For now, it has an essence 2 charm + 2 die for creating artifacts and has a feature allowing it to be upgraded. It has the draw back of having to repair the essence line in the goggles and restart from scratch if you fail any roll. I was thinking that it would require a 6m commitement +1m extra for each additional feature lvl added on (if an artifact 3 type-ability was added on, it would cost 3 more essence committed; excluding the first ability above).<br /> <br /> Let me know what you think and what the details should be. I am open to any comments/suggestions/changes that need to be made to make this work. Thanks!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1480-citanhyuga","name":"CitanHyuga","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1480_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"191"}]},"thankedby":[]},{"date":"2014-07-11T13:42:33-07:00","id":194959,"title":"","content":"This is a good artifact concept but the &quot; like all encompassing sorcerer sight &quot; bit seems a waste, I mean you're a twilight why not just buy the charm and put more other useful capabilities in it. I am not sure about the upgrade part, can artifact be upgraded ?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2087-magnusar","name":"Magnusar","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2087_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"458"}]},"thankedby":[]},{"date":"2014-07-11T14:04:07-07:00","id":194967,"title":"","content":"I was just thinking that it was a persisstent AESS and then I would not have to buy the pre-resiquite charms to use it in scene-long chunks. I am not sure what capabilities that Hyuga would really need right now besides that. I wanted to leave it open though. I was thinking maybe I could make it like an x-ray/analyzer to see what materials artifacts are made from, but that is kinda like the essence 5 charm Holistic Miracle understanding, but it only gives you the ingredients and not the methods I suppose. It could help me see through walls and traps though too, so maybe I should go with that for now. That would probably be a lvl 4 artifact though and I can't make those yet. <br /> <br /> I am not sure if an artifact is upgradeable though... that is why I had the idea of having up to 5-10 different &quot;channels&quot; in it like a network of manses. I was thinking of it as upgrading parts i na computer. But of course it is up to the ST whether it can be done. I figured with all the crafting I want to do, having a plethora of artifacts on me would be annoying (and costly for me if I want to try and store them in elsewhere). I wanted it to be like an omni-tool. <br /> <br /> Some &quot;upgrades&quot; I was thinking of were, a disguising ability (clark kent/superman?!? no way! those glasses!), night vision (so as not to have to use my anima), a movement tracker/predicter (for fighting bonuses), an internet-connetion type database (for tomes, music, geographic data, etc.), a text translator, facial recognition/reading software (for bonuses on exposing lies/disguises among other things), illusion piercing vision (so i don't lose all my willpower), and even 360-degree vision (to stop unexpected attacks). I have a few other ideas, but I haven't worked out many details. <br /> <br /> <br /> <br /> On a completely separate thought, I should make a special ring for storing essence so that more mortals can wield/attune to artifacts. Hmmm....","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1480-citanhyuga","name":"CitanHyuga","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1480_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"191"}]},"thankedby":[]},{"date":"2014-07-11T14:39:45-07:00","id":194992,"title":"","content":"That is a lot of abilities for one artifact instead you could have some sort of plug-in chip the size of a fingernail to put in your glasses each have different abilities and it would allow would you to have a massive amount of different powers to put in your glasses but it would mean crafting each powers individually. Personally I think your idea is cool but it seems a bit powerful for an artifact 3 that you can just add powers in it whenever you feel like it.<br /> <br /> The ring is a good idea but i think there is something like that in one of the book somewhere you should check it out i think it's in oadenol's codex","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2087-magnusar","name":"Magnusar","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2087_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"458"}]},"thankedby":[]},{"date":"2014-07-11T14:39:49-07:00","id":194993,"title":"","content":"I also thought about the artifact looking into the past of an area or the past of an artifact (to try and see some of the methods used on it), but then I realized that was actually already a spell in the black and white treatises and would be artifact 4 at least. :/<br /> <br /> I think the chip idea is good too though. Those can be the &quot;lines&quot; that I was talking about. I think that fits better. They would be chips still and would be bound just to the goggles too so it can't be used by anything else.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1480-citanhyuga","name":"CitanHyuga","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1480_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"191"}]},"thankedby":[]},{"date":"2014-07-11T14:56:10-07:00","id":195017,"title":"","content":"On a another subject, is Hyuga planning to build his own sword of creation ? Or is he just really into manse ?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2087-magnusar","name":"Magnusar","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2087_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"458"}]},"thankedby":[]},{"date":"2014-07-11T15:04:32-07:00","id":195024,"title":"","content":"He wants to fix the realm defense grid and alter it a bit. He also wants to create a sword BEYOND creation. (Like artifact N/A^2)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1480-citanhyuga","name":"CitanHyuga","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1480_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"191"}]},"thankedby":[]},{"date":"2014-07-11T15:30:23-07:00","id":195040,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CitanHyuga</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=194783#post194783\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Soooo... I am posting about an artifact in the game line soon, but I wanted to hash out some details here.<br /> <br /> I wanted to make a set of goggles that would be able to see essence and essence lines and act as a microscope to zoom in and out adding to 2-die to craft rolls for fine details (like all encompassing sorcerer's sight+ microscope). I also wanted it to be upgrade-able to include up to 4-9 additional features (like night vision, memory storage data, analytic observation, text translation, disguise capabilities,etc.) <i>I am thinking of it like high-tech glasses like ones we have with cameras, screens, etc.</i><br /> <br /> It would require a new craft-artifact set of rolls each time you wanted to add a component as if crafting a new artifact with that ability. If you failed to roll at any point, you would have to restart from scratch on the upgrade and fix the line before re-use of the essence line in the artifact, but it would not affect an ability already in the goggles (unless a bad botch happened or something).<br /> <br /> I wasn't sure what level artifact this would be exactly. I was thinking it would be a level 3, but I was not certain. For now, it has an essence 2 charm + 2 die for creating artifacts and has a feature allowing it to be upgraded. It has the draw back of having to repair the essence line in the goggles and restart from scratch if you fail any roll. I was thinking that it would require a 6m commitement +1m extra for each additional feature lvl added on (if an artifact 3 type-ability was added on, it would cost 3 more essence committed; excluding the first ability above).<br /> <br /> Let me know what you think and what the details should be. I am open to any comments/suggestions/changes that need to be made to make this work. Thanks!</div> </div> </div> </div>Look at the Precision Goggles in MoEP: Alechemicals and the Essence Visor from Scroll of Fallen Races: Jadeborn.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2014-07-11T15:50:58-07:00","id":195069,"title":"","content":"Well damn... that does quite a bit for artifact 1. Mine is similar, but slightly better whilst being upgrade-able. Mine would probably be artifact three if it was allowed. I think the zoom option on mine is nice too for crafting.<br /> <br /> Maybe when zoomed to normal, it gives +2 to awareness and when zoomed in +2 to crafting smaller items. Then it could give AESS and the same vision as those goggles. Think that would make the artifact more worth it?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1480-citanhyuga","name":"CitanHyuga","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1480_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"191"}]},"thankedby":[]},{"date":"2014-07-11T17:17:54-07:00","id":195119,"title":"","content":"The artifact 2 precision goggles in Alchemicals has the zoom feature and a better crafting bonus. See also the Light Amplification Visor a few pages later..","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2014-07-11T17:42:15-07:00","id":195133,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/44513-ooc-exalted-2-5-forging-a-nation?p=195119#post195119\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The artifact 2 precision goggles in Alchemicals has the zoom feature and a better crafting bonus. See also the Light Amplification Visor a few pages later..</div> </div> </div> </div>Neither of those options provide an AESS, though. The Revelation Blindfold in Glories:Maidens does though, and it's artifact 2. Say Artifact 3 for the AESS and a +2 craft bonus. <br /> <br /> The modules are harder. The one Artifact I can recall that does that is the Integrated God-Machine Matrix from Gunstar, that lets you slot Alchemical charms into a fighter or Warstrider. Each charm is a three dot artifact itself, and charm slots are two dots (though you get four freebies). Hm.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-07-11T18:13:31-07:00","id":195158,"title":"","content":"As I prepare to begin another Round of the Rumor Mill, I decided to avoid the clunks addition of previous Rumors at the bottom of each post. To mitigate this loss, I made this: A <a href=\"https://docs.google.com/document/d/1REaxoY-sraYz6KhQXMEWKWW278n-1GbakIYIUgoOrXg/edit?usp=sharing\" target=\"_blank\">Compilation of all posted Rumor Mills</a>. I will update it with all Confirmed True/False information, as well as any potential leads that may crop up. You're allowed to comment, so if you feel like there's any evidence for something, go ahead and point it out!<br /> <br /> Also, I will be putting the link in the first post of the Thread, for ease of finding.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-07-11T18:18:01-07:00","id":195160,"title":"","content":"While I'm here, any requests or suggestions for Setting info tidbits and such?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/155-noodle","name":"Noodle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar155_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1415"}]},"thankedby":[]},{"date":"2014-07-11T19:02:54-07:00","id":195183,"title":"","content":"yeah actually is there any first age/shogonate ruins or solar tombs in the region ? And thank you for the rumor mil compilation it really helps me.","signature":"","edited":{"userid":2087,"user_link":"https://forum.theonyxpath.com/member/2087-magnusar","user":"Magnusar","date":". 07-11-2014, 11:33 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2087-magnusar","name":"Magnusar","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2087_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"458"}]},"thankedby":[]},{"date":"2014-07-12T10:50:31-07:00","id":195600,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bb