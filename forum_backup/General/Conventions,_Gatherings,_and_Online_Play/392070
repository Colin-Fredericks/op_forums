":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"549"}]},"thankedby":[]},{"date":"2015-02-26T19:43:27-08:00","id":421049,"title":"","content":"I look away for 6 months and find Cire hosting another thread. So this is going by letters? Interesting.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1111-egreham","name":"egreham","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"107"}]},"thankedby":[]},{"date":"2015-02-26T19:48:41-08:00","id":421053,"title":"","content":"First, welcome back, and yes. Given my failure with the other format, I decided to go back to what I knew I could make work. By the way, I purposely wrote my first letter so we can work new people in. In any event, great to hear from you!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/790-cire","name":"Cire","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"549"}]},"thankedby":[]},{"date":"2015-03-01T22:52:53-08:00","id":424907,"title":"","content":"Another good round. Four experce points of regular and two of arcana experience for Techpriest, Warrior Angel, and Cod of Justice. I think Blaze will miss this round so I can do something dramatic and not skip Exthalion in the event he wants to go this round. (By no means am I trying to compel this, just erring on the side of caution.) Barring indication of this, Techpriest should feel to post a letter if wishes.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/790-cire","name":"Cire","avatar":"data:image/svg+xml;b