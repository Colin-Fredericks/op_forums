":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-06T03:38:24-08:00","id":394645,"title":"","content":"Yes. Alric needs his new winter? home. :-)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-06T08:38:49-08:00","id":394926,"title":"","content":"Alright, and another reminder, game today at 8pm EST","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-06T09:36:13-08:00","id":395005,"title":"","content":"I will likely be a couple of minutes late.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-10T14:47:20-08:00","id":400862,"title":"","content":"I'll be missing game this Friday. Fiance is taking me on a surprise trip out of town to an unknown location.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-10T20:40:30-08:00","id":401393,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/265726-back-and-looking-to-play-skype-game-recruiting?p=400862#post400862\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'll be missing game this Friday. Fiance is taking me on a surprise trip out of town to an unknown location.</div> </div> </div> </div>I'll make sure the life insurance is paid up","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-11T11:00:55-08:00","id":402097,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/265726-back-and-looking-to-play-skype-game-recruiting?p=400862#post400862\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'll be missing game this Friday. Fiance is taking me on a surprise trip out of town to an unknown location.</div> </div> </div> </div>Don't forget your passport and snakebite kit!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-11T19:20:45-08:00","id":402776,"title":"","content":"so guys since we didn't get to do Mayu attuning we are gonna just assume there were no major issues and more ahead, then do a small jump back next week","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-12T06:46:20-08:00","id":403249,"title":"","content":"I'm not sure we're prepared to take on the bank just yet. I have some ideas, but I think I'll need more charms to pull it off. <br /> <br /> Unless there's something more in the city to explore, maybe we should head back on the ship. Next week, we can do a flashback to how the attunement went and then keep going. I was planning on learning some First Age from Mayu on the trip back and maybe training Bloodless in melee so he doesn't kill him self with the critter on his wrist. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /><br /> <br /> Otherwise, I'm not sure what the plan was with the Guild; I wasn't there for that session. <br /> <br /> I feel a little bit like a leaf on the wind, which I don't think is the expected mode for Exalted. I didn't have a major overriding goal for Alric when I made him, but I think I need to create one now. Crime lord was the first that came to my mind, but I'm open to suggestions. Maybe I'll set up shop as an animal breeder and put more into Ride skills/charms?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-12T06:52:41-08:00","id":403260,"title":"","content":"The Guild - We paid an outrageous sum to rent the ship for a month and signed a contract to give the guild first rights to be our go between for selling anything we find. Thus why we need the fruit. I don't think we should SELL any of the bio-klaives. <br /> <br /> Hopefully, the fruit will keep for the trip and we make enough money to be able to finance another trip. I suppose we could go looting random &quot;crap that mortals will buy, but is completely useless to us&quot; from the rest of the city. <br /> <br /> Also, Mayu is going to make sure the fruit is packed REALLY well before we leave. It seems to be soft and squishy.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-12T06:53:28-08:00","id":403261,"title":"","content":"What abilities does Alric favor?<br /> <br /> Also, can Alric give Mayu some instruction in Athletics during the trip?<br /> <br /> Mayu's big plans, once we return to the city (if the city is still there), is to start building a Printing Press. She is going start distributing Skytongue and Riverspeak Translations of some of the Old Realm books she has acquired. I figure that Guild Contact would be a good? way to distribute them.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-12-2015, 10:06 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-12T07:35:02-08:00","id":403306,"title":"","content":"Favoured Abilities: Melee, Thrown, Investigation, Socialize and Ride + Night Caste (Awareness, Dodge, Athletics, Larceny and Stealth)<br /> <br /> Sure, I can train Mayu in Athletics. There's lots of rigging to use on the ship. Mayu can swim, right? <img src=\"https://forum.theonyxpath.com/core/images/smilies/tongue.png\" border=\"0\" alt=\"\" title=\"Stick Out Tongue\" smilieid=\"5\" class=\"inlineimg\" /><br /> <br /> Are we sticking around this city or moving on? That will play a big part in what Alric does next.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-12T07:43:34-08:00","id":403314,"title":"","content":"I hope Mayu can swim. Lookshy is a coastal town.<br /> <br /> I hope we stick around the city. Mayu has a lot invested in Twisted Stone.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-12-2015, 10:46 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-12T09:52:49-08:00","id":403414,"title":"","content":"I think he meant staying in the first age city. So to cover some stuff that came up in the last few posts. I applaud you for taking into consideration keeping the fruit ripe and worrying about shipping. These are things I want players to consider so please continue to do so, however I'll tell you now dont worry it will. I think you guys did enough to earn the fruit even limiting yourself abit as to maintain the ecosystem. <br /> <br /> For Alric's goal, I think you should go with something that demonstrates character growth. Learning to do things for more than just himself. Not to say you cant stay the dashing rogue. Think Han Solo, he's still the same guy but he went from only looking for some cash to risking his life for the greater good even without a direct reward to him. I could see him expanding on animal taming especially considering recent events and the city showing him just what a solar can do with living animals. This is me talking as a fellow Exalted player not your GM. Just my thoughts on it.<br /> <br /> I did also want to know how much you guys wanted to RP training. Some players just handwave &quot;I did sword kata for few hours each day&quot; others like to actually RP training and explore the mentor student role. I could go either way but when it comes to martial arts there will be some actual RP training stuff outside of hero styles. You cant just teach yourself say, even blades style. This also doesn't have to be all or nothing. Maybe Mayu wants to play out fumbling and flailing as she learns athletics but Bloodless just wants to sword train off screen. Thats fine. Just let me know.<br /> <br /> Now back to what I was originally saying. I figured you guys would be done with the first age city for now. The bank probably isn't the best thing at your current level and you dont have the time to train much. We will spend atleast a few sessions in Twisted Stone because I want abit of relaxation time for your characters as they reap the rewards of their trip. You see I need some context for when I pull out the GM dice and just completely wreck your day <img src=\"https://forum.theonyxpath.com/core/images/smilies/biggrin.png\" border=\"0\" alt=\"\" title=\"Big Grin\" smilieid=\"3\" class=\"inlineimg\" /><br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-12T10:09:47-08:00","id":403425,"title":"","content":"I meant Twisting Stone, sorry. Ok, let's see what happens. I might look into setting up a business around animal training and also see what's going on in Twisting Stone's underground economy. Gotta keep a hand in, you see. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-12T10:51:13-08:00","id":403488,"title":"","content":"If you open up an animal training business, I might just invest in craft Genesis.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-12T11:09:59-08:00","id":403497,"title":"","content":"ok I have two reasons to motivate you, but I'm still not sure how ... harsh. I should be with you guys. I mean honestly do you guys appreciate your characters getting just beat over the head with the drama stick? I will tell you this much, its not undeserved. Ok it is undeserved but narratively its reasonable to expect because you are exalted and this is the age of sorrow but if I go with option A your characters are going to have a very bad day.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-12T11:27:46-08:00","id":403508,"title":"","content":"We are Solars in Exalted game. Bring on the beat down.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-12T12:24:22-08:00","id":403590,"title":"","content":"I'm up for it. I have a couple of backup characters in mind in case it doesn't go well, but at least we should go out with a bang!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-12T13:12:29-08:00","id":403611,"title":"","content":"Whatever is more fun and/or interesting, although you might want to hold the invasion/city in flames scenario until we're invested in twisting stone","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-13T14:10:59-08:00","id":405063,"title":"","content":"just a reminder of tonights game","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-13T21:03:48-08:00","id":405442,"title":"","content":"Had a fun night! We fast forwarded past the attunement to the factory manse and trip home (which we will do in flashback next week). Once we were back in town, Alric picked up his horse from the guy he swindled Makoto out of. After that, we had two intertwining plotlines. We assumed Mayu was spending quality time with the barbarian swordmaiden.<br /> <br /> Bloodless investigated the sword from Janos and it's history. Of course, he's not good at investigation, so Alric facilitated. We contracted a necromancer to summon an ancestor of the sword for questioning. Bloodless gave the ghost the sword, asked questions, got answers and the ghost was sent home. We now have a contact for summoning ghosts!<br /> <br /> The lunar that had his limbs chopped off commissioned Alric to bust him out of jail. Alric arranged with his tribe through his daughter to spirit him away once he was free. Then Bloodless started a huge barroom brawl/riot to draw away the guards. Alric snuck in and freed the lunar and broke him out. Essence rolls and conversation seemed to indicate a connection between Alric and the Lunar. Memories were of comaraderie and friendly competition, but the current relationship is a little less respectful. I'm sure they'll meet again.<br /> <br /> Turns out the barbarian swordsman functions as the captain of the guard (perhaps in an unofficial capacity).<br /> <br /> We also raided Mayu's closets for clothes for Bloodless, food all around and the liquor cabinet. =)<br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-14T11:40:41-08:00","id":405954,"title":"","content":"Sounds like you guys had an awesome time. Mayu was hoping to avoid the Swordmaiden. However, Mayu is young and the Sword Maiden is hot, so I'm not surprised that Mayu found herself in the lady's bed again. <br /> <br /> So....um... What sort of clothes did you guys find in Mayu's Closet for Bloodless? Mayu is kind of short and Mokoto (I doubt he left any clothes behind) isn't really that tall either. I guess Mayu brought some guy back from the tavern and he left some clothes behind.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-14T11:54:48-08:00","id":405956,"title":"","content":"None, they then just went out and bought him some clothes. And there is other stuff Mayu could have been doing of course, thats just what we defaulted too","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-14T11:57:42-08:00","id":405959,"title":"","content":"Of course, just because the other two character think that is where Mayu was, doesn't mean that is actually where Mayu was. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-14T13:00:40-08:00","id":406051,"title":"","content":"Oh, Bloodless got vivid nightmares foreshadowing possible loyalist abyssal involvement. It's almost as if whispers is a double edged blade. Fun fact: if two people with whispers run into each other it's possible to both have visions due to the feedback.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-14T13:13:31-08:00","id":406066,"title":"","content":"Did the Necromancer have Whispers?<br /> <br /> Also, if I am going to go down the Mayu building a printing press road, she is going to need a Pen Name. Something like &quot;Sweeping River of Wisdom&quot; or &quot;Banishing Ignorance&quot; or some other First Age like name. Any ideas?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-14T15:53:13-08:00","id":406174,"title":"","content":"Wong shi tong he who knows ten-thousand things (not sure what to change to make it she)? I highly doubt the necromancer has whispers, anybody who isn't Abyssal/Deathlord has to hang out in the labyrinth to get it.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-14T17:03:13-08:00","id":406198,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/265726-back-and-looking-to-play-skype-game-recruiting?p=405954#post405954\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Sounds like you guys had an awesome time. Mayu was hoping to avoid the Swordmaiden. However, Mayu is young and the Sword Maiden is hot, so I'm not surprised that Mayu found herself in the lady's bed again.<br /> <br /> So....um... What sort of clothes did you guys find in Mayu's Closet for Bloodless? Mayu is kind of short and Mokoto (I doubt he left any clothes behind) isn't really that tall either. I guess Mayu brought some guy back from the tavern and he left some clothes behind.</div> </div> </div> </div>Nah, we just rooted through her stuff. Alric had to go out and get some brute squad clothing. On the upside, Bloodless can blend in as a bodyguard now! :-)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-14T19:55:30-08:00","id":406305,"title":"","content":"Did you find anything interesting? The only thing I can think of that would be interesting in there is her Seventh Legion Uniform.<br /> <br /> How about Zh\u012bsh\u00ec H\u00e9? Knowledge's River.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-15T04:25:32-08:00","id":406560,"title":"","content":"Aeroz didn't specify what we found, but the 7th Legion Uniform would be interesting if you are ok with us finding it.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-15T04:59:51-08:00","id":406594,"title":"","content":"Depends on how far you were digging. It's hanging in the back of her closet, in a bag, so a casual look won't find it. It's more of a &quot;she took the uniform off not long after her exaltation and couldn't bear to part with it.&quot;<br /> <br /> She isn't on assignment or anything, so she doesn't have any real need to hide it except for &quot;Why is a former Seventh Legion Sorcerer Technician doing out here?&quot;","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-15T09:28:17-08:00","id":406756,"title":"","content":"I'm not sure Alric or Bloodless would see it anymore than a military uniform since you're the only contact we've had with the river province. A Realm uniform would probably spark a reaction but I'm also pretty sure each legion/house has it's own heraldry. By the way, Mayu do you know if your friend still wants to try out Exalted? Also for Aeroz, would Marquee (Marquise?) Oron counts as an ally, contact, something else, or nothing at all? A more general question for spending experience is how is getting the lucrative 4th and 5th dots in an ability going to be handled when it's for things the character isn't specifically focused on? Multiple charm trees want you to get [ability] 4+ extremely quickly; normally this problem is more of a long term thing but melee is one of those low essence high ability trees.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-15T10:05:48-08:00","id":406801,"title":"","content":"I haven't talked to him since then. Might have been a spur of the moment interest. My fiance mentioned trying out the game as well. Though when I suggest we make a character today, he rather just watch Anime. :P<br /> <br /> If we want more players we should try to recruit more players via the forums. Maybe Aeroz can change the Subject of the post to try to recruit more people? Something like &quot;[Exalted 2.5] Open Recruitment - Skype Game set in the North&quot; or something.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-15T10:11:04-08:00","id":406809,"title":"","content":"Right now he counts as one dot of contacts, he could be upgraded to ally but right now its more of an &quot;I owe you one&quot; kind of thing. The 4th and 5th dot of an ability just take more time. Since melee is a caste ability it wont take alot of training but still want atleast a token effort for narrative reasons.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-15T17:43:19-08:00","id":407168,"title":"","content":"ANyone know how much total exp I've given out so far?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-15T17:44:41-08:00","id":407170,"title":"","content":"Mayu has 65 XP. I think I have missed two games total.<br /> <br /> (71 with the Ice Walker Influence and the Fur Merchant's Gift)","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-15T17:48:52-08:00","id":407173,"title":"","content":"Alric has 62, not counting the extra backgrounds we've earned in-play.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-16T07:52:25-08:00","id":407725,"title":"","content":"Bloodless has 66 and has gotten something like 12 background points earned through play","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-16T08:41:44-08:00","id":407783,"title":"","content":"What are the &quot;got to have&quot; melee and resistance charms?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-16T09:19:02-08:00","id":407827,"title":"","content":"It really depends on your build honestly (I'm assuming solar btw) infinite melee mastery is the only real charm everyone uses, hungry tiger and fire &amp; stones if you want to nuke somebody, iron whirlwind/peony blossom for all you aoe/doom combo's, if you're using artifacts the elsewhere charm is amazing and call the blade skips the draw your weapon action everyone seems to ignore, and finally don't forget about the easy to access perfect parry for a get out of jail free card. Personally, I love the counter attack branch because most people don't expect combo's out of them.<br /> <br /> For resistance if you're going the unarmored route go iron skin/iron kettle(there is a charm that lets you use these armored but its Glories so ask ahead of time), if you're going armored the armored scout charm to reduce penalties is nice if expensive (the conjured armor and elsewhere armor charm is also along this tree), if you want the ox-body route get the charms to reduce and/or negate wound penalties this one is usually the most powerful since it synergizes extremely well but it's also expensive to do ( most of your starting charms expensive).<br /> <br /> I don't mention ink monkey charms because the power creep is obvious and most are better to learn in game. (I'm also not on a memorization basis with them)<br /> <br /> and as always thunderbolt attack prana/increasing strength exercise is good for like 90% of combat builds.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-16T09:44:30-08:00","id":407845,"title":"","content":"He wants to buy the Wavecleaver Daiklave. He probably needs to work with Aeroz to figure out how his character got it. <br /> <br /> I am going to suggest that he wait to spend most of his 65 points of XP until he gets a better feel for the game. I know he wants to take some more abilities dots in Ride and Sail. I tried to get him to favor Athletics, but he took War instead.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-16T10:20:27-08:00","id":407932,"title":"","content":"Did he want to be more army of one, leader of men, or took war just because? While ride and sail charms are fun they kind of demand essence 3 past like 2 charms so keep that in mind. For a mount might I recommend a simhata (lion horse) if he's feeling fancy. They're expensive resources wise to feed but very few things mess with a simhata.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-16T10:31:44-08:00","id":407936,"title":"","content":"I have no clue why he took war. I'll ask. <br /> <br /> I was going to have him take essence 3 at character creation.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-16T11:45:10-08:00","id":407985,"title":"","content":"This was my first Exalted game and what I expected from the game isn't what it ended up being. The xp I would have spent at character creation with additional XP would not have been the same as the ones I ended up buying as a result of actual gaming. Chances are he'll end up buying things that he doesn't want. I would suggest he start with a starting character and earn 50% more XP per session until he's caught up. We can handwave some of the training times as well.<br /> <br /> Also, I have learned that the Melee charms are based around swinging a sword the size of a Buick and when you take a smaller weapon they don't scale down well. If he's going to take an artifact sword, I'd suggest a beefy one or be prepared to start working on custom charms. That said, Melee does it all; Offence, Defence via Parry DV, Perfect Defences. There's a short charm set in Resistance that works well around no armour, or he can just rely on armour until he's far enough down that tree.<br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-16T13:48:52-08:00","id":408172,"title":"","content":"The reason you don't hit hard is because you grabbed one of the lowest damage artifacts in the game, there's a fair amount of mundane weapons that compete with it's damage. The trade off is they have really good everything else which was borderline OP when essence ping was a thing to be honest. Going to be honest I did way worse mistakes my first character that took like 200 experience to rectify.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-16T13:56:56-08:00","id":408176,"title":"","content":"I went through two characters in my first exalted game. Of course, the game was at 200 xp when I joined and all the character niches I usually played were taken.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-16T16:33:42-08:00","id":408292,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/265726-back-and-looking-to-play-skype-game-recruiting?p=408172#post408172\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The reason you don't hit hard is because you grabbed one of the lowest damage artifacts in the game, there's a fair amount of mundane weapons that compete with it's damage. The trade off is they have really good everything else which was borderline OP when essence ping was a thing to be honest. Going to be honest I did way worse mistakes my first character that took like 200 experience to rectify.</div> </div> </div> </div>I'm not saying that I don't hit hard, because with minimum essence 2 damage, I'll do fine when I find a sweet spot for flurrying.<br /> <br /> The charms themselves work best when you're using something with big damage. A wavecleaver is +5L instead of +3L (Short Daiklave). That's not a big difference in damage output. Compare to +11L or +16B when using One Weapon, Two Blows. Same charm cost, but I'd rather be doing damage twice with the +11L than the +3/+5L. The rest on that branch of the charm tree ignore Rate with your Buick, so you can spread your giant damage bonus far and wide.<br /> <br /> There's nothing in the Solar Melee charm tree that works better for fast and/or small weapons than big, slow, large ones. Maybe he's going to take a shield as well, so the one-handed Wavecleaver can be used to wear down the enemy while he rides out the counterattacks with a huge PDV?<br /> <br /> All I'm saying is that if I had a better understanding of how the charm trees work in actual play, I would have made different choices if I was making a melee monster. I'm happy with the paired swords for character reasons and I think they can be moderately effective, but if I was making a beatstick I would have done something else.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-17T09:25:14-08:00","id":409043,"title":"","content":"This encounter is going to be tricky. Assuming everyone has an updated character sheet (the ones on the opening post) you guys dont have much to deal with high damage enemies. This will be a time I may have to abstract some systems so mechanics dont get in the way of narrative.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-17T09:31:40-08:00","id":409046,"title":"","content":"Alric's sheet from the main page is up to date.<br /> <br /> Mostly, I rely on Dodge DV and maybe the perfect. Otherwise, armour will help with some hits but not anything really big.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-17T09:46:01-08:00","id":409059,"title":"","content":"I also rely on Dodge Charms and of course, not being anywhere near the nasty things beating on Bloodless. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /><br /> <br /> I wrote up two melee builds for the fiance to choose from. I basically spend all of his character creation charms/bonus points on combat (hopefully the numbers are correct. I haven't put this in Anathema yet). <br /> <br /> I am also going to try to talk him into switching to a Grand Diaklaive (if Aeroz allows). I figured he could buy whatever other sail/ride/war/survival/etc charms with his XP once he figures out what he wants from the game. <br /> <br /> <br /> <u>Build one - High Damage/ Unarmored Resistance</u><br /> 1st Melee Excellency<br /> Infinite Melee Excellency<br /> Call the Blade<br /> Summoning the Loyal Steel (because Grand Diaklaive)<br /> <br /> Hungry Tiger Technique<br /> Fire and Stones Strike<br /> <br /> Durability of Oak Mediatation<br /> Iron Skin<br /> Iron Kettle Body<br /> <br /> Thunderbolt Attack Prana<br /> <br /> Bonus Points<br /> Willpower to ten - 5 points<br /> Essence x 3 - 7 points<br /> Athletics 2 and 3 - 2 points<br /> Increasing Strength Exercise - 4 points<br /> <br /> <br /> <u>Build two - AOE Damange/ Unarmored Resistance</u><br /> 1st Melee Excellency<br /> Infinite Melee Excellency<br /> Call the Blade<br /> Summoning the Loyal Steel (because Grand Diaklaive)<br /> <br /> One Weapon, Two Blows<br /> Peony Blossom Attack<br /> Iron Whirlwind Attack<br /> <br /> Durability of Oak Mediatation<br /> Iron Skin<br /> Iron Kettle Body<br /> <br /> Bonus Points<br /> Willpower to ten - 5 points<br /> Essence x 3 - 7 points<br /> Athletics 2 and 3 - 2 points<br /> Increasing Strength Exercise or Thunderbolt Attack Prana - 4 points","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-17T10:43:14-08:00","id":409089,"title":"","content":"Don't forget the athletics excellency as a prerequisite Mayu D : ! Unfortunately they made perfect soak a total pain in the ass to get to. It's almost as if it's by far the best perfect defense for abyssals not in the underworld. Since I'm assuming our new guy is a dawn I can go more defensive since he went eeny meeny meiny dead espescially since death's grip can wtf boom people if he goes next.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-17T10:58:29-08:00","id":409106,"title":"","content":"He is a Zenith. Holy Paladin idea and all.<br /> <br /> Doh! I guess I need to add the Athletics Excellency. Opps. I would have figured it out when I entered it into Anathema.<br /> <br /> Of course, I need to pass this plan by him first. He might have his own ideas on charms. lol","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-17T11:05:45-08:00","id":409130,"title":"","content":"Remember combat isn't everything one or two social charms can completely change how your character operates.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-17T11:26:43-08:00","id":409147,"title":"","content":"I know. He said he didn't want to be a social character, thus the focus on combat. He might change his mind after playing a few sessions. He does have performance and presence as caste abilities.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-17T14:57:33-08:00","id":409353,"title":"","content":"It might be a good idea to bank a bunch of exp to get a feel for things and spend it over time.<br /> <br /> As a GM I do have to say thats not just a combat focused thats combat exclusive by the looks of it. I especially have to ask why is he going with zenith? How does his character fulfill his role of Sol's priest and envoy? He doesn't have to be social, but he should have skills outside of combat otherwise he's going to be bored out of his mind for a good chunk of the game. Think of how often things like Bloodless's craft or Alric's ride or Mayu's bureaucracy came in handy despite it being very much out of the expected skill sets of your castes. This isn't just good mechanically but also for fleshing out the character.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-17T15:20:14-08:00","id":409362,"title":"","content":"I suggested Zenith because he wanted to go with a Paladin type. He did look at Dawn but decided to go with Zenith instead. He has taken some dots in survival, war, and sail. <br /> <br /> I think maybe I am going about this the wrong way. When I create a character, I always think about what their &quot;profession&quot; is and then build a background around that. Perhaps I should try to get him to build a background and then we can choose a &quot;profession&quot; based around that. <br /> <br />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-17T16:25:35-08:00","id":409398,"title":"","content":"Looking back on the original post it says I'm 22exp. Here's an updated Bloodless <a href=\"https://docs.google.com/file/d/0B_bGakUT9OwNLUhzY1pRbGdaVDg/edit\" target=\"_blank\">https://docs.google.com/file/d/0B_bG...pRbGdaVDg/edit</a>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2015-02-17T16:41:47-08:00","id":409407,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/265726-back-and-looking-to-play-skype-game-recruiting?p=409362#post409362\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I suggested Zenith because he wanted to go with a Paladin type. He did look at Dawn but decided to go with Zenith instead. He has taken some dots in survival, war, and sail.<br /> <br /> I think maybe I am going about this the wrong way. When I create a character, I always think about what their &quot;profession&quot; is and then build a background around that. Perhaps I should try to get him to build a background and then we can choose a &quot;profession&quot; based around that.<br /></div> </div> </div> </div>Do you mean the real world paladin, as in a fighter of holy wars to spread his beliefs or to defend the faithful, or more like the D&amp;D paladin that gets their power from a god and invokes their name when hitting people in the face?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3945-aeroz","name":"Aeroz","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"419"}]},"thankedby":[]},{"date":"2015-02-19T17:14:12-08:00","id":412221,"title":"","content":"I talked to him a little bit about his character. He is just going to listen in on tomorrow's game to see what we do.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-19T19:20:45-08:00","id":412328,"title":"","content":"Also, Alric needs to upgrade his mount. <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"><br /> <br /> <img src=\"https://s-media-cache-ak0.pinimg.com/736x/c9/c1/9c/c9c19c8b276110f4cabd46cf2aad6cdd.jpg\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/><br /> <br /> </div></div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2015-02-20T05:58:52-08:00","id":412661,"title":"","content":"Sign me up!<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3104-spaaace","name":"Spaaace","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3104_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"171"}]},"thankedby":[]},{"date":"2015-02-20T10:05:34-08:00","id":412914,"title":"","content":"If we are sharing mount suggestions<br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.di