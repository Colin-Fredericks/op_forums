rs/0/0/6/0/4/5/avatar10996_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"20"}]},"thankedby":[]},{"date":"2016-01-26T06:54:52-08:00","id":816839,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Red Priest</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/621169-recruiting-red-hand-chronicles-multi-venue-play-by-post?p=816768#post816768\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Your post says World of Darkness so is this VtM then?</div> </div> </div> </div>It was actually the New World of Darkness before they renamed it.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://youtu.be/_yBS2EZFduI?t=2m13s\" target=\"_blank\">Homo sapiens. What an inventive, invincible species. It's only a few million years since they crawled up out of the mud and learned to walk. Puny, defenceless bipeds. They've survived flood, famine and plague. They've survived cosmic wars and holocausts. And now, here they are, out among the stars, waiting to begin a new life. Ready to outsit eternity. They're indomitable. Indomitable.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/420-akatsukileader13","name":"AkatsukiLeader13","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar420_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1637"}]},"thankedby":[]},{"date":"2016-01-26T08:25:55-08:00","id":816900,"title":"","content":"I know so I was thinking perhaps they meant VtM.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11059-father-darius","name":"Father Darius","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"5"}]},"thankedby":[]},{"date":"2016-01-26T11:50:56-08:00","id":817036,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Father Darius</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/621169-recruiting-red-hand-chronicles-multi-venue-play-by-post?p=816900#post816900\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I know so I was thinking perhaps they meant VtM.</div> </div> </div> </div>It isn't. It's the formerly named New World of Darkness, now know as the Chronicles of Darkness. They even name drop the God-Machine Chronicles, original name of the 2nd Edition Rulebook.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://youtu.be/_yBS2EZFduI?t=2m13s\" target=\"_blank\">Homo sapiens. What an inventive, invincible species. It's only a few million years since they crawled up out of the mud and learned to walk. Puny, defenceless bipeds. They've survived flood, famine and plague. They've survived cosmic wars and holocausts. And now, here they are, out among the stars, waiting to begin a new life. Ready to outsit eternity. They're indomitable. Indomitable.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/420-akatsukileader13","name":"AkatsukiLeader13","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar420_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1637"}]},"thankedby":[]},{"date":"2016-01-26T12:23:23-08:00","id":817054,"title":"","content":"I realize how unclear I was, my apologizes. I was explaining that because it said world of darkness and not chronicles I thought perhaps they meant VtM. Yes they name dropped the God-Machine but I didn't originally see it when I read through it on my cell earlier.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11059-father-darius","name":"Father Darius","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"5"}]},"thankedby":[]},{"date":"2016-02-02T12:56:17-08:00","id":821830,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Red Priest</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/621169-recruiting-red-hand-chronicles-multi-venue-play-by-post?p=816768#post816768\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Your post says World of Darkness so is this VtM then?</div> </div> </div> </div>The post uses World of Darkness in the broadest sense. We use God Machine Chronicles as a base. Vampire uses Stryx Chronicles (VtR 2nd Ed etc etc).<br /> <br /> Cheers","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/7223-jehboi","name":"jehboi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7223_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2015"},{"key":"Posts:","value":"16"}]},"thankedby":[]},{"date":"2016-02-02T13:07:45-08:00","id":821833,"title":"","content":"Do you permit the use of any of the Immortals from World of Darkness: Immortals?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11131-karst\u00e4rke","name":"Karst\u00e4rke","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"16"}]},"thankedby":[]},{"date":"2016-02-02T13:20:40-08:00","id":821841,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Karst\u00e4rke</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/621169-recruiting-red-hand-chronicles-multi-venue-play-by-post?p=821833#post821833\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Do you permit the use of any of the Immortals from World of Darkness: Immortals?</div> </div> </div> </div><br /> Sorry. At this time we are only running Vampire and Werewolf chronicles.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/7223-jehboi","name":"jehboi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7223_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2015"},{"key":"Posts:","value":"16"}]},"thankedby":[]},{"date":"2016-02-02T18:28:14-08:00","id":822030