/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-02T20:51:46-08:00","id":1042786,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1042774#post1042774\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Ryo does not have any &quot;write something that will drive people mad&quot; charms.</div> </div> </div> </div>Carmela doesn't have any charms that let her give a burning stare of disapproval from halfway across a continent.<br /> <br /> She<i> doesn't need them to express her disappointment right now</i>.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2144-guancyto","name":"Guancyto","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2144_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"699"}]},"thankedby":[]},{"date":"2017-02-03T11:07:07-08:00","id":1043048,"title":"","content":"I'm writing Ryo's letter today. Anything he can do to help the Northern rebellion? <br /> <br /> I was planning on having him put bureaucratic pressure on the southern Tepet province.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-03T11:31:29-08:00","id":1043060,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1043048#post1043048\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'm writing Ryo's letter today. Anything he can do to help the Northern rebellion?<br /> <br /> I was planning on having him put bureaucratic pressure on the southern Tepet province.</div> </div> </div> </div>Anything he can do to delay the Cynis military response might be helpful - surely there are supplies they'll need traveling through the Imperial City, and they'll need ships to bring more troops north, and... well, plenty of stuff that might go through the Thousand Scales. I'm sure Quelaana would appreciate not having more legions dumped on her back. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /><br /> <br /> (also, guess I sort of jumped the gun with my PM - I was excited and forgot to wait for Ryu's letter. *^^*)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-03T12:17:46-08:00","id":1043080,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1042755#post1042755\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><a href=\"https://forum.theonyxpath.com/member/3950-wonderandawe\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar3950_2.gif');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"3950\" data-vbnamecard=\"3950\">wonderandawe</a> Spending 20 xp to raise essence to 3.</div> </div> </div> </div><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1042768#post1042768\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">We use solar exp costs.</div> </div> </div> </div><br /> Crap. Apparently essence is the one place Dragonblooded have an XP advantage over Solars. Just use the Dragonblooded costs for Essence. The Charms will stay at the Solar costs.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-03T12:38:04-08:00","id":1043094,"title":"","content":"They do? I've always read the Solar XP cost to be (8 * Current Rating), compared to DB's (10 * Current Rating). Where's the advantage?<br /> <br /> I make the assumption that it's &quot;current rating&quot; rather than &quot;new rating&quot; for a couple of reasons, most important of which is that almost every other splat book is explicit about being current rating (Lunars, DBs, Fair Folk and Sidereals). But now that I investigate more... I can see arguments for both sides. Hm. I can't find an explicit answer in the Scroll of Errata.<br /> <br /> Anyway, if it's actually going to be 30xp for Essence 4 rather than 24 as I'd assumed... I'm not sure how excited I am to keep saving up for that goal any more. &gt;.&gt;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-03T12:41:49-08:00","id":1043098,"title":"","content":"??????<br /> Dragon-blooded exp cost is current rating times 10=20 for ess3<br /> Solar exp cost is current rating times 8=16 for ess3<br /> <br /> <br /> Sidereal'd and it is clearly current rating for both.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-03T12:46:59-08:00","id":1043103,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1043098#post1043098\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">??????<br /> Dragon-blooded exp cost is current rating times 10=20 for ess3<br /> Solar exp cost is current rating times 8=16 for ess3</div> </div> </div> </div>That's how I've always read it as well. But then I reviewed a couple of the other books, and it's no longer so clear. &gt;.&gt;<br /> <br /> Consider the Lunar XP table (MoEP: Lunars, pg. 233): <div class=\"b-bbcode__table--wrapper text_table_\"><table class=\"b-bbcode__table text_table\" style=\"width: 500px\"><tr valign=\"top\" class=\"text_table_tr\"><td class=\"text_table_td\" style=\"border-width: 1px; padding: 1px\">Trait</td> <td class=\"text_table_td\" style=\"border-width: 1px; padding: 1px\">Cost</td> <td class=\"text_table_td\" style=\"border-width: 1px; padding: 1px\">Training Times</td> </tr> <tr valign=\"top\" class=\"text_table_tr\"><td class=\"text_table_td\" style=\"border-width: 1px; padding: 1px\">Attribute</td> <td class=\"text_table_td\" style=\"border-width: 1px; padding: 1px\">current rating x 4</td> <td class=\"text_table_td\" style=\"border-width: 1px; padding: 1px\">(rating) months</td> </tr> <tr valign=\"top\" class=\"text_table_tr\"><td class=\"text_table_td\" style=\"border-width: 1px; padding: 1px\">Cast / Favored Attribute</td> <td class=\"text_table_td\" style=\"border-width: 1px; padding: 1px\">current rating x 3</td> <td class=\"text_table_td\" style=\"border-width: 1px; padding: 1px\">(current rating x 2) weeks</td> </tr> </table></div> You can see in the training times that they're clearly using &quot;rating&quot; and &quot;current rating&quot; as different things. Which is super confusing! But it could be used to make an argument that &quot;rating&quot; means &quot;new rating.&quot;<br /> <br /> I wouldn't make that argument - I think this is mostly a dumb editing mistake, and don't trust WW's ability to use terms consistently across multiple years and different writers - but there it is.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-03T12:56:02-08:00","id":1043108,"title":"","content":"You are right, Eura. I just checked Anathema. It's current rating * 8. <br /> <br /> Let's stick with the Solar table as before.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-03T13:26:41-08:00","id":1043116,"title":"","content":"Ryo's letter is up.<br /> <br /> I will update the website this weekend with last season's letters and some other details.<br /> <br /> Please check the XP sheet to make sure I have all of your XP buys.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-03-2017, 04:30 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-03T16:01:14-08:00","id":1043210,"title":"","content":"Since it is only 16xp for the essence, I will buy that custom craft charm as well.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-03T16:15:44-08:00","id":1043223,"title":"","content":"What was the name of the custom charm again?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-03T16:31:38-08:00","id":1043234,"title":"","content":"Aisa is burning a full barrel's worth of XP for Essence 4, which hasn't made it on to the spreadsheet yet.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-03T16:46:12-08:00","id":1043243,"title":"","content":"Good thing you had me look. I don't have Shaping Hand Style, so I am buying that instead.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1004753#post1004753\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Custom Terrestrial Craft charm for consideration:<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">Strike the Dragon-Anvil<br /> Cost: 6m, 1wp; Mins: Craft 5, Essence 3; Type: Reflexive<br /> Keywords: Combo-OK, Obvious<br /> Duration: Instant<br /> Prerequisite Charms: Shaping Hand Style<br /> Striking at a block of uncarved stone as if it were a foe upon the<br /> battle-field, the Dragon-Blood carves it into shape. This Charm<br /> can enhance any Craft-based action to build an object, dividing<br /> the time needed to complete each interval in half. If the Dragon-<br /> Blood is assisted by others who knows this Charm, they may<br /> activate it cooperatively. Each cooperative activation increases by<br /> one the factor that the time is divided by, to a maximum dividing<br /> factor of the higher of the crafting Dragon-Blood\u2019s (Essence<br /> or Breeding). For example, if the Dragon-Blood was assisted by<br /> one other character with this Charm, the time needed for each<br /> interval would be divided by three, while with two assisting characters,<br /> it would be divided by four.</div></div> </div> </div></div> </div> </div> </div>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-04T12:03:36-08:00","id":1043666,"title":"","content":"To maintain my sanity, we will run the Northern Uprising here in OOC topic. It will make coordination easier. All other actions will be run via PM as usual. <br /> <br /> <u><b>Cheraki</b></u><br /> People are disappearing. Some on the List you found, Quelaana. Some aren't. Rumors abound of Cynis sending in an entire legion. A few hope the Roseblack will be their salvation. Surely she can see how the people suffer. Others say The Roseblack plans to win the Scarlet Throne swimming though the blood of the populace. <br /> <br /> The atmosphere in Cheraki is tense. The Bloody Hand stocks up on weapons. Everyone who can fight from young teenage girls to old men is armed. No one travels unarmed. Cynis Dynasts walk the streets in groups. Merchants pack up their wares to head elsewhere. Overseers whisper in the taverns. Slaves in the fields are more lively than usual. <br /> <br /> It's a powder keg. One spark could set the whole city into chaos. <br /> <br /> <u><b>Tepet and Cynis</b></u><br /> Tepet and Cynis are negotiating the Tepet Legion's place in the upcoming rebellion. <br /> <br /> Tepet REALLY wants to get involved in the Northern Situation. The Roseblack needs a decisive military victory and this Cynis problem is perfectly situated to provide her with one. Tepet needs permission to intervene or else Cynis can sue for trespassing into their affairs. Also, one house invading another house's territory may start a chain reaction of stronger houses taking out the weak. A situation Tepet wants to avoid. <br /> <br /> However, Cynis believes they can handle it themselves. Cynis says they are sending one of their legions north. However, Cynis legion moves slow. They are plagued with Bureaucratic delays. *cough Ryo cough* Yet, the Cynis elders are playing they have the situation under control. <br /> <br /> Some Tepet house elders are strongly considering throwing caution to the wind and conquering the province in a last attempt for glory. With the Empress gone, there is no one to stop them, except whatever forces Cynis has in the north. More rational minds see this as Suicide. It's a desperate measure for a desperate house. <br /> <br /> <b>What do you do?</b><br /> <br /> <br /> <br />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-05T09:24:17-08:00","id":1044019,"title":"","content":"Is one of the Tepet elders still willing to meet with her (or at least send a dynastic representative)? Preferably one of the more cautious ones. As it becomes apparent how close they are to making a deal with Cynis already, Aisa's request becomes much more urgent. &quot;I have an inside ear on the situation, and am willing to share. Please do not leap before you look - there are sharp rocks at the bottom of this well.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-05T09:37:44-08:00","id":1044027,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>BlueWinds</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044019#post1044019\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Is one of the Tepet elders still willing to meet with her (or at least send a dynastic representative)? Preferably one of the more cautious ones. As it becomes apparent how close they are to making a deal with Cynis already, Aisa's request becomes much more urgent. &quot;I have an inside ear on the situation, and am willing to share. Please do not leap before you look - there are sharp rocks at the bottom of this well.&quot;</div> </div> </div> </div><br /> They are not close to making a deal at all. The negotiations have failed. <br /> <br /> Cynis: &quot;We got this!&quot;<br /> Tepet: &quot;If you got this, then why is your Legion still on the Blessed Isle?&quot;<br /> Cynis: &quot;No, we got this! Leave us alone!&quot;<br /> <br /> <br /> Basically, Cynis isn't answering Tepet's calls anymore and Tepet is tempted to break the door down. If you approach one of the Tepet elders, they would be interested in having you talk to Cynis.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-05T10:06:01-08:00","id":1044047,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044027#post1044027\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Basically, Cynis isn't answering Tepet's calls anymore and Tepet is tempted to break the door down. If you approach one of the Tepet elders, they would be interested in having you talk to Cynis.</div> </div> </div> </div>Err, right. My reading comprehension seems to have failed, you said that clearly enough above. ^^;;<br /> <br /> Aisa's words at the meeting - and she does want a face-to-face meeting with Tepet - are straightforward: &quot;I will deliver the Slave Coast to you entirely, as a fresh, willing, tribute-paying satrapy that need not be occupied. Your military victory will be more than an empty symbol, then. In exchange, you must promise two things.<br /> <br /> First, you must wean them away from the horrific Deshan System. This is my non-negotiable price for assistance. It is a stain upon the honor of the dynasty. It is also your ticket to a swift end of the rebellion. Once you take control and publicly announce the end of Cynis' horrors, most of the resistance will melt away. I can then provide you with information on any remaining cells of resistance - a quick and decisive victory, practical as well as symbolic.<br /> <br /> Second, you must give up control of Hohenzon. This will be the price from House Cynis. Two years ago, this would have been a trade too expensive for you to consider - but things have changed, and the title to a talent is worth less than the reality of six bars.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-05T10:28:33-08:00","id":1044061,"title":"","content":"Tepet Elder says that is too expensive of a price now. Yes, they will admit Hohenzon is not profitable right now, but House Tepet will recover from this momentary setback. And when they do, Hohenzon will be profitable again. And the Slave Coast will be just as barren as before. <br /> <br /> <b>What do you do?</b>","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-05T10:49:40-08:00","id":1044074,"title":"","content":"Akashan is going to meet with Cynis Elders and present his artifact discoveries. He will claim to be interested in acquiring the aid of Cynis wood aspect gardeners (what with the artifacts being plants). While he will not say it, he will lament that they don't have a good place to do the growing since the plants are native to the south east. He will also make some slightly exaggerated speculations, like with the proper conditions the artifacts could grow without tending or skilled artificers and just require harvesting.<br /> <br /> So that it isn't obvious he is doing this for that reason he will want half ownership of all artifacts produced for house Ledaal, right of first refusal for Ledaal (we have the option to buy out their half when they want to sell before they sell to anyone else), and free access by approved Ledaal researchers to see that they are being grown properly and to do experimentation and study.<br /> <br /> Ideally, I want to open up a second route to Rathess and the heart of DK territory, but I don't know exactly where that is.","signature":"","edited":{"userid":1144,"user_link":"https://forum.theonyxpath.com/member/1144-exthalion","user":"Exthalion","date":". 02-05-2017, 01:51 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-05T13:13:08-08:00","id":1044149,"title":"","content":"&quot;Eventually&quot; is an awfully long time, given how fast things are moving. Do they really think that all the other houses are going to sit still and let them recover? Aisa will hazard a guess that Mnemon will make a move for the throne in within two years - do they really have time for distractions?<br /> <br /> &quot;You must feel the marshaling of forces. Great changes are afoot. Now's the time to leave aside pride, and gather your strength for the moment of maximum effort. I would prosper perfectly well under Mnemon's reign, but I think you have other plans - and if you can be pragmatic about what's needed to win, I think you'll find yourself surrounded by friends.&quot; Mysterious smile.<br /> <br /> Basically, she's going to push a bit harder in the face of reluctance (or even a flat &quot;no&quot;). Time to pull out the charm, lean on the reputation she's built, and stoke the flames of ambition.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-05T14:53:13-08:00","id":1044196,"title":"","content":"I'll respond after Eura decides what he wants to do in the North.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-05T18:11:09-08:00","id":1044306,"title":"","content":"I've been at a funeral for the past few days, I'll post in a bit since I just got back home.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-05T18:15:25-08:00","id":1044307,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044306#post1044306\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I've been at a funeral for the past few days, I'll post in a bit since I just got back home.</div> </div> </div> </div><br /> No worries. Real life comes first.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-05T19:20:11-08:00","id":1044324,"title":"","content":"Whelp, until the powder keg goes off I can't do the big battle scene. I think my public action will be convincing Roseblack to help liberate Amber River when the Political bullshit condonement happens. My initial PM will be set up for where all my pieces are. I'm hoping Roseblack helps because I don't have War.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-05T19:26:15-08:00","id":1044328,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044324#post1044324\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Whelp, until the powder keg goes off I can't do the big battle scene. I think my public action will be convincing Roseblack to help liberate Amber River when the Political bullshit condonement happens. My initial PM will be set up for where all my pieces are. I'm hoping Roseblack helps because I don't have War.</div> </div> </div> </div><br /> Did you want to set off the powder keg? Or just let things happen as they may?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-05T20:15:04-08:00","id":1044348,"title":"","content":"Preferably, but if you want to have it happen as a random complication go ahead.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-05T20:16:46-08:00","id":1044350,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044348#post1044348\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Preferably, but if you want to have it happen as a random complication go ahead.</div> </div> </div> </div><br /> I'd prefer if you set it off. I just need to know how, so I can tell you the fallout. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-05T20:22:26-08:00","id":1044351,"title":"","content":"I'll think of something tomorrow along with a more organized PM about the set up. I'd like to let Aisa do her negotiations first to lessen an already enormous Fallout.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-05T20:38:28-08:00","id":1044358,"title":"","content":"Ok.<br /> <br /> <a href=\"https://forum.theonyxpath.com/member/9510-bluewinds\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar9510_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"9510\" data-vbnamecard=\"9510\">BlueWinds</a> Roll Socialize or Presence (Diff 3) to see if the Elder Agree with the Assessment of the situation.<br /> <br /> <a href=\"https://forum.theonyxpath.com/member/1144-exthalion\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar1144_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"1144\" data-vbnamecard=\"1144\">Exthalion</a> The Cynis elder is skeptical about these &quot;artifact plants&quot;. As a farmer himself, it is almost too good to be true. He wants proof these plants will do what they say they do. Of course that is going to take time you don't have. Give me a Socialize (Diff 3) to convince the elder Akashan isn't trying to take advantage of him.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":".  I hit enter and it decides to post. Boo. 02-05-2017, 11:48 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-05T23:03:40-08:00","id":1044396,"title":"","content":"I do have samples of said plants... <br /> <a href=\"http://dice.brainclouds.net/Result.aspx?ID=4GXDXR3U\" target=\"_blank\">3 Successes</a><br /> <br /> I will include the stunt description in the letter.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-06T11:59:19-08:00","id":1044644,"title":"","content":"I'm... really tempted to channel Compassion on this roll. It's only one die, way worse than just spending the WP, but...<br /> Conviction it is. Aisa cares about the people of the Slave Coast, but compassion isn't what strengthens her voice.<br /> <br /> <a href=\"http://dice.brainclouds.net/Result.aspx?ID=2PDG3XFN\" target=\"_blank\">6 successes</a>.<br /> <br /> Have other people been adding stunts to their rolls? I haven't been claiming any stunt dice, which I assumed was intended for this format.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T13:05:37-08:00","id":1044684,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/9510-bluewinds\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar9510_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"9510\" data-vbnamecard=\"9510\">BlueWinds</a><br /> <br /> In the face of your conviction, the Tepet elder wants to make Aisa a counter offer. The Elder will agree to the trade if Aisa promises to speak for their House if Mnemon takes the throne. Because Aisa is right, things are moving quickly. And Tepet is in a precarious position. Right now, the Roseblack is the house's only hope and they will not betray their own. But if matters go badly in the North, they need this assurance. <br /> <br /> <b>What do you do?</b><br /> <br /> <a href=\"https://forum.theonyxpath.com/member/1144-exthalion\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar1144_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"1144\" data-vbnamecard=\"1144\">Exthalion</a><br /> <br /> The Cynis Elders seem impressed by your demonstration. But they wonder why you came to them. They don't have any available crop land in the Southeast right now. They do have some fields in fallow in the Lap, they can offer you.<br /> <br /> <b>What do you do?</b>","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-06-2017, 04:10 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T13:40:54-08:00","id":1044698,"title":"","content":"Aisa will do them one better - she'll speak for them <i>regardless</i> of who takes the throne. Surely they already know that she's dealing with V'Neef as well - it would be a shame if there were no room for anyone but the strong as the Realm moves forward.<br /> <br /> She too wants something more, in return for further promises on her part. Money. Two tenths of a percent (or some number) of the tribute payments.<br /> <br /> I don't have a good sense for how much money a typical tribute includes, but I assume a great deal - Aisa's asking for Resources 3, in a nutshell.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T13:48:31-08:00","id":1044703,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>BlueWinds</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044698#post1044698\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Aisa will do them one better - she'll speak for them <i>regardless</i> of who takes the throne. Surely they already know that she's dealing with V'Neef as well - it would be a shame if there were no room for anyone but the strong as the Realm moves forward.<br /> <br /> She too wants something more, in return for further promises on her part. Money. Two tenths of a percent (or some number) of the tribute payments.<br /> <br /> I don't have a good sense for how much money a typical tribute includes, but I assume a great deal - Aisa's asking for Resources 3, in a nutshell.</div> </div> </div> </div><br /> They aren't going to give you money out right, but they will cede some property in the North. You will have to manage it and it will be up to you to make a profit. Once they have an idea of what is available in the north, they will give you several options. <br /> <br /> (I am assuming this is the resources background you mentioned. We will play it as you'll need to build the property over the next few months.)","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T14:05:00-08:00","id":1044713,"title":"","content":"I came to them because I think the cooperation of wood aspects will be more useful than the actual location of the land. If we do use the land near the lap we will require an extensive irrigation program and likely some form of greenhouse system to maintain the proper humidity. The plants are as resilient as artifacts once they are mature but before then can be quite fragile.<br /> <br /> But, I am not trying to convince them. I am trying to plant the seed in their head that Aisa can use. Essentially a complicated aid another to her roll.<br /> <br /> However! I have charms that the Scroll of Errata made good.<br /> Starting with <a href=\"http://rathess.xi.co.nz/exalted/index.php/Charms:Thoughtful_Gift_Technique\" target=\"_blank\">Thoughful</a><a href=\"http://rathess.xi.co.nz/exalted/index.php/Charms:Thoughtful_Gift_Technique\" target=\"_blank\"> Gift Technique</a> to find out what would be the ideal gift to get this Elder on board with this plan.<br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">I don't know what the Elder's essence is. Given that Peleps Deled and the Roseblack are E4 and that most houses don't hold Artificers in much respect I suppose that might hint that this guy isn't a heavy hitter. That isn't a big deal though, more of a bonus.</div></div> </div> </div><br /> <br /> Ideally, the perfect gift will give me a bonus on my next roll which will consist of <a href=\"http://rathess.xi.co.nz/exalted/index.php/Charms:Finding_the_Water&#39;s_Depths\" target=\"_blank\">Finding the Water's Depths</a>. <br /> <br /> <br /> If possible, I will check with Ryo and Aiso before using either charm since UMI is horrible mind control. (How are we handling that by the way?)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-06T14:23:13-08:00","id":1044722,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044703#post1044703\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">They aren't going to give you money out right, but they will cede some property in the North. You will have to manage it and it will be up to you to make a profit. Once they have an idea of what is available in the north, they will give you several options.</div> </div> </div> </div>That is even better, and Aisa will readily consent, wishing she'd suggested that in the first place.<br /> <br /> Re: UMI, Aisa's response would be something like: (serious voice) &quot;As I teach to all my students: decide for yourself what prices you will pay for what rewards. Accepting consequences is a condition of exercising power.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T14:33:25-08:00","id":1044726,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>BlueWinds</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044722#post1044722\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> That is even better, and Aisa will readily consent, wishing she'd suggested that in the first place.<br /> <br /> Re: UMI, Aisa's response would be something like: (serious voice) &quot;As I teach to all my students: decide for yourself what prices you will pay for what rewards. Accepting consequences is a condition of exercising power.&quot;</div> </div> </div> </div><br /> Give me a Presence roll (Diff 3) before we finalize the Agreement. House Tepet is putting some serious faith in Aisa and she will need to show she is worthy of it.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T14:48:20-08:00","id":1044732,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044713#post1044713\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I came to them because I think the cooperation of wood aspects will be more useful than the actual location of the land. If we do use the land near the lap we will require an extensive irrigation program and likely some form of greenhouse system to maintain the proper humidity. The plants are as resilient as artifacts once they are mature but before then can be quite fragile.<br /> <br /> But, I am not trying to convince them. I am trying to plant the seed in their head that Aisa can use. Essentially a complicated aid another to her roll.</div> </div> </div> </div>Did you want to end the Cynis meeting here and have a second meeting after Aisa meets with the elders?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044713#post1044713\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">If possible, I will check with Ryo and Aiso before using either charm since UMI is horrible mind control. (How are we handling that by the way?)</div> </div> </div> </div>This is how I will run UMI: You can use it, but it is considered rude to do so. Especially with other Dragonblooded. If you get caught (ie, if the Exalted target decides to spend WP), it's a major breach of etiquette. Some prideful Dragonblooded may challenge you to a duel. Other more circumspect Dragonblooded will just take note and be more wary of your character.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T14:49:21-08:00","id":1044733,"title":"","content":"3 Manipulation + 3 Presence + 1 Family (Mnemon known, above all, for <i>competence</i>) = <a href=\"http://dice.brainclouds.net/Result.aspx?ID=XHG3XR7N\" target=\"_blank\">3 successes</a> (2 rolled, 1 from WP).<br /> <br /> That makes 4wp I've spent this season. Running kind of short, but it's all been totally worth it.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T14:56:25-08:00","id":1044736,"title":"","content":"Tepet Elder agrees to Aisa's proposal, with the added note that this agreement will depend on how Aisa's negotiations with Cynis go. <br /> <br /> Aisa will get a bonus die on a roll where she invokes Akashan's proposal.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T16:36:33-08:00","id":1044768,"title":"","content":"Ok, that's the Tepets! Partially in parallel (waiting until she confirms the meeting with Tepet, but before actually occurring), it's time to start setting up a meeting with Cynis! To Cynis Belar (MoEP: DB pg. 32):<div style=\"margin-left:40px\">The Slave Coast rebellion is can turn to profit rather than disaster. Are you willing to attempt the register of account rather than the iron boot?<br /> <br /> I have in my hand the keys to Hohenzon's ivory gates. Do not let the opium-daze of the North distract you from what is truly valuable.<br /> - Mnemon Aisa</div> <br /> She's going to offer Cynis the same deal as Tepet agreed to - give up the Slave Coast, and Tepet will transfer control of Hohenzon to their forces. Aisa's fee and interest in mediating this will be one of the Hohenzon's wood lots, famed for their fast-growing Ash trees. One of her big points is that Tepet is desperate, making them dangerous - better to profit from a sure exchange (unequal in their favor!) than risk the irrationality of a desperate house.<br /> <br /> Aisa's willing to give up the land, or accept a smaller fee of some other sort, but opening with it gives her more room to be negotiated down without having to chip in further resources or promises of her own.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T17:03:19-08:00","id":1044776,"title":"","content":"Cynis Belar agrees to meet with Aisa.<br /> <br /> But instead of negotiating with her, she accuses Aisa of playing bureaucratic games with her Legions. She is not pleased that some young upstart is sticking her nose into Cynis business. She idly wonders if Aisa's grandmother knows what Aisa is up to.<br /> <br /> <b>What do you do?</b>","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-06-2017, 08:06 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T17:42:11-08:00","id":1044785,"title":"","content":"&quot;What. If you want to look for traitors in your midst, I suggest you begin searching for Golden Cranes, rather than pointing fingers at me. They've been on the northern coasts recently.&quot;<br /> <br /> &quot;I have not a single agent in House Cynis, though perhaps I shall have to develop some sources if you wish to treat me as an enemy.&quot; (intentional misinterpretation of the accusation, as though she doesn't know exactly what's being referred to)<br /> <br /> Mnemon is dismissed with an offhanded wave. &quot;Of course Grandmother knows. 'Making friends in other houses,' she called it.&quot; Aisa purses her lips in annoyance, the very picture of innocence wronged. &quot;Though I might not have bothered if I'd known there'd be accusations rather than gratitude.&quot;<br /> <br /> (this is also why she chose Cynis Belar - as another sorceress, she at least knows about the existence of sidereals, even if she doesn't associate golden cranes with them immediately)","signature":"","edited":{"userid":9510,"user_link":"https://forum.theonyxpath.com/member/9510-bluewinds","user":"BlueWinds","date":". 02-06-2017, 08:45 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T18:25:47-08:00","id":1044803,"title":"","content":"Give me a Socialize (Diff 4) for your misdirection.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T18:52:06-08:00","id":1044813,"title":"","content":"<a href=\"http://dice.brainclouds.net/Result.aspx?ID=XX9UUWGA\" target=\"_blank\">5 successes</a>. 5wp spent this season.<br /> <br /> Do virtue channels refresh seasonally as well? Should ask that aloud rather than assuming.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T18:59:05-08:00","id":1044815,"title":"","content":"Yes, Virtues refresh Seasonally. <br /> <br /> Are you outright lying about Mnemon knowing you are here?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-06-2017, 10:05 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T20:10:23-08:00","id":1044846,"title":"","content":"Yes, that part is also a lie! Aisa does intend to fill Mnemon in soon - preferably after she's made the agreement, along the lines of &quot;hey, look at all this land I just got, want 15% of the money, 'cause House Mnemon is awesome?&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T20:15:11-08:00","id":1044848,"title":"","content":"&quot;Oh, my dear little Aisa. Run along back to your grandmother and ask her what she thinks of your little deal before you come back to me.&quot;<br /> <br /> ((Hmmm.... Maybe Mnemon has her own plans with the North.))<br /> <br /> ((This is actually a good outcome. Cynis Belar was using Falsehood Unearthing Attitude on Aisa. For reasons that will become clear when you talk to Mnemon))","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-06-2017, 11:25 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T20:40:29-08:00","id":1044863,"title":"","content":"This sounds like a good time for the powder keg to go off c:&lt;<br /> <br /> It's gonna start off with slave citizens forming a rather large protest in front of *strategic point*. Tensions rise, something is thrown at a guard, guards try to arrest the offender and all hell breaks loose. The battle of Amber River begins. I'm assuming everyone has done mostly what they want with Amber River being peaceful. Wind carried words may hold blurbs of what's happening depending on your guy's intelligence network.<br /> <br /> <b>Details of the battle will be through my Pm adventures and will be disclosed through the letter</b>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-06T20:42:53-08:00","id":1044866,"title":"","content":"Haha, ouch. Aisa got got good there. I assume the elder has E5, so that clause is no protection. (everything other than the bit about Mnemon knowing was an evasion or half-truth)<br /> <br /> She'll blush at being called 'dear little Aisa', and also a bit at being caught out in a lie. &quot;I shall. Would you like some tea?&quot; After a minute to collect herself and serve tea, &quot;I don't suppose you would like to share with me what Grandmother is thinking? I am afraid we're not as close as we used to be, as you've just seen demonstrated.&quot;<br /> <br /> She won't press if Belar declines, but putting it out there in case the elder feels like taking pity or has something of her own to share.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T20:51:26-08:00","id":1044869,"title":"","content":"She sighs. &quot;It is not for me to say, though I was worried you were sent to test my resolve. Your plan is a good one, though I am curious on how you managed to convince Tepet to give up Hohenzon...&quot; She seems almost tempted by the offer. &quot;No, I have put my trust in your grandmother. You must discuss this with her before coming back to me.&quot;","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T20:55:31-08:00","id":1044871,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044863#post1044863\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">This sounds like a good time for the powder keg to go off c:&lt;<br /> <br /> It's gonna start off with slave citizens forming a rather large protest in front of *strategic point*. Tensions rise, something is thrown at a guard, guards try to arrest the offender and all hell breaks loose. The battle of Amber River begins. I'm assuming everyone has done mostly what they want with Amber River being peaceful. Wind carried words may hold blurbs of what's happening depending on your guy's intelligence network.<br /> <br /> <b>Details of the battle will be through my Pm adventures and will be disclosed through the letter</b></div> </div> </div> </div><br /> <br /> Just to be clear: <br /> <br /> Rebels are rebelling against Cynis.<br /> <br /> Roseblack is pushing back whatever forces Cynis has managed to get to the North.<br /> <br /> The Magisterial Legion is doing what again?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T21:20:32-08:00","id":1044876,"title":"","content":"Oh shit, I forgot they exist.<br /> <br /> Ummm, I'm technically part of the magisters I just didn't know they had their own legion. Would we count them as delayed by our solar's charms? I'm not sure how they would act in a situation like this because Ejava is doing what they would. I guess social fu them to help but be in the backlines if they aren't delayed since I don't think they'd approve of my twists.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-06T21:52:44-08:00","id":1044893,"title":"","content":"Oh shit, are we doing this <i>now</i> now?<br /> <br /> Magisterial Legion is Carmela's baby, an actually-fairly-heavily-veiled excuse to have troops on the Blessed Isle. I can probably mobilize Contarini/Iselsi ships enough to get them to you (we are the closest to each other, geographically), but Carmela's not actually in charge (she is merely its commander). Without Aisa's deal in place, you'd need some extensive social-fu (stories of the Cynis responding to magisterial orders with stabbing?) to not have them side with the Cynis.<br /> <br /> Although, did you get the care package I sent? A scale of elite soldiers should help a little.","signature":"","edited":{"userid":2144,"user_link":"https://forum.theonyxpath.com/member/2144-guancyto","user":"Guancyto","date":". 02-07-2017, 12:54 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2144-guancyto","name":"Guancyto","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2144_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"699"}]},"thankedby":[]},{"date":"2017-02-06T21:59:42-08:00","id":1044898,"title":"","content":"Aisa will be sending a letter to Mnemon soon after her Cynis meeting.<div style=\"margin-left:40px\">Dear Grandmother,<br /> <br /> I seem to have made something of a fool of myself with Cynis Belar, working orthogonal to your purposes. I had hoped to present you House Tepet steeply in my debt and new lands in the North for House Mnemon to hold, but instead find my plans brought up short lest they interfere with yours.<br /> <br /> May I know what you intend with the Slave Coast and with House Cynis, that I do not stub my toes against your will again?</div>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T22:00:10-08:00","id":1044899,"title":"","content":"Well... we can have the rebellion go on for a while before the Roseblack and everyone steps in. And by a while, I mean &quot;we deal with it in next month's letters.&quot;","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-06T22:17:55-08:00","id":1044906,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044815#post1044815\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Yes, Virtues refresh Seasonally.<br /> <br /> Are you outright lying about Mnemon knowing you are here?</div> </div> </div> </div>More like paltering. Belar did not specify what of Aisa's doing Mnemnon is aware of. So Aisa spoke entirely honestly when she said Mnemnon knew that she was &quot;making friends in other houses&quot; since this conversation/negotiation could be characterized that way.<br /> <br /> People tend to hate this sort of thing more than outright lying.","signature":"","edited":{"userid":1144,"user_link":"https://forum.theonyxpath.com/member/1144-exthalion","user":"Exthalion","date":". 02-07-2017, 01:20 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-06T22:25:42-08:00","id":1044908,"title":"","content":"I think the charm works more on intention - and in this, Aisa's intention was a flat out untruth. Everything else was an evasion, diversion or technically true, but not the bit about Mnemon knowing what Aisa's up to. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-06T22:51:45-08:00","id":1044928,"title":"","content":"I'm going to bed now. Because I need to go to bed instead of talking to all of you lovely people. I'll reply to all of your crazy schemes tomorrow. <br /> <br /> Night all.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T08:23:16-08:00","id":1045075,"title":"","content":"So we need to talk about the timeline here and what place the Magisterial Legions have in the Rebellion.<br /> <br /> 1. First, we need to decide when the rebellion kicks of in comparison to Aisa's negotiations. My first thought was to have the news of the Rebellion come to the Blessed Isle just as Aisa is told to talk to her Grandmother. Pile all the bad news on poor Aisa all at once. <br /> <br /> 2. Are the Magisterial Legions going to come in play this month or next?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T08:41:27-08:00","id":1045091,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1045075#post1045075\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So we need to talk about the timeline here and what place the Magisterial Legions have in the Rebellion.<br /> <br /> 1. First, we need to decide when the rebellion kicks of in comparison to Aisa's negotiations. My first thought was to have the news of the Rebellion come to the Blessed Isle just as Aisa is told to talk to her Grandmother. Pile all the bad news on poor Aisa all at once.<br /> <br /> 2. Are the Magisterial Legions going to come in play this month or next?</div> </div> </div> </div>All the bad news at once, sure!<br /> <br /> Aisa's original intention had been to ask Carmela to move north after securing the satrapy for Tepet, as a stabilizing and peacekeeping force, but that sort of went out the window when Tepet decided it really, really, really wanted to do the fighting themselves. What they actually do is of course up Guancito - just wanted to mention that there's no requests / advice from Aisa in that regard.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T08:45:08-08:00","id":1045095,"title":"","content":"((I really need to have Ryo buy Wind Carried Words and scare the shit out of Aisa the first time he uses it.))<br /> <br /> So, no Magisterial Legions for right now.<br /> <br /> Let me collect my thoughts and give you a response to Mnemon's letter and all the other things.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T10:48:02-08:00","id":1045219,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>BlueWinds</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044898#post1044898\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Aisa will be sending a letter to Mnemon soon after her Cynis meeting.<div style=\"margin-left:40px\">Dear Grandmother,<br /> <br /> I seem to have made something of a fool of myself with Cynis Belar, working orthogonal to your purposes. I had hoped to present you House Tepet steeply in my debt and new lands in the North for House Mnemon to hold, but instead find my plans brought up short lest they interfere with yours.<br /> <br /> May I know what you intend with the Slave Coast and with House Cynis, that I do not stub my toes against your will again?</div></div> </div> </div> </div><br /> Mnemon sends the following:<br /> <div style=\"margin-left:40px\"><br /> Aisa,<br /> <br /> Tell me the details of your plan. Perhaps we can come to an agreement to the advantage of all.<br /> <br /> Mnemon<br /> </div><br /> ((I want to know how Aisa will spin this. ))<br /> <br /> Also, you get news that the North is in rebellion and Tepet Ejava has invaded Amber River. <br /> <br />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T11:23:23-08:00","id":1045239,"title":"","content":"The spin is &quot;keeping the Realm strong and delaying the inevitable.&quot;<br /> <div style=\"margin-left:40px\">Honored Grandmother,<br /> <br /> I am sure I bring you no new information when I say that the rebellion in the North has powerful backers. Let us call them nothing more than Golden Cranes in an open letter. Knowing this, I sought a way to keep the Realm strong and undistracted at this critical time. My sources say that the root of this rebellion is the horrific drug-addled policies of house Cynis. As it is, the violence will spiral out of control - but if that impetus is removed, the majority of rebels will lay down their arms. There will be nothing for the Cranes to work with.<br /> <br /> With that out of the way, my plan itself was rather simple. Tepet and Cynis were to exchange control of the Slave Coast and Hohenzon. Tepet can concede the rebel's demands without loss of face, and win back some of their dignity by crushing the remaining forces. Cynis can move troops south to take control of Hohenzon before it breaks from the Realm's orbit entirely. I am sure you can work out yourself the advantages to our house of having Tepet believe I am on their side, so I shall not trouble to list them.<br /> <br /> Perhaps violence is inevitable - the current state of affairs grows less stable by the day - but I hope the necessary maneuvering to strengthen your position does not weaken the Realm as a whole. &quot;Power through knowledge, mastery through rigor, and conquest through diligence.\u201d I believe there is more we can gain in the ballroom before resorting to the battle field.<br /> <br /> - Mnemon Aisa</div>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T11:24:45-08:00","id":1045240,"title":"","content":"Give me Linguistics (Diff 3) for your letter.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T11:37:27-08:00","id":1045252,"title":"","content":"Manip + Ling = 6 dice = <a href=\"http://dice.brainclouds.net/Result.aspx?ID=GBVUVK96\" target=\"_blank\">5 successes</a>.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T11:56:11-08:00","id":1045266,"title":"","content":"Mnemon writes back.<br /> <br /> &quot;Your plan has merit. I will negotiate with Cynis to see it enacted.&quot;<br /> \u200b<br /> <b>What do you do</b>?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T13:23:35-08:00","id":1045339,"title":"","content":"Aisa will switch to Wind Carried Words, given the urgency of the situation and the fact that they're past the point of pretty words and careful explanations.<br /> <div style=\"margin-left:40px\">House Tepet was barely willing to trust me,and will probably back out if you become overtly involved. At the very least I shall have to renegotiate and give up some advantages.<br /> <br /> Please allow me to finish what I've begun.</div>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T13:24:52-08:00","id":1045342,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>BlueWinds</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1045339#post1045339\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Aisa will switch to Wind Carried Words, given the urgency of the situation and the fact that they're past the point of pretty words and careful explanations.<br /> <div style=\"margin-left:40px\">House Tepet was barely willing to trust me,and will probably back out if you become overtly involved. At the very least I shall have to renegotiate and give up some advantages.<br /> <br /> Please allow me to finish what I've begun.</div></div> </div> </div> </div><br /> Give me Presence (Diff 4) to see if you can prove to your Grandmother you can handle the negotiate.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T13:50:00-08:00","id":1045356,"title":"","content":"Whew, thank you sidereal astrology. <a href=\"http://dice.brainclouds.net/Result.aspx?ID=HFB4X6AE\" target=\"_blank\">5 successes</a>. 6wp spent, and Aisa's last conviction channel for the season.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T13:56:37-08:00","id":1045363,"title":"","content":"I have a hearthstone Aisa might like to borrow at some point. It allows you to regain 1 more WP per day.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-07T13:59:34-08:00","id":1045367,"title":"","content":"The wind carries Mnemon's words back to you.<br /> <br /> &quot;House Cynis knows you speak with my voice. The North is already in rebellion and Tepet Ejava has already engaged on the side of the rebels. Bring peace between the houses of Cynis and Tepet, granddaughter.&quot;","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T14:05:44-08:00","id":1045371,"title":"","content":"((Who is near the closest Yu-Shan Gate?))<br /> <br /> (It's either Carmela or Akashan. Akashan travels around a lot so, I'll say Carmela right now).","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-07-2017, 05:09 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T14:23:43-08:00","id":1045383,"title":"","content":"I think there's one in the Imperial City? That would make Akashan or Ryu the closest.<br /> <br /> Aisa will send Ai'Zul (air elemental) as a messenger to Cynis Belar, hopefully swifter than a letter in the post given that she's probably sailing by ship. &quot;My mistress apologizes for the confusion before. They have spoken, and Mnemon has charged Aisa to end the chaos in the North before any more blood is shed. Are you willing to return and speak to her again?&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T14:27:43-08:00","id":1045387,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>BlueWinds</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1045383#post1045383\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I think there's one in the Imperial City? That would make Akashan or Ryu the closest.<br /> <br /> Aisa will send Ai'Zul (air elemental) as a messenger to Cynis Belar, hopefully swifter than a letter in the post given that she's probably sailing by ship. &quot;My mistress apologizes for the confusion before. They have spoken, and Mnemon has charged Aisa to end the chaos in the North before any more blood is shed. Are you willing to return and speak to her again?&quot;</div> </div> </div> </div><br /> Cynis Belar agrees to meet again. <br /> <br /> (Ryo doesn't have Wind Carried words... yet. Is Akashan in the Imperial City and does he have Wind Carried Words? ) <br /> <br /> (If Titus didn't have someone dispell the Air Elemental Aisa gave him, he wouldn't be having this problem. )","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T14:34:36-08:00","id":1045397,"title":"","content":"Titus and Ryo figured out a solution.<br /> <br /> ((This may backfire on me as an ST, but let's see what happens!))","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-07-2017, 06:05 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T14:41:20-08:00","id":1045400,"title":"","content":"Here is a map of the gates:<br /> <div class=\"b-bbcode b-bbcode__url b-bbcode__url--preview\"> <a href=\"http://hd42.de/images/exalted/Creation_Map_v7.1c.jpg\" target=\"_blank\" class=\"urlimg_container\"> <img class=\"js-img-fallback\" src=\"https://forum.theonyxpath.com/core/images/default/google-material/image_placeholder.svg\"> </a> <div class=\"urlinfo\"> <div class=\"title ellipsis\"> <a href=\"http://hd42.de/images/exalted/Creation_Map_v7.1c.jpg\" target=\"_blank\"> </a> </div> <div class=\"url ellipsis\"> <a href=\"http://hd42.de/images/exalted/Creation_Map_v7.1c.jpg\" target=\"_blank\"> http://hd42.de/images/exalted/Creation_Map_v7.1c.jpg </a> </div> <div class=\"meta\"> </div> </div> </div><br /> <br /> I believe the Gate in the Imperial City is in the Imperial Manse.<br /> <br /> Edit: Akashan does not know Wind Carried Words.","signature":"","edited":{"userid":1144,"user_link":"https://forum.theonyxpath.com/member/1144-exthalion","user":"Exthalion","date":". 02-07-2017, 05:43 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-07T14:43:28-08:00","id":1045401,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1045400#post1045400\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Here is a map of the gates:<br /> <div class=\"b-bbcode b-bbcode__url b-bbcode__url--preview\"> <a href=\"http://hd42.de/images/exalted/Creation_Map_v7.1c.jpg\" target=\"_blank\" class=\"urlimg_container\"> <img class=\"js-img-fallback\" src=\"https://forum.theonyxpath.com/core/images/default/google-material/image_placeholder.svg\"> </a> <div class=\"urlinfo\"> <div class=\"title ellipsis\"> <a href=\"http://hd42.de/images/exalted/Creation_Map_v7.1c.jpg\" target=\"_blank\"> </a> </div> <div class=\"url ellipsis\"> <a href=\"http://hd42.de/images/exalted/Creation_Map_v7.1c.jpg\" target=\"_blank\"> http://hd42.de/images/exalted/Creation_Map_v7.1c.jpg </a> </div> <div class=\"meta\"> </div> </div> </div><br /> <br /> I believe the Gate in the Imperial City is in the Imperial Manse.</div> </div> </div> </div><br /> I looked at the map I made so long ago I forgot about it. :P","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T14:47:19-08:00","id":1045404,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1045400#post1045400\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Edit: Akashan does not know Wind Carried Words.</div> </div> </div> </div>Ryo didn't know that at the time. <br />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T15:03:30-08:00","id":1045411,"title":"","content":"Aisa's going to offer Belar the same thing she's been explaining to everyone. Her tone is somewhat wearier - and warier - than at the last meeting. Slave Coast &lt;--&gt; Hohenzon and a truce with Tepet. Aisa wants one of the forestry lots in the south for her fee in mediating the exchange, but is willing to be bargained down from that if necessary.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T15:43:39-08:00","id":1045437,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1045404#post1045404\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Ryo didn't know that at the time.</div> </div> </div> </div>He does however have cousins. So many sorcerer cousins...<br /> <br /> He will agree to do a favor later for one of them who knows Infallible Messenger and will send it to Aisa for him. If they ask, its a shogunate piece that is in need of a lot of repair.<br /> <br /> &quot;Written Receipt: Scenic Cameo suitable for a lady of white glamor, missing candles on the untrue side.&quot;<br /> <br /> In the conspiracy cypher: &quot;Don't allow Cynis to leave the North. Mnemnon poised to sail and crush Roseblack. More soon.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-07T16:25:02-08:00","id":1045462,"title":"","content":"Well <i>that </i>changes Aisa's plans for meeting with Cynis. And forces her hand. She'd like to have time to consult with the rest of the conspiracy - and especially, she'd like to know &quot;more soon,&quot; but events are running out of control.<div style=\"margin-left:40px\">&quot;I have just learned the full details of Mnemon's plan for the North, and I am tired of daggers in the dark. I had hoped to remain silent for longer, but I cannot sit idly by while my reputation is used as bait to destroy a great house.<br /> <br /> Great Aunt Cynis Belar, it's time I ask a dangerous question. I place my life in your hands.&quot; Aisa folds her hands in her lap and puts on a disciplined, serious expression, almost as though setting aside the friendly mask she usually wears. &quot;Do you want Mnemon on the throne, or are you cooperating with her because you feel there's no other choice?&quot; She manages a smile.</div>","signature":"","edited":{"userid":9510,"user_link":"https://forum.theonyxpath.com/member/9510-bluewinds","user":"BlueWinds","date":".  Typo 02-07-2017, 07:49 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T16:26:31-08:00","id":1045465,"title":"","content":"<img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /> Presence (Diff 4) please","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T16:45:51-08:00","id":1045486,"title":"","content":"Manip + Pres + Specialty = <a href=\"http://dice.brainclouds.net/Result.aspx?ID=LGL66XPQ\" target=\"_blank\">3 successes</a>.<br /> <br /> Nope. Well, I was bound to fail one eventually. Can't spend WP on everything!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T16:50:45-08:00","id":1045490,"title":"","content":"&quot;My dear, if you are pulling for the Roseblack, you are less intelligent than I gave you credit for. I know she is young and charismatic, but Tepet Ejava has that and nothing more. House Tepet is dying. Mnemon will take her mother's throne.&quot; Cynis Belar lectures. &quot;It would be good of you to support your family, instead of scheming behind your grandmother's back.&quot;<br /> <br /> &quot;Now, are you still willing to bargain the trade of territories?&quot;","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T17:07:25-08:00","id":1045501,"title":"","content":"&quot;I am not backing the Roseblack. You are correct, that is fool's cause. House Tepet has no chance at the throne. If you wish to dismiss me as a child, there is little I can do about that - but if you are willing to bear Corrupted Words, I will tell you a thing I known to only six others in all of Creation.&quot;<br /> <br /> Aisa sighs.<br /> <br /> &quot;But yes, I am still willing to negotiate the trade of territories if that is all you wish to discuss.&quot;","signature":"","edited":{"userid":9510,"user_link":"https://forum.theonyxpath.com/member/9510-bluewinds","user":"BlueWinds","date":". 02-07-2017, 08:10 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T17:45:45-08:00","id":1045523,"title":"","content":"&quot;What is this thing?&quot;","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-07T18:08:42-08:00","id":1045534,"title":"","content":"((Just to be clear - Aisa's sharing of the secret is conditional on Cynis accepting the spell first - she won't say a peep on the subject until after it's cast. Is that what you meant her to agree to? Thus why I've stopped here.))<br /> <br /> Aisa snaps her fingers. &quot;Jal'Kaith, go find V'Neef Iphen and bring him here immediately. It is more important than anything else he is doing.&quot;<br /> <br /> An earth elemental materializes, gives Cynis a good bodyguard stare as though to say 'don't mess with my ward,' and leaves. While they're waiting, Aisa will make tea for her guest - it's a thing she does - and Wind-Carried-Words a whisper to Iphen. &quot;Please please please play along without complaint. I will trust you with a secret known to neither V'Neef nor Mnemon, if this gamble doesn't ruin me.&quot;<br /> <br /> He returns a few minutes later with the sleepy wood aspect in tow. He had a late night last night, and is rubbing his eyes.<br /> <br /> &quot;V'Neef Iphen, thank you. If you would cast Corrupted Words upon Cynis Belar here, with the target of 'the secret Mnemon Aisa is about to share?'&quot; After he's done so, she gestures him back out of the room. Jal'Kaith steps out as well.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-07T18:20:43-08:00","id":1045543,"title":"","content":"She agrees to the spell. You get the feeling you trigger her curiosity.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-08T10:06:12-08:00","id":1045840,"title":"","content":"&quot;Please see to your charms, that you may know that what I say is the complete truth.&quot; Aisa takes a deep breath. &quot;I intend to be Empress.&quot;<br /> <br /> &quot;More than one Great House has aligned itself with me. More than one legion moves as I direct. I have power bases both on the Blessed Isle and in the Threshold, inside the Dynasty and out. I have good reason to believe Cathak Cainan will back me once I ask. The Sidereals are watching me carefully, and some of them are being swayed to my side.<br /> <br /> I tell you all this not to boast, but merely so you understand that my claim is not the empty hopes of a child. The Roseblack is <i>my </i>piece, and I will not sacrifice her just yet. While I would prefer to avoid violence, I am perfectly capable of responding to Mnemon with force of arms if I cannot resolve things here and now.&quot;","signature":"","edited":{"userid":9510,"user_link":"https://forum.theonyxpath.com/member/9510-bluewinds","user":"BlueWinds","date":". 02-08-2017, 01:10 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-08T10:10:29-08:00","id":1045842,"title":"","content":"<img src=\"https://forum.theonyxpath.com/core/images/smilies/eek.png\" border=\"0\" alt=\"\" title=\"EEK!\" smilieid=\"9\" class=\"inlineimg\" /><br /> <br /> Presence (Diff 4)","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-08T10:34:26-08:00","id":1045853,"title":"","content":"I'm going to invoke the bonus die from Akashan here, on the assumption that Belar is smart enough to make the connection for herself.<br /> <br /> <a href=\"http://dice.brainclouds.net/Result.aspx?ID=WAEEFXRK\" target=\"_blank\">7 successes</a>. Last point of WP spent! Aisa's getting <i>real </i>exhausted this month, running herself ragged and stressed.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-08T10:50:19-08:00","id":1045862,"title":"","content":"Belar laughs. &quot;You are a Wyld Child. Was it you who sent that Ledaal crafter to my nephew to discuss growing rare crops in the South West?&quot; <br /> <br /> Belar grows serious. &quot;You are wise to hide behind Mnemon's silks, but you must stand on your own soon. She plans on taking credit for your Northern negotiations. She told me - yes, she did talk to me after promising to leave this matter to you- you were working under her directive.&quot; <br /> <br /> &quot;Let us say, I promise the support of my house? What will you give us? &quot; Belar lists off a list of economic incentives Mnemon promised when she ascends to the throne. Some include relaxed Slave Regulations. &quot;I have little love for your grandmother, but I can not sell my house's support based on personal preference. Get with your advisors and write up an economic proposal for us to go over the next time we meet.&quot;<br /> <br /> &quot;Your original plan to have my house leave the North will not suit your needs. And I do not wish to come in direct conflict with Mnemon, though I assume that time is coming. Especially if you say you are building up military support. &quot; <br /> <br /> &quot;What will have of my house now? &quot;","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-08T11:13:47-08:00","id":1045871,"title":"","content":"Aisa nods seriously. &quot;I will. I can already tell you my offer will be more generous in the Threshold. I have no love lost for the Guild, nor any intention of courting their support. Less for them means more for you.&quot;<br /> <br /> &quot;For now, though, my request is merely that your forces remain in the north, and you continue your plans to deploy further troops there. Make the trade originally offered with house Tepet, but they will pay you for 'assistance in securing our northern borders' until Mnemon's forces return to the Blessed Isle. You need not actively support the Roseblack, merely make threatening motions suggesting you're ready to destroy the weakened survivors of any confrontation.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-08T11:28:12-08:00","id":1045877,"title":"","content":"&quot;I will work with House Tepet about the security arrangements.&quot; She smiles. &quot;With our House's new found reputation for slow troop movements, we have a convenient excuse to stick around until Mnemon's forces leave.&quot; <br /> <br /> Belar stands up. &quot;I will be following your career closely, Aisa.&quot; She says as she leaves.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-08T12:19:54-08:00","id":1045903,"title":"","content":"Ok! Anything else that needs to be done here, other than for Aisa to contact the Tepet elder she spoke with and inform them about Mnemon's plan and Cynis' offer of assistance?<br /> <br /> Also, you keep mentioning Ryu buying Wind Carried Words. That would indeed scare the hell out of Aisa, since he's a Solar and she didn't think they could do that.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-08T12:27:31-08:00","id":1045909,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>BlueWinds</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1045903#post1045903\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Also, you keep mentioning Ryu buying Wind Carried Words. That would indeed scare the hell out of Aisa, since he's a Solar and she didn't think they could do that.</div> </div> </div> </div>Ryo didn't think he could either. Titus will enlighten him. <br /> <br /> <br /> I just need to finish up the battle with Eura and have Exthalion finish his deal with Cynis.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-08T14:45:31-08:00","id":1046008,"title":"","content":"Also, we will deal with Mnemon's fleet in the Season of Wood.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-08T17:25:52-08:00","id":1046079,"title":"","content":"I suggest telling the Court of Storms that they are harboring water elemental rebels. Let Chief Storms-As-He-Walks settle things.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-09T06:19:30-08:00","id":1046278,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1044713#post1044713\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I came to them because I think the cooperation of wood aspects will be more useful than the actual location of the land. If we do use the land near the lap we will require an extensive irrigation program and likely some form of greenhouse system to maintain the proper humidity. The plants are as resilient as artifacts once they are mature but before then can be quite fragile.<br /> <br /> But, I am not trying to convince them. I am trying to plant the seed in their head that Aisa can use. Essentially a complicated aid another to her roll.<br /> <br /> However! I have charms that the Scroll of Errata made good.<br /> Starting with <a href=\"http://rathess.xi.co.nz/exalted/index.php/Charms:Thoughtful_Gift_Technique\" target=\"_blank\">Thoughful</a><a href=\"http://rathess.xi.co.nz/exalted/index.php/Charms:Thoughtful_Gift_Technique\" target=\"_blank\"> Gift Technique</a> to find out what would be the ideal gift to get this Elder on board with this plan.<br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">I don't know what the Elder's essence is. Given that Peleps Deled and the Roseblack are E4 and that most houses don't hold Artificers in much respect I suppose that might hint that this guy isn't a heavy hitter. That isn't a big deal though, more of a bonus.</div></div> </div> </div><br /> <br /> Ideally, the perfect gift will give me a bonus on my next roll which will consist of <a href=\"http://rathess.xi.co.nz/exalted/index.php/Charms:Finding_the_Water&#39;s_Depths\" target=\"_blank\">Finding the Water's Depths</a>.<br /> <br /> <br /> If possible, I will check with Ryo and Aiso before using either charm since UMI is horrible mind control. (How are we handling that by the way?)</div> </div> </div> </div><br /> Did you want to change anything here, Exthalion?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-09T18:56:40-08:00","id":1046579,"title":"","content":"Still going to ask Ryo, when he calms down, for his charm backed bureaucratic advice. For example, can I even trust Cynis to keep to this deal once they realize the full scope of what is possible?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-09T21:12:35-08:00","id":1046616,"title":"","content":"Ryo says Cynis will keep to the letter of the deal. However, they will attempt to cut House Ledaal out of the Artifact Production. Their Sorcerers will be investigating your artifacts to see if they can reverse engineer them.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-09T23:26:29-08:00","id":1046654,"title":"","content":"Does he think he can throw a zillion successes at the roll to craft an airtight contract? <br /> I am not overly worried about them rediscovering the technique ooc, since it would require Craft (genesis) which also has medicine requirements or Dragon Kings with the Growing Wood path. The first would probably have to be reinvented while I intend to scoop up the second.<br /> <br /> Ideally, the contract will require Ledaal assistance on any research such that if they do figure it out they wont be able to act on it without us.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-10T06:37:24-08:00","id":1046747,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1046654#post1046654\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Does he think he can throw a zillion successes at the roll to craft an airtight contract?<br /> I am not overly worried about them rediscovering the technique ooc, since it would require Craft (genesis) which also has medicine requirements or Dragon Kings with the Growing Wood path. The first would probably have to be reinvented while I intend to scoop up the second.<br /> <br /> Ideally, the contract will require Ledaal assistance on any research such that if they do figure it out they wont be able to act on it without us.</div> </div> </div> </div><br /> Let's see.<br /> <br /> By a zillion do you mean.... <a href=\"http://dice.brainclouds.net/Result.aspx?ID=MLN9QKC3\" target=\"_blank\">six</a>?<br /> <br /> ((Seriously, Ryo why do you only roll crazy high on not important rolls?!?))<br /> <br /> Anyways, according to the difficulty table, this would be an airtight contract. <br />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":3950,"user_link":"https://forum.theonyxpath.com/member/3950-wonderandawe","user":"wonderandawe","date":". 02-10-2017, 11:08 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-11T10:32:49-08:00","id":1047304,"title":"","content":"I just found a pretty cool High Realm generator: <a href=\"http://rpg.divnull.com/exalted/script.html\" target=\"_blank\">http://rpg.divnull.com/exalted/script.html</a><br /> <br /> <img src=\"http://threewestwinds.com/MnemonAisaSignatureSmall.png\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/><br /> -- Mnemon Aisa","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-14T05:20:35-08:00","id":1048684,"title":"","content":"I didn't have much to talk about since the majority of last week was the siege itself. It was fun to have DB craft and War charms create crazy solutions to crazy problems caused by the same charm tree's.<br /> <br /> Also how'd you get the letters to mush together, the name generator spreads out all the syllables for me.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-14T06:09:04-08:00","id":1048707,"title":"","content":"Quelaana's letter: Hey, Guys, I didn't die! What did I miss while I was doing the messy part of this plan? <br /> <br /> ((Really I need to even out my attention between players. I had too many schemes to run with the NPCs, I feel like I didn't give Eura's character a fair run at the rebellion.))","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-14T07:37:37-08:00","id":1048741,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1048684#post1048684\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I didn't have much to talk about since the majority of last week was the siege itself. It was fun to have DB craft and War charms create crazy solutions to crazy problems caused by the same charm tree's.<br /> <br /> Also how'd you get the letters to mush together, the name generator spreads out all the syllables for me.</div> </div> </div> </div>GIMP. I took the individual letters, added and arranged them, then used the pen to connect them nicely.<br /> <br /> Also, I only now realized that Aisa was so focused on her own dealings that she didn't clearly explain things that other characters would need to know. It's a blind spot! She's gotten used to dealing with people who have already heard the gross facts due to their own information networks (eg. &quot;Cynis has passed control of the northern territories to House Tepet in return for a Satrapy to the south east. They'll stay for a while, but don't worry, they're now on your/our side.&quot;).<br /> <br /> Edit: I'd love to hear more about the tactics and counter-tactics, if you wanted to expand your letter with details. Sounds interesting. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"","edited":{"userid":9510,"user_link":"https://forum.theonyxpath.com/member/9510-bluewinds","user":"BlueWinds","date":". 02-14-2017, 10:44 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-14T07:49:57-08:00","id":1048748,"title":"","content":"Aisa needs to realize that the Conspiracy is the Information Network for some characters. :P","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-14T09:00:51-08:00","id":1048769,"title":"","content":"Indeed! She could also use a reminder that there are people who don't belong to the obvious power structures (Great Houses, Immaculate Order, Legions, Thousand Scales...) who it might be wise to pay attention to. Dynastic blind spot.<br /> <br /> I was already planning on a supplemental letter later in the week, hopefully after more people have posted. She'll include a clear and concise description of events in there.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-14T20:55:44-08:00","id":1049123,"title":"","content":"I'll be lazy and post one of the cool things here. Amber river had deep pits and high walls created by DB shenanigans, so Roseblack ordered her subordinates to use shaping hand style to collapse buildings on top of the obstacles to create ramps for the pits and knock down the walls while I was using soul stirring performance to spook the enemy soldiers.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-17T07:39:30-08:00","id":1050489,"title":"","content":"FYI, I am stilling running Scenarios with Exthalion and Guancyto.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-17T08:08:53-08:00","id":1050508,"title":"","content":"Sorry about that, will finish up rolls in a few min.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-17T08:10:22-08:00","id":1050509,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1050508#post1050508\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Sorry about that, will finish up rolls in a few min.</div> </div> </div> </div><br /> No worries. It's been <i>interesting</i> juggling everything this month. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-17T18:00:03-08:00","id":1050820,"title":"","content":"I was in a silly mood, so here, have a thing. Made with <a href=\"http://www.walfas.org/flash/create.swf\" target=\"_blank\">http://www.walfas.org/flash/create.swf</a>, which is far more fun than it has any right to be. I did my best to capture the essence of your characters, based on my impressions and the pictures from Obsidian Portal, but let me know if there's anything you'd like tweaked. Sorry Exthalion, the generator's only meant for female characters - I did my best.<br /> <br /> Also I couldn't find a character sheet for Akashan anywhere, so no idea what artifacts he's supposed to have. The glasses were cute, so have those instead. *^^*<br /> <br /> How tall is everyone supposed to be? Aisa's short.<br /> <img src=\"http://threewestwinds.com/ScarletSky.png\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-17T20:10:44-08:00","id":1050863,"title":"","content":"I like how Akashan isn't sure how to feel about the situation. I'd say Quelaana is around 5 foot 9inches (I'm not familiar with meters if you use that measurement). Tall for a female but I have a head canon that wood aspects are naturally taller.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-21T07:09:25-08:00","id":1052551,"title":"","content":"So... Last season was chaotic for me. I can't keep running five simultaneous scenes at once. I can't keep them all straight and a few people got shafted in scene time. I did some thinking and realized the issue is I'm running the game in Table Top mode. I got NPCs with specific goals and need to interact more with the PCs to make sure the NPCs move to achieve those goals. While in a table top game that is okay, it doesn't work in a letter game. <br /> <br /> Something needs to change. We have three options (I'm willing to entertain more options).<br /> <br /> 1. I post more information about the NPCs and their goals. Now, this is out of character knowledge, so please don't be &quot;Hey! I figured all this out in a month!&quot;. The plan was to have your characters build power and maybe start a Civil War on the long March until Calibration and the Jade Prison Break. I let you see behind the screen, so you can come up with a better story for your character. You write your own complications and I give updates both in and out of character on what the NPCs are doing. <br /> <br /> 2. I forget about my crazy NPC plans, stop being a control freak, and let you guys come up and run NPCs. Probably drop the dice rolling aspect of the game in this case. This is maximum collaborative storytelling. I'd be more of a referee than a Storyteller in this case. <br /> <br /> 3. We end the game. <img src=\"https://forum.theonyxpath.com/core/images/smilies/frown.png\" border=\"0\" alt=\"\" title=\"Frown\" smilieid=\"11\" class=\"inlineimg\" /><br /> <br /> But, if we continue these changes will be made:<br /> <br /> 1. No more stunt dice. Your letters should be describing what you do for character's actions already. You guys are already passing most of your rolls, so you don't really need those dice to begin with. <br /> 2. You will be able to gain three background points a letter. You guys have so many schemes going, you need that extra background point.<br /> 3. If you are a crafter, you have two crafting slots (more to be added depending on charms). These crafting slots can be used to build artifacts that don't benefit your own character sheet (dice rolls, powers, etc). Those Artifacts are gained though Backgrounds as usual. This change is so Akashan can both craft and play politics with the rest of us.<br /> <br /> <br /> Either way, you guys are going to be coming up with your own complications from now on. I'm still going to be writing Ryo and Titus letters, but you are going to have more control over your letters. <br /> <br /> What do you guys think?","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-21T09:27:41-08:00","id":1052603,"title":"","content":"It sounds really exhausting, if you were doing the same sorts of scenes I had with five players! I can't blame you for needing to change things up.<br /> <br /> I'd prefer #1. Keeping a level of outside input (even just in the form of you coming up with NPCs) seems valuable, and I like to trust people to keep IC and OOC knowledge separate.<br /> <br /> Edit: Also, thank you for your hard work running the game so far. It has been a fantastic experience.","signature":"","edited":{"userid":9510,"user_link":"https://forum.theonyxpath.com/member/9510-bluewinds","user":"BlueWinds","date":". 02-21-2017, 05:46 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-21T14:41:10-08:00","id":1052787,"title":"","content":"I am sorry for the part I played in making things harder for you. Option one is the one I like most, but any will be acceptable.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-21T14:48:01-08:00","id":1052794,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Exthalion</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1052787#post1052787\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I am sorry for the part I played in making things harder for you. Option one is the one I like most, but any will be acceptable.</div> </div> </div> </div><br /> No worries. This whole game is a learning experience. We will make adjustments as we go to find a good setup for this type of game. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /> <br /> <br /> I'll wait until the other players to chime in before posting any OOC knowledge.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-21T15:47:28-08:00","id":1052854,"title":"","content":"So how would 1 work? Is it basically the same, but more meta knowledge for how I do things? Am I just picking from my own list of possible complications?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-21T15:51:39-08:00","id":1052861,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1052854#post1052854\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So how would 1 work? Is it basically the same, but more meta knowledge for how I do things? Am I just picking from my own list of possible complications?</div> </div> </div> </div><br /> It's the same, but you have more meta knowledge for coming up with your own complications.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-21T19:46:40-08:00","id":1052992,"title":"","content":"I feel like 1 is the best as well, I suspect that given more metaknowledge, we'll make life even harder for ourselves rather than the opposite!<br /> <br /> And after all, isn't being brutally beaten half to death by angry dragon-bloods what Exalted is all about?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2144-guancyto","name":"Guancyto","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2144_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"699"}]},"thankedby":[]},{"date":"2017-02-22T09:34:23-08:00","id":1053271,"title":"","content":"If Eura is okay with the change, I'll try to post what the opposition NPCs are doing either today or tomorrow. II'll try to update the website sometime today. So many schemes. <img src=\"https://forum.theonyxpath.com/core/images/smilies/biggrin.png\" border=\"0\" alt=\"\" title=\"Big Grin\" smilieid=\"3\" class=\"inlineimg\" /><br /> <br /> Exthalion and Guancyto still need to post their Descending Water letter. I'll send Exthalion the last tibbit he needs for the letter. Exthalion, If you could send me three Dynast woman for potential wives. After you send me the list, I'll come up with three of my own. This is what BlueWinds and I did for Aisa's potential betrothals. Note, just because your character becomes engaged, doesn't mean you have to get married right away. Dynasts have long engagements. <br /> <br /> Guancyto, should be ready for letter writing. <br /> <br /> <br /> Also, since we don't need to do any more back and forth, did we want to write letters weekly instead of biweekly? <br />","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-22T09:43:59-08:00","id":1053281,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wonderandawe</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1053271#post1053271\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Also, since we don't need to do any more back and forth, did we want to write letters weekly instead of biweekly?</div> </div> </div> </div>I'd prefer keeping it biweekly for at least the first one while we get used to the new format, and make a decision after that. (unless we all finish our next letters super fast, of course. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/9510-bluewinds","name":"BlueWinds","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar9510_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2015"},{"key":"Posts:","value":"554"}]},"thankedby":[]},{"date":"2017-02-22T10:35:45-08:00","id":1053311,"title":"","content":"I'm fine with this being the last biweekly and with number 1 of doing things. The only thing likely to change is when I start messing with Shanarinara(or Inara for it's non-official name).","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-24T06:48:56-08:00","id":1054289,"title":"","content":"I haven't posted anything since I am sick. I'll try to get something up by this weekend.<br /> <br /> Still waiting on Descending Water letters from <a href=\"https://forum.theonyxpath.com/member/2144-guancyto\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar2144_2.png');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"2144\" data-vbnamecard=\"2144\">Guancyto</a> and <a href=\"https://forum.theonyxpath.com/member/1144-exthalion\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar1144_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"1144\" data-vbnamecard=\"1144\">Exthalion</a>","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-25T07:57:20-08:00","id":1054750,"title":"","content":"<b>Gold Faction Goals</b><br /> The Gold Faction works to destabilize the Realm. They want the world in Chaos, so the returning Solars can sweep in and save the day. They are working with the Deathlords to open the Jade Prison. No one inside of fate can touch the prison, so the Gold Faction decided the Underworld was the safest option outside of fate. They do not expect the Deathlords can screw with the Solar Exaltations. Lytek said they are incorruptible.<br /> <br /> Roseblack is their throne candidate, if only because she brings the most conflict and seems to be the most reasonable if she does take the throne. The Gold Faction sent assassins after her to enrage the Roseblack into action. They want the north in conflict and saw Quelaana as a way to ensure this. They were helping her up until the point she convince the Roseblack to accept the Cynis\u2019 surrender. They do not know about the Mnemon fleet coming. They want all the Throne Candidates alive to start up a civil war. <br /> <br /> The Gold Faction knows nothing about Nellens Ryo. They are aware of Whispering Twilight\u2019s existence, but he is low priority right now. They have their eye on the large prize \u2013 freeing the Solars from the Jade Prison.<br /> <br /> <b>Bronze Faction Goals</b><br /> The Bronze Faction supports the Realm. They spent the past few months in Chaos, thanks to Chejop Kejak\u2019s death. When Ledaal Kes revealed what he discovered in the Underworld, the remaining Bronze Faction (they lost some in the wake of Kejak\u2019s death), jumped on the opportunity to unite the realm against a common enemy. Cathak Cainan is wary of Ledaal Kes. He believes he is jumping at shadows and is too\u2026 agnostic to lead the Realm. <br /> <br /> If they find out there is a Solar working to put someone on the Scarlet Throne, they will be much displeased. And by displeased, I mean, kill everyone involved in the conspiracy.<br /> <br /> <b>Mnemon Goals</b><br /> Mnemon intends to become Empress by any means possible. Her lone Sidereal supporter doesn\u2019t realize how ruthless she is. Ironically, Mnemon\u2019s support of Aisa make her Sidereal support thinks she is sentimental. <br /> <br /> The death of the Roseblack is Mnemon's main goal right now. She believes once the Roseblack is dead, she can easily take the throne. <br /> <br /> With some work, the other candidates will step aside for another stronger candidate. Mnemon will not. She will either sit on the Throne or die trying. <br /> <br /> <br /> <b>Underworld Goals</b><br /> Like the Gold Faction, the Deathlords are prepare the way for the breaking of the Jade Prison. Without the Knowledge of the Gold Faction, they plan on stealing and corrupting the Solar Essences. They stockpile and labor to arm their deathknights. The Deathlords expect to get all the Solar Exaltations.<br /> <br /> <b>Malfeas Goals</b><br /> As no player has interacted with Malfeas yet, I have no plans for these guys. This may change later, if the players start to get involved.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3950-wonderandawe","name":"wonderandawe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3950_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"5410"}]},"thankedby":[]},{"date":"2017-02-25T09:23:43-08:00","id":1054791,"title":"","content":"Writing letter now, will post later today.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-02-25T10:37:10-08:00","id":1054845,"title":"","content":"I like how the Gold faction wanted me to go full murder hobo on the Cynis when I've done something worse to them. I took their main source of income. Also Roseblack was the one whom wanted to spare the Cynis.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3103-eura","name":"Eura","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3103_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"663"}]},"thankedby":[]},{"date":"2017-02-25T12:42:42-08:00","id":1054916,"title":"","content":"Likewise I will post later today!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2144-guancyto","name":"Guancyto","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2144_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"699"}]},"thankedby":[]},{"date":"2017-02-25T18:05:28-08:00","id":1055018,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Eura</strong> <a href=\"https://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/998288-ooc-exalted-2-5-the-scarlet-sky-conspiracy-\u2013-an-epistolary-game?p=1054845#post1054845\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I like how the Gold faction wanted me to go full murder hobo on the Cynis when I've done something worse to them. I took their main source of income. Also Roseblack was the one whom wanted to spare the Cynis.</div> </div> </div> </div><br /> That was the Gold Faction's last ditch effort to salvage the situation. Cynis will want their stock with them when they go and other parties (like the Bloody Hand) may disagree.","signature":"<hr class=\"b-divider\"/><br/>I write things.","edited":