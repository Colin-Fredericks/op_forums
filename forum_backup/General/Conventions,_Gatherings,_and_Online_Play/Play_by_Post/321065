/5/avatar3804_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"79"}]},"thankedby":[]},{"date":"2015-02-08T15:01:18-08:00","id":398088,"title":"","content":"Geoff immediately stopped, and laid low. He tried to keep Echoes in sight, and looked around, checking if the others were still here. &quot;If anyone is good at sneaking around, go with her in case things get bad. I'm not,&quot; he whispered to his packmates.","signature":"<hr class=\"b-divider\"/><br/>&quot;And for my next trick&quot; I said, &quot;anvils!&quot;","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2016-evilmarmelade","name":"Evilmarmelade","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2016_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"632"}]},"thankedby":[]},{"date":"2015-02-08T23:42:44-08:00","id":398504,"title":"","content":"&quot;Bother.&quot; Val sighs, and crouching low, prowls after Echoes.<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> Dex+Stealth, attempting to remain hidden, while following Echoes<br /> 1d10 \u2192 [7] = (7)<br /> 1d10 \u2192 [9] = (9)<br /> 1d10 \u2192 [9] = (9)<br /> 1d10 \u2192 [4] = (4)<br /> 1d10 \u2192 [7] = (7)<br /> 1d10 \u2192 [2] = (2)<br /> That's: 7, 9, 9, 4, 7, 2<br /> <div class=\"b-bbcode b-bbcode__url b-bbcode__url--preview\"> <a href=\"http://invisiblecastle.com/roller/view/4773044/\" target=\"_blank\" class=\"urlimg_container\"> <img class=\"js-img-fallback\" src=\"https://forum.theonyxpath.com/core/images/default/google-material/image_placeholder.svg\"> </a> <div class=\"urlinfo\"> <div class=\"title ellipsis\"> <a href=\"http://invisiblecastle.com/roller/view/4773044/\" target=\"_blank\"> Loading... </a> </div> <div class=\"url ellipsis\"> <a href=\"http://invisiblecastle.com/roller/view/4773044/\" target=\"_blank\"> http://invisiblecastle.com/roller/view/4773044/ </a> </div> <div class=\"meta\"> </div> </div> </div><br /> (Sorry about the weird format, still getting used to this thing)</div></div> </div> </div><br />","signature":"","edited":{"userid":3869,"user_link":"https://forum.theonyxpath.com/member/3869-al-haleem","user":"Al-Haleem","date":". 02-09-2015, 11:25 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3869-al-haleem","name":"Al-Haleem","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3869_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"154"}]},"thankedby":[]},{"date":"2015-02-09T05:38:44-08:00","id":398717,"title":"","content":"Jon splayed his ears and crouched low, moving slowly behind Echoes and Val. The expression on his face showed a tad more confidence now.<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">Jon Blazczyk<br /> <br /> Dex(2) + Stealth(2) = <a href=\"http://invisiblecastle.com/roller/view/4773555/\" target=\"_blank\">4d10 \u2192 [4,9,8,8]</a><br /> <br /> Dex(+2, Lupus) = <a href=\"http://invisiblecastle.com/roller/view/4775192/\" target=\"_blank\"> 2d10 \u2192 [6,2]</a><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/play-by-post/288755-ooc-rage-across-the-delaware-valley-werewolf-the-apocalypse?p=306482#post306482\">[Link to character]</a></div></div> </div> </div>","signature":"","edited":{"userid":4123,"user_link":"https://forum.theonyxpath.com/member/4123-rall-bashir","user":"Rall Bashir","date":". 02-12-2015, 12:06 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4123-rall-bashir","name":"Rall Bashir","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4123_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2014"},{"key":"Posts:","value":"114"}]},"thankedby":[]},{"date":"2015-02-09T15:20:07-08:00","id":399404,"title":"","content":"Scott, not confident in his stealth, stays behind with Geoff.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3789-deathmatchfm","name":"DeathmatchFM","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3789_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"55"}]},"thankedby":[]},{"date":"2015-02-16T00:34:29-08:00","id":407487,"title":"","content":"As Echoes, Val and Jon crept forward along the wall of the building, following the tracks and approaching the noises, the sounds slowly became more distinct. The clang of metal on earth, snow and stone was now unmistakeably the sound of several shovels digging into the frozen earth. The muffled voices also became more clear, resolving into those of three people, two male and one female, speaking English.<br /> <br /> &quot;This... fucking... sucks...&quot; growled a deep, gruff male voice. It was accompanied by a series of quick and heavy clangs, as a shovel hitting stone. &quot;This ground is completely frozen!&quot;<br /> <br /> &quot;You hit a rock, stupid. Dig around it,&quot; replied an annoyed sounding female voice.<br /> <br /> &quot;That doesn't make it any less frozen!&quot; the gruff voiced male replied.<br /> <br /> &quot;Why do we always get all the shit jobs?&quot; interjected a third voice, a softer voiced male. &quot;What did we do to deserve this?&quot;<br /> <br /> The female voice let out a heavy sigh. &quot;Are you forgetting the cough syrup incident?&quot;<br /> <br /> &quot;That was not our fault!&quot; both male voices replied in unison. The shoveling sounds paused for a moment, then all three voices laughed. It was the slightly high strung laugh of releasing tension. The shoveling sounds resumed.<br /> <br /> The soft voiced male spoke up again. &quot;We should probably be keeping better watch. There might...&quot;<br /> <br /> He was cut off by the deeper voiced male, who sneered &quot;You're just trying to get out of more shoveling. You already checked all the way around the damned village!&quot;<br /> <br /> &quot;We're within their territory. Being here without guards is reckless,&quot; the softer voiced male replied.<br /> <br /> &quot;I told you,&quot; countered the female matter-of-factly, &quot;we're perfectly safe. Our spy told us that tonight is the perfect night- the whole sept is preoccupied.&quot;<br /> <br /> &quot;Preoccupied with what?&quot; asked the soft-voiced one.<br /> <br /> &quot;New cubs,&quot; the female replied. &quot;There's a rite of passage going on. Half a dozen wet-behind-the-ears little cubbies being put through their paces. The whole sept is wrapped up with the ritual. Plus, visitors from all the other septs. Including what's-his-name, that obnoxious Fianna that always starts fights. Trust me, no one's coming all the way down here.&quot;<br /> <br /> &quot;And if they come through the Umbra?&quot;<br /> <br /> &quot;The sentinel tree will handle them,&quot; she replied brusquely. &quot;Now, keep digging. We have a lot of graves to dig up, and I want to get this done before dawn. We have to find it. I won't report failure to the Chosen One.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1416-nutiketaiel","name":"NutiketAiel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1416_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"303"}]},"thankedby":[]},{"date":"2015-02-16T12:02:18-08:00","id":408010,"title":"","content":"Geoff looked around nervously, as he wasn't really used to stakeouts. He looked curiously at the Stargazer next to him, gauging him. &quot;You've been awfully quiet all night, except for that outburst toward Val. I trust that there's no bad blood between us, right?&quot; Geoff whispered.","signature":"<hr class=\"b-divider\"/><br/>&quot;And for my next trick&quot; I said, &quot;anvils!&quot;","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2016-evilmarmelade","name":"Evilmarmelade","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2016_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"632"}]},"thankedby":[]},{"date":"2015-02-18T10:35:36-08:00","id":410298,"title":"","content":"Her snarl grew wider, and soon her body had swelled up into a massive red wolf (Crinos), but she remained in a crouch, ready to strike. With her snout she nudged Jon, and, if he happened to look her way, she would point back to where the rest of the pack lurked. Her tail twitched with anticipation.<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">stamina + primal urge to shapeshift<br /> Rolled on: Feb. 18, 2015, 10:17 a.m.<br /> 8d10 \u2192 [2,2,10,3,4,3,10,2] = (36)<br /> <br /> [<a href=\"http://invisiblecastle.com/roller/view/4780641/\" target=\"_blank\">link to roll</a>] [<a href=\"http://invisiblecastle.com/roller/search/1548470\" target=\"_blank\">link to character</a>]<br /> <br /> also noting here that her snarl was just a gesture, no sounds. yet. ;D<br /> </div></div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/><u>Rage Across the Delaware Valley</u><br /> <b>Health: </b><br /> <b>Rage (3)</b>:<br /> <b>Gnosis (7):</b> X<br /> <b>Willpower (6): </b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3804-stir-of-echoes","name":"Stir of Echoes","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3804_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"79"}]},"thankedby":[]},{"date":"2015-02-18T17:34:15-08:00","id":410839,"title":"","content":"&quot;What in Ram's name are you doing?&quot; Val hisses, straining to keep his voice calm.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3869-al-haleem","name":"Al-Haleem","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3869_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"154"}]},"thankedby":[]},{"date":"2015-02-20T08:13:08-08:00","id":412813,"title":"","content":"Scott, finding himself feeling better about the cold in his wolf-shape, sits patiently while meditating on overcoming the lingering chill with his mind. He does hear Geoff talk to him. <br /> <br /> &quot;I give my emotions to the wind; it carries away unneeded sentiments. If tainted feelings existed, they've long since been released.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3789-deathmatchfm","name":"DeathmatchFM","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3789_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"55"}]},"thankedby":[]},{"date":"2015-02-20T23:07:42-08:00","id":413840,"title":"","content":"Jon darted his head quickly at Echoes, almost reflexively about to nip from the nosing. He had to pause to interpret the gesture. But after hearing this conversation, Jon took in a deep breath, held it, then let it go. His eyes briefly turned milky white as he started to bring his consciousness to all of the pack.<br /> <br /> <i><span style=\"color:gray\">...You better get up here, because this is about the only time left we have to actually <b>THINK</b> about our actions...</span></i><br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">Spending one willpower to link up the pack with Mindspeak. Will do roll if anyone resists.</div></div> </div> </div>","signature":"","edited":{"userid":4123,"user_link":"https://forum.theonyxpath.com/member/4123-rall-bashir","user":"Rall Bashir","date":". 02-24-2015, 11:32 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4123-rall-bashir","name":"Rall Bashir","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4123_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2014"},{"key":"Posts:","value":"114"}]},"thankedby":[]},{"date":"2015-02-21T23:56:46-08:00","id":414965,"title":"","content":"Val's ears drop, eyes darting between Jon and Echoes. &quot;What are you doing? You're not going to attack are you?&quot; A note of panic creeps into his voice. &quot;Someone tell me what's going on!&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3869-al-haleem","name":"Al-Haleem","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3869_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"154"}]},"thankedby":[]},{"date":"2015-02-22T16:47:39-08:00","id":415831,"title":"","content":"&quot;That's wise. Thank you for that. Honestly, I think we can make this pack work, but we'll need to-&quot; Geoff was cut short as he heard a voice in his mind. After a few moments of panic, he looked at the three behind, and his eyes widened as he saw Echoes' form. &quot;What is she doing?!&quot; <br /> <br /> He trotted towards her, hoping to stop her before anything foolish happened.","signature":"<hr class=\"b-divider\"/><br/>&quot;And for my next trick&quot; I said, &quot;anvils!&quot;","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2016-evilmarmelade","name":"Evilmarmelade","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2016_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"632"}]},"thankedby":[]},{"date":"2015-02-25T12:21:26-08:00","id":419134,"title":"","content":"<span style=\"color:lightgray\"><i>No time for summary. Questions later. Now is damage control</i>.</span><br /> <br /> Jon hunched low and arched his back hard. The visceral sound of bones cracking and tendons snapping could be heard as he, too, made the poor decision to go full Crinos.<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">Spending fury. Better safe than sorry in this instance.<br /> Willpower (8)=X<br /> Fury (4)=X</div></div> </div> </div><br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4123-rall-bashir","name":"Rall Bashir","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4123_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2014"},{"key":"Posts:","value":"114"}]},"thankedby":[]},{"date":"2015-02-26T00:19:33-08:00","id":419898,"title":"","content":"&quot;No...no I can't, I...I...&quot;<br /> <br /> Val begins shivering, his breaths come come short and fast. For a moment his body blurs, and then he's in homid form. <br /> <br /> Leaping from cover, he dashes into view of the assembled diggers.<br /> <br /> &quot;I bring a message from the Chosen One!&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3869-al-haleem","name":"Al-Haleem","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3869_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"154"}]},"thankedby":[]},{"date":"2015-02-26T14:05:32-08:00","id":420629,"title":"","content":"As he runs out into view, Val sees three enormous people digging in an old, snow covered graveyard. The graveyard is small, but many of the tombstones look like they've been there since before the revolution, so worn and faded are they. Despite the snow, most of the tombstones can be seen clearly since the white powder has been brushed off almost all of them. All around the open graves are discarded bones or rotting bodies frozen on the cold, tossed aside like so much detritus. Incongruously, there is a six foot tall snowman standing in the exact center of the graveyard with an old skull in place of a head. long femur is in the skull's mouth, as if it is gnawing on the bone.<br /> <br /> The owners of the three voices all freeze in the process of digging, turning to stare at the newcomer. At a second glance, the three &quot;enormous people&quot; are clearly three individuals in Glabro form. Val's eyes are first drawn to the most unusual of the three, who is also the smallest of the three even in Glabro form. He is bundled up in winter gear, though most of it is ratty and old, except for his head, which is unaccountably bare. He has no hair at all, not even eyebrows, and appears to be in his early twenties. He licks his lips nervously when he sees Val, and looks questioningly at the woman, glancing back and forth between her and Val.<br /> <br /> The second man, Val can only see from the waist up, as he is standing in a deep grave that he is in the process of excavating. He's wearing a heavy leather coat, covered with biker patches, and sunglasses despite the darkness, and looks to be in his mid-twenties. He stops digging when Val comes into view, standing up straight and resting the shovel on his shoulder. He spares a glance for the woman, but keeps most of his focus on Val, his eyes gleaming with predatory intent.<br /> <br /> The woman stood closest to Val, besides a fully excavated grave. As Val rounded the corner, she appeared to be moving to the next grave, but stopped, whirling to fully face Val as he emerged. She wears a heavy trenchcoat over her massive glabro form, and drops the shovel once Val comes into view. She glares at him, suspicion painted on her features. &quot;Who the fuck are you?&quot; she growls, taking a step towards him menacingly.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1416-nutiketaiel","name":"NutiketAiel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1416_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"303"}]},"thankedby":[]},{"date":"2015-02-26T14:56:59-08:00","id":420698,"title":"","content":"Val works his expression into a sneer of disdain.<br /> <br /> &quot;You fools! How have you not realized it yet? You've been compromised, your spy's a double agent! Even now a host of garou are heading this way, led by a blood-thirsty Red Talon! If they see what you've done here, you'll be slaughtered and our great work will be for nothing!&quot;<br /> <br /> He takes a deep breath.<br /> <br /> &quot;Personally, I'd start running now.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3869-al-haleem","name":"Al-Haleem","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3869_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"154"}]},"thankedby":[]},{"date":"2015-02-26T15:30:02-08:00","id":420725,"title":"","content":"The three of them stared at Val silently for a moment. Then two men looked towards the woman. Without turning from Val, she growled at them &quot;Keep digging.&quot; They immediately set back to work. She, meantime, took another step towards Val. In mid step, her muscles swelled and fur bristled all over her body, her face elongating into a snout. Her eyes stayed the same, however, and they were glaring down at him. &quot;If you don't tell me who you are right now,&quot; she growled at him, the words thick and barely intelligible because of the shape of her mouth, &quot;I'm going to tear you apart and feast on your liver. Who sent you? How did you know where to find us?&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1416-nutiketaiel","name":"NutiketAiel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1416_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"303"}]},"thankedby":[]},{"date":"2015-02-26T16:24:14-08:00","id":420799,"title":"","content":"Val draws himself up to his full height, which is still quite a bit shorter than the woman. <br /> <br /> &quot;How dare you question me? You have no idea what I've suffered for our cause, what I've sacrificed.&quot;<br /> <br /> Val calls on his spirit, trying to add a supernatural edge to his words.<br /> <br /> &quot;I'm not the one who betrayed you, don't direct your anger at me. I'm trying to help you here.&quot;<br /> <br /> With great effort, he looks the woman in the eye.<br /> <br /> &quot;And I won't report failure to the Chosen One.&quot;<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> Gift: Persuasion<br /> Charisma+Subterfuge<br /> 6d10 = 6, 1, 7, 10, 8, 6<br /> <a href=\"http://invisiblecastle.com/roller/view/4788095\" target=\"_blank\">http://invisiblecastle.com/roller/view/4788095</a></div></div> </div> </div>","signature":"","edited":{"userid":3869,"user_link":"https://forum.theonyxpath.com/member/3869-al-haleem","user":"Al-Haleem","date":". 02-26-2015, 07:36 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3869-al-haleem","name":"Al-Haleem","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3869_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"154"}]},"thankedby":[]},{"date":"2015-03-02T14:27:44-08:00","id":425672,"title":"","content":"Geoff stopped when he arrived near Echoes and Jon. Now that he could hear the situation, he stood still, not moving an inch, but ready to act as soon as needed.","signature":"<hr class=\"b-divider\"/><br/>&quot;And for my next trick&quot; I said, &quot;anvils!&quot;","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2016-evilmarmelade","name":"Evilmarmelade","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2016_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"632"}]},"thankedby":[]},{"date":"2015-03-05T22:30:26-08:00","id":429846,"title":"","content":"Jon was ready to follow Echoes' lead when the Ragabash went charting out. His jaw dropped, eyes widened, and a face of sheer unbelieving terror flashed across his face.<br /> <br /> <span style=\"color:darkgray\"><i>What. The. Fuck.</i></span>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4123-rall-bashir","name":"Rall Bashir","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4123_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2014"},{"key":"Posts:","value":"114"}]},"thankedby":[]},{"date":"2015-03-08T23:01:39-07:00","id":433614,"title":"","content":"&quot;Last chance,&quot; she said, seething with rage as she glared down at Val. &quot;Tell me who you are, or die.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1416-nutiketaiel","name":"NutiketAiel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1416_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"303"}]},"thankedby":[]},{"date":"2015-03-09T03:39:46-07:00","id":433776,"title":"","content":"<span style=\"color:darkgray\"><i>Be prepared for an extraction. Move around to flank, get ready to try to tear some intestines out, just in case. I'm probably going to die. Here goes nothing...</i></span><br /> <br /> Jon took a deep breath. Then he took another. Once more, and then he strode out of the cover. The hulking beast of black fur moved towards Val, making eye contact with whoever he passed.<br /> <br /> &quot;His name is Hadji Quest.&quot; Jon rolled his shoulders back and puffed his chest out, then turned once again to Val, &quot;So, did you escape your cage, or did someone let you out?&quot;<br /> <br /> Jon returned his gaze to the crowd, &quot;I am Suffers-Fools, apparently. I assume Hadji here came with a message. Val, tell them the message.&quot; Jon brought his large, clawed hand and gripped Val by the back of the neck, &quot;Second strike...&quot; Jon started to return to his breed form, &quot;...one more, Hadji, and I will personally gut you and feed you piece. by. piece to the Talons. Now tell them.&quot;<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">Gift: Persuasion.<br /> Charisma (3) + Subterfuge (4) = Whatever gets rolled as Invisible Castle is on the blink again.</div></div> </div> </div>","signature":"","edited":{"userid":4123,"user_link":"https://forum.theonyxpath.com/member/4123-rall-bashir","user":"Rall Bashir","date":". 03-09-2015, 06:45 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4123-rall-bashir","name":"Rall Bashir","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4123_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2014"},{"key":"Posts:","value":"114"}]},"thankedby":[]},{"date":"2015-03-09T21:37:57-07:00","id":435239,"title":"","content":"Val gapes, staring at Jon.<br /> <br /> &quot;What the hell are you...&quot;<br /> <br /> He manages to reel his jaw in. Grimacing, he punches Jon in the arm.<br /> <br /> &quot;You disgusting creature, what took you so long?&quot;<br /> <br /> His face twists into snarl.<br /> <br /> &quot;And I've already given her the bloody message. No one mentioned she was gonna be a lobotomy patient. Good lord, what the hell did I do to deserve this abuse? Ugh, next time Walks-The-Abyss can play messenger boy.&quot;<br /> <br /> Val looks at the irate woman, smiling sweetly.<br /> <br /> &quot;This idiot was supposed to tell me how far behind the garou war party was.&quot;<br /> <br /> He nudges Jon in the ribs.<br /> <br /> &quot;Can you believe this crazy chick? I come here, try to save her smelly hide, and she threatens to kill me! That's gratitude huh? I didn't dance the Black Spiral for this shit.&quot;<br /> <br /> His eyes go wide. Gasping, he clamps a hand over his mouth. <br /> <br /> &quot;Oh, how rude of me, you wanted an introduction right? What is this, a Jane Austen novel? Ah, whatever.&quot;<br /> <br /> He bows deeply.<br /> <br /> &quot;Narasimha-Vallabha, I'm from the same pack as Malakai, heard of him? He's pretty famous. This's Hollow Heart.&quot; He indicates Jon. Smiling, he leans in close to the woman.<br /> <br /> &quot;We're dating,&quot; he whispers.","signature":"","edited":{"userid":3869,"user_link":"https://forum.theonyxpath.com/member/3869-al-haleem","user":"Al-Haleem","date":". 03-10-2015, 12:50 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3869-al-haleem","name":"Al-Haleem","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3869_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"154"}]},"thankedby":[]},{"date":"2015-03-12T13:05:08-07:00","id":438838,"title":"","content":"Geoff looked at Scott and Echoes, then lowered his head toward the Red Talon, whispering. &quot;Let's go around, find a way to flank them as he said. Work as a pack.&quot; He went back quickly to Scott, repeated himself, and looked for a way to attack the three Garous from rear.","signature":"<hr class=\"b-divider\"/><br/>&quot;And for my next trick&quot; I said, &quot;anvils!&quot;","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2016-evilmarmelade","name":"Evilmarmelade","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2016_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"632"}]},"thankedby":[]},{"date":"2015-03-26T08:27:38-07:00","id":458071,"title":"","content":"Scott isn't sure that this has anything to do with their objective, but it seems something to be concerned about. Still in lupus form, he follows Geoff quietly and cautiously.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3789-deathmatchfm","name":"DeathmatchFM","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3789_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"55"}]},"thankedby":[]}]}