6/0/4/5/avatar2308_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"914"}]},"thankedby":[]},{"date":"2014-11-28T10:26:57-08:00","id":324653,"title":"","content":"Are you still looking for a player ?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1540-basic","name":"Basic","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1540_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"777"}]},"thankedby":[]},{"date":"2014-11-29T01:24:29-08:00","id":325144,"title":"","content":"We are planning on starting next week and are playing requiem second ed on Fridays every other week or saturdays every week between. So our player base is split. <br /> <br /> If I were you I'd email donnie I'm sure he wouldn't mind a last minute addition. But he's the St so it's his call. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3837-slimjimjohnson","name":"Slimjimjohnson","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"135"}]},"thankedby":[]},{"date":"2014-11-29T19:26:22-08:00","id":325718,"title":"","content":"@Slimjim/Vitalis If you guys are interested in a Forsaken game my group could use one or two players to fill it out.<br /> <br /> @Donnie I just sent you an email Donnie as I just today saw the one you sent me. I generally check for responses to the thread not my Onyx mail. Sorry. However if you are still wanting to ST, and you are GOOD and not against a single splat then by all means drop a line on my thread posting so that people know there is an interest.<br /> <br /> Otherwise guys, I have a wolf group with an ST if we get like two more good people to play.","signature":"","edited":{"userid":3872,"user_link":"https://forum.theonyxpath.com/member/3872-captain-america","user":"Captain America","date":". 11-29-2014, 10:31 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3872-captain-america","name":"Captain America","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"49"}]},"thankedby":[]},{"date":"2014-11-30T10:35:40-08:00","id":326134,"title":"","content":"So, CA, you put in all caps the word &quot;GOOD&quot; so could you define what you mean by the accented word?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/786-thedonnie","name":"thedonnie","avatar":"data:image/svg+xml;base64,","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"567"}]},"thankedby":[]},{"date":"2014-11-30T11:42:40-08:00","id":326176,"title":"","content":"I mean I could probably write a dissertation on what a good ST/player is. The skill set for an ST has some differences to be good. But usually its easier to just see what a potential ST is bringing to the table and whether they and a group mesh with a player. <br /> <br /> Some examples though, would be the ability to proactively run a game. Whether that means you plan it out and have an outline first, or you fly by the seat of your pants each session doesn't matter as much as your ability to DO something in many cases. Being able to identify momentum and not let it die before you move with it is a good example.<br /> <br /> More practically, I once had a potential ST who was planning a game....months and months still planning. All the mean while he originally and posted and sold us on the idea that he already HAD a game ready and just needed players. Meanwhile players were waiting...waiting...getting bored with trying to keep a schedule free and open for something that is less and less likely to ever happen. So they started dropping off, going to do other things...soon no game, and a potential ST who was still &quot;planning.&quot; <br /> <br /> While planning a well thought out campaign setting is great two things come up. 1. At some point you just need to start a session or two. All the planning in the world will not help if the players end up (as they ALL do) doing things that you did not plan for. 2. If you are planning a future game and setting, do not tell people that you have a game/setting ready to play. That just goes badly for everyone, STs and Players.<br /> <br /> On the heels of that, adaptability and improvisation are strong desires for one to have as an ST as well. Mental/Psychological soundness; Gaming can be therapeutic, but it is not therapy. If you are a nut case, or complete flake, you will probably make a bad ST. Probably. There are exceptions to most all rules, including perhaps this one. Or in more facetious tone, if you have meds...take them. If you don't, expect that people will either not hang around/play with you or... might even one day smack you in the head with a brick when you act like a complete psycho. This tends to be more for players than STs.<br /> <br /> Some leadership/organizational abilities. I do not mean being Chesty Puller, John Basilone or El Cid, but if you are super passive aggressive, unable to make decisions of any kind, or establish a vision (however broad or narrowly defined) to move towards, then you will likely have issues and your games will likely fold before long. Not enough vision is less often the problem than too much. As gamers we all tend to have decent imaginations. Often the issue becomes when the vision is TOO big for the game and one is unwilling to adapt as time goes by to fit the circumstances.<br /> <br /> Experience. Not vital, but always good as a &quot;plus&quot; if someone has it. However I am very much of the school of thought that if an ST is inexperienced then the best way for them to learn is to let them ST. And since my group has a couple of experienced tabletop/large chat STs in it, we are good about grabbing the ST who &quot;trips&quot; and brushing him off and keeping him looking like he/she &quot;planned&quot; to trip. <img src=\"https://forum.theonyxpath.com/core/images/smilies/biggrin.png\" border=\"0\" alt=\"\" title=\"Big Grin\" smilieid=\"3\" class=\"inlineimg\" /> I am fortunate to have a very forgiving and friendly group. One or two introverted folk, but even they are very friendly and loving....they just don't talk much till they get used to you being around and seeing your 'face/login' once or twice. lol I'm sure you know the type.<br /> <br /> I mean anyone could likely go on and on with this, but I'm sure you get the idea. No one has ALL of the good ST traits, but possessing a few of the skills in the set leads to a strong game that folks enjoy coming to play and that the ST feels is enjoyable and not a second or third job. No one wants (Player or ST) to have the game feel more like an extra job. Its a hobby after all. I think it is less about what skills you have, versus what traits you don't possess. Mainly...it all falls under don't be a jerk and have SOME of your stuff together. A good group will help carry any of the extra baggage! lol A good group's job is to help the ST in the above things.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3872-captain-america","name":"Captain America","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"49"}]},"thankedby":[]}]}