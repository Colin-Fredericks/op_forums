/4/5/avatar4488_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2015-07-07T09:25:21-07:00","id":582427,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>malonkey1</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=582362#post582362\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Perhaps the Heart is just near-empty cosmos, while the chambers are alien-looking locations? (for example, Mars Rovers are often tested on Earth deserts, so a Chamber based on an Earth desert area could be easily modified to resemble Mars).</div> </div> </div> </div>Sounds good so a makara ruin and the chambers are planets I think ill make the heart a dieing sun.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/893-reaperfrost8","name":"reaperfrost8","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar893_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"401"}]},"thankedby":[]},{"date":"2015-07-07T10:42:53-07:00","id":582493,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>reaperfrost8</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=582427#post582427\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Sounds good so a makara ruin and the chambers are planets I think ill make the heart a dieing sun.</div> </div> </div> </div>Use Maze or something to make truly planetary Chambers.","signature":"<hr class=\"b-divider\"/><br/>Crunch isn't a hobby; it's a calling.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1959-hexmeister-vic","name":"Hexmeister Vic","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1959_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"764"}]},"thankedby":[]},{"date":"2015-07-07T11:20:32-07:00","id":582534,"title":"","content":"Make it an actual giant, beating heart, with veins and arteries leading into the surrounding area!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2102-mcn","name":"MCN","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2102_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"3479"}]},"thankedby":[]},{"date":"2015-07-07T11:37:28-07:00","id":582547,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Hexmeister Vic</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=582493#post582493\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Use Maze or something to make truly planetary Chambers.</div> </div> </div> </div>What is the Maze? Did not you mean the Hive?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2015-07-07T11:52:16-07:00","id":582589,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wyrdhamster</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=582547#post582547\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> What is the Maze? Did not you mean the Hive?</div> </div> </div> </div>It's a Lair Trait. Given how Lairs run on dream logic, it seems like an effective way of representing the difficulty to navigate such a vast and overwhelming space symbolically represented as a Chamber.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/188-yeoflittlefaith","name":"YeOfLittleFaith","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar188_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1159"}]},"thankedby":[]},{"date":"2015-07-07T12:13:41-07:00","id":582610,"title":"","content":"My beasts lair has now become a dieing universe with its chambers acting as planets and sun a dieing beating heart that on thats on fire this is the most videogame sounding lair ever I love it.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/893-reaperfrost8","name":"reaperfrost8","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar893_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"401"}]},"thankedby":[]},{"date":"2015-07-07T12:34:25-07:00","id":582627,"title":"","content":"I'm reminded off hand of one of the forth coming supplements for &quot;The Strange&quot; from Monte Cook. A preview shows one of the worlds being introduced is a clear (though not explicit) Star Wars expy setting. As it describes the setting though, this seeming galaxy-sized Recursion doesn't violate the normal spatial limitations of the worlds of the Strange, because each &quot;planet&quot; is actually a fairly limited environ, and &quot;space&quot; only exists in that the interior of ships are the tunnels you use to travel between these different environ chambers.","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2015-07-07T15:53:31-07:00","id":582826,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>reaperfrost8</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=582610#post582610\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">My beasts lair has now become a dieing universe with its chambers acting as planets and sun a dieing beating heart that on thats on fire this is the most videogame sounding lair ever I love it.</div> </div> </div> </div>Rereading Lair Traits, there are a lot of ways to represent an ever-dying pocket dimension. Just depends on how hyperbolic you'd want it.","signature":"<hr class=\"b-divider\"/><br/>Crunch isn't a hobby; it's a calling.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1959-hexmeister-vic","name":"Hexmeister Vic","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1959_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"764"}]},"thankedby":[]},{"date":"2015-07-08T12:41:05-07:00","id":583766,"title":"","content":"Just an off hand thought. One possibility for the &quot;truth&quot; behind Begotten beliefs in the interrelationship of all supernaturals: they were born from the fears INSPIRED by other supernaturals, who of course have diverse origins. Thus they are the product of them upon the human psyche. That's how they interconnect in relationship to everyone, even though those other supernaturals would seem not to share common origin.","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2015-07-08T12:45:54-07:00","id":583776,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>glamourweaver</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=583766#post583766\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Just an off hand thought. One possibility for the &quot;truth&quot; behind Begotten beliefs in the interrelationship of all supernaturals: they were born from the fears INSPIRED by other supernaturals, who of course have diverse origins. Thus they are the product of them upon the human psyche. That's how they interconnect in relationship to everyone, even though those other supernaturals would seem not to share common origin.</div> </div> </div> </div>I read that as a possibility, yeah. It's a chicken-or-the-egg thing.<br /> <br /> Something that strikes me as somewhat more interesting is the idea that the Dark Mother doesn't exist: the Introduction says that Beasts <i>feel </i>that she's still out there, but come on, think about it: Beasts are still partially human, and they once dreamed <i>deep</i>. What if the Dark Mother is simply the Primordial Dream hitting what's left of Beasts' collective humanity?","signature":"<hr class=\"b-divider\"/><br/>&quot;<a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/werewolf-the-forsaken/127887-doing-first-tongue-translations?p=484226#post484226\" target=\"_blank\">Nihhina kalekal-zidu kal masun, kal manudanadu. Nihhina kalekal-zidu nukal shaghu-desasudu \u2014 nihhina kalekal-zidu kal innu-desasudu udhkal samm</a>.&quot; Arthur Ashe<br /> She/her, contributing writer for <a href=\"https://www.drivethrurpg.com/product/363404/Scion-Pride-2021\" target=\"_blank\">Scion: Pride 2021</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1923-bigdamnhero","name":"BigDamnHero","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1923_4.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"1263"}]},"thankedby":[]},{"date":"2015-07-08T12:53:11-07:00","id":583779,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>BigDamnHero</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=583776#post583776\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I read that as a possibility, yeah. It's a chicken-or-the-egg thing.<br /> <br /> Something that strikes me as somewhat more interesting is the idea that the Dark Mother doesn't exist: the Introduction says that Beasts <i>feel </i>that she's still out there, but come on, think about it: Beasts are still partially human, and they once dreamed <i>deep</i>. What if the Dark Mother is simply the Primordial Dream hitting what's left of Beasts' collective humanity?</div> </div> </div> </div>Well, one of the schools of thought on the Dark Mother is that she <i>is</i> the Primordial Dream, so\u2026","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:trebuchet ms\"><span style=\"color:#4B0082\"><b>Resident Lore-Hound</b></span><br /> Currently Consuming: <i>Demon: the Descent 1e</i></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/111-satchel","name":"Satchel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar111_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9828"}]},"thankedby":[]},{"date":"2015-07-08T13:00:39-07:00","id":583782,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Satchel</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=583779#post583779\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Well, one of the schools of thought on the Dark Mother is that she <i>is</i> the Primordial Dream, so\u2026</div> </div> </div> </div>Sure, I was positing the idea that The-Dark-Mother-as-the-Primordial-Dream would be &quot;merely&quot; a system rather than a free-willed being. Beasts, being human, classify and anthropomorphize their lingering, human fears as a distant Mother Figure.<br /> <br /> You know, whatever helps them sleep at night. :P","signature":"<hr class=\"b-divider\"/><br/>&quot;<a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/werewolf-the-forsaken/127887-doing-first-tongue-translations?p=484226#post484226\" target=\"_blank\">Nihhina kalekal-zidu kal masun, kal manudanadu. Nihhina kalekal-zidu nukal shaghu-desasudu \u2014 nihhina kalekal-zidu kal innu-desasudu udhkal samm</a>.&quot; Arthur Ashe<br /> She/her, contributing writer for <a href=\"https://www.drivethrurpg.com/product/363404/Scion-Pride-2021\" target=\"_blank\">Scion: Pride 2021</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1923-bigdamnhero","name":"BigDamnHero","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1923_4.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"1263"}]},"thankedby":[]},{"date":"2015-07-08T13:01:05-07:00","id":583783,"title":"","content":"Reminds me of an important observation about the end of Sandman<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> If one can still dream about Morpheus, can he really be dead. I know DREAM isn't dead of course, that's obvious - but Morpheus specifically. If Morpheus, who was dreams, can still exist in dreams, isn't that still him essentially? </div></div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2015-07-08T16:37:23-07:00","id":583978,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>glamourweaver</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=583766#post583766\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Just an off hand thought. One possibility for the &quot;truth&quot; behind Begotten beliefs in the interrelationship of all supernaturals: they were born from the fears INSPIRED by other supernaturals, who of course have diverse origins. Thus they are the product of them upon the human psyche. That's how they interconnect in relationship to everyone, even though those other supernaturals would seem not to share common origin.</div> </div> </div> </div><br /> Honestly, this has been my primary interpertation since i read the first draft, seemed super obvious to me.","signature":"<hr class=\"b-divider\"/><br/>(he/him/his)<br /> <br /> <a href=\"http://www.kickstarter.com/projects/200664283/demon-the-descent-prestige-edition\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://img513.imageshack.us/img513/4478/8vno.png\" border=\"0\" alt=\"\" /></a><br /> Backer #2010","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1329-elvesofzion","name":"ElvesofZion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1329_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1086"}]},"thankedby":[]},{"date":"2015-07-08T16:38:55-07:00","id":583980,"title":"","content":"The problem with that one is that if it was just human response shaping them, then they should connect with demons. They don't, because their roots exist in different spiritual ancestries.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2015-07-08T16:47:52-07:00","id":583991,"title":"","content":"For myself (entering Head Cannon territory here), I'd say that its a combination of:<ul><li>Not JUST from humans, but the world itself. (Primordial after all)</li> <li>Demons as concept, sure there are demonic beasts, and demonic changelings and Inferno demons that can be kin.</li> <li>Unchanined are either too new (for some value of new) or have some special metaphysical reason (not decided yet, depends on the actual game im running) to not count.</li> </ul>But generally, yeah, its not a perfect version, just the one I like the most.<br /> <br /> Also, I meant it was an obvious option for me, not necessarily the absolute truth.","signature":"<hr class=\"b-divider\"/><br/>(he/him/his)<br /> <br /> <a href=\"http://www.kickstarter.com/projects/200664283/demon-the-descent-prestige-edition\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://img513.imageshack.us/img513/4478/8vno.png\" border=\"0\" alt=\"\" /></a><br /> Backer #2010","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1329-elvesofzion","name":"ElvesofZion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1329_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1086"}]},"thankedby":[]},{"date":"2015-07-08T17:36:29-07:00","id":584012,"title":"","content":"I have just realized I may be a little confused about the mechanics of the Hive Trait.<br /> <br /> Unless a Beast (who is not the Apex) cuts off their own Lair from the Hive, the Hive Trait will be present in every Chamber of the Lair. If the Apex grants the Beast environmental immunity to it, or it matches a Lair Trait of theirs then the Beast &quot;can <i>move</i> <i>throughout the Hive</i>* with impunity.&quot;<br /> <br /> <span style=\"font-size:11px\">*Italics emphasis mine.</span><br /> <br /> Maybe I'm focusing too much on the wording, but is the text meant to read that Beasts have no immunity to the Hive Trait inside their own Lair unless given by the Apex (which requires they be a Beast)? Or do they only need to be <i>granted</i> immunity when exploring the <i>other</i> Chambers that make up the Hive?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/188-yeoflittlefaith","name":"YeOfLittleFaith","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar188_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1159"}]},"thankedby":[]},{"date":"2015-07-08T17:43:41-07:00","id":584016,"title":"","content":"I think the reason that Demons and the GM don't fit is because their fear isn't <i>primal</i>. If you went back a few centuries, then the idea of a giant machine controlling everything seems silly. The fear that the God-Machine represents didn't fully form until very late in our existence, when the runaway complex systems it represents came into being.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://eoinsstuff.shoutwiki.com/wiki/Genius:_the_Transgression_(2nd_Edition)\" target=\"_blank\">Genius: the Transgression 2E is a thing that's being worked on.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/4488-malonkey1","name":"malonkey1","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4488_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2015-07-08T17:52:16-07:00","id":584022,"title":"","content":"You could also make an argument about outsider/detached divinity in regards to Demons and the God-Machine, which Satchel has brought up several times in this thread already.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/188-yeoflittlefaith","name":"YeOfLittleFaith","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar188_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1159"}]},"thankedby":[]},{"date":"2015-07-08T17:52:41-07:00","id":584023,"title":"","content":"As have I.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2015-07-08T18:26:41-07:00","id":584044,"title":"","content":"I didn't mean to forget you! (*w*)<br /> <br /> It's just been a while since the last time it was brought up.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/188-yeoflittlefaith","name":"YeOfLittleFaith","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar188_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1159"}]},"thankedby":[]},{"date":"2015-07-09T09:09:35-07:00","id":584817,"title":"","content":"The way I tend to see it, Beasts are connected to dreams, and the GM is somewhat antithetical to dreams. I haven't really read D:tD, but from what I've seen the GM seems a lot like what the Weaver was accused of being in CWoD: a near-cosmic force of stagnation, that would see all thinking beings become nothing more than cogs in it's design. Hopes, dreams, and even fears are &quot;obsolete&quot;, &quot;anomalies&quot;, and &quot;errors&quot;, that must be <span style=\"color:#FF0000\"><b><u>&quot;DELETED&quot;</u></b></span>. (Read <span style=\"color:#FF0000\"><u><b>&quot;DELETED&quot;</b></u></span> with Cyberman voice effects.)","signature":"<hr class=\"b-divider\"/><br/><div align=\"center\"><a href=\"http://www.nodiatis.com/personality.htm\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://www.nodiatis.com/pub/12.jpg\" border=\"0\" alt=\"\" /></a></div> &quot;A free society is one in which it is safe to be unpopular.&quot;<br /> <span style=\"color:DarkRed\"><span style=\"font-size:20px\"><span style=\"font-family:Comic Sans MS\">I find <a href=\"https://www.google.com/url?sa=t&amp;rct=j&amp;q=&amp;esrc=s&amp;source=web&amp;cd=3&amp;cad=rja&amp;uact=8&amp;ved=0ahUKEwin4NXQzLfXAhVGySYKHV3TDXYQFgg3MAI&amp;url=http%3A%2F%2Fwww.ign.com%2Farticles%2F2017%2F04%2F25%2Fmarvels-nick-spencer-on-captain-americas-betrayal-and-handling-fan-reactions&amp;usg=AOvVaw2EcsX7n5ebntygb0TizyGl\" target=\"_blank\">Nick Spencer</a> and <a href=\"https://www.google.com/url?sa=t&amp;rct=j&amp;q=&amp;esrc=s&amp;source=web&amp;cd=4&amp;cad=rja&amp;uact=8&amp;ved=0ahUKEwiK7d7szLfXAhXCWSYKHTpKBbcQFgg4MAM&amp;url=https%3A%2F%2Fen.wikipedia.org%2Fwiki%2FRichard_B._Spencer&amp;usg=AOvVaw1tuP6phfINia-bh_jWsDT_\" target=\"_blank\">Richard Spencer</a> to be equally repulsive.</span></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/6138-mangle77","name":"Mangle77","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar6138_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2015"},{"key":"Posts:","value":"605"}]},"thankedby":[]},{"date":"2015-07-09T10:46:30-07:00","id":584874,"title":"","content":"I prefer the &quot;in, not of,&quot; argument.","signature":"<hr class=\"b-divider\"/><br/>Crunch isn't a hobby; it's a calling.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1959-hexmeister-vic","name":"Hexmeister Vic","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1959_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"764"}]},"thankedby":[]},{"date":"2015-07-09T13:16:52-07:00","id":585064,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Hexmeister Vic</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=584874#post584874\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I prefer the &quot;in, not of,&quot; argument.</div> </div> </div> </div>I am confused, &quot;in, not of,&quot;, what, exactly?","signature":"<hr class=\"b-divider\"/><br/><div align=\"center\"><a href=\"http://www.nodiatis.com/personality.htm\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://www.nodiatis.com/pub/12.jpg\" border=\"0\" alt=\"\" /></a></div> &quot;A free society is one in which it is safe to be unpopular.&quot;<br /> <span style=\"color:DarkRed\"><span style=\"font-size:20px\"><span style=\"font-family:Comic Sans MS\">I find <a href=\"https://www.google.com/url?sa=t&amp;rct=j&amp;q=&amp;esrc=s&amp;source=web&amp;cd=3&amp;cad=rja&amp;uact=8&amp;ved=0ahUKEwin4NXQzLfXAhVGySYKHV3TDXYQFgg3MAI&amp;url=http%3A%2F%2Fwww.ign.com%2Farticles%2F2017%2F04%2F25%2Fmarvels-nick-spencer-on-captain-americas-betrayal-and-handling-fan-reactions&amp;usg=AOvVaw2EcsX7n5ebntygb0TizyGl\" target=\"_blank\">Nick Spencer</a> and <a href=\"https://www.google.com/url?sa=t&amp;rct=j&amp;q=&amp;esrc=s&amp;source=web&amp;cd=4&amp;cad=rja&amp;uact=8&amp;ved=0ahUKEwiK7d7szLfXAhXCWSYKHTpKBbcQFgg4MAM&amp;url=https%3A%2F%2Fen.wikipedia.org%2Fwiki%2FRichard_B._Spencer&amp;usg=AOvVaw1tuP6phfINia-bh_jWsDT_\" target=\"_blank\">Richard Spencer</a> to be equally repulsive.</span></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/6138-mangle77","name":"Mangle77","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar6138_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2015"},{"key":"Posts:","value":"605"}]},"thankedby":[]},{"date":"2015-07-09T18:09:57-07:00","id":585495,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mangle77</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=585064#post585064\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I am confused, &quot;in, not of,&quot;, what, exactly?</div> </div> </div> </div>Stick that phrase between &quot;The Dark Mother is&quot; and &quot;the Primordial Dream.&quot;","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:trebuchet ms\"><span style=\"color:#4B0082\"><b>Resident Lore-Hound</b></span><br /> Currently Consuming: <i>Demon: the Descent 1e</i></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/111-satchel","name":"Satchel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar111_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9828"}]},"thankedby":[]},{"date":"2015-07-09T19:21:13-07:00","id":585527,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Satchel</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=585495#post585495\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Stick that phrase between &quot;The Dark Mother is&quot; and &quot;the Primordial Dream.&quot;</div> </div> </div> </div>I was more referring to the God-Machine and the Fallen World. The reason Its Agents/Apostates aren't Kin is because they are not manifestations of horror the way other supernaturals are, because, by the nature of Its power, they are beyond the unknown, but are rather Unknowable, so any reflection of them within the Shadow or the higher, inner, or lower Realms are imperfect to the point that effects that would duplicate or identify them are laughably ineffective.","signature":"<hr class=\"b-divider\"/><br/>Crunch isn't a hobby; it's a calling.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1959-hexmeister-vic","name":"Hexmeister Vic","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1959_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"764"}]},"thankedby":[]},{"date":"2015-07-09T21:30:08-07:00","id":585634,"title":"","content":"Especially since there are several other types of demons including the infernal ones from Inferno.<br /> <br /> Someone has a nightmare about demons, what are the odds his nightmare is a rogue AI former energy construct who knows the cheatcodes of the universe, and not something a lot more grounded in the human zeitgeist?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/391-stsword","name":"StSword","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar391_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1635"}]},"thankedby":[]},{"date":"2015-07-10T02:16:18-07:00","id":585782,"title":"","content":"It's also debatable if the GM is even supernatural enough to count as Kin. The powers wielded by demons and angels can all be replicated by human technology, the principles just haven't been discovered yet and the technology isn't advanced enough.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/477-xenorath","name":"Xenorath","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar477_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"169"}]},"thankedby":[]},{"date":"2015-07-10T11:49:49-07:00","id":586302,"title":"","content":"Did we ever find out what the era the Dark Era is","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.youtube.com/channel/UCxrkv14ojD_TQXU0RBvF33Q\" target=\"_blank\">Fool's Corner Productions</a>: Where we review Video Game, and eventually tabletop RPGs<br /> <br /> <img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://dl.dropboxusercontent.com/u/7019410/Images/Ex3%20KS%20Badge.gif\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img31/2512/25ew.png\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/461-kingcarnival","name":"KingCarnival","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar461_2.gif","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"170"}]},"thankedby":[]},{"date":"2015-07-10T17:55:13-07:00","id":586646,"title":"","content":"Skimming through the drafts again I notice that we now have rules for how your normal Health and your Horror's Astral Health interact and that the Horror has gotten something of a buff \u2014 you now distribute twice your Lair in additional points between its Power, Finesse, Resistance, and Size.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:trebuchet ms\"><span style=\"color:#4B0082\"><b>Resident Lore-Hound</b></span><br /> Currently Consuming: <i>Demon: the Descent 1e</i></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/111-satchel","name":"Satchel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar111_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9828"}]},"thankedby":[]},{"date":"2015-07-10T21:51:04-07:00","id":586774,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>KingCarnival</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=586302#post586302\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Did we ever find out what the era the Dark Era is</div> </div> </div> </div><br /> i don't believe so - it's for the Companion, not the main Dark Eras book, so it's a bit on the back burner while they get that first batch completed.","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2015-07-10T21:55:23-07:00","id":586776,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>glamourweaver</strong> <a href=\"https://fo