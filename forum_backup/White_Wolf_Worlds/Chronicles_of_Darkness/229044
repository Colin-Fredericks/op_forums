ars/0/0/6/0/4/5/avatar4433_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"4202"}]},"thankedby":[]},{"date":"2015-06-30T09:33:40-07:00","id":574037,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ganonso</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=573853#post573853\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Bur then compared to Omage flame wars, it is nothing to worry about :<img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /></div> </div> </div> </div>Omage flame wars?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3400-nalak42","name":"nalak42","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3400_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2014"},{"key":"Posts:","value":"2931"}]},"thankedby":[]},{"date":"2015-06-30T09:44:29-07:00","id":574041,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ganonso</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/beast-the-primordial-aa/229044-beast-the-primordial?p=573853#post573853\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The critics are still going strong in Rpg.net, yes. Apparently people who dissaprove of BtP are anxious to see people wanting to play a Beast (because they are cross-over friendly) at their table.<br /> <br /> Bur then compared to Omage flame wars, it is nothing to worry about :<img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /><br /></div> </div> </div> </div><br /> Would that be the fights over who was the good guy in oMage? If so, that is still a thing that happens heh. Yeah, I looked through the previews and mostly like what I saw, at least with reference to the rules. I give WoD a bit of leeway with dark stuff, especiallynWoD, where a lot of it is at least a little more tame than its older counter parts, stuff from V:tM and certain W:tA books spring to mind. Also, at least with the poisoned candy one, she seems to be taking on a folkloric aspect almost, you know all those urban legends about poisoned Halloween candy and the like. A lot of other forums seem to slip rather quickly into echo chamber mode. Then again it has always been that way. I am still looking forward to this game. I like being the embodiment of humanities fears and legends.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/5383-lonesomewanderer1982","name":"Lonesomewanderer1982","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2015"},{"key":"Posts:","value":"3"}]},"thankedby":[]},{"date":"2015-06-30T09:48:45-07:00","id":574050,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\