xpath.com/core/avatars/0/0/6/0/4/5/avatar23812_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2018"},{"key":"Posts:","value":"16"}]},"thankedby":[]},{"date":"2018-07-02T16:43:17-07:00","id":1231981,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>White Oak Dragon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/1231193-geist-kickstarter-discussion-thread?p=1231974#post1231974\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I think that they already said that they don\u2019t appear in the core, but I could be mistaken.</div> </div> </div> </div> ah well. Book is still awesome. As cherubic said. Will be great for a night horrors book. <br /> <br /> Also. We\u2019re so close to goal.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24316-mrowl","name":"MrOwl","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2018"},{"key":"Posts:","value":"48"}]},"thankedby":[]},{"date":"2018-07-02T16:47:17-07:00","id":1231983,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MrOwl</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/1231193-geist-kickstarter-discussion-thread?p=1231970#post1231970\" rel=\"nofollow\