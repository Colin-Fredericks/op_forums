":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2081"}]},"thankedby":[]},{"date":"2014-08-28T05:24:39-07:00","id":243020,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dave Brookshaw</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/demon-the-descent/232989-getting-dtd-prestige-edition?p=242929#post242929\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Try living in Europe. My book should be somewhere on a boat crossing the Atlantic. I've been keeping my eye out for a tracking number to say it's arrived at the UK distro firm.</div> </div> </div> </div>Of course if they piss you off you can always kill them off in MtAw 2nd Ed. The postal worker who gets eaten by an abyssal entity posing as a package.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1250-shadowlost","name":"Shadowlost","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1250_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"155"}]},"thankedby":[]},{"date":"2014-08-28T06:25:40-07:00","id":243051,"title":"","content":"Ok so it looks like i'm not the only one still waiting","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/991-pgolasze13","name":"pgolasze13","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Post