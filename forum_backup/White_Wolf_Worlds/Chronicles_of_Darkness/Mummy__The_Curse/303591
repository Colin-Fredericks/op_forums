c4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/4055-felipe","name":"Felipe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4055_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2014"},{"key":"Posts:","value":"538"}]},"thankedby":[]},{"date":"2014-11-07T21:04:15-08:00","id":306394,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Felipe</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mummy-the-curse/303591-secrets-of-the-book-of-the-deceived?p=306360#post306360\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">And he got more powerful not less, like Shuanksen do, when they devour mortals they replenish their Pillar Points.</div> </div> </div> </div>Yep. If I did anything clever there, it was making sure that the concept could work either way. And for Imhotep as presented, I think it does.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/277-cas","name":"CAS","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar277_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"33"}]},"thankedby":[]},{"date":"2014-11-07T22:03:22-08:00","id":306411,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ArcaneArts</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mummy-the-curse/303591-secrets-of-the-book-of-the-deceived?p=306048#post306048\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'd also like put forth the very real possibility that Marco Singe <i>was fucking insane</i>, ruined by exposure to the Machine. There's no evidence to suggest he's right in his story, particularly now that we <i>have</i> God-Machine demons. That means there's equally no evidence to even begin tying it to Mummy.<br /> <br /> Nice try.</div> </div> </div> </div>Or or or... The God-Machine is a liar.","signature":"<hr class=\"b-divider\"/><br/><i>&quot;These are merely stones...&quot;</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/276-merkonan","name":"Merkonan","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar276_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"132"}]},"thankedby":[]},{"date":"2014-11-07T22:20:20-08:00","id":306418,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Merkonan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mummy-the-curse/303591-secrets-of-the-book-of-the-deceived?p=306411#post306411\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Or or or... The God-Machine is a liar.</div> </div> </div> </div>Does God need to lie?<br /> <br /> That's always a fun little idea to poke at, particularly since I like looking across the room at Coyote-As-Creator.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2014-11-07T22:34:33-08:00","id":306419,"title":"","content":"<div class=\"b-bbcode b-bbcode__url b-bbcode__url--preview\"> <a href=\"https://imgflip.com/i/dxiu4\" target=\"_blank\" class=\"urlimg_container\"> <img class=\"js-img-fallback\" src=\"https://i.imgflip.com/dxiu4.jpg\"> </a> <div class=\"urlinfo\"> <div class=\"title ellipsis\"> <a href=\"https://imgflip.com/i/dxiu4\" target=\"_blank\"> Image tagged in creepy kirk </a> </div> <div class=\"url ellipsis\"> <a href=\"https://imgflip.com/i/dxiu4\" target=\"_blank\"> https://imgflip.com/i/dxiu4 </a> </div> <div class=\"meta\"> An image tagged creepy kirk </div> </div> </div><br /> <br /> C.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/277-cas","name":"CAS","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar277_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"33"}]},"thankedby":[]},{"date":"2014-11-07T22:38:50-08:00","id":306421,"title":"","content":"By the way, when Mummy first came out, I said I loved Anpu and wanted more Anpu.<br /> <br /> I loved