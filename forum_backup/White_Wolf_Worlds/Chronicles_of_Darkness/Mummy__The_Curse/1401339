ould be without those dots for two hours.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26513-laguz-24","name":"Laguz 24","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26513_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2020"},{"key":"Posts:","value":"31"}]},"thankedby":[]}]}