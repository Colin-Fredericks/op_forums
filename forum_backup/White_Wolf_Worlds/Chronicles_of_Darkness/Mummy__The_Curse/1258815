nicles of Darkness in the far future that is Warframe.<br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/760136-monarch-the-endless\" target=\"_blank\">Monarch: The Endless</a> You are an alien ruler, charged with maintaining a people who you shape to suit your needs.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/7015-almarck","name":"Almarck","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2015"},{"key":"Posts:","value":"1156"}]},"thankedby":[]}]}