0/4/5/avatar775_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"749"}]},"thankedby":[]},{"date":"2016-06-04T07:06:16-07:00","id":907085,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ZealousChristian24</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/349384-think-of-fictional-characters-and-say-what-they-would-be-in-cofd?p=904487#post904487\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> Honestly, I'd peg the former as a type of latter. Or a particularly weird kind of Sin-Eatet.</div> </div> </div> </div>Danny could just be a sin-eater with a weird caul manifestation that allows him to turn ghost and learn numina. Kind of like the ghost walk devotion from vtr ancient bloodlines, just change vampire to sin-eater:<br /> <br /> &quot;With this Devotion the vampire can literally walk as a ghost, manifesting as a physically visible specter. The flesh fades, and becomes the corpus of the diaphanous dead.&quot;<br /> <br />","signature":"","edited":{"userid":11914,"user_link":"https://forum.theonyxpath.com/member/11914-beyondthegrave","user":"BeyondTheGrave","date":". 06-07-2016, 05:17 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11914-beyondthegrave","name":"BeyondTheGrave","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11914_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"16"}]},"thankedby":[]},{"date":"2016-06-04T17:39:11-07:00","id":907342,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Vent0</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/349384-think-of-fictional-characters-and-say-what-they-would-be-in-cofd?p=901014#post901014\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Rocket Raccoon as a Deviant?</div> </div> </div> </div> \u200bThat is exactly what Rocket is.<br />","signature":"<hr class=\"b-divider\"/><br/><div align=\"center\"><a href=\"http://www.nodiatis.com/personality.htm\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://www.nodiatis.com/pub/12.jpg\" border=\"0\" alt=\"\" /></a></div> &quot;A free society is one in which it is safe to be unpopular.&quot;<br /> <span style=\"color:DarkRed\"><span style=\"font-size:20px\"><span style=\"font-family:Comic Sans MS\">I find <a href=\"https://www.google.com/url?sa=t&amp;rct=j&amp;q=&amp;esrc=s&amp;source=web&amp;cd=3&amp;cad=rja&amp;uact=8&amp;ved=0ahUKEwin4NXQzLfXAhVGySYKHV3TDXYQFgg3MAI&amp;url=http%3A%2F%2Fwww.ign.com%2Farticles%2F2017%2F04%2F25%2Fmarvels-nick-spencer-on-captain-americas-betrayal-and-handling-fan-reactions&amp;usg=AOvVaw2EcsX7n5ebntygb0TizyGl\" target=\"_blank\">Nick Spencer</a> and <a href=\"https://www.google.com/url?sa=t&amp;rct=j&amp;q=&amp;esrc=s&amp;source=web&amp;cd=4&amp;cad=rja&amp;uact=8&amp;ved=0ahUKEwiK7d7szLfXAhXCWSYKHTpKBbcQFgg4MAM&amp;url=https%3A%2F%2Fen.wikipedia.org%2Fwiki%2FRichard_B._Spencer&amp;usg=AOvVaw1tuP6phfINia-bh_jWsDT_\" target=\"_blank\">Richard Spencer</a> to be equally repulsive.</span></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/6138-mangle77","name":"Mangle77","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar6138_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2015"},{"key":"Posts:","value":"605"}]},"thankedby":[]},{"date":"2016-06-04T20:13:18-07:00","id":907401,"title":"","content":"The Toy Chest from the Foster's Home For Imaginary Friends special, &quot;Destination Imagination&quot; is almost exactly an Incarnate Beast:<ul><li>Personal pocket world that defies human understandings of space? That's a Lair.</li> <li>Obsessive, near-pathological need to control others? Pretty clear Tyrant behaviors.</li> <li>He can be anywhere, anyone and anything in his world at any time. Could be Ugallu, maybe Anakim.</li> </ul>","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://eoinsstuff.shoutwiki.com/wiki/Genius:_the_Transgression_(2nd_Edition)\" target=\"_blank\">Genius: the Transgression 2E is a thing that's being worked on.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4488-malonkey1","name":"malonkey1","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4488_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2016-06-07T00:38:51-07:00","id":908959,"title":"","content":"I honestly think you can do many characters as different games, so with that in mind...<br /> <br /> Korra from Legend of Korra as an Ithaeur Blood Talon<br /> <br /> I mean she patrols the Spirit and Physical world and decides how separate they should be representing both. Has rage issues, Tries constantly to become balanced and Spiritually whole. Even though spirits are a bit hostile toward her they look to her to settle disputes and she obviously has an honorary spirit rank. It's discovered the balance between worlds was created by the choice of a spiritual ancestor. Blood Talon because most of her enemies are other benders and she's aggressive. And to top it all off, sometimes loses control in physical distress than if more destructive could be a form of Karuth.<br /> <br /> Mako- An Irraka Storm Lord for both the lightning and he tries to play tough like things don't bother him, but also he tries to think things through and questions things. He tries to be stealthy and likes to plan ahead.<br /> <br /> Bolin- A Cahalith Iron Master Much more relaxed than the others, but between being a mover star, his general enthusiasm, and his belief in others Cahalith makes the most sense. Iron Master because he spends more time with people than the others, and has a deeper connection to place than the other two when Kovira came to town.<br /> <br /> Asami- Wolfblood with the Sagrim Ur merit and A Wolf's Meat Tell. The first is obvious she loves machines and is good with her hands. The second because she is always wearing gloves or other layers and it seemed appropriate if she's bringing silver to the fight.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/11938-3comrades","name":"3Comrades","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"90"}]},"thankedby":[]},{"date":"2016-06-07T05:09:53-07:00","id":909054,"title":"","content":"Alternately, Korra as an unusually benign Claimed (merged with Raava), and other Benders as pyro/aqua/aero/geokinetics","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://eoinsstuff.shoutwiki.com/wiki/Genius:_the_Transgression_(2nd_Edition)\" target=\"_blank\">Genius: the Transgression 2E is a thing that's being worked on.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/4488-malonkey1","name":"malonkey1","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4488_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2016-06-08T09:55:35-07:00","id":910144,"title":"","content":"So having just finished Perdido Street Station, I've got it on my mind.<br /> <br /> Obvious most of the characters are just mortals, possibly with supernatural merits or similar.<br /> <br /> The Remade are the most Deviant Deviants to ever Deviate. <br /> <br /> Slake-Moths are denizens of a Lower Depth (The Fractured Lands) which lacks any sort of Astral Space. Probably rank 3, difficult but not impossible for prepared and aided mortals to kill. <br /> <br /> The Weaver is probably a Supremal Demon, though I could also see spirit.<br /> <br /> And I have no idea what the Construct Council is, but its followers are a perfect God Machine Cult.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11821-st-just","name":"St.Just","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"19"}]},"thankedby":[]},{"date":"2016-06-13T17:55:05-07:00","id":913763,"title":"","content":"Superman as an Anakim Tyrant whose Horror is a glorious gleaming demigod (see DC One Million). He feeds by asserting his dominance as protector of Truth, Justice and the American Way. Lex Luthor is a Hero, and Darkseid is another Beast.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://eoinsstuff.shoutwiki.com/wiki/Genius:_the_Transgression_(2nd_Edition)\" target=\"_blank\">Genius: the Transgression 2E is a thing that's being worked on.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/4488-malonkey1","name":"malonkey1","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4488_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2016-06-13T18:34:56-07:00","id":913784,"title":"","content":"Darkseid is nothing short of an Exarch. I'd go so far as to say he is something above the Exarchs, as many of the known Exarchs are aspects of him in the DCU and even sometimes his high-ranking servants.<br /> <br /> <img src=\"http://img.photobucket.com/albums/v337/skandha/darkseid-is-here.jpg\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/><br /> <br /> While I was thinking Brainiac would be a Beast, he fits much better as a Demon who prefers machines-as-Cover and found a source of high technology. Metallo and Parasite as Deviants. Mr. Mxyzptlk as a True Fae, along with the other entities from his dimension.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2016-06-14T07:05:11-07:00","id":914069,"title":"","content":"Can't remember if this was already stated, but Santa Claus would make an excellent high Rank God-Machine Angel. Influence: Presents 5, Clairvoyance, Teleport (or Behind The Curtain as a Numina), Stop, Deep Pockets, and/or 4 Minutes Ago as Numina. Mission is to bring presents to all the nice kids in the world. Sacrifices used to empower him are letters to Santa Claus (for most of the year), and Milk and Cookies (during his run).","signature":"<hr class=\"b-divider\"/><br/>Malkydel: &quot;And the Machine dictated; let there be adequate illumination.&quot;<br /> Yossarian: &quot;And lo, it was optimal.&quot;","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/7212-vent0","name":"Vent0","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7212_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2015"},{"key":"Posts:","value":"5184"}]},"thankedby":[]},{"date":"2016-06-14T14:37:11-07:00","id":914378,"title":"","content":"Boris The Animal from Men In Black 3 is like a combination of a Namtaru and a Gangrel. The way he refers to that bug in his hand sounds like something a Beast might say about their Horror. And he growls like a vampire Lashing Out with the Competitive or Monstrous Beast.","signature":"<hr class=\"b-divider\"/><br/>Bye.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4443-gibberingeloquence","name":"GibberingEloquence","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4443_5.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"2470"}]},"thankedby":[]},{"date":"2016-06-16T13:06:49-07:00","id":915787,"title":"","content":"Right, so I've been playing Neverwinter Nights 2, and the main character's plight int the &quot;Mask of the Betrayer&quot; expansion strikes me as rather akin to somebody unwittingly implanted with a Beast's Horror. Not sure on the Family the Spirit-Eater comes from, or its hunger, but the Spirit-Eater Feats you pick up are all pretty clearly Kinship Nightmares.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://eoinsstuff.shoutwiki.com/wiki/Genius:_the_Transgression_(2nd_Edition)\" target=\"_blank\">Genius: the Transgression 2E is a thing that's being worked on.</a>","edited":{"userid":4488,"user_link":"https://forum.theonyxpath.com/member/4488-malonkey1","user":"malonkey1","date":". 06-19-2016, 08:54 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/4488-malonkey1","name":"malonkey1","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4488_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2016-06-19T16:52:14-07:00","id":917629,"title":"","content":"Bill Cipher?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/641-ben-linus","name":"Ben Linus","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"444"}]},"thankedby":[]},{"date":"2016-06-19T16:58:25-07:00","id":917635,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ben Linus</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/349384-think-of-fictional-characters-and-say-what-they-would-be-in-cofd?p=917629#post917629\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Bill Cipher?</div> </div> </div> </div> A powerful Acamoth (Abyssal entity that manifests through Astral phenomena) with the personality of a True Fae.<br />","signature":"<hr class=\"b-divider\"/><br/>Bye.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/4443-gibberingeloquence","name":"GibberingEloquence","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4443_5.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"2470"}]},"thankedby":[]},{"date":"2016-06-19T18:49:26-07:00","id":917707,"title":"","content":"- Hal 9000 (2001 - A Space Odyssey)?<br /> - Maria (Metropolis)?<br /> - Muta (This Island Earth)?<br /> - Aliens (The War of the Worlds)?<br /> - Dr Moreau (The Island of Doctor Moreau)?<br /> - Aberrations created by Moreau?<br /> - Xanatus (Gargoyles)?<br /> - Gargoyles (Gargoyles)?<br /> - Replicants (Bladerunner)?<br /> - Cthulhu?","signature":"","edited":{"userid":641,"user_link":"https://forum.theonyxpath.com/member/641-ben-linus","user":"Ben Linus","date":". 06-20-2016, 10:01 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/641-ben-linus","name":"Ben Linus","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"444"}]},"thankedby":[]},{"date":"2016-06-19T19:00:47-07:00","id":917710,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/641-ben-linus\" style=\"background-image:url('data:image/svg+xml;base64,');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"641\" data-vbnamecard=\"641\">Ben Linus</a>: A write up for <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/349384-think-of-fictional-characters-and-say-what-they-would-be-in-the-nwod?p=563072#post563072\"><b>Goliath</b></a> has been posted, but it uses the Dread Powers instead of the abilities specific to a major template.<br /> <br /> Cthulhu is an archetypal Bound (the ones from Mage, not Sin-Eaters). The Outer Gods might be different manifestations of the same Anunnaki (Greater Abyssal).<br /> <br /> Dr Moreau acts like a Genius with low Obligation from what I've heard, and he's cited in the inspirational material section for Genius: The Transgression.","signature":"<hr class=\"b-divider\"/><br/>Bye.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/4443-gibberingeloquence","name":"GibberingEloquence","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4443_5.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"2470"}]},"thankedby":[]},{"date":"2016-06-19T19:10:35-07:00","id":917716,"title":"","content":"I think making David Xanatos anything other than a very skilled and resourceful mortal kind of misses the point of his character.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/1419-wardragon","name":"WarDragon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1419_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1052"}]},"thankedby":[]},{"date":"2016-06-19T19:26:48-07:00","id":917725,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>WarDragon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/349384-think-of-fictional-characters-and-say-what-they-would-be-in-cofd?p=917716#post917716\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I think making David Xanatos anything other than a very skilled and resourceful mortal kind of misses the point of his character.</div> </div> </div> </div><br /> Same for the sect children (of Children of the Corn)?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ben Linus</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/349384-think-of-fictional-characters-and-say-what-they-would-be-in-cofd?p=917707#post917707\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><span style=\"color:#252C2F\"><span style=\"font-family:Helvetica\"><span style=\"font-size:13px\">- Maria (Metropolis)?</span></span></span><br /> <span style=\"color:#252C2F\"><span style=\"font-family:Helvetica\"><span style=\"font-size:13px\">- Aberrations created by Moreau?</span></span></span><br /> <span style=\"color:#252C2F\"><span style=\"font-family:Helvetica\"><span style=\"font-size:13px\">- Replicants (Bladerunner)?</span></span></span><br /> <span style=\"color:#252C2F\"><span style=\"font-family:Helvetica\"><span style=\"font-size:13px\">-</span></span></span></div> </div> </div> </div><br /> <br /> <span style=\"color:#252C2F\"><span style=\"font-family:Helvetica\"><span style=\"font-size:13px\">Prometheans? </span></span></span><br /> <br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ben Linus</strong> <a href=\"https://forum.theonyxpath.com/forum/main-cate