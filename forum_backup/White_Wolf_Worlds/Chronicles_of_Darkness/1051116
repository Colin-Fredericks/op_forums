6/0/4/5/avatar482_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"705"}]},"thankedby":[]},{"date":"2017-03-14T16:40:32-07:00","id":1062547,"title":"","content":"ok, so that is terrifying, especially since i often hear a small high-pitched whine/ringing late at night sometimes, when everything's quiet. In fact, I'm hearing it right now. Can I still can get in on this? I have a Changeling character who could be converted back to a mortal pretty easily. Foster kid just aging out of the system, trying to figure out what to do next. Only got to town recently, as he's more of a city man.","signature":"<hr class=\"b-divider\"/><br/><b>A god is just a monster you kneel to. </b>- ArcaneArts, Quoting &quot;Fall of Gods&quot; <div align=\"center\"><a href=\"http://www.nodiatis.com/personality.htm\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://www.nodiatis.com/pub/6.jpg\" border=\"0\" alt=\"\" /></a> </div>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/7920-master-aquatosic","name":"Master Aquatosic","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7920_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2015"},{"key":"Posts:","value":"2369"}]},"thankedby":[]},{"date":"2017-03-14T23:14:25-07:00","id":1062675,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Master Aquatosic</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/1051116-okay-so-let-s-read-this-thing?p=1062547#post1062547\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">ok, so that is terrifying, especially since i often hear a small high-pitched whine/ringing late at night sometimes, when everything's quiet. In fact, I'm hearing it right now. Can I still can get in on this? I have a Changeling character who could be converted back to a mortal pretty easily. Foster kid just aging out of the system, trying to figure out what to do next. Only got to town recently, as he's more of a city man.</div> </div> </div> </div>It's a solo game so you'll have to settle with reading it, I'm afraid. Thanks for the interest though.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://ekorrengames.com\" target=\"_blank\">ekorrengames.com</a><br /> <a href=\"https://www.youtube.com/@ekorren\" target=\"_blank\">youtube.com/@ekorren</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/482-ekorren","name":"Ekorren","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar482_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"705"}]},"thankedby":[]},{"date":"2017-03-15T05:51:43-07:00","id":1062749,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ekorren</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/1051116-okay-so-let-s-read-this-thing?p=1062675#post1062675\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">It's a solo game so you'll have to settle with reading it, I'm afraid. Thanks for the interest though.</div