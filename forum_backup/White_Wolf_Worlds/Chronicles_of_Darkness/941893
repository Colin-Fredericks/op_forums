dc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/4488-malonkey1","name":"malonkey1","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4488_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2017-01-31T12:05:25-08:00","id":1041386,"title":"","content":"Who ever lets the others argue while he grabs the soul wins, after all possession is 9/10 of the law.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/12802-hardwire99","name":"Hardwire99","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12802_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2016"},{"key":"Posts:","value":"754"}]},"thankedby":[]},{"date":"2017-01-31T12:32:13-08:00","id":1041406,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>malonkey1</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1041371#post1041371\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Yet another thing that can contract people for their souls in some way. I just want to see a G-M Demon, an Inferno Demon, a Changeling, a Mage, and a Geist all arguing who's supposed to get some poor schmuck's soul.</div> </div> </div> </div>Well, there's a reason that soul-contracts are such a robust trope in literature and what-have-you. They're drama made easy.","signature":"<hr class=\"b-divider\"/><br/><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://theonyxpath.com/forum/core/<img class=\"bbcode-attachment js-need-data-att-update\" src=\"filedata/fetch?filedataid=423\" data-tempid=\"temp_423_1523360155059_212\" />\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/10397-ajf115","name":"ajf115","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10397_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2015"},{"key":"Posts:","value":"2416"}]},"thankedby":[]},{"date":"2017-01-31T13:56:21-08:00","id":1041463,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ajf115</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1041406#post1041406\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Well, there's a reason that soul-contracts are such a robust trope in literature and what-have-you. They're drama made easy.</div> </div> </div> </div>Well, if the Unchained gets there first, then I think that ends it (being erased from/replaced in existences does bad things for a soul). Other than that, all the others could place an interesting game of capture the <s>flag</s>soul.","signature":"<hr class=\"b-divider\"/><br/>Malkydel: &quot;And the Machine dictated; let there be adequate illumination.&quot;<br /> Yossarian: &quot;And lo, it was optimal.&quot;","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/7212-vent0","name":"Vent0","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7212_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2015"},{"key":"Posts:","value":"5184"}]},"thankedby":[]},{"date":"2017-01-31T14:24:04-08:00","id":1041480,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Vent0</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1041463#post1041463\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Well, if the Unchained gets there first, then I think that ends it (being erased from/replaced in existences does bad things for a soul). Other than that, all the others could place an interesting game of capture the <s>flag</s>soul.</div> </div> </div> </div>Excellent point. And I don't even want to think about what might happen if said soul was sacrificed to the God-Machine itself. Souls-as-gear-grease. Naaaaaasty.","signature":"<hr class=\"b-divider\"/><br/><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://theonyxpath.com/forum/core/<img class=\"bbcode-attachment js-need-data-att-update\" src=\"filedata/fetch?filedataid=423\" data-tempid=\"temp_423_1523360155059_212\" />\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/10397-ajf115","name":"ajf115","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10397_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2015"},{"key":"Posts:","value":"2416"}]},"thankedby":[]},{"date":"2017-02-01T09:51:47-08:00","id":1041885,"title":"","content":"I don't think Changelings deal in souls usually.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2241-omegaphallic","name":"Omegaphallic","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"3435"}]},"thankedby":[]},{"date":"2017-02-02T01:08:10-08:00","id":1042273,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>malonkey1</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1041371#post1041371\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Yet another thing that can contract people for their souls in some way. I just want to see a G-M Demon, an Inferno Demon, a Changeling, a Mage, and a Geist all arguing who's supposed to get some poor schmuck's soul.</div> </div> </div> </div>Nope. The Bargain doesn't give the geist a claim to the Sin-Eater's soul. In fact, since the soul vanishes at (or shortly after) death, Sin-Eaters don't really have souls. Not that that seems to particularly hamper them in their day-to-day.","signature":"<hr class=\"b-divider\"/><br/>Travis Stout<br /> Geist 2e Developer","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/12259-gimpinblack","name":"GimpInBlack","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2016"},{"key":"Posts:","value":"81"}]},"thankedby":[]},{"date":"2017-02-02T01:22:47-08:00","id":1042274,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>GimpInBlack</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1042273#post1042273\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Nope. The Bargain doesn't give the geist a claim to the Sin-Eater's soul. In fact, since the soul vanishes at (or shortly after) death, Sin-Eaters don't really have souls. Not that that seems to particularly hamper them in their day-to-day.</div> </div> </div> </div>That makes sense. So the Giest doesn't just bring you back but mitigates the effects of Soul Loss...<br /> Mind you, I thought the Bargain was more like a set of prerogatives than a deal with a demon. You agree to do SOMETHING and let this fella hitch a ride, in return for a second shot at life and kwel death-themed magic.","signature":"<hr class=\"b-divider\"/><br/>Thoughts ripple out, birthing others","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1624-falleneco","name":"FallenEco","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1624_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"1927"}]},"thankedby":[]},{"date":"2017-02-02T01:48:09-08:00","id":1042283,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>GimpInBlack</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1042273#post1042273\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Nope. The Bargain doesn't give the geist a claim to the Sin-Eater's soul. In fact, since the soul vanishes at (or shortly after) death, Sin-Eaters don't really have souls. Not that that seems to particularly hamper them in their day-to-day.</div> </div> </div> </div>Interesting. Very interesting...<br /> <br /> So, what about all those supernatural powers that affect the soul? I suspect it's similar to how they work on Beasts and their Horrors.","signature":"<hr class=\"b-divider\"/><br/>MtAw Homebrew:<br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1051456-even-more-legacies-updated-to-2e#post1051456\" target=\"_blank\">Even more Legacies, updated to 2E</a><br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1443819-new-2e-legacies-expanded\" target=\"_blank\">New 2E Legacies, expanded</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12619-21c-hermit","name":"21C Hermit","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12619_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"3489"}]},"thankedby":[]},{"date":"2017-02-02T07:15:53-08:00","id":1042397,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>GimpInBlack</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1042273#post1042273\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Nope. The Bargain doesn't give the geist a claim to the Sin-Eater's soul. In fact, since the soul vanishes at (or shortly after) death, Sin-Eaters don't really have souls. Not that that seems to particularly hamper them in their day-to-day.</div> </div> </div> </div>It's funny to me that vampires still have their souls but Bound don't. Not a bad thing, mind, it just makes me laugh that the most iconic undead, especially of the * of Darkness games, definitively still have their souls, whereas creatures like Bound don't.","signature":"<hr class=\"b-divider\"/><br/>&quot;<a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/werewolf-the-forsaken/127887-doing-first-tongue-translations?p=484226#post484226\" target=\"_blank\">Nihhina kalekal-zidu kal masun, kal manudanadu. Nihhina kalekal-zidu nukal shaghu-desasudu \u2014 nihhina kalekal-zidu kal innu-desasudu udhkal samm</a>.&quot; Arthur Ashe<br /> She/her, contributing writer for <a href=\"https://www.drivethrurpg.com/product/363404/Scion-Pride-2021\" target=\"_blank\">Scion: Pride 2021</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1923-bigdamnhero","name":"BigDamnHero","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1923_4.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"1263"}]},"thankedby":[]},{"date":"2017-02-02T08:11:25-08:00","id":1042423,"title":"","content":"I can see that during an embrace at the moment of death the power of the embrace traps the soul. A Geist makes a bargain with someone after death and the soul has already departed.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12802-hardwire99","name":"Hardwire99","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12802_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2016"},{"key":"Posts:","value":"754"}]},"thankedby":[]},{"date":"2017-02-02T09:19:14-08:00","id":1042469,"title":"","content":"I had been told the Geist and Soul merge with the Bargain.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://eoinsstuff.shoutwiki.com/wiki/Genius:_the_Transgression_(2nd_Edition)\" target=\"_blank\">Genius: the Transgression 2E is a thing that's being worked on.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4488-malonkey1","name":"malonkey1","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4488_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2017-02-02T09:21:51-08:00","id":1042471,"title":"","content":"And who told you that?","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#000000\"><b>Dave Brookshaw</b></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/14-dave-brookshaw","name":"Dave Brookshaw","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar14_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2081"}]},"thankedby":[]},{"date":"2017-02-02T09:27:14-08:00","id":1042474,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>GimpInBlack</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1042273#post1042273\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Nope. The Bargain doesn't give the geist a claim to the Sin-Eater's soul. In fact, since the soul vanishes at (or shortly after) death, Sin-Eaters don't really have souls. Not that that seems to particularly hamper them in their day-to-day.</div> </div> </div> </div>As relates to other monsters, does &quot;shortly after&quot; sometimes mean &quot;within a few days&quot;? I ask mostly because of things like the postmortem Embrace and the stipulations of Demon's Raise Dead Exploit.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:trebuchet ms\"><span style=\"color:#4B0082\"><b>Resident Lore-Hound</b></span><br /> Currently Consuming: <i>Demon: the Descent 1e</i></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/111-satchel","name":"Satchel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar111_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9828"}]},"thankedby":[]},{"date":"2017-02-02T09:42:11-08:00","id":1042480,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>GimpInBlack</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1042273#post1042273\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Nope. The Bargain doesn't give the geist a claim to the Sin-Eater's soul. In fact, since the soul vanishes at (or shortly after) death, Sin-Eaters don't really have souls. Not that that seems to particularly hamper them in their day-to-day.</div> </div> </div> </div>wait- what? who? when? what?! <b><i>what???</i></b><br /> <br /> that just caught me 100% off guard. Sin Eaters don't have souls. Sin. Eaters. Don't. Have. Souls. ha. haha. hahahahahaha. It's just so... so... so...<br /> <br /> its the craziest, weirdest, most appropriate thing I've ever heard. It's just so... right. All the internet arguments people had over whether or not <i>ghosts</i> should have souls, and that even without souls ghosts are still people- and now, this.<br /> <br /> Sin Eaters don't have souls.<br /> <br /> That's just awesome. Geist is awesome. This is the best thing ever. Being a person while not being a person, being alive, while still with one foot in the grave. Pure nihilism, which gives birth to the greatest celebration ever. Dancing with the dead in the carnival of life. So many images, so much beauty and tragedy and pain and hope and lust and shadows and light that its is just amazing. The gods of death being the trash of heaven, clinging to the cloths of pale horsemen as they ride toward the apocalypse and laugh all the way out. You are dead- but alive. You are a miracle, you are nothing. Who needs souls nowadays- not you. You just wear a mask instead and join the festival.<br /> <br /> I'm sorry- my synesthesia all flared out because of that sentence, and I had to write it down. It's just that awesome. No matter what other changes Geist is going to have, I think that this little thing is the best one.<br /> <br /> Sin Eaters don't have souls.<br /> <br /> That's awesome.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.storytellersvault.com/browse.php?author=Shachar%20Gold\" target=\"_blank\">Check my STV content</a>, <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/28219-my-weekly-wod-project-program\" target=\"_blank\">Or My Homebrew</a><br /> <br /> &quot;And all our knowledge is, Ourselves to know&quot;- An Essay on Man<br /> <br /> I now blog in <a href=\"https://chroniclesoflostlight.wordpress.com/\" target=\"_blank\">here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":7}],"user":{"link":"https://forum.theonyxpath.com/member/503-lostlight","name":"LostLight","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar503_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"4531"}]},"thankedby":[]},{"date":"2017-02-02T10:04:46-08:00","id":1042489,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>GimpInBlack</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1042273#post1042273\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Nope. The Bargain doesn't give the geist a claim to the Sin-Eater's soul. In fact, since the soul vanishes at (or shortly after) death, Sin-Eaters don't really have souls. Not that that seems to particularly hamper them in their day-to-day.</div> </div> </div> </div> That's a massive change from 1e Giest I believe. One wonders how the Sin-Eater feels about having they're soul gone to the, afterlife. <br /> <br /> It's weird how in the CoD souls are so replaceable, it adds to the horror when you realize how you can replace your soul with with things like a somebody else's soul, divine fire, a vampires beast, ect..., and still function. <br /> <br /> Still if the soul is gone and the brain is rotting meat, what does the Giest make a bargain with?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2241-omegaphallic","name":"Omegaphallic","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"3435"}]},"thankedby":[]},{"date":"2017-02-02T10:53:16-08:00","id":1042512,"title":"","content":"<s>I imagine that means the Bargain is Geist is offering to fill the &quot;slot&quot; for the Sin-Eater-to-be in much the same way a Horror takes over as a pseudo-soul for Beasts, not bargaining with the soul for anything in particular.</s> Heck, pretty sure that exact comparison was made before in official material somewhere... which raises questions of what might happen in the same circumstances with other kinds of ephemeral entities (maybe that's exactly what the difference is between capital-P Possessed from <i>Inferno</i> and lowercase-p possessed in general?), but that's a matter for discussing elsewhere.<br /> <br /> <i>Edit:</i> Ohh, I see what you're getting at... it does raise again the question of where exactly a mortal's consciousness &quot;sits&quot;, yeah, but we've known for a while that the soul is pretty much interchangeable in this setting (for all the horror and <s>fun</s> weirdness that implies), so &lt;&lt;;<br /> <br /> But yeah, this really does drive home just how intensely Sin-Eaters blur that line between life and death, and as a result helps double down on the game's themes as a whole. Internally squeeing in anticipation right now.","signature":"<hr class=\"b-divider\"/><br/>I've got a bit of a bad habit of extensively editing my posts after the fact. Please try and bear with me...<br /> In case you're comfortable being more friendly and casual about things, my name's Seren, or Es/Es for short. They/Them or Fae/Faer, please.","edited":{"userid":3946,"user_link":"https://forum.theonyxpath.com/member/3946-sconce","user":"Sconce","date":". 02-02-2017, 01:59 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3946-sconce","name":"Sconce","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"127"}]},"thankedby":[]},{"date":"2017-02-02T13:44:27-08:00","id":1042578,"title":"","content":"I imagine it is similar in the sense that a ghost in CoD is not a person's soul but rather an echo/imprint, so that when a Sin-Eater dies for the first time, their soul has already moved on, but the Geist's bargain is with the Sin-Eater's ghost shoving it back into the body and using itself as tether for the ghost and the body, anchoring itself in the process. Would make sense with the Vacant and the pain of a removed Geist not there to fill in the holes in the cracks of where their soul used to be.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/5557-runcible","name":"Runcible","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5557_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"164"}]},"thankedby":[]},{"date":"2017-02-02T15:24:36-08:00","id":1042633,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Omegaphallic</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1042489#post1042489\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> That's a massive change from 1e Giest I believe. One wonders how the Sin-Eater feels about having they're soul gone to the, afterlife.<br /> <br /> It's weird how in the CoD souls are so replaceable, it adds to the horror when you realize how you can replace your soul with with things like a somebody else's soul, divine fire, a vampires beast, ect..., and still function.<br /> <br /> Still if the soul is gone and the brain is rotting meat, what does the Giest make a bargain with?</div> </div> </div> </div>To turn that around a bit: if a Sin-Eater to be has died, what happened to their ghost?","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#000000\"><b>Dave Brookshaw</b></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/14-dave-brookshaw","name":"Dave Brookshaw","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar14_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2081"}]},"thankedby":[]},{"date":"2017-02-02T15:35:31-08:00","id":1042636,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Sconce</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1042512#post1042512\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Heck, pretty sure that exact comparison was made before in official material somewhere...</div> </div> </div> </div>I remember someone mentioning a mage character saying that in the Beast Anthology.","signature":"<hr class=\"b-divider\"/><br/><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://theonyxpath.com/downloads/Backer%20Badge%20small.png\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/178-michael","name":"Michael","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar178_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"3560"}]},"thankedby":[]},{"date":"2017-02-02T15:51:09-08:00","id":1042645,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dave Brookshaw</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/geist-the-sin-eaters/941893-geist-2nd-edition-thoughts-speculations?p=1042633#post1042633\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> To turn that around a bit: if a Sin-Eater to be has died, what happened to their ghost?</div> </div> </div> </div><br /> Not all that die create a ghost, Just so that I know that I have this correct let me lay this out. A person dies and they become a ghost. If they have no anchors or their anchors are destroyed/resolved they are pulled into the Underworld where they can become a Geist. How fast can that happen? The Geist makes a Bargain with the Body of the dead, How recently dead, moment, Hours, Days, Weeks? How long does it take a rank 2 ghost to become a rank 3 Geist once in the Underworld. If the body can be dead for a while and the rank two Ghost can become a Rank 3 Geist fast enough I propose the scenario below.<br /> <br /> A person dies and they have no anchors then they immediately go to the underworld, become a Geist upon arrival and then make a deal with themselves to return a Sin-Eater. Their Ghost become Geist makes a deal with the Their dead body. The Bargain is Made and the Geist is no easier on his ex-body then he would be on a different body. Just a hypothetical and a possible character concept.","signature":"","edited":{"userid":12802,"user_link":"https://forum.theonyxpath.com/member/12802-hardwire99","user":"Hardwire99","date":". 02-02-2017, 06:59 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12802-hardwire99","name":"Hardwire99","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12802_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2016"},{"key":"Posts:","value":"754"}]},"thankedby":[]},{"date":"2017-02-02T16:50:16-08:00","id":1042676,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dave Brookshaw</strong> <a href=\"h