atars/0/0/6/0/4/5/avatar1996_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"150"}]},"thankedby":[]},{"date":"2014-06-21T22:38:44-07:00","id":176752,"title":"","content":"Contract of Elements: Basketball?","signature":"<hr class=\"b-divider\"/><br/>Once is happenstance. Twice is coincidence. Three times is enemy action. Four times is Infrastructure.<br /> <img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://img513.imageshack.us/img513/4478/8vno.png\" border=\"0\" alt=\"\" /><br /> Rule #2: Never let the game-mechanics get in the way of a good story.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1642-paddon","name":"Paddon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1642_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"326"}]},"thankedby":[]},{"date":"2014-06-24T10:37:25-07:00","id":179036,"title":"","content":"Oh dear god, Bugs Bunny as True Fae. I hope you are happy with yourselves, you monsters.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3343-radiodragon","name":"Radiodragon","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2014"},{"key":"Posts:","value":"4"}]},"thankedby":[]},{"date":"2014-06-26T15:15:04-07:00","id":181288,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Radiodragon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-