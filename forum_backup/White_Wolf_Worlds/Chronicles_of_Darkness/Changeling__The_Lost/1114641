date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11752-cloudscar","name":"Cloudscar","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11752_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"1"}]},"thankedby":[]},{"date":"2017-07-12T07:00:24-07:00","id":1115074,"title":"","content":"What marin said. You're going to have to define valkyrie for us. A true mythological valkyrie that collects fallen warriors and sends them on to the next world is different from a more modern take, or a video game like Valkyrie Profile. If its just the winged warrior woman type, that's really easy to pull off.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2102-mcn","name":"MCN","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2102_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"3479"}]},"thankedby":[]}]}