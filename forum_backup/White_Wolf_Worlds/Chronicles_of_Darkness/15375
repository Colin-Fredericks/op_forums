ist venue than I did before!<br />","signature":"<hr class=\"b-divider\"/><br/>&quot;Nothing is foolproof for a sufficiently talented fool.&quot;","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/981-bigwhitt","name":"bigwhitt","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar981_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"15"}]},"thankedby":[]}]}