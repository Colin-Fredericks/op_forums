99\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">4-5</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">3</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">2</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">6-7</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">4</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">3</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">2</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">8-9</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">5</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">4</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">3</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">2</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">10</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">6</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">5</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">4</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">3</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">2</span></span></td> </tr> </table></div> <br /> <span style=\"font-family:Aptos\"><span style=\"font-family:Arial\"><span style=\"font-size:14px\">The reason i originally decided to go with the previous version was because i felt like 2 rouse check for 2 vitae, is a bit too expensive, but for a group that would prefer to remove that added complication, this table might be a better fit.</span></span></span><br /> \u200b","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26771-algarik","name":"Algarik","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26771_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2021"},{"key":"Posts:","value":"115"}]},"thankedby":[]},{"date":"2026-09-04T03:29:35-07:00","id":1563823,"title":"","content":"Is there a reason for those powers to never be free?<br /> <br /> Not a mathematical reson, but does it really benefits game design?<br /> <br /> Or is it maybe worth it to let someone powers become free once the character has enough power?<br /> <br /> My experience in many games in the last years has shown that sometimes keeping track of small costs isn't just boring, but removing them actually improves the game as characters get more wiling to use such powers frequently and the change in &quot;power&quot; isn't really that big. Quite the opposite, the remaining cost is punishing expressions of power actually appropriate for the point the character reached.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2026-09-04T11:03:21-07:00","id":1563830,"title":"","content":"<span style=\"font-size:12px\"><span style=\"font-family:Arial\">The base game never assumes any reduction, so instinctively I assumed that no power should be free if they have a cost in the base game. Even V5 only gives rouse check rerolls.<br /> <br /> I don\u2019t think it adds any extra book keeping; it\u2019s not different than a starting character using a discipline. In my hunger system, hunger never goes above 5. It\u2019s not like the base system. We aren't tracking 1 vitae expenditure for Blood Potency 10 Elders with a vitae pool of 75.<br /> <br /> However, I don\u2019t think it would break the game in a mechanical way to have Discipline Cost Reduction reduce the cost of a disicpline to 0, but it would definitely change how the game plays.<br /> <br /> This goes beyond mathematical reason, but fundamentally changes one would interact with disciplines. If something is free, there\u2019s very little reason not to use it when you can. It becomes one of the other tools in the bag rather than a special power. It also further pushes back the need to hunt and deal with the survival part of being a vampire. <br /> <br /> That being said, there's nothing wrong with leaning into the blood-powered super hero trope, it's a perfectly valid way to play.<br /> <br /> It comes down to a matter of taste.</span></span> <hr /><span style=\"font-size:16px\"><span style=\"font-family:Arial\"><b>Free Disciplines</b></span></span><br /> <span style=\"font-size:12px\"><span style=\"font-family:Arial\">Free discipline could be cool for a very high-powered game. Or might require a different reduction table.<br /> <br /> As it stands in my current rule. If discipline reduction reduces discipline costs to 0, it would mean that, under the current table, a Blood Potency 4 character would treat vitae 1 discipline as free. At the top of my head this means :</span></span><ul><li><span style=\"font-size:12px\"><span style=\"font-family:Arial\">Free use of all physical disciplines. </span></span></li> <li><span style=\"font-size:12px\"><span style=\"font-family:Arial\">Free use of Obfuscate 2 and 3. </span></span></li> <li><span style=\"font-size:12px\"><span style=\"font-family:Arial\">Free use of Dominate 2. </span></span></li> <li><span style=\"font-size:12px\"><span style=\"font-family:Arial\">Free use of Majesty 3. </span></span></li> <li><span style=\"font-size:12px\"><span style=\"font-family:Arial\">Free use of Nightmare 2 and 4</span></span></li> <li><span style=\"font-size:12px\"><span style=\"font-family:Arial\">Free use of Protean 2 and 4. </span></span></li> </ul><span style=\"font-size:12px\"><span style=\"font-family:Arial\">This sounds more like very high-powered elder territory. At least Blood Potency 6, but even then I\u2019d personally go above.</span></span> <hr /><span style=\"font-size:16px\"><span style=\"font-family:Arial\"><b>My opinion </b></span></span><br /> <span style=\"font-size:12px\"><span style=\"font-family:Arial\">I prefer when all discipline involves a risk. Even for free discipline, in our home game we apply a free once per scene rule. Using the same discipline again will cost a rouse check after the first free use. Some are already like this in the base game, but not all.<br /> <br /> VTR disciplines are <i>very</i> powerful. They tend to take a scene by the rein and bypass subsystems like social maneuvering with a simple test that, more often than not, will succeed.<br /> <br /> In my first VTR chronicle, we had a Ventrue and he used to dominate against humans all the time. It was honestly\u2026 it got old fast. I know some storytellers are fine with this, but i don't like it. </span></span> <hr /><span style=\"font-size:16px\"><span style=\"font-family:Arial\"><b>Tangent on magic and superpowers</b></span></span><br /> <span style=\"font-size:12px\"><span style=\"font-family:Arial\">I have this love and hate relationship with magic and supernatural powers in RPG in general.<br /> <br /> On the one hand, I think it\u2019s cool, can create some interesting scenarios and overall is pretty fun to use, but on the other, I\u2019ve found that magic can often get out of hand when a setting or a system isn\u2019t prepared to deal with the ramifications of having said magic in a way that stifles creativity rather than enhancing it or gives storytellers headaches during preparation.<br /> <br /> Magic opens new areas of play but also removes a number of possible interesting scenarios.<br /> <br /> For example, If one has access to flying through spells, then you can expect that any ground-type difficulty will be ignored and any creative thinking involved goes out the window. If you have access to food creating magic, it\u2019s cool to roleplay a wizard cook, but any survival related scenario goes out the window.<br /> <br /> Of course magic can be limited, but it often comes to the detriment of the player\u2019s fun. If every time you encounter a significant disease, it\u2019s super resistant to a magical cure, then it feels like you shouldn\u2019t have invested in that spell at all.<br /> <br /> It\u2019s not always easy to balance fun challenge that encourage creative thinking without nullifying powers completely.</span></span><br /> <br /> <br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26771-algarik","name":"Algarik","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26771_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2021"},{"key":"Posts:","value":"115"}]},"thankedby":[]},{"date":"2026-09-04T18:37:54-07:00","id":1563846,"title":"","content":"I didn't say it creates extra bookkeeping. The point isn't if it is less or more, is if it is necessary regardless of comparison.<br /> <br /> And I do agree it changes how the game plays, but the change may be positive. It may also not be, depends on many things I didn't consider, I was just pointing that they we're relevant to.<br /> <br /> But one thing here I want to say very clearly: calling this &quot;superhero trope&quot; is offensively simplistic. Emphasis in &quot;offensive&quot;.<br /> <br /> Your take is valid, but this phrase overlook how varied other takes are by equating unrelated concepts. Powers can involve risks in many ways other than limiting their use. They can serve many different tropes and genres. Horror frequently makes good use of the temptation of a power with seemingly no cost.<br /> <br /> Superhero used out of context as was here is a sure sign of demeaning comparison, prejudice against the genre even if not voiced. But even if we set it aside, the literal cost/frequency of its use has fucking nothing to do with the genre.<br /> <br /> More on point, though, I find the idea that the setting isn't prepared to deal with consequence for the abuse of magic off. A character that is dealing with every mortal through Dominate should have faced plenty of them: a noticeable trail of degraded psyches, a lot of Kindred pissed because the was sowing problems in an obvious way, the people in the affected area starting to suffer measurable effects that reduce their capacity for useful work in all senses.<br /> <br /> Overall I'm seeing more lack of exploration of what they were doing than a power bypassing constraints. It's the same as it having a cost and the ST and player forgetting to record it.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2026-09-05T10:54:13-07:00","id":1563855,"title":"","content":"<span style=\"font-size:12px\"><span style=\"font-family:Arial\">Blood powered superhero was a simplistic throwaway line; it wasn\u2019t intended as an insult. Hence why I said \u2018\u2019lean in\u2019\u2019 and specifically mentioned that there was nothing wrong with that play style.<br /> <br /> That being said, I realize how it can be taken as offensive, has it has often been used to demean Vampire players certain playstyle over another. I apologize if it was offensive. It wasn\u2019t meant to ridicule or diminish your idea.<br /> <br /> What I meant was that a limited resource expenditure will inevitably lead to power being used more frequently and it could lead to some unintended consequences for characters as soon as BP 4 using the system I made.<br /> <br /> However, it\u2019s true that it could be used for very high-power elders to great effect.<br /> <br /> In the end, though, I don\u2019t think there\u2019s any gameplay incentive that will prove one to be superior to the other; it all comes down to the style of campaign you want to play.</span></span> <hr /><span style=\"font-size:12px\"><span style=\"font-family:Arial\">For the ventrue using dominate, \u2018\u2018All the time\u2019\u2019 was a slight exaggeration, but let\u2019s say they had done so every time it was advantageous to do so.<br /> <br /> In the end the player did end up paying for his abuse when his poorly worded entombed command created a big masquerade breach. He ended up discarding the character when he got tired of dealing with the consequences of his character\u2019s actions; for such player a direct mechanical deterrent is generally a better way of restricting power abuse. <br /> <br /> Creating limitations through narrative consequences is interesting, but it\u2019s extra work for the storyteller and it might not be applied evenly between the players.<br /> <br /> I personally prefer when there\u2019s a clear resources expenditure/risk involved with using a power.<br /> <br /> Anyway, my point wasn\u2019t that <i>Requiem</i> specifically isn\u2019t equipped to deal with it, it\u2019s just that magic in general create extra work for the storyteller and cut some angle where you can challenge players. Now that isn\u2019t necessarily limited to magic, but I\u2019ve found magic to be the most prone to generate headaches. Hence the love &amp; hate relationship. Anyway, it wasn\u2019t my main point, only an RPG tangent in general. </span></span> <hr /><b><span style=\"font-size:16px\"><span style=\"font-family:Arial\">Continuing the tangent</span></span></b><br /> <br /> <span style=\"font-size:12px\"><span style=\"font-family:Arial\">Let's take an actual recent example to illustrate my love &amp; hate feeling with magic.<br /> <br /> My player is currently in the middle of a semi-abandoned Cheiron Lab Complex with SCP-foundation vibe mixed with Umbrella Corps and a side dish of Stanley Parable/Portal with an evil Ai/Artificial Spirit thing i homebrewed. It was essentially running a dungeon with Vampire the Requiem rules, not optimal, but it made it functional. However, because discipline is as powerful as they are I had to make sure that :</span></span><ul><li><span style=\"font-size:12px\"><span style=\"font-family:Arial\">Walls were solid enough to avoid Vigor to punch down any wall.</span></span></li> <li><span style=\"font-size:12px\"><span style=\"font-family:Arial\">Not all monsters were susceptible to Mental Discipline or Obfuscate. </span></span></li> <li><span style=\"font-size:12px\"><span style=\"font-family:Arial\">Players couldn\u2019t escape by any means before completing their objectives.</span></span></li> </ul><span style=\"font-size:12px\"><span style=\"font-family:Arial\">All the while Making sure to reward disciplines usage in the opportune moment to acknowledge that my players did indeed invest experience point in those powers and it <i>should be relevant, </i>because well it sucks to your powers invalidated every time you want to use it.<br /> <br /> The Hermes System (the Artificial Spirit) came through later in the creation process where i was ''how can i make sure the lab is secure against spiritual intrusion?'' Then came the idea of a Artificial Spirit super computer with access to spiritual wards, elevator control and a quirky personality. This is actually also why i like supernatural stuff, where the extra considerations i had to take when designing the ''dungeon'' ended up sparkling creativity. The AI was actually the thing i ended up enjoying the most, as it essentially allowed me to act as an in world narrator; super fun. <br /> <br /> Why go through all that trouble one might one ask?<br /> <br /> I spend a little over 30 hours, no exaggeration, designing new monsters, physical prompts like the 75 pages of files materials players could read that include references to current NPCS their life, other they hate, secret information on how to beat the spirit, design the map. Paint new miniatures, etc.<br /> <br /> So, I wasn\u2019t ready to have a moment a la \u2018\u2019oh fuck I didn\u2019t plan my player with Vigor 3 to punch down a steel door with Durability 3. \u2018\u2019 or \u2018\u2019Oh fuck, I didn\u2019t plan my Nosferatu player could skip the whole Super deadly encounter with the Giant Flesh Ooze Monster thing designed to make the fighter feel badass by using Nightmare 4. \u2018\u2019<br /> <br /> In the end, the players and I had a lot of fun. They really liked all the physical props. I'm really glad it worked, I would have been devastated to have gone through all that work to have the player sidestep 3 hours of content simply because they were able to burst down a door that had access to the final area immediately.<br /> <br /> It has happened to me in the past and I always take it gracefully, but it sucks so much.<br /> </span></span>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26771-algarik","name":"Algarik","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26771_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2021"},{"key":"Posts:","value":"115"}]},"thankedby":[]}]}