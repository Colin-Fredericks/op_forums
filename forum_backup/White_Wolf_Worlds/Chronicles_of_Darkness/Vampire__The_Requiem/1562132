xt_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-size:9px\"><span style=\"font-family:Aptos\"><span style=\"color:black\">Animal and cold blood cannot reduce hunger below 2.</span></span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid4Accent2_tr\"><td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\"><b>3</b></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">4/1</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">2/1</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">-</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">2</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">2</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">30 seconds</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-size:9px\"><span style=\"font-family:Aptos\">Animal and cold blood cannot reduce hunger below 3.</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid4Accent2_tr\"><td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><b><span style=\"color:black\">4</span></b></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">5/2</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">4/2</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">-1</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">2</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">2</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">One Turn</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-size:9px\"><span style=\"font-family:Aptos\"><span style=\"color:black\">Animal and cold blood cannot reduce hunger below 4.</span></span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid4Accent2_tr\"><td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\"><b>5</b></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">6/3 </span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">4/2</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">-1</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">3</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">2</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">One Turn</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-size:9px\"><span style=\"font-family:Aptos\">Animal Blood and bagged blood slakes no hunger.</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid4Accent2_tr\"><td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><b><span style=\"color:black\">6</span></b></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">7/4</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">6/3</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">-1</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">3</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">3</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">2x / turn</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-size:9px\"><span style=\"font-family:Aptos\"><span style=\"color:black\">Even Human blood cannot reduce hunger bellow 4</span></span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid4Accent2_tr\"><td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\"><b>7</b></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">8/5</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">6/3</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">-2</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">4</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">3</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-family:Aptos\">2x / Turn</span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\"><span style=\"font-size:9px\"><span style=\"font-family:Aptos\">Even Human blood cannot reduce hunger bellow 4</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid4Accent2_tr\"><td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><b><span style=\"color:black\">8</span></b></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">9/6</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">8/4</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">-2</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">4</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">4</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">3x/ Turn</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-size:9px\"><span style=\"font-family:Aptos\"><span style=\"color:black\">Even Human blood cannot reduce hunger bellow 4</span></span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid4Accent2_tr\"><td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: white\"><span style=\"font-family:Aptos\"><b><span style=\"color:black\">9</span></b></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: white\"><span style=\"font-family:Aptos\"><span style=\"color:black\">10/7</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: white\"><span style=\"font-family:Aptos\"><span style=\"color:black\">10/5</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: white\"><span style=\"font-family:Aptos\"><span style=\"color:black\">-3</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: white\"><span style=\"font-family:Aptos\"><span style=\"color:black\">5</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: white\"><span style=\"font-family:Aptos\"><span style=\"color:black\">5</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: white\"><span style=\"font-family:Aptos\"><span style=\"color:black\">3x/ Turn</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: white\"><span style=\"font-size:9px\"><span style=\"font-family:Aptos\"><span style=\"color:black\">Even Human blood cannot reduce hunger bellow 4</span></span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid4Accent2_tr\"><td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><b><span style=\"color:black\">10</span></b></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">11/8</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">12/6</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">-4</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">7</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">6</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-family:Aptos\"><span style=\"color:black\">5x/ Turn</span></span></td> <td class=\"text_table_MsoTable15Grid4Accent2_td\" style=\"background-color: #ffb3b3\"><span style=\"font-size:9px\"><span style=\"font-family:Aptos\"><span style=\"color:black\">Only Vitae can slake hunger.</span></span></span></td> </tr> </table></div> <div align=\"left\"><span style=\"font-family:Aptos\"><span style=\"font-size:10px\">*BP 0 characters are ghouls.</span></span><br /> <br /> <span style=\"font-family:Aptos\"><b>Blood surge </b><br /> You canmake a rouse check once per turn, you gain Blood Surge value as extra dice on all physical action for a turn. At BP 3 or higher, you can use the lesser number to make two rouse check instead of once, only increasing your hunger if both fails. </span><br /> <br /> <span style=\"font-family:Aptos\"><b>Discipline Reduction </b><br /> With high blood potency, reduce the number of rouse check needed per discipline. If this would reduce the number of rouse check below 1, roll 2 dice instead of one, if one succeeds hunger does not increase.</span><br /> <br /> <span style=\"font-family:Aptos\"><b><span style=\"color:black\">Vitae Potency. </span></b><br /> <span style=\"color:black\">Vitae potency represent how must vitae and kindred can store and how much blood they need to take before feeding slated.<br /> <br /> It also represents how many nights they can wake up per single rouse check; this does not mean they stay awake during the day, simply that it doesn\u2019t tax their reserve enough to be relevant on a single night.<br /> <br /> When feeding on mortal a vampire needs to inflict a number of lethal damage equal to their vitae potency before reducing their hunger by 1.</span></span><br /> <br /> <span style=\"font-family:Aptos\"><b>Damage Mended</b><br /> A vampire can mend damage by making a rouse check. They can heal a number of bashing equal to the first number and a number of lethal damage equal to the second number. <br /> <br /> Healing a point of aggravated damage takes a full day of sleep each 5-point worth of lethal healing heals 1 aggravated damage. </span><br /> <br /> <span style=\"font-family:Aptos\"><b>Feeding Restriction.</b><br /> Feeding restriction makes a kindred unable to reduce their hunger bellow a certain threshold. Cold Blood, Animal blood can only satiate the beast to a certain degree.<br /> <br /> A character can ignore their feeding restriction, but this cost 1 point of willpower per hunger reduced below their restriction. Hunger cannot be reduced to 0 this way, unless a human victim is also killed.</span> <hr /> <div align=\"center\"><span style=\"font-family:Aptos\"><b>Some answer, to some question I anticipate receiving</b></span></div> <br /> <span style=\"font-family:Aptos\"><b>Why does sunlight damage scales differently than the book?</b></span><br /> <span style=\"font-family:Aptos\">simply felt like having a linear progression. Additionally, since BP 2 in my rework becomes a lot better by increasing the amount of rouse checks they can take per turn to 2, I wanted BP 1 characters to have a little edge in that aspect.</span><br /> <br /> <span style=\"font-family:Aptos\"><b>Why did you change feeding restriction?</b></span><br /> <span style=\"font-family:Aptos\">I made it a bit more linear. It\u2019s a bit more lenient than the base book also, since Willpower is spent per hunger reduced instead of per vitae taken. For two reasons:</span><ul><li><span style=\"font-family:Aptos\">Willpower tends not to regenerate very quickly in my games. </span></li> <li><span style=\"font-family:Aptos\">Elders already have so many ways to avoid blood bonds I didn\u2019t feel like lowering the restrictions a bit actually changed anything meaningful. Worse case scenario, an elder with no kindred connection can feed on humans by spending nearly all their willpower, it ain't free.</span></li> </ul><span style=\"font-family:Aptos\"><b>Does it make disciplines more expensive to use?</b></span><br /> <br /> <span style=\"font-family:Aptos\">Yes, in a way, and no in others.</span><br /> <br /> <span style=\"font-family:Aptos\">Since a rouse check has a 50% chance of increasing hunger, but a vampire\u2019s hunger threshold is a lot less than vitae maximum, I estimate that 1 vitae is approximately worth 1 rouse check. Starting at hunger 1 is the equivalent of starting at roughly 8 vitae, so just short of 10, which is the maximum of vitae for BP 1 character. I went with V5\u2019s way of making it harder to reach hunger 0; I want it to have cost or a risk. So, in that aspect, it\u2019s a bit more expensive to use disciplines, since your reserve is harder to fill compared to the base game. Once a character gets some discipline cost reduction from High BP, it starts to matter a bit less.</span><br /> <br /> <span style=\"font-family:Aptos\">In my experience what it truly does, is that player thinks a bit more before using their discipline, because it involves risks. For each fail hunger check increase their chance of rolling a bestial failure or success.</span><br /> <br /> <span style=\"font-family:Aptos\"><b>What\u2019s are chance to roll a Bestial success at any given hunger?</b></span><br /> <br /> <span style=\"font-family:Aptos\">At hunger 1, the chance is 1%, 3% at hunger 2, 5% at hunger 3, 7% at hunger 4, and 9% at hunger 5.</span><br /> <br /> <span style=\"font-family:Aptos\">Under the previous system with hunger dice, the chance to have a bestial failure would be a bit too weird for my math abilities, but it definitely felt too high for my taste. As for bestial success the chance was 3% at hunger 1, 6% at hunger 2, 9% at hunger 3, 12% at hunger 4 and 15% at hunger five.</span><br /> <hr /><br /> <span style=\"font-family:Aptos\">Feel free to ask if you have any questions!</span><br /> <br /> <span style=\"font-family:Aptos\">Feedback is also welcome, as long as it's constructive!</span><br /> </div> <br /> </div> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26771-algarik","name":"Algarik","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26771_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2021"},{"key":"Posts:","value":"115"}]},"thankedby":[]},{"date":"2026-07-24T21:14:20-07:00","id":1562137,"title":"","content":"What do you want Hunger to represent?<br /> <br /> The first issue I see here is a lot of choice effects without much clarity on what they're trying to build.<br /> <br /> Requiem is not Masquerade, much less V5. V5 Conditions and effects for Messy Criticals are a reflection of a concept of the Beast as moral degeneracy. In V5 it's not only a hungry thing, but a combination of malice and vice that induces the Vampire towards depravity.<br /> <br /> Legacy Masquerade has an amoral Beast. It is not interested in concepts of clan, power or vice. It's a violent animal, but ultimately moved by basic needs. Beneath the skin, all Beasts are equal, and it doesn't provoke the vampire into evil as much as represents loss of Ego: losing Humanity isn't about evil, but about losing your grasp on your own identity, slowly reduced to a mindless automaton.<br /> <br /> In Requiem the Beast is an alien intelligence that may or may not be linked to the Strix. It is driven by hunger, but it's ultimately Other. It is fed by the loss of grounding in this reality and seeks a new life where the concerns of mortals and Vampires alike don't have meaning.<br /> <br /> With all differences and nuance, the three games remain consistent in their vision of the Beast, with all mechanics feeding their main concept, be them restrictions, Conditions or what a Wight is.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2026-07-25T09:19:45-07:00","id":1562145,"title":"","content":"<span style=\"font-family:Aptos\">My goal is to make Vitae management a riskier endeavor than typical &quot;Blood Points.&quot;</span><br /> <br /> <span style=\"font-family:Aptos\">I want the players to feel the weight of their decision when they call on their special points; calling on the Beast's power is always going to be risky.</span><br /> <br /> <span style=\"font-family:Aptos\">Having playtested Hunger in V5 and my previous version of Hunger Dice, it works for our group. I tested it both as a Storyteller and as a player.</span><br /> <hr /><span style=\"font-family:Aptos\">As for the nature of the Beast in Requiem, nothing I have read from the core book seems to suggest to <u><i>me</i></u> that it's an alien intelligence. I interpret it more as raw impulse. I went and reread the information on the Beast, but maybe I missed something from the rest of the book, or in some other source somewhere. Anyhow, that's how it manifests in my chronicles.</span><br /> <br /> <span style=\"font-family:Aptos\">I don't attribute the Beast's wants to moral degeneracy, simply to those of a violent loner predator that wants to feed, dominate, and continue its existence. The Beast is short-sighted and can't plan for the long game, but it's insidious, and it feeds on certain feelings: Alienation, Anger, Arrogance, Callousness, Despair, Grief, and Isolation. It's definitely something other, but I see it as good enough to sometimes hide itself in the vampire's intention. At least, that's how I interpret it.</span><br /> <hr /><br /> <span style=\"font-family:Aptos\">Hunger is supposed to represent the increased danger of letting the Beast seep in. The hungrier it is, the louder it is. Or the hungrier you are, the more susceptible you are to its influence.</span> <br /> <br /> <span style=\"font-family:Aptos\">The Bestial Dice determine if the Beast gets to influence you in a significant action. The conditions are supposed to represent the Beast's bestial urge in that moment.</span><br /> <span style=\"font-family:Aptos\">Examples of bestial results:</span><ul><li><span style=\"font-family:Aptos\">On a successful <i>Wits + Empathy</i> test, you realize that your rival is lying to you. The Beast wants you to put them in their place; you gain the Competitive Condition for the scene.</span></li> <li><span style=\"font-family:Aptos\">On a successful <i>Presence + Persuasion</i> test, you successfully seduce your mark. The Beast's influence seeps in; it doesn't only want you to bring home one mark, it wants all of them. You gain the Wanton Condition.</span></li> <li><span style=\"font-family:Aptos\">On a successful <i>Manipulation + Intimidation</i> test, you successfully frighten your target into leaving you alone. The Beast likes that; you gain the Obsessed Condition as your Beast wants you to repeat the exploit again and again.</span></li> <li><span style=\"font-family:Aptos\">On a successful <i>Strength + Athletics</i> test to climb a nearby wall and spy on the rooftop, you jump 6 meters high as your Beast pushes you to your maximum thanks to your Vigor. Someone from across the street definitely noticed; hopefully no one will believe them.</span></li> <li><span style=\"font-family:Aptos\">On a failed I<i>ntelligence + Academics</i> test, as you try to recall some important obscure information about the law relevant to the murder case you're trying to solve, your hungry Beast is assailing you with images of bloody murder; make a Rouse Check, as all you can think of in this instant is blood.</span></li> <li><span style=\"font-family:Aptos\">On a failed <i>Dexterity + Larceny</i> test, you fail to disarm the alarm system and it goes off. Panic sets in. The Beast smells your panic; roll for fear frenzy.</span></li> </ul><br /> <span style=\"font-family:Aptos\">Maybe a caveat I should have added: I sometimes treat some rolls as &quot;trivial,&quot; the classic &quot;roll to see if you notice X detail.&quot; Those rolls are not subject to the Beast's influence. If the Beast's influence would have absolutely no dramatic effect, I'll consider the roll trivial.</span><br /> <br /> <span style=\"font-family:Aptos\">A vampire can also ignore what their Beast wants, to an extent, as getting a condition from a bestial test does not imply that they have to follow their urge.</span><br /> <span style=\"font-family:Aptos\">For example, in the last game I took part in, my character became Competitive as I realized on a Wits + Empathy test that someone was hiding something from me, and the Beast was annoyed by it. My character was aware that it was her Beast's urge and not her own, so she tried to channel those competitive feelings into something more productive. Since she was partying on a baseball field with a bunch of other people, she took part in a ball-strike contest, spent some Willpower, and thankfully managed to win, proving to everyone she was the best around. The Beast was partly sated.<br /> <br /> Finally one thing to keep in mind, is that i didn't want to have to rewrite the <i>whole </i>book. I like homebrewing, but i also like to play, lol. <br /> <br /> When i designed the hunger system, i wanted it to be usable with the base game. As it stand it does in our gaming circle. The idea is that you can pick a discipline from the book and know how many rouse check you need to do simply by reading the amount of vitae necessary. </span><br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26771-algarik","name":"Algarik","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26771_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2021"},{"key":"Posts:","value":"115"}]},"thankedby":[]},{"date":"2026-07-25T10:34:49-07:00","id":1562150,"title":"","content":"My first suggestion, then, is to focus more on general usage when asking for feedback. I see a recurring friction in your threads where you propose a rule, but you're not interested in hearing what people have to say on their use in situations that don't pertain to your group.<br /> <br /> That won't do. I can discuss the rule within the parameters and game goals you set, not within the specific culture and homebrews of your group. Either you engage broader conversation or you get more succinct in your questions. <hr /><br /> Your 1 Hunger Dice only take seems good. I can see issues with it requiring the extra roll, but nothing too worrying for now. Another approach may be to move the Hunger score from modeling the likelihood of interference to the intensity or duration of interference. That way no second roll is needed, and Hunger has a more nuanced effect where its value matter during the Condition.<br /> <br /> For the possible results, I'd remove the Rouse Check and revise how it may influence the roll. The Beast is hungry, not wasteful, rolling a Rouse Check for no benefit doesn't look at all as something it would do. You may instead homebrew a Hungry Condition where it pushes the Kindred to feed with abandon, instead.<br /> <br /> Vitae cost of 2 I'd convert to no roll rather than two dice. More mathematically sound and less complexity. Otherwise just do as V5 and calls more Rouse Checks with individual resolution.<br /> <br /> I don't like the rules that force more damage or killing the vessel to benefit from feeding. I don't like them in V5, I don't like them here, I think it's not an interesting constraint when it forbids you from building logistics and strategy just to say you have to be a killer to feed. I think doing a similar approach to the total slaking of the night is an acceptable compromise, forcing to cause X damage to a single victim is not. <hr /><br /> On to my point on goals: I think you may have misunderstood my description. I'm not saying VtR Beast is alien as in inscrutable, but as in a more overtly <i>extraneous</i> influence. A character experience the Beast as a thing that's clearly distinct from their Self, as intrusive sensation rather than a change in personality.<br /> <br /> And this directly affects what and how those Conditions and roll influences should work. I see a take that's still very similar to V5, but V5 does the moral degeneracy thing: the Beast is affecting complex emotions and thoughts as it is driving the Vampire to change personality into a worse version of themselves.<br /> <br /> With this in mind, I'd really avoid manifestating the Beast within intentions, at least in a more complex way. With Conditions, I'd consider the character getting more direct versions that feel like this extraneous influence, or at least as an impatient, crude goal. A vampire sometimes do think of those feelings as just their desires going intense, but ultimately it's recognizable as other, as dissociated from what they want.<br /> <br /> I'd similarly avoid the current take on influence roll to make for a more additive thing: instead of the Beast changing how the character goes with the roll, it adds a secondary if minor action that's only contextually related: a target notices the hungry eyes, the lock is picked but the tools are broken, an Aura flares without intention. I'd move from corrupting the action itself (which just succeeded or not) to adding anything else that shows the other, internal Beast coming to the fore opportunistically.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2026-07-25T13:58:22-07:00","id":1562155,"title":"","content":"<span style=\"font-family:Aptos\">Apology. Any friction perceived or caused is entirely unintentional.</span><br /> <br /> <span style=\"font-family:Aptos\">I\u2019ll try to explain my perspective on the matter.</span><br /> <br /> <span style=\"font-family:Aptos\">I thought I was clear in the beginning of my post about what I enjoyed about the hunger dice system, so I assumed that it was clear that it was my intention for the reworked version I posted. I\u2019ll try to be clearer next time.</span><br /> <br /> <span style=\"font-family:Aptos\">If I emphasized that I was speaking about my experience, it\u2019s because I dislike using language such as &quot;it is&quot; rather than &quot;I think it is&quot; when speaking about lore or media that are open to interpretation. You asked some clarifying questions, so I answered how I interpret the Beast from the source I have access to.</span><br /> <br /> <span style=\"font-family:Aptos\">Finally, I\u2019m interested in learning what others have to say; otherwise, I wouldn\u2019t write here. I try to engage in good faith. If I state that it doesn\u2019t relate to my group, it is simply that; it doesn\u2019t relate to my group, and it doesn\u2019t invalidate your experience. I\u2019m not arguing; I\u2019m explaining or clarifying my situation.</span><br /> <br /> <span style=\"font-family:Aptos\">What I\u2019ll admit I find frustrating is when intentions are ascribed to me that I did not state. Writing is an inherently flawed method of communication, and I try to always read things in the most charitable light. I\u2019d like others to return the favor. I guess I\u2019ll resume using emoticons, even if I find they make my writing look childish, but they somewhat lighten the mood.</span><br /> <br /> <span style=\"font-family:Aptos\">Anyway, suggestion noted. Thanks for engaging, its appreciated. On to the post now! <span style=\"font-family:Segoe UI Emoji\">\ud83d\ude0a</span></span><br /> <br /> <span style=\"font-family:Arial\">I opted to quote for sake of clarity. </span> <hr /><span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> Your 1 Hunger Dice only take seems good. I can see issues with it requiring the extra roll, but nothing too worrying for now. Another approach may be to move the Hunger score from modeling the likelihood of interference to the intensity or duration of interference. That way no second roll is needed, and Hunger has a more nuanced effect where its value matter during the Condition.</div> </div> </div> </div></span><br /> <span style=\"font-family:Aptos\">That\u2019s true, but the extra die roll isn\u2019t really any longer than rolling an extra die on a 10. In practice, I anticipate that it will be much quicker than adding together a pool of Attributes + Skills, then replacing dice with the appropriate number of Hunger dice. That part is honestly slow.</span><br /> <br /> <span style=\"font-family:Aptos\">As for modelling Hunger as intensity and duration, I like the idea a lot in theory, but I\u2019m not sure I have the necessary tools within the game system to model it in a satisfying manner. I guess I could create extra conditions, but I don\u2019t want to add too much additional complexity.</span><br /> <br /> <span style=\"font-family:Aptos\">Do you have any ideas on how it could look while remaining relatively simple?</span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> For the possible results, I'd remove the Rouse Check and revise how it may influence the roll. The Beast is hungry, not wasteful, rolling a Rouse Check for no benefit doesn't look at all as something it would do. You may instead homebrew a Hungry Condition where it pushes the Kindred to feed with abandon, instead.</div> </div> </div> </div></span><br /> <br /> <span style=\"font-family:Aptos\">That\u2019s true, good catch. I\u2019ll remove it and probably replace it with Tempted, or with the following condition.</span><br /> <br /> <span style=\"font-family:Aptos\"><b>Hungry</b><br /> Your character feels hunger gnawing at their chest as they crave blood. They suffer a \u20132 penalty to resist hunger frenzy, and perceiving any amount of blood is considered a provocation for frenzy. If your character is already at Hunger 4, they are treated asStarving (\u20134) instead. This condition has no additional effect if they are already Starving.</span><br /> <span style=\"font-family:Aptos\"><b>Possible Source:</b> Bestial die.<br /> <b>Resolution:</b> Reduce your Hunger. This condition resolves automatically at the end of the scene.<br /> <b>Beat:</b> Feed even if you would gain no sustenance. Feed at the risk of a breaking point. Feed even if doing so would be dangerous (breaking the Masquerade, etc.).</span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> Vitae cost of 2 I'd convert to no roll rather than two dice. More mathematically sound and less complexity.</div> </div> </div> </div></span><br /> <span style=\"font-family:Aptos\">Just to clarify my rule: At 2 Vitae a vampire rolls 2 rouse check, if both are at least 6, they do not get hungrier. If any dice rolls 5 or under, hunger increase by 1. If both dice rolls under 5 the hunger still only increase by 1.</span><br /> <br /> <span style=\"font-family:Aptos\">On average 1 vitae is 0.5 hunger increase, 2 vitae is 0.75 increase , 3-4 vitae is 1 average, 5-6 vitae is 1.5, etc. </span><br /> <br /> <span style=\"font-family:Aptos\">Since the cost increase by 0.25 between 1, 2 and 3, and 0.5 between all other brackets of cost, it\u2019s not mathematically perfect, but I feel like having a flat cost of 1 hunger, would be too high and would go against the design philosophy of including risks. With the proposed changed, we could also run into the weird scenario, where one success on all their rouse check on a 3 Vitae discipline, while a 2 vitae discipline always means rising hunger.</span><br /> <br /> <span style=\"font-family:Aptos\">2 Vitae in my current system is the weird duck because a few disciplines are balanced by having them cost 2 vitae instead of one. Yet I couldn\u2019t make 2 vitae discipline cost the same as 3 or 4 vitae cost one. Hence the weirder rule. In practice we found it worked. Generally, it meant becoming hungrier but without the running the risk of increasing your hunger by 2 like a 3 vitae discipline would.</span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> Otherwise just do as V5 and calls more Rouse Checks with individual resolution.</div> </div> </div> </div></span><br /> <span style=\"font-family:Aptos\">I\u2019m unsure of you what mean. </span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> I don't like the rules that force more damage or killing the vessel to benefit from feeding. I don't like them in V5, I don't like them here, I think it's not an interesting constraint when it forbids you from building logistics and strategy just to say you have to be a killer to feed. I think doing a similar approach to the total slaking of the night is an acceptable compromise, forcing to cause X damage to a single victim is not.</div> </div> </div> </div></span><br /> <span style=\"font-family:Aptos\">That\u2019s fair. I think that\u2019s easy to homebrew away, even in V5.</span><br /> <br /> <span style=\"font-family:Aptos\">Personally, I\u2019ve always perceived it as a way the Beast has pull the vampire toward itself not as something inherently decadent or immoral, but as something that puts the vampire into the mindset of a predator. Since the human experience is not predator in nature, they have found a way to predate on humans using their inherent sexual nature (which is creepy on its own) and that causes a dichotomy between the beast and the human part of the vampire. To me, the feeling of never being fully satiated until they kill stems from that dichotomy.</span><br /> <br /> <span style=\"font-family:Aptos\">Additionally,<i> &quot;You\u2019ll never be fully at peace until you kill&quot;</i> is something I find interesting for the purpose of personal horror. To each their own, though. <span style=\"font-family:Segoe UI Emoji\">\ud83d\ude0a</span></span><br /> <br /> <span style=\"font-family:Aptos\">An alternative middle-ground rule could be that killing a mortal count as a feeding restriction to reduce hunger bellow 1 and a vampire can spend a point of Willpower to ignore that feeding restriction and lower their Hunger to 0. The same could probably be done in v5.</span><br /> <br /> <span style=\"font-family:Aptos\">Vitae is also an option can also reduce Hunger below 1 in my Hunger system, even if it comes with a lot of extra risks.</span><br /> <br /> <span style=\"font-family:Aptos\">The extra damage required to reduce Hunger could be alleviated in my Hunger rules by feeding on multiple targets. The idea is that, at higher Blood Potency, when your Vitae Potency increases, you need to ingest more Vitae to slake your Hunger. For example, at VP 2, i would allow a vampire to feed on 2 humans, inflicting 1 lethal each, to slake 1 hunger. </span> <hr /><span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> On to my point on goals: I think you may have misunderstood my description. I'm not saying VtR Beast is alien as in inscrutable, but as in a more overtly <i>extraneous</i> influence. A character experience the Beast as a thing that's clearly distinct from their Self, as intrusive sensation rather than a change in personality.</div> </div> </div> </div></span><br /> <span style=\"font-family:Aptos\">I get the alien or &quot;other&quot; aspect of the Beast. If that\u2019s what you meant, then I think we\u2019re in agreement.</span><br /> <br /> <span style=\"font-family:Aptos\">Do you disagree with how I described the beast in my previous post?</span><br /> <br /> <span style=\"font-family:Aptos\">Originally, I was replying to the point about intelligence, because I couldn\u2019t find anything stating that the Beast possesses anything resembling intelligence.</span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> And this directly affects what and how those Conditions and roll influences should work. I see a take that's still very similar to V5, but V5 does the moral degeneracy thing: the Beast is affecting complex emotions and thoughts as it is driving the Vampire to change personality into a worse version of themselves</div> </div> </div> </div></span><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <span style=\"font-family:Aptos\">With this in mind, I'd really avoid manifestating the Beast within intentions, at least in a more complex way. With Conditions, I'd consider the character getting more direct versions that feel like this extraneous influence, or at least as an impatient, crude goal. A vampire sometimes do think of those feelings as just their desires going intense, but ultimately it's recognizable as other, as dissociated from what they want.</span></div> </div> </div> </div><span style=\"font-family:Aptos\">For the Beast, I use intentions with the same intended meaning as when the game uses &quot;goal&quot; for a frenzy.</span><br /> <br /> <span style=\"font-family:Aptos\">I\u2019ll use my character as an example again:</span><ul><li><span style=\"font-family:Aptos\"><b>Empathy + Wits (Bestial Success):</b> Yuka successfully picked up that someone was hiding something from her. </span></li> <li><span style=\"font-family:Aptos\"><b>Bestial Effect:</b> Her Beast flared and made her feel like she should be angry about it. No one should withhold information from her. </span></li> <li><span style=\"font-family:Aptos\"><b>Crude Goal:</b> Show everyone that you are better than them. </span></li> <li><span style=\"font-family:Aptos\"><b>Yuka\u2019s Reaction:</b> Feeling her Beast urge her to assert her superiority and dominance, she tried to appease it by taking part in a competition and going all out to win, hoping she could satisfy her Beast and wash that feeling away. </span></li> </ul><span style=\"font-family:Aptos\">Is that accurate to what you mean?</span><br /> <br /> <span style=\"font-family:Aptos\">Otherwise, I think I might be failing to see the difference between your point and the example I laid out, or how the goals are too precise for the beast in the examples I listed.</span><br /> <br /> <span style=\"font-family:Aptos\">Do you have any examples that might help me see the difference?</span><br /> <br /> <span style=\"font-family:Aptos\">Feel free to use any of the examples I gave and explain how you think they fail to capture the Requiem narrative. (Not a gotcha, I'm genuinely curious.)</span><br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><span style=\"font-family:Aptos\"> I'd similarly avoid the current take on influence roll to make for a more additive thing: instead of the Beast changing how the character goes with the roll, it adds a secondary if minor action that's only contextually related: a target notices the hungry eyes, the lock is picked but the tools are broken, an Aura flares without intention. I'd move from corrupting the action itself (which just succeeded or not) to adding anything else that shows the other, internal Beast coming to the fore opportunistically. </span></div> </div> </div> </div><span style=\"font-family:Aptos\">I think corrupting actions is only interesting if it adds something to the story. If used too much, the characters become lunatics who can\u2019t keep it together. I personally don\u2019t want to trip my player in \u2018\u2019gotcha\u2019\u2019 moment with bad rolls, I use Bestial success and failures to increase tensions and drama, not to make them feel like they have no control over themselves, hence why I generally prefer going the condition route.</span><br /> <br /> <span style=\"font-family:Aptos\">I specifically remember an example from V5. I don\u2019t remember whether it\u2019s from the book or something someone just invented, but the idea was that, on a stealth messy critical, a vampire could sneak up by snapping the neck of a security guard in the corridor. I don\u2019t like that because it\u2019s too extreme, and unless the character is very skilled, it doesn\u2019t make much sense.</span><br /> <br /> <span style=\"font-family:Aptos\">Your examples are good, and they are what I would use for &quot;corrupting an action.&quot; If you break your lockpicks because the Beast urged you to be quicker, or if the target of your seduction becomes spooked by your hungry eyes, those are, to me, examples of &quot;corruptedsuccesses&quot; that are interesting and add something to the scene.</span> <hr /><br /> <span style=\"font-family:Aptos\">Unrelated to the point above, but I have an example of a bestial success that just came back to mind. I specifically remember one player character being very hungry and rolling a bestial success on their stealth to sneak on someone and feed on them. I described usually they would feel the gnawing feeling at their chest would get weaker and weaker as they fed, but that this time the beast would not have it; the beast wanted to exsanguinate the poor victim until nothing was left. So, I had the player roll humanity to avoid killing their victim. Thankfully they succeeded and while the victim was injured, they were in good shape enough that an ambulance could save them in time if the player acted quickly.</span><br /> <br /> <span style=\"font-family:Aptos\">Thanks for the feedback! <span style=\"font-family:Segoe UI Emoji\">\ud83d\ude0a</span></span>","signature":"","edited":{"userid":26771,"user_link":"https://forum.theonyxpath.com/member/26771-algarik","user":"Algarik","date":". 07-26-2026, 10:35 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/26771-algarik","name":"Algarik","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26771_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2021"},{"key":"Posts:","value":"115"}]},"thankedby":[]},{"date":"2026-07-25T22:36:01-07:00","id":1562169,"title":"","content":"I understood your initial request, I'm only pointing out that answers will assume a &quot;standard&quot; chronicle. That's not a big problem, only something to keep in mind.<br /> <br /> As for clarity, and I say that aware that I'm no great example to follow, what works against you is excess: too many words and tangents intended to qualify the central point, but that end up obscuring it.<br /> <br /> Not a terrible problem, though, I dedicated more words to it than I should, you're being polite and well intended, that's coming clear. <hr /><br /> I'm not going to quote because my phone isn't helping right now, so I'll talk about things in order and hope it's clear enough.<br /> <br /> One way to apply Hunger as an intense factor without extra Conditions is to use variables. A penalty of -X, has to do something X times, you can use X\u00d72 or even X\u00b2 if you want. X is current Hunger, so the Condition scales.<br /> <br /> Hungry is already an example: change penalty to -X and be done. Hunger 0 still triggers with any provocation and has the Resolution and Beat clauses, so expect this character to feed anyway.<br /> <br /> Rouse Checks with independent resolution is what V5 already does: a power can cost 2+ Rouse Checks. When stated like that, those are rolled independently, each dice can increase Hunger or not. In practice this is quite simple: you roll a Rouse Check as a Pool determined by the power, each failure increases Hunger by 1. Your math is sound and more stable, but this is simpler and reinforce the same themes of uncertainty Rouse Checks bring.<br /> <br /> I like your middle-ground and the option to spread damage to slake Hunger in your system. This is not intuitive in the original wording and is not how V5 works, but being possible to spread I have no problem with this.<br /> <br /> About intelligence, I got what you meant, hence my clarification thr way I did it. We are, indeed, in agreement. As for intelligence, VtR makes Humanity 0 Vampires smarter and more dangerous than VtM. Still certainly not human.<br /> <br /> How I would run your character Beast's influence:<br /> 1. The character picks the person hiding something from her.<br /> 2. The Beast gets angry. The key here is: the Beast doesn't say she has to be angry. The Beast isn't angry about this. The Beast is angry, period. While the character may rationalize this anger as hers and as motivated, it's not and if she doesn't conclude such the Beast is angry nonetheless.<br /> 3. Crude Goal is not to show off. The Beast is angry, and as a Beast it releases anger through physical violence. Preferably, bit not necessarily, against its target.<br /> 4. The character may try different approaches to appease the Beast, but the crude sensation is primal. Superiority in a game is unlikely to do it. If the game gives room for some plausibly deniable physical bullying, then we have more of a chance. But the actual goal is violence, the character knows that and it's the simpler, faster and more satisfying solution.<br /> 5. Of course, this is just a Condition. The character can ignore until resolution.<br /> <br /> I liked your stealth example.<br /> <br /> I personally don't like the V5 examples like &quot;you Persuade the victim but through threats&quot; or &quot;you pick the lock by crushing it&quot; because those essentially &quot;de-success&quot; the roll, and feel like changing the intended action rather than adding the Beast as an extraneous entity. But above all the messing with the roll, I think every successful roll is deserved and should be treated as such, it accomplishes the goal, not just the action.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2026-07-26T07:40:27-07:00","id":1562185,"title":"","content":"Thanks for the reply! I'll come back to it later,<br /> <br /> I just wanted to notify that currently my previous post has been flagged as spam when i tried to edit to correct formatting mistakes, it so to anyone but me, it looks like Monteparnas is responding to herself. A bit frustrating, i Hope it gets re-approved.<br /> <br /> <span style=\"font-family:Aptos\">Edit : In the Meanwhile here's the previous post. <br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> Apology. Any friction perceived or caused is entirely unintentional.</div></div> </div> </div></span><div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"><br /> <span style=\"font-family:Aptos\">I\u2019ll try to explain my perspective on the matter.</span><br /> <br /> <span style=\"font-family:Aptos\">I thought I was clear in the beginning of my post about what I enjoyed about the hunger dice system, so I assumed that it was clear that it was my intention for the reworked version I posted. I\u2019ll try to be clearer next time.</span><br /> <br /> <span style=\"font-family:Aptos\">If I emphasized that I was speaking about my experience, it\u2019s because I dislike using language such as &quot;it is&quot; rather than &quot;I think it is&quot; when speaking about lore or media that are open to interpretation. You asked some clarifying questions, so I answered how I interpret the Beast from the source I have access to.</span><br /> <br /> <span style=\"font-family:Aptos\">Finally, I\u2019m interested in learning what others have to say; otherwise, I wouldn\u2019t write here. I try to engage in good faith. If I state that it doesn\u2019t relate to my group, it is simply that; it doesn\u2019t relate to my group, and it doesn\u2019t invalidate your experience. I\u2019m not arguing; I\u2019m explaining or clarifying my situation.</span><br /> <br /> <span style=\"font-family:Aptos\">What I\u2019ll admit I find frustrating is when intentions are ascribed to me that I did not state. Writing is an inherently flawed method of communication, and I try to always read things in the most charitable light. I\u2019d like others to return the favor. I guess I\u2019ll resume using emoticons, even if I find they make my writing look childish, but they somewhat lighten the mood.</span><br /> <span style=\"font-family:Aptos\">Anyway, thanks for engaging, appreciated. On to the post now! <span style=\"font-family:Segoe UI Emoji\">\ud83d\ude0a</span></span><br /> <br /> <span style=\"font-family:Aptos\"><span style=\"font-family:Segoe UI Emoji\">PS: I opted to quote for sake of clarity. </span></span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> Your 1 Hunger Dice only take seems good. I can see issues with it requiring the extra roll, but nothing too worrying for now. Another approach may be to move the Hunger score from modeling the likelihood of interference to the intensity or duration of interference. That way no second roll is needed, and Hunger has a more nuanced effect where its value matter during the Condition.</div> </div> </div> </div></span><br /> <br /> <span style=\"font-family:Aptos\">That\u2019s true, but the extra die roll isn\u2019t really any longer than rolling an extra die on a 10. In practice, I anticipate that it will be much quicker than adding together a pool of Attributes + Skills, then replacing dice with the appropriate number of Hunger dice. That part is honestly slow.</span><br /> <span style=\"font-family:Aptos\">As for modeling Hunger as intensity and duration, I like the idea a lot in theory, but I\u2019m not sure I have the necessary tools within the game system to model it in a satisfying manner. I guess I could create extra conditions, but I don\u2019t want to add too much additional complexity.</span><br /> <span style=\"font-family:Aptos\">Do you have any ideas on how it could look while remaining relatively simple?</span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> For the possible results, I'd remove the Rouse Check and revise how it may influence the roll. The Beast is hungry, not wasteful, rolling a Rouse Check for no benefit doesn't look at all as something it would do. You may instead homebrew a Hungry Condition where it pushes the Kindred to feed with abandon, instead.</div> </div> </div> </div></span><br /> <br /> <span style=\"font-family:Aptos\">That\u2019s true, good catch. I\u2019ll remove it and probably replace it with <b>Tempted</b>, or with the following condition.</span><br /> <br /> <span style=\"font-family:Aptos\"><b>Hungry</b><br /> Your character feels hunger gnawing at their chest as they crave blood. They suffer a <b>\u20132 penalty</b> to resist hunger frenzy, and perceiving any amount of blood is considered a provocation for frenzy. If your character is already at Hunger 4, they are treated as <b>Starving</b> (\u20134) instead. This condition has no additional effect if they are already Starving.</span><br /> <span style=\"font-family:Aptos\"><b>Possible Source:</b> Bestial die.<br /> <b>Resolution:</b> Reduce your Hunger. This condition resolves automatically at the end of the scene.<br /> <b>Beat:</b> Feed even if you would gain no sustenance. Feed at the risk of a breaking point. Feed even if doing so would be dangerous (breaking the Masquerade, etc.).</span><br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> Vitae cost of 2 I'd convert to no roll rather than two dice. More mathematically sound and less complexity.</div> </div> </div> </div></span><br /> <span style=\"font-family:Aptos\">Just to clarify my rule: At 2 Vitae a vampire rolls 2 rouse check, if both are at least 6, they do not get hungrier. If any dice rolls 5 or under, hunger increase by 1. If both dice rolls under 5 the hunger still only increase by 1.</span><br /> <span style=\"font-family:Aptos\">On average 1 vitae is 0.5 hunger increase, 2 vitae is 0.75 increase , 3-4 vitae is 1 average, 5-6 vitae is 1.5, etc. </span><br /> <span style=\"font-family:Aptos\">Since the cost increase by 0.25 between 1, 2 and 3, and 0.5 between all other brackets of cost, it\u2019s not mathematically perfect, but I feel like having a flat increase, would be too high and would go against the design philosophy of including risks. With the proposed changed, we could also run into the weird scenario, where one success on all their rouse check on a 3 Vitae discipline, while a 2 vitae discipline always means rising hunger.</span><br /> <br /> <span style=\"font-family:Aptos\">2 Vitae in my current system is the weird duck because a few disciplines are balanced by having them cost 2 vitae instead of one. Yet I couldn\u2019t make 2 vitae discipline cost the same as 3 or 4 vitae cost one. Hence the weirder rule. In practice we found it worked. Generally, it meant becoming hungrier but without the running the risk of increasing your hunger by 2 like a 3 vitae discipline would.</span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> Otherwise just do as V5 and calls more Rouse Checks with individual resolution.</div> </div> </div> </div></span><br /> <span style=\"font-family:Aptos\">I\u2019m unsure of you what mean.</span><br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> I don't like the rules that force more damage or killing the vessel to benefit from feeding. I don't like them in V5, I don't like them here, I think it's not an interesting constraint when it forbids you from building logistics and strategy just to say you have to be a killer to feed. I think doing a similar approach to the total slaking of the night is an acceptable compromise, forcing to cause X damage to a single victim is not.</div> </div> </div> </div></span><br /> <br /> <span style=\"font-family:Aptos\">That\u2019s fair. I think that\u2019s easy to homebrew away, even in V5.</span><br /> <br /> <span style=\"font-family:Aptos\">Personally, I\u2019ve always perceived it as a way the Beast has pull the vampire toward itself not as something inherently decadent or immoral, but as something that puts the vampire into the mindset of a predator. Since the human experience is not predator in nature, they have found a way to predate on humans using their inherent sexual nature (which is creepy on its own) and that causes a dichotomy between the beast and the human part of the vampire. To me, the feeling of never being fully satiated until they kill stems from that dichotomy.</span><br /> <span style=\"font-family:Aptos\">Additionally,<i> &quot;You\u2019ll never be fully at peace until you kill&quot;</i> is something I find interesting for the purpose of personal horror. To each their own, though. <span style=\"font-family:Segoe UI Emoji\">\ud83d\ude0a</span></span><br /> <span style=\"font-family:Aptos\">An alternative middle-ground rule could be that killing a mortal count as a feeding restriction to reduce hunger bellow 1 and a vampire can spend a point of Willpower to ignore that feeding restriction and lower their Hunger to 0.</span><br /> <span style=\"font-family:Aptos\">Vitae can also reduce Hunger below 1 in my Hunger system.</span><br /> <span style=\"font-family:Aptos\">The extra damage required to reduce Hunger could be alleviated in my Hunger rules by feeding on multiple targets. The idea is that, at higher Blood Potency, when your Vitae Potency increases, you need to ingest more Vitae to slake your Hunger.</span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> On to my point on goals: I think you may have misunderstood my description. I'm not saying VtR Beast is alien as in inscrutable, but as in a more overtly <i>extraneous</i> influence. A character experience the Beast as a thing that's clearly distinct from their Self, as intrusive sensation rather than a change in personality.</div> </div> </div> </div></span><br /> <span style=\"font-family:Aptos\">I get the alien or &quot;other&quot; aspect of the Beast. If that\u2019s what you meant, then I think we\u2019re in agreement.</span><br /> <span style=\"font-family:Aptos\">Do you disagree with how I described the beast in my previous post?</span><br /> <span style=\"font-family:Aptos\">Originally, I was replying to the point about intelligence, because I couldn\u2019t find anything stating that the Beast possesses anything resembling intelligence.</span><br /> <br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> And this directly affects what and how those Conditions and roll influences should work. I see a take that's still very similar to V5, but V5 does the moral degeneracy thing: the Beast is affecting complex emotions and thoughts as it is driving the Vampire to change personality into a worse version of themselves.</div> </div> </div> </div></span><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><span style=\"font-family:Aptos\">With this in mind, I'd really avoid manifestating the Beast within intentions, at least in a more complex way. With Conditions, I'd consider the character getting more direct versions that feel like this extraneous influence, or at least as an impatient, crude goal. A vampire sometimes do think of those feelings as just their desires going intense, but ultimately it's recognizable as other, as dissociated from what they want.</span></div> </div> </div> </div><br /> <span style=\"font-family:Aptos\">For the Beast, I use intentions with the same intended meaning as when the game uses &quot;goal&quot; for a frenzy.</span><br /> <span style=\"font-family:Aptos\">I\u2019ll use my character as an example again:</span><ul><li><span style=\"font-family:Aptos\"><b>Empathy + Wits (Bestial Success):</b> Yuka successfully picked up that someone was hiding something from her. </span></li> <li><span style=\"font-family:Aptos\"><b>Bestial Effect:</b> Her Beast flared and made her feel like she should be angry about it. No one should withhold information from her. </span></li> <li><span style=\"font-family:Aptos\"><b>Crude Goal:</b> Show everyone that you are better than them. </span></li> <li><span style=\"font-family:Aptos\"><b>Yuka\u2019s Reaction:</b> Feeling her Beast urge her to assert her superiority and dominance, she tried to appease it by taking part in a competition and going all out to win, hoping she could satisfy her Beast and wash that feeling away. </span></li> </ul><span style=\"font-family:Aptos\">Is that accurate to what you mean?</span><br /> <span style=\"font-family:Aptos\">Otherwise, I think I might be failing to see the difference between your point and the example I laid out, or how the goals are too precise for the beast in the examples I listed.</span><br /> <span style=\"font-family:Aptos\">Do you have any examples that might help me see the difference?</span><br /> <span style=\"font-family:Aptos\">Feel free to use any of the examples I gave and explain how you think they fail to capture the Requiem narrative. (Not a gotcha, I'm genuinely curious.)</span><br /> <span style=\"font-family:Aptos\"><div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1562132-hunger-system-homebrew-feedback-welcome?p=1562150#post1562150\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> I'd similarly avoid the current take on influence roll to make for a more additive thing: instead of the Beast changing how the character goes with the roll, it adds a secondary if minor action that's only contextually related: a target notices the hungry eyes, the lock is picked but the tools are broken, an Aura flares without intention. I'd move from corrupting the action itself (which just succeeded or not) to adding anything else that shows the other, internal Beast coming to the fore opportunistically.</div> </div> </div> </div></span><br /> <span style=\"font-family:Aptos\">I think corrupting actions is only interesting if it adds something to the story. If used too much, the characters become lunatics who can\u2019t keep it together. I personally don\u2019t want to trip my player in \u2018\u2019gotcha\u2019\u2019 moment with bad rolls, I use Bestial success and failures to increase tensions and drama, not to make them feel like they have no control over themselves, hence why I generally prefer going the condition route.</span><br /> <span style=\"font-family:Aptos\">I specifically remember an example from V5. I don\u2019t remember whether it\u2019s from the book or something someone just invented, but the idea was that, on a stealth messy critical, a vampire could sneak up by snapping the neck of a security guard in the corridor. I don\u2019t like that because it\u2019s too extreme, and unless the character is very skilled, it doesn\u2019t make much sense.</span><br /> <span style=\"font-family:Aptos\">Your examples are good, and they are what I would use for &quot;corrupting an action.&quot; If you break your lockpicks because the Beast urged you to be quicker, or if the target of your seduction becomes spooked by your hungry eyes, those are, to me, examples of &quot;corruptedsuccesses&quot; that are interesting and add something to the story.</span><br /> <br /> <span style=\"font-family:Aptos\">Unrelated to the point above, but I have an example of something that came back to mind. I specifically remember one player character being very hungry and rolling a bestial success on their stealth to sneak on someone and feed on them. I described usually they would feel the gnawing feeling at their chest would get weaker and weaker as they fed, but that this time the beast would not have it; the beast wanted to exsanguinate the poor victim until nothing was left. So, I had the player roll humanity to avoid killing their victim. Thankfully they succeeded and while the victim was injured, they were in good shape enough that an ambulance could save them in time if the player acted quickly.</span><br /> <br /> <span style=\"font-family:Aptos\">Thanks for the feedback! <span style=\"font-family:Segoe UI Emoji\">\ud83d\ude0a</span></span></div></div> </div> </div><br />","signature":"","edited":{"userid":26771,"user_link":"https://forum.theonyxpath.com/member/26771-algarik","user":"Algarik","date":". 07-26-2026, 12:01 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26771-algarik","name":"Algarik","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26771_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2021"},{"key":"Posts:","value":"115"}]},"thankedby":[]},{"date":"2026-07-26T16:46:30-07:00","id":1562211,"title":"","content":"<span style=\"color:#e74c3c\"><b>Please refrain from duplicate posting as a means of circumventing the moderation tools. It makes more work for the mods and fills the thread with duplication.</b></span>","signature":"<hr class=\"b-divider\"/><br/>He/They<br /> Moderator<br /> Line Developer: <b><a href=\"https://www.drivethrurpg.com/browse/pub/4261/Onyx-Path-Publishing/subcategory/8329_24824/Scarred-Lands-new\" target=\"_blank\">Scarred Lands</a></b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/25411-travislegge","name":"TravisLegge","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25411_2.jpeg","title":"Member","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2019"},{"key":"Posts:","value":"227"}]},"thankedby":[]},{"date":"2026-07-27T16:58:59-07:00","id":1562242,"title":"","content":"<br /> <span style=\"font-family:Aptos\">Apology to the Moderation Team, it wasn't my intention.</span> <hr /><br /> <span style=\"font-family:Aptos\">Yeah, I could get a bit clearer and less wordy. Something I always struggled with even during my university essays.</span><br /> <br /> <span style=\"font-family:Aptos\">I\u2019ll try to keep that in mind <span style=\"font-family:Segoe UI Emoji\">\ud83d\ude0a</span></span> <hr /><br /> <span style=\"font-family:Aptos\"><b>On Hunger intensity Variant</b></span><br /> <span style=\"font-family:Aptos\">Okay yeah, that\u2019s cool.<br /> <br /> I\u2019ll keep that in mind if we end up feeling like the extra dice roll is too much. It wouldn\u2019t work with all conditions, but it works pretty well with the bestial triad.</span><br /> <br /> <span style=\"font-family:Aptos\"><b>On 2 Vitae Rouse Checks</b></span><br /> <span style=\"font-family:Aptos\">My problem would be that under the current system, rolling 2 separate rouse checks would basically amount to 2 vitae ability to cost as much as 3 and 4 vitae power. Unless I\u2019m missing something.</span><br /> <br /> <span style=\"font-family:Aptos\">Currently, in my system: </span><ul><li><span style=\"font-family:Aptos\"><b>1 Vitae :</b> 1 Rouse check.</span></li> <li><span style=\"font-family:Aptos\"><b>2 Vitae :</b> 2 rouse check, 1 maximum increase in hunger</span></li> <li><span style=\"font-family:Aptos\"><b>3-4 Vitae:</b> 2 rouse checks</span></li> <li><span style=\"font-family:Aptos\"><b>5-6 Vitae equal :</b> 3 rouse check</span></li> <li><b><span style=\"font-family:Aptos\">Etc.</span></b></li> </ul><span style=\"font-family:Aptos\"><b>On Vitae Potency</b></span><br /> <span style=\"font-family:Aptos\">Vitae Potency is something I\u2019ve added later. Before it was called \u2018\u2019Night per Rouse checks\u2019\u2019 and the idea was that older vampire had higher reserve so it took longer for them to get hungrier by waking up.</span><br /> <br /> <span style=\"font-family:Aptos\">It didn\u2019t come up until later that if they had higher reserve, it should take more blood to feed them or they should be able to share more vitae before increasing their hunger.</span><br /> <br /> <span style=\"font-family:Aptos\">V5 works differently by simply making elder blood more potent when roused at the cost of increased base hunger without killing human or losing the ability to feed on animals.</span><br /> <br /> <span style=\"font-family:Aptos\">My text is a bit Janky and could stand from precision.</span><br /> <br /> <span style=\"font-family:Aptos\">The idea is that VP = Your vitae exchange rate. If you want to reduce your hunger you need \u2018\u2019a number of vitae\u2019\u2019 equal to your VP and if you give Vitae, you increase your hunger for each full fraction of your VP, add a rouse check for fractions.</span><ul><li><span style=\"font-family:Aptos\"><b>For example:</b> A VP 2 character gives 3 Vitae to their torpid VP 1 coterie, mate. The VP 2 characters increase their hunger by 1, then roll a rouse check for the 1 left over past 2. The VP 1 character reduce their hunger by 3. </span></li> </ul><span style=\"font-family:Aptos\">This is not supposed to be something that\u2019s abused, storyteller is encouraged to increase hunger if a character with a VP over 1 shares blood to different sources.</span><ul><li><span style=\"font-family:Aptos\"><b>For example:</b> A VP 2 characters, shares 2 vitae split between their two torpid VP 1 coterie, mate. They increase their hunger by 1.</span></li> </ul><span style=\"font-family:Aptos\">So i would absolutely allow a more humane or careful Ancillae to feed on multiple target to reduce their hunger instead of sending someone to the hospital. A Daeva could essentially have a very high herd* for the same amount of merits dots for example.<br /> <br /> <br /> <b>* </b>Herd gives 1 hunger reduction per merit dot in my system, maybe i should have mentioned that before. </span><br /> <br /> <span style=\"font-family:Aptos\"><b>On Yuka\u2019s example.</b></span><br /> <span style=\"font-family:Aptos\">I was under the impression that the beast could feel something other than anger, but maybe \u2018\u2019showing off\u2019\u2019 is a bit too \u2018\u2019tame\u2019\u2019 as far as the beast go.</span><br /> <br /> <span style=\"font-family:Aptos\">My idea was \u2018\u2019I\u2019m pissed, show your superiority by crushing everyone else.\u2019\u2019</span><br /> <br /> <span style=\"font-family:Aptos\">Maybe a caveat to add : Yuka didn\u2019t actually succeed at appeasing her beast, since she did not push anyone to a breaking point. She was only trying to channel the competitive feeling pushed by the beast into something less destructive.</span><br /> <br /> <span style=\"font-family:Aptos\"><b>On corrupted success.</b></span><br /> <br /> <span style=\"font-family:Aptos\">That\u2019s a fair take.</span><br /> <br /> <span style=\"font-family:Aptos\">It is a \u2018\u2019de-success\u2019\u2019 in a sense, but I feel it work best when it adds a complication you might have to deal with later.</span><br /> <br /> <span style=\"font-family:Aptos\">Like crushing the lock is not annoying now, it\u2019s annoying later because you left traces. Opening the door still succeeded, you just have another problem you have to deal with now, because you left your beast unchecked.<br /> <br /> When i make use of it mindset is : How can i fully honor the fact that you succeed, while giving you some bit of trouble for letter yourself get that hungry?</span><br /> <br /> <span style=\"font-family:Aptos\">I get why it can be frustrating, though, so I only use it when I feel it adds interesting drama. <span style=\"font-family:Segoe UI Emoji\">\ud83d\ude0a</span></span><br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26771-algarik","name":"Algarik","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26771_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2021"},{"key":"Posts:","value":"115"}]},"thankedby":[]},{"date":"2026-09-03T15:46:39-07:00","id":1563812,"title":"","content":"<span style=\"font-size:14px\"><span style=\"font-family:Arial\">Just an update!<br /> <br /> We've been playing with the Hunger Die version for about 6-7 sessions so far. I play tested as both storyteller and player, and so far, for us, it's a straight improvement from the previous hunger dice system.<br /> <br /> <b>My instincts were right :</b></span></span><ul><li><span style=\"font-size:14px\"><span style=\"font-family:Arial\">It gets rid of all the finicky bits of the original system.</span></span></li> <li><span style=\"font-size:14px\"><span style=\"font-family:Arial\">It actually plays quite well with Requiem system instead of fighting it; Now dramatic failures can be dramatic failures without being bestial failures as well. </span></span></li> <li><span style=\"font-size:14px\"><span style=\"font-family:Arial\">The extra dice to roll on 1 isn\u2019t a problem. It\u2019s actually kind of fun, because a result of \u2018\u20191\u2019\u2019 on the hunger die raises tension. Rather than being an instant frustration, it lets the player and the table anticipate the result, which is, in my opinion, less frustrating and more fun.</span></span></li> </ul><span style=\"font-size:14px\"><span style=\"font-family:Arial\">In actual play, we mostly used bestial success to give out conditions for a scene, mostly the bestial triad, since it was rare enough compared to the previous system that we didn\u2019t feel like we needed to vary too much. I wouldn\u2019t really use corrupted success too much unless i had some very interesting ideas, or a player would want to lean into it.</span></span> <hr /><span style=\"font-size:14px\"><span style=\"font-family:Arial\"><b>Discipline Cost Reduction - Something I would need to clarify.</b><br /> <br /> Currently, discipline cost reduction is can be a bit confusing because of the 2 vitae cost discipline. It works because I\u2019m at the table and I can clarify the rule, but it\u2019s not super clear. It would be better to revise all discipline costs as rouse checks.<br /> <br /> The way the reduction cost is applied is the following way.<br /> <br /> Where \u2018\u2019A\u2019\u2019 stands for \u2018\u2019advantage\u2019\u2019 or roll 2 dice and keeps the best dice and \u2018\u2019D\u2019\u2019 stands for disadvantage or \u2018\u2019roll twice\u2019\u2019 and keeps the worst dice.</span></span> <div class=\"b-bbcode__table--wrapper text_table_\"><table class=\"b-bbcode__table text_table_MsoTable15Grid5Dark\"><tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">Base Vitae </span></b></span><br /> <span style=\"font-family:Aptos\"><b><span style=\"color:white\">Cost</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">Base Rouse </span></b></span><br /> <span style=\"font-family:Aptos\"><b><span style=\"color:white\">Checks</span></b></span></td> <td colspan=\"4\" class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">Reduction Effect</span></b></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">-1</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">-2</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">-3</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">-4</span></b></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">1</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">2</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1D</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">3-4</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">2</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1D</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #CCCCCC\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color:white\">5-6</span></b></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">3</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">2</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1D</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1</span></span></td> <td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: #999999\"><span style=\"font-family:Aptos\"><span style=\"color:black\">1A</span></span></td> </tr> <tr valign=\"top\" class=\"text_table_MsoTable15Grid5Dark_tr\"><td class=\"text_table_MsoTable15Grid5Dark_td\" style=\"background-color: black\"><span style=\"font-family:Aptos\"><b><span style=\"color: