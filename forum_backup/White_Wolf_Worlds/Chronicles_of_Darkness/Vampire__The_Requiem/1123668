3d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12845-ahather","name":"ahather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12845_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2017"},{"key":"Posts:","value":"238"}]},"thankedby":[]},{"date":"2017-08-01T17:04:08-07:00","id":1123706,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>atamajakki</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1123688#post1123688\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I've heard it's a book.</div> </div> </div> </div>Actually, word is that it is only a PDF unless you specifically request the book.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/2003-tabanese","name":"Tabanese","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2003_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"282"}]},"thankedby":[]},{"date":"2017-08-01T17:31:57-07:00","id":1123717,"title":"","content":"According to the MMN not only is it in post editing dev but artists right now are somewhere making art to put in it.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/13009-burritomage","name":"BurritoMage","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar13009_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2017"},{"key":"Posts:","value":"585"}]},"thankedby":[]},{"date":"2017-08-01T18:25:17-07:00","id":1123727,"title":"","content":"I seem to recall hearing that the dhampirs are not the same dhampirs that were in Wicked Dead.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/321-sunlessnick","name":"SunlessNick","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1214"}]},"thankedby":[]},{"date":"2017-08-01T18:32:32-07:00","id":1123730,"title":"","content":"I think there was supposed to be updates on ghoul families and the dhampirs are still supposed to be problems for their vampire parents but more easily playable.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1526-diggs","name":"Diggs","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"986"}]},"thankedby":[]},{"date":"2017-08-02T07:45:48-07:00","id":1123875,"title":"","content":"I really, really wish they would release more teasers for this book, especially since it's now in art direction. Perhaps after GenCon they'll have time for that?<br /> <br /> My broad expectation is that we'll see an update on the ghouls book for 2e, lumping in further info on families, dhampiers, and other variations of a partial vampiric curse or lingering influence. Ghouls 1e is actually a rather heavy-handed book in my opinion, in line with 1e generally; I hope that Half-damned takes a lighter touch and emphasizes the range of play within the material. <br /> <br /> --Khanwulf","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12493-khanwulf","name":"Khanwulf","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12493_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2016"},{"key":"Posts:","value":"898"}]},"thankedby":[]},{"date":"2017-08-02T08:42:12-07:00","id":1123890,"title":"","content":"I assume it'll be in the pamphlet when they release that.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://www.kickstarter.com/projects/200664283/demon-the-descent-prestige-edition\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://img513.imageshack.us/img513/4478/8vno.png\" border=\"0\" alt=\"\" /></a><br /> Frequent Story Teller for the Circle of Five gaming group.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/654-xiongrey","name":"xiongrey","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar654_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"549"}]},"thankedby":[]},{"date":"2017-08-02T09:02:54-07:00","id":1123897,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Diggs</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1123730#post1123730\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I think ... dhampirs are still supposed to be problems for their vampire parents but more easily playable.</div> </div> </div> </div>I think the phrase was &quot;still a demonstration of why vampires are their own biggest reason they can't have nice things.&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/321-sunlessnick","name":"SunlessNick","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1214"}]},"thankedby":[]},{"date":"2017-08-02T09:40:53-07:00","id":1123906,"title":"","content":"I believe Revenants are supposed to be in the book, with some more stuff to make them player characters.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12436-ever-professional","name":"Ever Professional","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12436_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2016"},{"key":"Posts:","value":"506"}]},"thankedby":[]},{"date":"2017-08-02T15:15:32-07:00","id":1124028,"title":"","content":"I'll try to arrange some more direct spoilers in the future, but I thought I'd note that this book's design process came up in a CtL thread:<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Rose Bailey</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1123628-changeling-2-0-antagonists-allies?p=1123971#post1123971\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Danielle and I sat down at Gen Con last year and had a long talk about <i>Half-Damned</i>. We'd looked at dhampir in <i>Wicked Dead</i>, and we loved the conflicts they set up for vampires. But when you're looking at player characters (or even just a part of the mythos that we mention more than once), being a literal curse seemed too one-note. And Danielle's insight was that if you have dhampir in the first place, and you have Kindred trying to be parents (or abandoning their kids) when the Requiem is usually one long solo... well, you've got plenty of conflict right there.<br /> <br /> So you'll see in <i>Half-Damned</i> that although there are definitely some unique supernatural angles, and while the conflicts from <i>Wicked Dead</i> are still there, the <i>Vampire </i>team looked at them much more from the perspective of &quot;okay, what would actually happen if occasionally a vampire becomes a mom? what are all the ways that could go wrong? and most importantly: why would they do it anyway?&quot;</div> </div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/><b>Cavaliers of Mars Creator</b><br /> <b>Retired CofD Lead</b><br /> <br /> Check out my <a href=\"https://www.storytellersvault.com/browse.php?author=Rose%20Bailey\" target=\"_blank\">guides to </a><a href=\"https://www.storytellersvault.com/product/261142/BITE-ME-How-to-Write-Vampire?affiliate_id=453494&amp;src=OPPf\" target=\"_blank\">Vampire</a> and my <a href=\"https://www.drivethrurpg.com/browse/pub/4895/Fantasy-Heartbreaker?affiliate_id=453494&amp;src=OPPf\" target=\"_blank\">indie games</a>!","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/2-rose-bailey","name":"Rose Bailey","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"2361"}]},"thankedby":[]},{"date":"2017-08-02T16:00:30-07:00","id":1124053,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> &quot;okay, what would actually happen if occasionally a vampire becomes a mom? what are all the ways that could go wrong? and most importantly: why would they do it anyway?<br /> </div> </div> </div>this, This is the reason i am so interested in this book!!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/12845-ahather","name":"ahather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12845_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2017"},{"key":"Posts:","value":"238"}]},"thankedby":[]},{"date":"2017-08-02T16:55:06-07:00","id":1124085,"title":"","content":"Good. I never thought Wicked Dead dhampir were useful outside of an antagonist and they didn't really need a curse to serve that role, although it certainly made them more generally useful as antagonists. If someone is playing a vampire that has a kid then I think they deserve full support in an attempt to be a parent because there is so much that can go wrong. Seemed a poor choice to basically say to a vampire player their character has a kid now they need to avoid them at all costs.<br /> <br /> Of all things that could be spoiled, I want to know the role of a dhampir. Normally, I prefer mechanics and feel &quot;meh&quot; over fluff spoilers, but I think the aspect of that interests me most of all the subject matter of the book is how a vampire deals with having a child and not old life leftovers either. It has to be shocking.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/1526-diggs","name":"Diggs","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"986"}]},"thankedby":[]},{"date":"2017-08-03T09:26:01-07:00","id":1124334,"title":"","content":"Well, now we know this.<br /> <br /> <div class=\"b-bbcode b-bbcode__url b-bbcode__url--preview\"> <a href=\"http://theonyxpath.com/dhampir-vampire-the-requiem/\" target=\"_blank\" class=\"urlimg_container\"> <img class=\"js-img-fallback\" src=\"https://theonyxpath.com/wp-content/uploads/2023/11/OPP-Metal.png\"> </a> <div class=\"urlinfo\"> <div class=\"title ellipsis\"> <a href=\"http://theonyxpath.com/dhampir-vampire-the-requiem/\" target=\"_blank\"> Dhampir [Vampire: The Requiem] &ndash; Onyx Path Publishing </a> </div> <div class=\"url ellipsis\"> <a href=\"http://theonyxpath.com/dhampir-vampire-the-requiem/\" target=\"_blank\"> http://theonyxpath.com/dhampir-vampire-the-requiem/ </a> </div> <div class=\"meta\"> </div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-size:14px\"><a href=\"https://tinyurl.com/2p8ss75f\" target=\"_blank\"><b>Chris H</b></a>/<b>EndDaysEngine</b> | <a href=\"https://www.patreon.com/EndDaysEngine\" target=\"_blank\"><b>Patreon</b></a></span>| <b>He/His </b>| <b>Currently Writing</b>: <i>[Redacted], [Redacted]</i><br /> <br /> <b>CofD booklists: </b><a href=\"https://goo.gl/DRdB7h\" target=\"_blank\">Beast</a> I <a href=\"https://goo.gl/x1FPpM\" target=\"_blank\">Changeling</a> | <a href=\"https://goo.gl/ZSCx5U\" target=\"_blank\">Demon</a> | <a href=\"http://shorturl.at/syDK9\" target=\"_blank\">Deviant</a> | <a href=\"https://goo.gl/Mh5M6m\" target=\"_blank\">Geist</a> l <a href=\"https://goo.gl/gSjfm5\" target=\"_blank\">Hunter</a> l <a href=\"https://goo.gl/qj5aX9\" target=\"_blank\">Mage</a> | <a href=\"https://goo.gl/2HCpjg\" target=\"_blank\">Mummy</a> | <a href=\"https://goo.gl/68yRHY\" target=\"_blank\">Promethean</a> | <a href=\"https://goo.gl/a4mjqA\" target=\"_blank\">Vampire</a> | <a href=\"https://goo.gl/hrULtN\" target=\"_blank\">Werewolf</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/4433-second-chances","name":"Second Chances","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4433_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"4202"}]},"thankedby":[]},{"date":"2017-08-03T12:01:30-07:00","id":1124421,"title":"","content":"Ask and ye shall receive.<br /> <br /> That was pretty shocking for me. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /> I wouldn't have thought the Sanctified would accept dhampir.<br /> <br /> Interesting presentation and obviously lots of thought was put into the role of a dhampir in stories from a variety of perspectives. I assume dhampir have about a third of the book so there is much more to see later. Great tease. I have quite a few more questions now, but I shall digest and wait. I think if this is representative of the rest of the book Vampire fans will be happy.<br /> <br /> I guess we know dhampir powers are called Breaks and Malisons. A malison is a curse so I wonder if a break would be will-crushing or go into a different direction.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1526-diggs","name":"Diggs","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"986"}]},"thankedby":[]},{"date":"2017-08-03T12:07:00-07:00","id":1124422,"title":"","content":"Now the question really is - <b>HOW to get your own dhampir child in the first place?</b> <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2017-08-03T12:13:20-07:00","id":1124427,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wyrdhamster</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124422#post1124422\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Now the question really is - <b>HOW to get your own dhampir child in the first place?</b> <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /></div> </div> </div> </div><a href=\"https://en.wikipedia.org/wiki/Human_reproduction\" target=\"_blank\">There's been some writing done on that.</a><br /> <br /> In first edition the recently Embraced might still have some swimmers going, but both Cruac and Theban Sorcery had methods to make the dead reproduce as if they were alive. Better, in fact. It's probably easy to pull off for the Ordo Dracul and anyone who knows general blood sorcery.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2017-08-03T12:18:50-07:00","id":1124428,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>nofather</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124427#post1124427\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">In first edition the recently Embraced might still have some swimmers going, but both Cruac and Theban Sorcery had methods to make the dead reproduce as if they were alive. Better, in fact. It's probably easy to pull off for the Ordo Dracul and anyone who knows general blood sorcery.</div> </div> </div> </div>There was some mentioning in spoiler of Invictus also having some Dhampirs, so question is how First Estate could get them?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2017-08-03T12:19:22-07:00","id":1124429,"title":"","content":"there's also the the coil of ziva (specifically shedding the beasts skin) for Ordo Dracul that secrets of the covenants suggests (in a sidebar) could be used to allow a vampire to bare a child.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12845-ahather","name":"ahather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12845_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2017"},{"key":"Posts:","value":"238"}]},"thankedby":[]},{"date":"2017-08-03T12:20:40-07:00","id":1124430,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wyrdhamster</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124428#post1124428\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">There was some mentioning in spoiler of Invictus also having some Dhampirs, so question is how First Estate could get them?</div> </div> </div> </div>I'm guessing you mean this.<br /> <br /> 'Most statuses Kindred can achieve are also achievable for dhampir, with the notable exceptions of joining the Invictus, along with a few specific roles in the Circle of the Crone and among the Sanctified.'<br /> <br /> It seems to suggest more that the Invictus don't allow for dhampir in their ranks, while others will, with a few exceptions among the sorcerous.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2017-08-03T12:35:59-07:00","id":1124434,"title":"","content":"Special thanks to <a href=\"https://forum.theonyxpath.com/member/2-rose-bailey\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar2_2.png');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"2\" data-vbnamecard=\"2\">Rose Bailey</a> for pulling this teaser out of a hat for us!<br /> <br /> The Invictus represent the special place of rulership that vampires obtain by dint of their existence. Dhampir are not vampires, ergo, they may not rule. The Sanctified separate the human herd from the supernaturally damned, so it would be little stretch for them to identify the, er, half-damned dhampir as being within the latter category as they most certainly wield some form of blood-manifested powers.<br /> <br /> In other words, seems logical to me.<br /> <br /> I'm looking forward to this book.<br /> <br /> --Khanwulf<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12493-khanwulf","name":"Khanwulf","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12493_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2016"},{"key":"Posts:","value":"898"}]},"thankedby":[]},{"date":"2017-08-03T13:45:39-07:00","id":1124457,"title":"","content":"I think I was surprised by the Sanctified taking a logical position. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /> I have no issue with it. I had assumed the Sanctified viewed dhampir as abominations that needed to be destroyed. Of course, that actually wasn't specifically what I found &quot;shocking&quot; about the preview. The dhampir were so one-note to me in Wicked Dead that to see a rework that offers them such a broad use was awesome, in the literal rather than ninja turtle sense.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1526-diggs","name":"Diggs","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"986"}]},"thankedby":[]},{"date":"2017-08-03T14:23:43-07:00","id":1124478,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Diggs</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124457#post1124457\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I think I was surprised by the Sanctified taking a logical position. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /> I have no issue with it. I had assumed the Sanctified viewed dhampir as abominations that needed to be destroyed. Of course, that actually wasn't specifically what I found &quot;shocking&quot; about the preview. The dhampir were so one-note to me in Wicked Dead that to see a rework that offers them such a broad use was awesome, in the literal rather than ninja turtle sense.</div> </div> </div> </div><br /> Let's be inclusive--if some dhampir are ninja turtles they should feel welcome. Cruac rituals especially are not terribly particular about who or what ends up being the parent....<br /> <br /> With (more?) seriousness, I'm pleased that it seems half-damned continues the trend toward &quot;sure, play everything!&quot; that seems woven into the 2e approach to splats. So, elders are not moldering wrecks of creaking evil prop-dressing, dhampir are people with distinct issues instead of hapless curses important only because their parents were &quot;naughty&quot;, and the Pure werewolves are a mixed trashbag of hatreds that are very much found in people (as well as People). <br /> <br /> I like this direction very much, and look forward to the treatment in the book of ghouls; in WoD and CofD lines it always seemed like the writing slid toward treating them like props even while acknowledging that they &quot;have feels, y0&quot;, but the examples and language used made them not so much shackled slaves as locked in carbonite.<br /> <br /> --Khanwulf<br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12493-khanwulf","name":"Khanwulf","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12493_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2016"},{"key":"Posts:","value":"898"}]},"thankedby":[]},{"date":"2017-08-03T17:55:42-07:00","id":1124549,"title":"","content":"&quot;When her mother dies in a car accident, the young dhampir can feel it deep in her blood. She knew it before it happened, she knows it before she is told, and that argument she had with her mother last night? The one where the kid said she wished she\u2019d never been born and she wished that her mother was dead? She knows things occasionally just happen around her when she wants them to \u2014 did she kill her mother?&quot;<br /> <br /> That actually happened to me. When I was younger I hated myself alot, I mean alot, and as such I resented those who made me as well. <br /> <br /> And I just started growing out of it, when my mother died in a car accident, and as a Pagan I felt responsible for that, like my negative emotions cursed her, as illogical as that may seem, so I never gave myself premission to greavie, and I never forgave myself, although the self hatred died down some what so I wan't filled all the time with self hatred. But the sense of it being my responsibility never really left me. Nor the sense of regret. <br /> <br /> So I think I'm really going to get these Dhampirs on a deep level, because its a kind of pain and inner coldness/darkness I get.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2241-omegaphallic","name":"Omegaphallic","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"3435"}]},"thankedby":[]},{"date":"2017-08-04T08:39:44-07:00","id":1124795,"title":"","content":"The art is probably gonna be photography photoshop which I really really dislike<br /> <br /> please Onyx Path, please, hire real artists","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/12561-shawarbaaz","name":"Shawarbaaz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12561_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"467"}]},"thankedby":[]},{"date":"2017-08-04T10:36:58-07:00","id":1124829,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shawarbaaz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124795#post1124795\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The art is probably gonna be photography photoshop which I really really dislike<br /> <br /> please Onyx Path, please, hire real artists</div> </div> </div> </div> I'm not big on it either honestly.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2241-omegaphallic","name":"Omegaphallic","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"3435"}]},"thankedby":[]},{"date":"2017-08-04T11:21:14-07:00","id":1124843,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Omegaphallic</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124829#post1124829\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I'm not big on it either honestly.</div> </div> </div> </div>What really bothers me is that there are many, many artists on Tumblr and deviantART who are both affordable and excellent. I'm not asking for technical skill, only art that has a soul and a story to tell.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12561-shawarbaaz","name":"Shawarbaaz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12561_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"467"}]},"thankedby":[]},{"date":"2017-08-04T11:36:52-07:00","id":1124853,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shawarbaaz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124843#post1124843\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">What really bothers me is that there are many, many artists on Tumblr and deviantART who are both affordable and excellent. I'm not asking for technical skill, only art that has a soul and a story to tell.</div> </div> </div> </div>If you think any of them might be interested, have them <a href=\"http://theonyxpath.com/art/\" target=\"_blank\">contact to try and get hired by Onyx Path</a>. Companies don't usually just go to Tumblr or Deviantart to commission individual pieces of work for books. For repetitive works, at least, like filling out a book. More common if you just need one image, like an advertisement.","signature":"","edited":{"userid":886,"user_link":"https://forum.theonyxpath.com/member/886-nofather","user":"nofather","date":". 08-04-2017, 02:54 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2017-08-04T11:40:47-07:00","id":1124855,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shawarbaaz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124795#post1124795\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The art is probably gonna be photography photoshop which I really really dislike<br /> <br /> please Onyx Path, please, hire real artists</div> </div> </div> </div>Checking Thousand Years of Night, I notice a fair few traditional art pieces. The 2e core is majority traditional art.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/51-marin","name":"marin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2019"}]},"thankedby":[]},{"date":"2017-08-04T11:45:11-07:00","id":1124857,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>nofather</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124853#post1124853\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> If you think any of them might be interested, have them <a href=\"http://theonyxpath.com/art/\" target=\"_blank\">contact to try and get hired by Onyx Path</a>. Companies don't usually just go to Tumblr or Deviantart to commission individual pieces of work for books.</div> </div> </div> </div>Some artists I know might be interested, if they are getting payment for it that is, I'll do more poking around at the matter","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12561-shawarbaaz","name":"Shawarbaaz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12561_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"467"}]},"thankedby":[]},{"date":"2017-08-07T23:11:27-07:00","id":1126200,"title":"","content":"[Deleted post]","signature":"","edited":{"userid":2648,"user_link":"https://forum.theonyxpath.com/member/2648-telperionst","user":"TelperionST","date":".  Pointless post is pointless. 08-08-2017, 02:12 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2648-telperionst","name":"TelperionST","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2648_3.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"84"}]},"thankedby":[]},{"date":"2017-08-15T11:26:15-07:00","id":1129316,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Khanwulf</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124434#post1124434\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Special thanks to <a href=\"https://forum.theonyxpath.com/member/2-rose-bailey\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar2_2.png');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"2\" data-vbnamecard=\"2\">Rose Bailey</a> for pulling this teaser out of a hat for us!</div> </div> </div> </div>I appreciate it, but Danielle's really more to thank. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><b>Cavaliers of Mars Creator</b><br /> <b>Retired CofD Lead</b><br /> <br /> Check out my <a href=\"https://www.storytellersvault.com/browse.php?author=Rose%20Bailey\" target=\"_blank\">guides to </a><a href=\"https://www.storytellersvault.com/product/261142/BITE-ME-How-to-Write-Vampire?affiliate_id=453494&amp;src=OPPf\" target=\"_blank\">Vampire</a> and my <a href=\"https://www.drivethrurpg.com/browse/pub/4895/Fantasy-Heartbreaker?affiliate_id=453494&amp;src=OPPf\" target=\"_blank\">indie games</a>!","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2-rose-bailey","name":"Rose Bailey","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"2361"}]},"thankedby":[]},{"date":"2017-08-15T11:30:50-07:00","id":1129317,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Diggs</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124457#post1124457\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I think I was surprised by the Sanctified taking a logical position. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /></div> </div> </div> </div>One of the things we've tried to do since around 2007, and very explicitly in 2e, is to make the factions less inevitably self-defeating. Vampires still cause the majority of their own problems, but we don't treat whole covenants as &quot;dumbass vampire fundamentalists&quot; or anything.","signature":"<hr class=\"b-divider\"/><br/><b>Cavaliers of Mars Creator</b><br /> <b>Retired CofD Lead</b><br /> <br /> Check out my <a href=\"https://www.storytellersvault.com/browse.php?author=Rose%20Bailey\" target=\"_blank\">guides to </a><a href=\"https://www.storytellersvault.com/product/261142/BITE-ME-How-to-Write-Vampire?affiliate_id=453494&amp;src=OPPf\" target=\"_blank\">Vampire</a> and my <a href=\"https://www.drivethrurpg.com/browse/pub/4895/Fantasy-Heartbreaker?affiliate_id=453494&amp;src=OPPf\" target=\"_blank\">indie games</a>!","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/2-rose-bailey","name":"Rose Bailey","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"2361"}]},"thankedby":[]},{"date":"2017-08-18T07:53:57-07:00","id":1130817,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Diggs</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124085#post1124085\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Good. I never thought Wicked Dead dhampir were useful outside of an antagonist and they didn't really need a curse to serve that role, although it certainly made them more generally useful as antagonists.</div> </div> </div> </div>From the other angle, a tutelary curse was an interesting concept, but too limited by being attached to dhampirs alone.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>nofather</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1124430#post1124430\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">It seems to suggest more that the Invictus don't allow for dhampir in their ranks, while others will, with a few exceptions among the sorcerous.</div> </div> </div> </div>It makes sense - the Invictus is the covenant with the most vested interest in preventing the creation of dhampirs - not necessarily because of their nature in themselves, but because the kinds of relationships that will lead to their existence are prone to being Masquerade breaches and vampires and humans acting equal, neither of which the Invictus is keen on.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Rose Bailey</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1123668-half-damned-what-do-we-know?p=1129317#post1129317\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">One of the things we've tried to do since around 2007, and very explicitly in 2e, is to make the factions less inevitably self-defeating. Vampires still cause the majority of their own problems, but we don't treat whole covenants as &quot;dumbass vampire fundamentalists&quot; or anything.</div> </div> </div> </div>That's a good thing. I remember a while back, I came up with some ghoul-only Disciplines - while most vampires didn't let their ghouls learn them, or even realise it was possible, some did - and every covenant had a reason why it was the &quot;only&quot; one enlightened enough allow it.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/321-sunlessnick","name":"SunlessNick","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1214"}]},"thankedby":[]},{"date":"2017-08-18T08:28:53-07:00","id":1130831,"title":"","content":"I actually love Sam Araya, he's the one who's done most of the &quot;photography photoshop&quot; pieces. His art <i>is</i> Mummy for me, and I've never been sorry to see his work in a book.","signature":"<hr class=\"b-divider\"/><br/>&quot;<a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/werewolf-the-forsaken/127887-doing-first-tongue-translations?p=484226#post484226\" target=\"_blank\">Nihhina kalekal-zidu kal masun, kal manudanadu. Nihhina kalekal-zidu nukal shaghu-desasudu \u2014 nihhina kalekal-zidu kal innu-desasudu udhkal samm</a>.&quot; Arthur Ashe<br /> She/her, contributing writer for <a href=\"https://www.drivethrurpg.com/product/363404/Scion-Pride-2021\" target=\"_blank\">Scion: Pride 2021</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/1923-bigdamnhero","name":"BigDamnHero","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1923_4.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"1263"}]},"thankedby":[]},{"date":"2017-08-23T06:06:43-07:00","id":1132983,"title":"","content":"Curious, Will it still be possible to do the kind of plot with Dhampirs you could in first edition?","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://imagizer.imageshack.us/a/img829/1897/8seg.png\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imagizer.imageshack.us/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imageshack.com/i/2iw20supportergarou125p\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imageshack.com/i/0j5hz8j\" border=\"0\" alt=\"\" /></a><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/i/idnSdTJkj\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://i.imgsafe.org/97fd805379.png\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1153-prince-of-the-night","name":"Prince of the Night","avatar":"data:image/svg+x