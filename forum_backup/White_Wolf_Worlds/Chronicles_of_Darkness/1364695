onyxpath.com/forum/m...a-valentinelli</a><br /> <br /> And for now - what do you expect from the new edition of the game?","signature":"","edited":{"userid":1437,"user_link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","user":"wyrdhamster","date":". 02-08-2020, 02:21 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2020-02-02T05:31:57-08:00","id":1364739,"title":"","content":"Big freaking weapons to take down mummies \ud83e\udd2f","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/4621-nicolas-milioni","name":"Nicolas Milioni","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4621_2.jpeg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"3605"}]},"thankedby":[]},{"date":"2020-02-02T06:07:09-08:00","id":1364744,"title":"","content":"More on the compacts and conspiracies, spy gear, using monsters like chess pieces in order to make them kill each other.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/24173-primordial-newcomer","name":"Primordial newcomer","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2018"},{"key":"Posts:","value":"1965"}]},"thankedby":[]},{"date":"2020-02-02T09:33:55-08:00","id":1364776,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_containe