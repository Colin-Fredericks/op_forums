om/core/avatars/0/0/6/0/4/5/avatar152_2.jpeg","title":"Member","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1698"}]},"thankedby":[]},{"date":"2018-12-24T04:21:35-08:00","id":1276424,"title":"","content":"May I ask what the vectors for the Rosetta Society and the Ship of Theseus are?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12074-robert-d","name":"Robert D","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"434"}]},"thankedby":[]},{"date":"2018-12-24T06:29:28-08:00","id":1276437,"title":"","content":"How useful would the book be for crossover material if you aren't planning on introducing &quot;the contagion&quot; to your chronicle?","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/demon-the-descent/904596-geniuses-and-gramarie\" target=\"_blank\">Genius templates</a>: Super Science Mini-Template for Demon: the Descent<br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/1337874-oracle-the-endbringers-fan-splat\" target=\"_blank\">Oracle the Endbringers</a>: Time-Manipulator Fan-Splat","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8331-milo-v3","name":"milo v3","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar8331_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"1505"}]},"thankedby":[]},{"date":"2018-12-24T14:23:03-08:00","id":1276525,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcod