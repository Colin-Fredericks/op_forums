darkness/mage-the-awakening/1443819-new-2e-legacies-expanded\" target=\"_blank\">New 2E Legacies, expanded</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12619-21c-hermit","name":"21C Hermit","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12619_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"3489"}]},"thankedby":[]},{"date":"2017-05-08T02:59:03-07:00","id":1089672,"title":"","content":"Possibly, but Rose specifically referred to them as emphereal beings.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2241-omegaphallic","name":"Omegaphallic","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"3435"}]},"thankedby":[]},{"date":"2017-05-08T08:05:55-07:00","id":1089789,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Omegaphallic</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1082242-hedge-ghosts?p=1089672#post1089672\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Possibly, but Rose specifically referred to them as emphereal beings.</div> </div> </div> </div><a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1077119-a-walk-in-the-hedge?p=1078369#post1078369\">This </a>is the referrence, right? She only says that they use the ephemeral entity rules, not that they are ephemeral entities, and another post by another writer <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1077119-a-walk-in-the-hedge?p=1078439#post1078439\">here</a> say that they use Glamour instead of Essence. So the possibility of them being something more like the Strix (non-ephemeras who use the Ephemeral Entity rules) is still open, I think.","signature":"<hr class=\"b-divider\"/><br/>MtAw Homebrew:<br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1051456-even-more-legacies-updated-to-2e#post1051456\" target=\"_blank\">Even more Legacies, updated to 2E</a><br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1443819-new-2e-legacies-expanded\" target=\"_blank\">New 2E Legacies, expanded</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12619-21c-hermit","name":"21C Hermit","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12619_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"3489"}]},"thankedby":[]},{"date":"2017-05-08T08:15:59-07:00","id":1089795,"title":"","content":"Damn you right, good observation. I hope the do a development blog on Hedge Ghosts.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2241-omegaphallic","name":"Omegaphallic","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"3435"}]},"thankedby":[]},{"date":"2017-05-08T09:16:19-07:00","id":1089822,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>21C Hermit</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1082242-hedge-ghosts?p=1089789#post1089789\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1077119-a-walk-in-the-hedge?p=1078369#post1078369\">This </a>is the referrence, right? She only says that they use the ephemeral entity rules, not that they are ephemeral entities, and another post by another writer <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1077119-a-walk-in-the-hedge?p=1078439#post1078439\">here</a> say that they use Glamour instead of Essence. So the possibility of them being something more like the Strix (non-ephemeras who use the Ephemeral Entity rules) is still open, I think.</div> </div> </div> </div>Qashmallim would be a better analogue than Strix since the only &quot;ephemeral entities&quot; rules that Strix use is the three Attributes, and not even that is particularly similar to ephemeral entities since they use them together with Skills like people in dream forms rather than ephemerals' Attribute+Attribute rolls.<br /> <br /> Qashmallim, on the other hand, starts with the ephemeral rules and then describes the exceptions from the normal ephemeral rules. I personally hope that Hedge Ghosts are actually ephemeral, but otherwise differ from regular ghosts similar to how Qashmallim differ from ephemerals.<br /> <br /> I get why people compares Strix to ephemeral entities since they're kinda similar, but it irks me when people (and even the books) say Strix use ephemeral rules since they simply don't.<br /> <br /> Edit:<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Meghan Fitzgerald</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1077119-a-walk-in-the-hedge?p=1078439#post1078439\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hedge ghosts are a different type of ephemeral entity from the ghosts that you find elsewhere, and they use Glamour rather than Essence.</div> </div> </div> </div>At least it's confirmed that they are ephemeral rather than just using the ephemeral rules.","signature":"<hr class=\"b-divider\"/><br/>Writer for <a href=\"https://www.storytellersvault.com/product/410713/Bloodlines-The-Ageless\" target=\"_blank\">Bloodlines: The Ageless</a> and <a href=\"https://www.storytellersvault.com/product/491569/Fire--Revolution-Carthians\" target=\"_blank\">Fire &amp; Revolution: Carthians</a> on STV<br /> Some other stuff I've done: Ordo Dracul Mysteries: <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1138490-idea-coil-of-owls?p=1140522\" target=\"_blank\">Mystery of Smoke</a>, <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1227848-mystery-of-%C5%BEiva-house-rule-revision\" target=\"_blank\">Revised Mystery of \u017diva</a> Mage The Awakening: <a href=\"https://drive.google.com/file/d/0B2LMDRtfCcpdZDU1dWJzT1dNeEE/view\" target=\"_blank\">Spell Quick Reference</a> (single page and landscape for computer screens)","edited":{"userid":11887,"user_link":"https://forum.theonyxpath.com/member/11887-tessie","user":"Tessie","date":". 05-08-2017, 12:19 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11887-tessie","name":"Tessie","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11887_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"4406"}]},"thankedby":[]},{"date":"2017-05-08T10:21:49-07:00","id":1089848,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Tessie</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1082242-hedge-ghosts?p=1089822#post1089822\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Qashmallim would be a better analogue than Strix since the only &amp;quot;ephemeral entities&amp;quot; rules that Strix use is the three Attributes, and not even that is particularly similar to ephemeral entities since they use them together with Skills like people in dream forms rather than ephemerals' Attribute+Attribute rolls.<br /> <br /> Qashmallim, on the other hand, starts with the ephemeral rules and then describes the exceptions from the normal ephemeral rules. I personally hope that Hedge Ghosts are actually ephemeral, but otherwise differ from regular ghosts similar to how Qashmallim differ from ephemerals.<br /> <br /> I get why people compares Strix to ephemeral entities since they're kinda similar, but it irks me when people (and even the books) say Strix use ephemeral rules since they simply don't.<br /> <br /> Edit:<br /> <br /> <br /> <br /> At least it's confirmed that they are ephemeral rather than just using the ephemeral rules.</div> </div> </div> </div> Why is there a benefit to them being true ephemerals rather then like Qashmallim? <br /> <br /> I'll have to check my Promny 2e corebook to refresh my memory on Qashmallims.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2241-omegaphallic","name":"Omegaphallic","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"3435"}]},"thankedby":[]},{"date":"2017-05-08T10:37:01-07:00","id":1089854,"title":"","content":"If they weren't ephemeral then any similarities to regular ghosts would be coincidental. Hedge Ghosts and regular ghosts being an example of &quot;convergent evolution&quot; would certainly be interesting, but for me personally I find it more interesting to explore the relation between Hedge Ghosts and ghosts should they be two distinct but ultimately related phenomena. (At least if they're more related than say ghosts and spirits who just both happen to be ephemeral.)","signature":"<hr class=\"b-divider\"/><br/>Writer for <a href=\"https://www.storytellersvault.com/product/410713/Bloodlines-The-Ageless\" target=\"_blank\">Bloodlines: The Ageless</a> and <a href=\"https://www.storytellersvault.com/product/491569/Fire--Revolution-Carthians\" target=\"_blank\">Fire &amp; Revolution: Carthians</a> on STV<br /> Some other stuff I've done: Ordo Dracul Mysteries: <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1138490-idea-coil-of-owls?p=1140522\" target=\"_blank\">Mystery of Smoke</a>, <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/1227848-mystery-of-%C5%BEiva-house-rule-revision\" target=\"_blank\">Revised Mystery of \u017diva</a> Mage The Awakening: <a href=\"https://drive.google.com/file/d/0B2LMDRtfCcpdZDU1dWJzT1dNeEE/view\" target=\"_blank\">Spell Quick Reference</a> (single page and landscape for computer screens)","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11887-tessie","name":"Tessie","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11887_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"4406"}]},"thankedby":[]},{"date":"2017-05-08T23:31:06-07:00","id":1090127,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Tessie</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1082242-hedge-ghosts?p=1089822#post1089822\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Qashmallim would be a better analogue than Strix since the only &quot;ephemeral entities&quot; rules that Strix use is the three Attributes, and not even that is particularly similar to ephemeral entities since they use them together with Skills like people in dream forms rather than ephemerals' Attribute+Attribute rolls.<br /> <br /> Qashmallim, on the other hand, starts with the ephemeral rules and then describes the exceptions from the normal ephemeral rules. I personally hope that Hedge Ghosts are actually ephemeral, but otherwise differ from regular ghosts similar to how Qashmallim differ from ephemerals.<br /> <br /> I get why people compares Strix to ephemeral entities since they're kinda similar, but it irks me when people (and even the books) say Strix use ephemeral rules since they simply don't.<br /></div> </div> </div> </div>Oh, the qashmallim completely slipped my mind. Yeah, they make better analogues. It's just that I (and the people you mention) had more time to familiarize myself with Vampire than Promethean, so the first example that pops up is the Owls rather than the Flames.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <br /> Edit:<br /> <br /> <br /> <br /> At least it's confirmed that they are ephemeral rather than just using the ephemeral rules. </div> </div> </div>Ah, I see.<br /> <br /> <br /> Hmm, would they have Anchors then I presume? But Anchors are something formed to connect the ghost to the living world, and yet Hedge Ghosts are native to the Hedge. Or are they Hedge natives in the same sense that the Underworld is ghosts' true home domain, and can Hedge Ghosts be created in places outside the Hedge? I remember in the Huntsmen preview that changelings in a Bargain (the pledge type, not the Court function) with mortals are masked from them by appearing to be 'native' fae of the mortal world. Could Hedge Ghosts be that 'native' fae? Speculations arise...","signature":"<hr class=\"b-divider\"/><br/>MtAw Homebrew:<br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1051456-even-more-legacies-updated-to-2e#post1051456\" target=\"_blank\">Even more Legacies, updated to 2E</a><br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1443819-new-2e-legacies-expanded\" target=\"_blank\">New 2E Legacies, expanded</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12619-21c-hermit","name":"21C Hermit","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12619_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"3489"}]},"thankedby":[]},{"date":"2017-05-09T09:09:24-07:00","id":1090333,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>21C Hermit</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1082242-hedge-ghosts?p=1090127#post1090127\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Oh, the qashmallim completely slipped my mind. Yeah, they make better analogues. It's just that I (and the people you mention) had more time to familiarize myself with Vampire than Promethean, so the first example that pops up is the Owls rather than the Flames.<br /> <br /> <br /> <br /> Ah, I see.<br /> <br /> <br /> Hmm, would they have Anchors then I presume? But Anchors are something formed to connect the ghost to the living world, and yet Hedge Ghosts are native to the Hedge. Or are they Hedge natives in the same sense that the Underworld is ghosts' true home domain, and can Hedge Ghosts be created in places outside the Hedge? I remember in the Huntsmen preview that changelings in a Bargain (the pledge type, not the Court function) with mortals are masked from them by appearing to be 'native' fae of the mortal world. Could Hedge Ghosts be that 'native' fae? Speculations arise...</div> </div> </div> </div> Maybe Hedge Ghosts have something different then Anchors and Reasence, like maybe they are tied to emotions or story roles. Just a wild guess.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2241-omegaphallic","name":"Omegaphallic","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"3435"}]},"thankedby":[]},{"date":"2017-05-10T16:16:05-07:00","id":1090910,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>21C Hermit</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/changeling-the-lost/1082242-hedge-ghosts?p=1089592#post1089592\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> This maybe how Hedge Ghosts turn out to be, if they indeed have Wyrd and Glamour.</div> </div> </div> </div> We know they have Glamour, we don't know if they have Wyrd or Glamour.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2241-omegaphallic","name":"Omegaphallic","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"3435"}]},"thankedby":[]}]}