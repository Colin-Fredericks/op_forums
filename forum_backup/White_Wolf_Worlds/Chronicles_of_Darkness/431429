/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"192"}]},"thankedby":[]},{"date":"2015-03-07T12:01:09-08:00","id":431599,"title":"","content":"Understandable. It's a touch rough for me, too, and I'm only 9 hours away by car! It's just the only thing I know I'm doing that isn't limited to any of my three local groups. If I had time to run something online, I would, though.","signature":"<hr class=\"b-divider\"/><br/>This space for rent.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/552-strider1276","name":"strider1276","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar552_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"382"}]},"thankedby":[]},{"date":"2015-03-07T12:01:19-08:00","id":431601,"title":"","content":"I would love to offer my services as GM, but I am already doing two games every week, so I am kind of swamped.","signature":"<hr class=\"b-divider\"/><br/>Politeness is the lubricant of social intercourse.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/272-saibot","name":"saibot","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar272_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1063"}]},"thankedby":[]},{"date":"2015-03-07T12:02:51-08:00","id":431604,"title":"","content":"I should also mention that, for timezone reasons, a play by post is far more practical for me.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2650-retias","name":"Retias","avatar":"data:image/svg+xml;base64,","title":"M