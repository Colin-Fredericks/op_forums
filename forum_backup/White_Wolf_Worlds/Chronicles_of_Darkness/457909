d in killing.","signature":"","edited":{"userid":886,"user_link":"https://forum.theonyxpath.com/member/886-nofather","user":"nofather","date":". 03-27-2015, 12:24 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]}]}