ocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2014-05-03T12:11:29-07:00","id":124663,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ArcaneArts</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124523#post124523\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I know, right?<br /> <br /> So, question, ironically,about the Faithful: Do the effects of Anthrophagy not wear off unless it's Revivify?</div> </div> </div> </div>Looks that way. They can only have dots in Dread Powers (not including Revivify) up to their Endowment dots, but yeah. If a Shulpite has eaten a power he likes, he can keep it.<br /> <br /> They're literally the Promethean Brotherhood's big, badass brothers, and a hell of a lot less amoral (their Feast is a sign of their <i>devotion...</i>and they fully admit the Lucifuge are descended from wicked gods, so I suspect they hunt genuine threats and give the power of the dark demigods in more pious, kind hands...by the Faithful's estimation,,,).","signature":"<hr class=\"b-divider\"/><br/><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.us/a/img824/1346/mosz.jpg\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/180-leliel","name":"Leliel","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar180_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2259"}]},"thankedby":[]},{"date":"2014-05-03T12:12:52-07:00","id":124665,"title":"","content":"I'm going to rework the 1 pager abit, see if I can squeeze tactics in there...I'll post an update shortly.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://mrgone.rocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2014-05-03T12:33:39-07:00","id":124676,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Leliel</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124663#post124663\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Looks that way. They can only have dots in Dread Powers (not including Revivify) up to their Endowment dots, but yeah. If a Shulpite has eaten a power he likes, he can keep it.<br /> <br /> They're literally the Promethean Brotherhood's big, badass brothers, and a hell of a lot less amoral (their Feast is a sign of their <i>devotion...</i>and they fully admit the Lucifuge are descended from wicked gods, so I suspect they hunt genuine threats and give the power of the dark demigods in more pious, kind hands...by the Faithful's estimation,,,).</div> </div> </div> </div>I think they're about even if for no other reason than they don't eat people.<br /> <br /> .<br /> But guys! GUYS! We're missing the big picture! <i>These guys are becoming what they eat!</i>(particularly since,while the goal is mummies, they can eat any monster)<br /> <br /> The Faithful just got a lot cooler. Hooray almost-cannibalism!<br />","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2014-05-03T12:35:32-07:00","id":124680,"title":"","content":"Ok, got that 1 pager updated. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://mrgone.rocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2014-05-03T14:41:25-07:00","id":124777,"title":"","content":"HOD Rounds versus Compound Rounds: Hod does half lethal to vampires and negates the penalty for staking(plus you know, staking in general with a bullet, where as Compound does lethal to anything regardless, and 9 again.<br /> <br /> I'm thinking Hod Rounds need an upgrade against vampires, is what I'm saying.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2014-05-03T16:07:00-07:00","id":124834,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mr Gone</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124612#post124612\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I don't have the book, so I apologize if there's endowments or merits missing. If someone wants to type me up a list, I'll be more than willing to update the sheets. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /></div> </div> </div> </div>The same kind soul who sent me the sheet also wrote me up a list of the new endowments and such, so I'll be updating the sheets with those. I'll let you know when they're ready...<br /> <br /> <br /> Edit: Annnd they're updated. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://mrgone.rocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":24,"user_link":"https://forum.theonyxpath.com/member/24-mr-gone","user":"Mr Gone","date":". 05-03-2014, 07:35 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2014-05-03T17:17:34-07:00","id":124861,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>glamourweaver</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=123987#post123987\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> They can PUNCH OFF DEMONS' COVERS!</div> </div> </div> </div>I'm thinking about homebrewing it to be less Demon-centric and say that it punches any shapeshifter into their birth form. It just so happens that Demons' natural form is their demon form.<br /> <br /> Mostly because my players have been dissatisfied with the power level of Hunter since the game came out and one of them told the other half-remembered snippets of Reckoning and I think this will bump them up a little.<br /> <br /> And partially because I like the idea of one of my players punching a werewolf out of gauru.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1178-ravenmancer","name":"Ravenmancer","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"36"}]},"thankedby":[]},{"date":"2014-05-03T17:38:15-07:00","id":124877,"title":"","content":"Demon-centric is kind of the point. Ever other ability of theirs works on non-demons though, I think Fist of Revelation is allowed to be specific for the flavor's sake.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2014-05-03T18:13:26-07:00","id":124890,"title":"","content":"I finished reading the book, and I must say that The Knights of St. Adrian is probably the closest that we'll get to having a Hunter of the Avenger creed in nWoD. Plus, since the Faithful of Shulpae eats Undead denizens of the World of Darkness, I wonder if they can feast on Kindred as well as they do on the Arisen. It would be interesting.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/891-jackalopevegas","name":"JackalopeVegas","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"246"}]},"thankedby":[]},{"date":"2014-05-03T18:21:51-07:00","id":124896,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ArcaneArts</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124877#post124877\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Demon-centric is kind of the point. Ever other ability of theirs works on non-demons though, I think Fist of Revelation is allowed to be specific for the flavor's sake.</div> </div> </div> </div>On a slightly darker note, I just realized the Fae fall within the St. Adrian's focus.<br /> <br /> The idea of a bunch of 80's era action heros hunting down what basically amounts to abuse victims is very grimm indeed.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/604-shock","name":"Shock","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar604_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1071"}]},"thankedby":[]},{"date":"2014-05-03T20:13:34-07:00","id":124936,"title":"","content":"After talking with someone about a different sheet, I might slightly update the way beats are on these sheets, to have Beats, then Experiences, followed by Practical Beats and then Practical experiences. I did it for a GMC update to an Awakening sheet, so I might do it here as well....<br /> <br /> I'll post and update once I do it. Thanks for bearing with me everyone. <img src=\"https://forum.theonyxpath.com/core/images/smilies/biggrin.png\" border=\"0\" alt=\"\" title=\"Big Grin\" smilieid=\"3\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://mrgone.rocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2014-05-03T20:31:55-07:00","id":124949,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shock</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124896#post124896\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> On a slightly darker note, I just realized the Fae fall within the St. Adrian's focus.<br /> <br /> The idea of a bunch of 80's era action heros hunting down what basically amounts to abuse victims is very grimm indeed.</div> </div> </div> </div>How so?<br /> <br /> (I mean, every group that has a particular focus on demons has claim on the Fae, but I think you have something more exact in mind)<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JackalopeVegas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124890#post124890\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I finished reading the book, and I must say that The Knights of St. Adrian is probably the closest that we'll get to having a Hunter of the Avenger creed in nWoD. Plus, since the Faithful of Shulpae eats Undead denizens of the World of Darkness, I wonder if they can feast on Kindred as well as they do on the Arisen. It would be interesting.</div> </div> </div> </div>The Faithful can eat <i>anyone</i>. Anthrophagy draws no distinction. I imagine it's not a stretch for them to consider all sorts of monsters as divine, with immortals being the most divine.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":99,"user_link":"https://forum.theonyxpath.com/member/99-arcanearts","user":"ArcaneArts","date":". 05-03-2014, 11:35 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2014-05-03T20:41:57-07:00","id":124954,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shock</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=122913#post122913\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I just finished reading Knight of St. Adrian. Here are my thoughts on the matter:</div> </div> </div> </div>I bought <i>Mortal Remains</i> mainly for the <i>Promethean</i> and <i>Mummy</i> chapters and, while I read most of <i>Demon: the Descent</i> and it sounds solid but I probably won't end up playing it, I gotta say that your post just sold me on reading the <i>Demon</i> chapter when I initially had no drive to","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/638-reseru","name":"reseru","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar638_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1574"}]},"thankedby":[]},{"date":"2014-05-03T21:12:17-07:00","id":124979,"title":"","content":"So I may have just thrown together a write-up of the Fog Men as a minor Conspiracy rather than a supernatural threat all their own. Oops.","signature":"<hr class=\"b-divider\"/><br/>Remi. she/her. game designer.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/281-atamajakki","name":"atamajakki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar281_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5487"}]},"thankedby":[]},{"date":"2014-05-03T22:43:07-07:00","id":125007,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ArcaneArts</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124949#post124949\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">How so?<br /> <br /> (I mean, every group that has a particular focus on demons has claim on the Fae, but I think you have something more exact in mind)</div> </div> </div> </div>Most notably, The conspiracy, at it's core, is a bounty hunter organization. True, the God-Machine has co-oped it but I am assuming it's still open for normal customers as well.<br /> <br /> What would happen if a True Fae decided to use that company to recover some &quot;bail jumpers?&quot; <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/604-shock","name":"Shock","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar604_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1071"}]},"thankedby":[]},{"date":"2014-05-04T02:52:46-07:00","id":125092,"title":"","content":"I wouldn't really say co-opted in this case. There's relatively minimal deception and a lot of money instead. Can mercenaries be &quot;co-opted&quot;?","signature":"<hr class=\"b-divider\"/><br/>\u201cThere are no rules. Only Principles and natural laws.\u201d - Promethius<br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/17686-the-kings-raven-s-homebrwe-index\" target=\"_blank\">My Homebrew no longer fits in a signature, you can find an index of it here</a>.<br /> <b>Full length fan-books I contributed too: </b><a href=\"https://sites.google.com/site/princessthehopeful/files/PrincessTheHopeful.pdf?attredirects=0&amp;d=1\" target=\"_blank\">Princess: the Hopeful</a>, <a href=\"https://drive.google.com/drive/folders/0B9DMG5y7ZdngekVaMGNQbTF4RzA\" target=\"_blank\">Leviathan: the Tempest</a>, <a href=\"https://sites.google.com/site/thekingsraven/files/DreamCatchers.pdf?attredirects=0&amp;d=1\" target=\"_blank\">Dream Catchers</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/134-the-kings-raven","name":"The Kings Raven","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar134_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"3003"}]},"thankedby":[]},{"date":"2014-05-04T07:10:40-07:00","id":125150,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JackalopeVegas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124890#post124890\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I finished reading the book, and I must say that <b>The Knights of St. Adrian is probably the closest that we'll get to having a Hunter of the Avenger creed in nWoD</b>. Plus, since the Faithful of Shulpae eats Undead denizens of the World of Darkness, I wonder if they can feast on Kindred as well as they do on the Arisen. It would be interesting.</div> </div> </div> </div>I thought the exact same thing. Avenger/Defender/Wayward Creed if played correctly, in the NWOD. Which is great since I love Reckoning.","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#333333\"><span style=\"font-family:&amp;quot\"><span style=\"font-size:16px\">&quot;Steel isn't strong, boy. Flesh is stronger.&quot;</span></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/95-fat-larry","name":"Fat Larry","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar95_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1337"}]},"thankedby":[]},{"date":"2014-05-04T08:18:08-07:00","id":125178,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Kings Raven</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=125092#post125092\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I wouldn't really say co-opted in this case. There's relatively minimal deception and a lot of money instead. Can mercenaries be &quot;co-opted&quot;?</div> </div> </div> </div>Absolutely, and there is a certain element of it if you understand the Sidearms from Demon the Descent. It may not be terribly forced, and it may not be a lot of deception, but God-Machine clearly just twisted the arm of Casey and probability to get a blunt instrument. There's probably catches to Ink that can be employed if the conspiracy on the whole starts realizing that the game's not as easy as angels and demons.<br /> <br /> Mercenaries have things they don't want to do, and when you want to get them to do it anyway, you co-opt them. You think any of the Sidearms would do what they do if they had an inklng of what 'Heaven' was really like?<br /> <br /> Of course, this is all assuming it goes at it from the Descent angle-it might legitimately be run by God and angels as conventionally understood.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shock</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=125007#post125007\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Most notably, The conspiracy, at it's core, is a bounty hunter organization. True, the God-Machine has co-oped it but I am assuming it's still open for normal customers as well.<br /> <br /> What would happen if a True Fae decided to use that company to recover some &quot;bail jumpers?&quot;</div> </div> </div> </div>Ooh, that's terrifying. Of course, the compunctions of the group might be a little more compromised once they do their digging.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2014-05-04T09:54:11-07:00","id":125211,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ArcaneArts</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=125178#post125178\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Absolutely, and there is a certain element of it if you understand the Sidearms from Demon the Descent. It may not be terribly forced, and it may not be a lot of deception, but God-Machine clearly just twisted the arm of Casey and probability to get a blunt instrument.</div> </div> </div> </div> Since the God Machine is infamously lazy, I suspect it didn't even both doing that. How many high quality bounty hunters are injured in the line of duty?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ArcaneArts</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=125178#post125178\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Mercenaries have things they don't want to do, and when you want to get them to do it anyway, you co-opt them. You think any of the Sidearms would do what they do if they had an inklng of what 'Heaven' was really like?</div> </div> </div> </div> Half of them: rebel. The other half: Sure, but it costs you extra.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ArcaneArts</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=125178#post125178\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Of course, this is all assuming it goes at it from the Descent angle-it might legitimately be run by God and angels as conventionally understood.</div> </div> </div> </div> Indeed it might.<br /> <br /> <br />","signature":"<hr class=\"b-divider\"/><br/>\u201cThere are no rules. Only Principles and natural laws.\u201d - Promethius<br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/17686-the-kings-raven-s-homebrwe-index\" target=\"_blank\">My Homebrew no longer fits in a signature, you can find an index of it here</a>.<br /> <b>Full length fan-books I contributed too: </b><a href=\"https://sites.google.com/site/princessthehopeful/files/PrincessTheHopeful.pdf?attredirects=0&amp;d=1\" target=\"_blank\">Princess: the Hopeful</a>, <a href=\"https://drive.google.com/drive/folders/0B9DMG5y7ZdngekVaMGNQbTF4RzA\" target=\"_blank\">Leviathan: the Tempest</a>, <a href=\"https://sites.google.com/site/thekingsraven/files/DreamCatchers.pdf?attredirects=0&amp;d=1\" target=\"_blank\">Dream Catchers</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/134-the-kings-raven","name":"The Kings Raven","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar134_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"3003"}]},"thankedby":[]},{"date":"2014-05-04T11:00:54-07:00","id":125239,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ArcaneArts</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124777#post124777\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'm thinking Hod Rounds need an upgrade against vampires, is what I'm saying.</div> </div> </div> </div>Not necessarily. Hod rounds are the specialty tool, while it feels like the compound rounds are set up for situations where you're not sure what the hell the monster is. I mean, vampires are <i>relatively</i> easy to uncover, given how all you need is a good cell phone camera and a decent sized cell to back you up. With the fae or similar creatures, you're not sure if it's gonna be the holy water or iron that's done the damage. Plus, Hod rounds need to be placed in the heart to have some effect, and that means if you're up against a leech, both rounds are useless if you aren't calm under fire and can easily hit the heart every time. So, I think compound rounds are a nice compliment to Hod and Etheric rounds.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/483-flyboy254","name":"Flyboy254","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar483_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"703"}]},"thankedby":[]},{"date":"2014-05-04T11:34:42-07:00","id":125263,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mr Gone</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=124936#post124936\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">After talking with someone about a different sheet, I might slightly update the way beats are on these sheets, to have Beats, then Experiences, followed by Practical Beats and then Practical experiences. I did it for a GMC update to an Awakening sheet, so I might do it here as well....<br /> <br /> I'll post and update once I do it. Thanks for bearing with me everyone. <img src=\"https://forum.theonyxpath.com/core/images/smilies/biggrin.png\" border=\"0\" alt=\"\" title=\"Big Grin\" smilieid=\"3\" class=\"inlineimg\" /></div> </div> </div> </div><br /> Ok, sheets updated. Same links as before.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://mrgone.rocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2014-05-04T12:13:16-07:00","id":125290,"title":"","content":"I can't help but wish each chapter could've had Compacts and/or Conspiracies. It's tough to imagine one about Prometheans (they're too rare, Qashmallim even more so, and Pandorans aren't an issue unless there's a Promethean around), but Changeling and Geist are dripping with potential. Anyone have any ideas for them?","signature":"<hr class=\"b-divider\"/><br/>Remi. she/her. game designer.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/281-atamajakki","name":"atamajakki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar281_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5487"}]},"thankedby":[]},{"date":"2014-05-04T13:23:06-07:00","id":125318,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>atamajakki</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=125290#post125290\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I can't help but wish each chapter could've had Compacts and/or Conspiracies. It's tough to imagine one about Prometheans (they're too rare, Qashmallim even more so, and Pandorans aren't an issue unless there's a Promethean around), but Changeling and Geist are dripping with potential. Anyone have any ideas for them?</div> </div> </div> </div>Yes, but you already read most of mine <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /><br /> <br /> I don't think it's hard to do a Promethian org, just create a group with a reason to exist entirely independently of Promethians; who on there rare encounter with the Created are the perfect thematic foil... why am I saying this, you already know that's my opinion <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /><br />","signature":"<hr class=\"b-divider\"/><br/>\u201cThere are no rules. Only Principles and natural laws.\u201d - Promethius<br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/17686-the-kings-raven-s-homebrwe-index\" target=\"_blank\">My Homebrew no longer fits in a signature, you can find an index of it here</a>.<br /> <b>Full length fan-books I contributed too: </b><a href=\"https://sites.google.com/site/princessthehopeful/files/PrincessTheHopeful.pdf?attredirects=0&amp;d=1\" target=\"_blank\">Princess: the Hopeful</a>, <a href=\"https://drive.google.com/drive/folders/0B9DMG5y7ZdngekVaMGNQbTF4RzA\" target=\"_blank\">Leviathan: the Tempest</a>, <a href=\"https://sites.google.com/site/thekingsraven/files/DreamCatchers.pdf?attredirects=0&amp;d=1\" target=\"_blank\">Dream Catchers</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/134-the-kings-raven","name":"The Kings Raven","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar134_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"3003"}]},"thankedby":[]},{"date":"2014-05-04T16:30:09-07:00","id":125388,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Flyboy254</strong> </div> <div class=\"message\">Not necessarily. Hod rounds are the specialty tool, while it feels like the compound rounds are set up for situations where you're not sure what the hell the monster is. I mean, vampires are relatively easy to uncover, given how all you need is a good cell phone camera and a decent sized cell to back you up. With the fae or similar creatures, you're not sure if it's gonna be the holy water or iron that's done the damage. Plus, Hod rounds need to be placed in the heart to have some effect, and that means if you're up against a leech, both rounds are useless if you aren't calm under fire and can easily hit the heart every time. So, I think compound rounds are a nice compliment to Hod and Etheric rounds.</div> </div> </div> </div>THe high use of HOD rounds, which is being able to stake a vampire without greater penalty and the general ability to stake with a bullet period is still good, but the general use of it has changed.<br /> <br /> Before GMC, being able to do half your bullet damage as lethal to vampires was a big deal-the power at range was quite valuable, because now you had a shot at taking them down before they got close(the conventional problem of most hunters). Now we have compound rounds that do full lethal damage(with 9 again!) to vampires even though they are a catch-all bullet-the jack of all banes is better than the specialty bullet for the average scenario, which is backwards. Sure, the staking thing is nice, but in order to really make that work(on top of of the old penalty) you have to take your time-time that Compound bullets can cut in half just killing the bastards.<br /> <br /> Sooooo...yes, it needs an upgrade.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2014-05-04T17:54:05-07:00","id":125426,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>atamajakki</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=125290#post125290\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I can't help but wish each chapter could've had Compacts and/or Conspiracies. It's tough to imagine one about Prometheans (they're too rare, Qashmallim even more so, and Pandorans aren't an issue unless there's a Promethean around), but Changeling and Geist are dripping with potential. Anyone have any ideas for them?</div> </div> </div> </div>&quot;You know about that pet rock craze? It was a stupid fad but I heard that a bunch of them weren't really rocks. They were creatures that were sleeping, waiting for something to wake them up. Wonder what could have done that..&quot;","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/604-shock","name":"Shock","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar604_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1071"}]},"thankedby":[]},{"date":"2014-05-05T09:39:29-07:00","id":125884,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Flyboy254</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=125239#post125239\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Not necessarily. Hod rounds are the specialty tool, while it feels like the compound rounds are set up for situations where you're not sure what the hell the monster is. <b>I mean, vampires are <i>relatively</i> easy to uncover, given how all you need is a good cell phone camera </b>and a decent sized cell to back you up. With the fae or similar creatures, you're not sure if it's gonna be the holy water or iron that's done the damage. Plus, Hod rounds need to be placed in the heart to have some effect, and that means if you're up against a leech, both rounds are useless if you aren't calm under fire and can easily hit the heart every time. So, I think compound rounds are a nice compliment to Hod and Etheric rounds.</div> </div> </div> </div>Not anymore. BTW What Hod and Compound rounds?","signature":"<hr class=\"b-divider\"/><br/>If you want By Night Studios to release new LARP RULES for NWoD,<br /> <a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/313137-open-letter-to-by-night-studios\" target=\"_blank\">like this post</a>.<br /> <br /> <img class=\"bbcode-attachment js-need-data-att-update\" src=\"filedata/fetch?filedataid=62\" data-tempid=\"temp_62_1418088885567_853\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/594-chattnos","name":"Chattnos","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar594_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"879"}]},"thankedby":[]},{"date":"2014-05-05T10:05:51-07:00","id":125920,"title":"","content":"HOD Rounds are from the supplement Night Stalkers, a TFV bullet made of wood with a core of mistletoe(specifically). It has a -2 to shoot, but does half of it's damage as lethal to vampires and takes no penalty for the purposes of staking-and oh, yeah, you can stake a vampire with these bullets.<br /> <br /> Compound Rounds are from the supplement Mortal Remains, a round made up of a variety of banes from folklore for all sorts of things. It does lethal to anything that normally wouldn't take it, and receives 9-again.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2014-05-05T12:32:05-07:00","id":126051,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ArcaneArts</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=125920#post125920\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">HOD Rounds are from the supplement Night Stalkers, a TFV bullet made of wood with a core of mistletoe(specifically). It has a -2 to shoot, but does half of it's damage as lethal to vampires and takes no penalty for the purposes of staking-and oh, yeah, you can stake a vampire with these bullets.<br /> <br /> Compound Rounds are from the supplement Mortal Remains, a round made up of a variety of banes from folklore for all sorts of things. It does lethal to anything that normally wouldn't take it, and receives 9-again.</div> </div> </div> </div>What nobody heard of Crossbows and wooden quarrels?<br /> Thanks though. Just how many banes can you get in a bullet? Doesn't that approach homeopathy levels?","signature":"<hr class=\"b-divider\"/><br/>If you want By Night Studios to release new LARP RULES for NWoD,<br /> <a href=\"http://forum.theonyxpath.com/forum/general/conventions-and-gatherings/313137-open-letter-to-by-night-studios\" target=\"_blank\">like this post</a>.<br /> <br /> <img class=\"bbcode-attachment js-need-data-att-update\" src=\"filedata/fetch?filedataid=62\" data-tempid=\"temp_62_1418088885567_853\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/594-chattnos","name":"Chattnos","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar594_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"879"}]},"thankedby":[]},{"date":"2014-05-05T14:13:47-07:00","id":126132,"title":"","content":"Like Valkyrie cares, on both counts. EDIT: I don't have the pdf with me right now, so I can't give an exact number, but the idea is still that this works on everyone, and the exact details will be damned.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":99,"user_link":"https://forum.theonyxpath.com/member/99-arcanearts","user":"ArcaneArts","date":". 05-05-2014, 05:33 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2014-05-05T15:46:12-07:00","id":126190,"title":"","content":"Updated the Mortal Remains sheet with a new logo and color background. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://mrgone.rocksolidshells.com/\" target=\"_blank\">MrGone's Character Sheets</a><br /> For all your WoD Character Sheet Needs<br /> _________________________________<br /> Buy books &amp; pdfs from DTRPG and support my web site! <a href=\"http://www.drivethrurpg.com/browse.php?affiliate_id=55414\" target=\"_blank\">Click Here</a><br /> Support my site on Patreon! <a href=\"https://www.patreon.com/mrgone\" target=\"_blank\">Click Here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24-mr-gone","name":"Mr Gone","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2695"}]},"thankedby":[]},{"date":"2014-05-05T17:44:55-07:00","id":126295,"title":"","content":"Why are compound rounds a 1-5 dot merit, is there supposed to be a limit on how many monsters are affected per dot or something?<br /> <br /> *EDIT* Nevermind, I figured out the 1-5 dot merit thing and yeah this is a bit ridiculous as written, what about etheric rounds? Do you even need those anymore?","signature":"","edited":{"userid":2111,"user_link":"https://forum.theonyxpath.com/member/2111-doeman","user":"DoeMan","date":". 05-05-2014, 09:02 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2111-doeman","name":"DoeMan","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"68"}]},"thankedby":[]},{"date":"2014-05-05T18:02:20-07:00","id":126302,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>DoeMan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=126295#post126295\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Why are compound rounds a 1-5 dot merit, is there supposed to be a limit on how many monsters are affected per dot or something?</div> </div> </div> </div>Presumably it uses the same rules for the Etheric Rounds it references, where the number of dots determines how many clips of ammo you're authorized to carry at once.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/522-stupid-loserman","name":"Stupid Loserman","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar522_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1824"}]},"thankedby":[]},{"date":"2014-05-05T18:05:38-07:00","id":126304,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>DoeMan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=126295#post126295\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Why are compound rounds a 1-5 dot merit, is there supposed to be a limit on how many monsters are affected per dot or something?</div> </div> </div> </div>I read it to work like Etheric Rounds. Each dot gets ya a clip.<br /> <br /> As for the book in general, seems to me to have a very different feel from the other supplements. Less Huntery, more cross-over madnessy. Maybe it was the shortness of the individual sections. I certainly look forward to the next supplement when/if one comes out.","signature":"<hr class=\"b-divider\"/><br/><div align=\"center\"> <div align=\"left\"><a href=\"http://imageshack.com/a/img31/2512/25ew.png\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img31/2512/25ew.png\" border=\"0\" alt=\"\" /></a></div> </div> Audentis Fortuna iuvat.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/548-generalvostok","name":"generalvostok","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar548_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"12"}]},"thankedby":[]},{"date":"2014-05-05T18:36:17-07:00","id":126315,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>DoeMan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=126295#post126295\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> *EDIT* Nevermind, I figured out the 1-5 dot merit thing and yeah this is a bit ridiculous as written, what about etheric rounds? Do you even need those anymore?</div> </div> </div> </div>Since ghosts are the most common and homogeneus type of super in the World of darkness i think they still found some use to those old etheric rounds xD<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2896-nemastoncito","name":"Nemastoncito","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"13"}]},"thankedby":[]},{"date":"2014-05-05T18:42:30-07:00","id":126319,"title":"","content":"Mortal Remains had two major effects on me; hungry for <i>Threats Unknown</i> and hungry for new Geist content.","signature":"<hr class=\"b-divider\"/><br/>Remi. she/her. game designer.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/281-atamajakki","name":"atamajakki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar281_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5487"}]},"thankedby":[]},{"date":"2014-05-05T18:50:52-07:00","id":126331,"title":"","content":"Can someone refresh my memory of what we know about Threats Unknown?","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#333333\"><span style=\"font-family:&amp;quot\"><span style=\"font-size:16px\">&quot;Steel isn't strong, boy. Flesh is stronger.&quot;</span></span></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/95-fat-larry","name":"Fat Larry","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar95_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1337"}]},"thankedby":[]},{"date":"2014-05-05T20:10:20-07:00","id":126399,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dude of Legend</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/122598-mortal-remains-is-here?p=126331#post126331\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Can someone refresh my memory of what we know about Threats Unknown?</div> </div> </div> </div>It might've been pitched. Nothing beyond that; it's definitely not a for-sure product, I don't think. Still, it seems like Mortal Remains is selling well.","signature":"<hr class=\"b-divider\"/><br/>Remi. she/her. game designer.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/281-atamajakki","name":"atamajakki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar281_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"