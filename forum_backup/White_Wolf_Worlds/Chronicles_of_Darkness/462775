xpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2018-04-05T11:13:09-07:00","id":1203458,"title":"","content":"Question. How would Uratha heal the gauntlet after the hosts fuck with it? Is this the sort of thing only time can fix?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24014-winterchangeling","name":"WinterChangeling","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2018"},{"key":"Posts:","value":"4"}]},"thankedby":[]},{"date":"2018-04-05T13:45:26-07:00","id":1203510,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>WinterChangeling</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/werewolf-the-forsaken/462775-ask-a-simple-question-get-a-simple-answer-werewolf-2e-edition?p=1203458#post1203458\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Question. How would Uratha heal the gauntlet after the hosts fuck with it? Is this the sort of thing only time can fix?</div> </div> </div> </div>We talked briefly about this in another thread, and Gnomish American said he remembered a formula for it from one of the first edition books <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/werewolf-the-forsaken/708218-the-gauntlet?p=709966#post709966\">here</a>.<br /> <br /> Mostly it's time, but obviously keeping things from messing around with it would help.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/886-nofather","name":"nofather","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar886_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11016"}]},"thankedby":[]},{"date":"2018-04-05T14:43:06-07:00","id":1203530,"title":"","content":"You can always make a fetish to speed the process.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12191-malus","name":"Malus","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12191_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2016"},{"key":"Posts:","value":"1562"}]},"thankedby":[]},{"date":"2018-04-05T18:42:20-07:00","id":1203612,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>nofather</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/werewolf-the-forsaken/462775-ask-a-simple-question-get-a-simple-answer-werewolf-2e-edition?p=1202073#post1202073\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Just the host dies, spirit escapes.</div> </div> </div> </div>Unless it was Hive-Claimed. Then, apparently, the Three Stooges Syndrome comes into play and they all die too.","signature":"<hr class=\"b-divider\"/>