rs/0/0/6/0/4/5/avatar43_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2240"}]},"thankedby":[]},{"date":"2017-03-16T13:52:08-07:00","id":1063469,"title":"","content":"Thank you kindly! Anyways, Archon, these are 2 of your cabal mates. Your 3rd is/was/might-still-be Jim. What arcana you got?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2309-ashenrogue","name":"Ashenrogue","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2309_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"1388"}]},"thankedby":[]},{"date":"2017-03-16T13:53:55-07:00","id":1063471,"title":"","content":"Okay, let's do this. Silver Ladder Acanthus with Time 3, Space 3 and Fate 2.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11880-dark-archon","name":"Dark Archon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11880_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"348"}]},"thankedby":[]},{"date":"2017-03-16T13:55:06-07:00","id":1063472,"title":"","content":"(I am legitimately, unironically hyped for this game tbh)","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:lucida sans unicode\">Bearer of the legacy of Trauma Bear<br /> Need a dice-roller? Check out <a href=\"http://bit.ly/dicemat\" target=\"_blank\">Dicemat</a>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/43-fata-ku","name":"Fata-Ku","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar43_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2240"}]},"thankedby":[]},{"date":"2017-03-16T13:55:53-07:00","id":1063473,"title":"","content":"Oh, and by the way - killer can't have Time magic. That's the thing.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11880-dark-archon","name":"Dark Archon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11880_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"348"}]},"thankedby":[]},{"date":"2017-03-16T13:55:55-07:00","id":1063474,"title":"","content":"I find the complaint weird because it's analogous to complaining that you're investigative character is using his detective skills to solve a mystery with forensic evidence and video footage. Postcognition like all magic is a short cut to what mundane stuff can do, or accomplishing what the mundane can't, but it's still just a character using their skills. Also, no good mystery story is done before the character does something with or about the information he's discovered.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":7}],"user":{"link":"https://forum.theonyxpath.com/member/2632-mrmdubois","name":"Mrmdubois","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"6827"}]},"thankedby":[]},{"date":"2017-03-16T13:56:25-07:00","id":1063475,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dark Archon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063471#post1063471\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Okay, let's do this. Silver Ladder Acanthus with Time 3, Space 3 and Fate 2.</div> </div> </div> </div>Alright! Now Jims been missing for about 4 hours, but that doesn't necessarily mean it's time to panic. He's not the greatest when it comes to keeping track of days and schedules, so he might have just forgot about your hang out night. What do?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dark Archon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063473#post1063473\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Oh, and by the way - killer can't have Time magic. That's the thing.</div> </div> </div> </div>Correct, he has 0 dots in Time as per the scenario.<br /> <br /> Also, Romulus's Alchemist is at the bar waiting with you. Fata-Ku's hacker is currently busy with something else, but he could be called it something comes up.","signature":"","edited":{"userid":2309,"user_link":"https://forum.theonyxpath.com/member/2309-ashenrogue","user":"Ashenrogue","date":". 03-16-2017, 04:58 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2309-ashenrogue","name":"Ashenrogue","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2309_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"1388"}]},"thankedby":[]},{"date":"2017-03-16T13:58:37-07:00","id":1063479,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ashenrogue</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063475#post1063475\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Alright! Now Jims been missing for about 4 hours, but that doesn't necessarily mean it's time to panic. He's not the greatest when it comes to keeping track of days and schedules, so he might have just forgot about your hang out night. What do?</div> </div> </div> </div>Check my future for the events which will happen if I will start to look for him. Reached Divination.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11880-dark-archon","name":"Dark Archon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11880_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"348"}]},"thankedby":[]},{"date":"2017-03-16T14:00:48-07:00","id":1063480,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dark Archon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063479#post1063479\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Check my future for the events which will happen if I will start to look for him. Reached Divination.</div> </div> </div> </div>You foresee a lot of time spent tracking him down in the past with just your alchemist cabal mate, but not actually finding much.<br /> <br /> Edit: What do?","signature":"","edited":{"userid":2309,"user_link":"https://forum.theonyxpath.com/member/2309-ashenrogue","user":"Ashenrogue","date":". 03-16-2017, 05:04 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2309-ashenrogue","name":"Ashenrogue","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2309_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"1388"}]},"thankedby":[]},{"date":"2017-03-16T14:05:28-07:00","id":1063485,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ashenrogue</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063480#post1063480\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">You foresee a lot of time spent tracking him down in the past with just your alchemist cabal mate, but not actually finding much.</div> </div> </div> </div>Okay, let's get to it then. I tell Romulus that Jim isn't going to show up, notify other character and start guessing where is the last time he reliably was. I also try scrying his present location, using his name for that. I also constantly check the future for signs of trouble.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11880-dark-archon","name":"Dark Archon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11880_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"348"}]},"thankedby":[]},{"date":"2017-03-16T14:06:46-07:00","id":1063486,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ashenrogue</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063480#post1063480\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">You foresee a lot of time spent tracking him down in the past with just your alchemist cabal mate, but not actually finding much.</div> </div> </div> </div>I get frustrated with his non-answering-his-phone and send a sympathetic urge to check his phone, using my phone as a yantra for notification-anxiety.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:lucida sans unicode\">Bearer of the legacy of Trauma Bear<br /> Need a dice-roller? Check out <a href=\"http://bit.ly/dicemat\" target=\"_blank\">Dicemat</a>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/43-fata-ku","name":"Fata-Ku","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar43_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2240"}]},"thankedby":[]},{"date":"2017-03-16T14:09:42-07:00","id":1063490,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>RomulusGloriosus</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063453#post1063453\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Time is <i>most definitely </i>an issue with Time magic involved because even scrying <i>one week ago </i>is a -4.<br /> <br /> I know because one of my players tried scrying back to a week prior to figure out what was going on in the last game we had, and it was not enough.<br /> <br /> So, yeah, if your buddy has been missing for a long time, there's no guarantee you can even look back that far.</div> </div> </div> </div>I don't think this is correct. A -4 die penalty to the spellcasting pool with Advanced Duration will give the spell a Duration of a week, but the Duration doesn't affect where you can start scrying. As long as you have the right Temporal Sympathy, you could scry several thousand years into the past as far as I understand it. Now, if you wanted to look at the past for a week straight and you didn't employ the Reach effect which allows you to fast-forward, then yes you'd need to set a week Duration.<br /> <br /> I'm not misunderstanding this, am I?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/13082-projectmoon","name":"projectmoon","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2017"},{"key":"Posts:","value":"156"}]},"thankedby":[]},{"date":"2017-03-16T14:10:47-07:00","id":1063492,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dark Archon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063485#post1063485\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Okay, let's get to it then. I tell Romulus that Jim isn't going to show up, notify other character and start guessing where is the last time he reliably was. I also try scrying his present location, using his name for that.</div> </div> </div> </div>The last place you know he was at for a fact was hanging out with Fata-Ku's character earlier this morning at the starbucks downtown, and as for scrying, you can't seem to pick up anything. It's like he's not even there. You start to really find this worrisome. You're fairly sure that this isn't something like Jim being in a warded area, but you're not certain. The connection doesn't really feel like it was blocked or suppressed, just absent on one side. What do? Do you tell Romulus who is currently with you? If so, what do <i>you</i> do Rom?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2309-ashenrogue","name":"Ashenrogue","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2309_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"1388"}]},"thankedby":[]},{"date":"2017-03-16T14:14:34-07:00","id":1063500,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ashenrogue</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063492#post1063492\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The last place you know he was at for a fact was hanging out with Fata-Ku's character earlier this morning at the starbucks downtown, and as for scrying, you can't seem to pick up anything. It's like he's not even there. You start to really find this worrisome. You're fairly sure that this isn't something like Jim being in a warded area, but you're not certain. The connection doesn't really feel like it was blocked or suppressed, just absent on one side. What do? Do you tell Romulus who is currently with you? If so, what do <i>you</i> do Rom?</div> </div> </div> </div>As I understand, Romulus character is with me. I tell him about Jim being cut off on one side. Now we really need to get Fata-Ku and get to those starbucks. Can I cast Postcognition on Jim's past via Sympathetic Range Attainment by knowing his sympathetic name?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11880-dark-archon","name":"Dark Archon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11880_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"348"}]},"thankedby":[]},{"date":"2017-03-16T14:14:58-07:00","id":1063501,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>projectmoon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063490#post1063490\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I don't think this is correct. A -4 die penalty to the spellcasting pool with Advanced Duration will give the spell a Duration of a week, but the Duration doesn't affect where you can start scrying. As long as you have the right Temporal Sympathy, you could scry several thousand years into the past as far as I understand it. Now, if you wanted to look at the past for a week straight and you didn't employ the Reach effect which allows you to fast-forward, then yes you'd need to set a week Duration.<br /> <br /> I'm not misunderstanding this, am I?</div> </div> </div> </div>You are actually probably right, and I interpreted duration as time you could scry. Whoops. I'll have to apologize to the player next week....<br /> <br /> I am going to call Fata-Ku and see if he's gotten any luck getting a hold of Jim, and whether Jim had said anything about where he was gonna be after Starbucks.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12981-romulusgloriosus","name":"RomulusGloriosus","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12981_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2017"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2017-03-16T14:15:49-07:00","id":1063503,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Fata-Ku</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063486#post1063486\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I get frustrated with his non-answering-his-phone and send a sympathetic urge to check his phone, using my phone as a yantra for notification-anxiety.</div> </div> </div> </div>Unfortunately, you aren't currently with the rest of your cabal mates. You're currently using your mad hacker skills to break into the information databank of a prominent group of corporate Seers. Their system is heavily encrypted using both mundane and magical means, it's taking a great deal of concentrating to remain undetected. That said, they could always call you. If they do and you try to send a sympathetic message, you get the same absent feeling as Archon. <br /> <br /> That said, you know that if you pull out now, without being extremely careful, and taking your time, they may detect your presence and bad thing may stem from this venture. And even if you do remain undetected, there's a high chance of you not being able to get in again in the future.","signature":"","edited":{"userid":2309,"user_link":"https://forum.theonyxpath.com/member/2309-ashenrogue","user":"Ashenrogue","date":". 03-16-2017, 05:18 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/2309-ashenrogue","name":"Ashenrogue","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2309_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"1388"}]},"thankedby":[]},{"date":"2017-03-16T14:18:16-07:00","id":1063505,"title":"","content":"(All this really drives the point home about how good it is to have Cabalmates in case you accidentally splinch yourself out of existence.)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12981-romulusgloriosus","name":"RomulusGloriosus","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12981_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2017"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2017-03-16T14:19:11-07:00","id":1063506,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>RomulusGloriosus</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063505#post1063505\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">(All this really drives the point home about how good it is to have Cabalmates in case you accidentally splinch yourself out of existence.)</div> </div> </div> </div>Don't think anyone ever argued with that.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11880-dark-archon","name":"Dark Archon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11880_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"348"}]},"thankedby":[]},{"date":"2017-03-16T14:22:09-07:00","id":1063509,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dark Archon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063500#post1063500\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">As I understand, Romulus character is with me. I tell him about Jim being cut off on one side. Now we really need to get Fata-Ku and get to those starbucks. Can I cast Postcognition on Jim's past via Sympathetic Range Attainment by knowing his sympathetic name?</div> </div> </div> </div>You attempt to do so, and can pinpoint exactly where he was at around 6 hours ago using a combination of Space and Time. He was somewhere out on the highway outside out town heading to the east. From what you can tell he was by himself, driving out of town.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2309-ashenrogue","name":"Ashenrogue","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2309_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"1388"}]},"thankedby":[]},{"date":"2017-03-16T14:23:32-07:00","id":1063510,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ashenrogue</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063503#post1063503\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Unfortunately, you aren't currently with the rest of your cabal mates. You're currently using your mad hacker skills to break into the information databank of a prominent group of corporate Seers. Their system is heavily encrypted using both mundane and magical means, it's taking a great deal of concentrating to remain undetected. That said, they could always call you. If they do and you try to send a sympathetic message, you get the same absent feeling as Archon. <br /> <br /> That said, you know that if you pull out now, without being extremely careful, and taking your time, they may detect your presence and bad thing may stem from this venture. And even if you do remain undetected, there's a high chance of you not being able to get in again in the future.</div> </div> </div> </div>(I'm in the metro and can't check my books, but 1 mind 2 thoughts should still be a thing)<br /> I use one mind two thoughts, reaching for instant cast and probably again if I'm at my spell limit. Too focused to care about paradox or yantras.<br /> <br /> I put them on speaker phone.<br /> <br /> &quot;What up broskis?&quot; I say semi-ironically.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:lucida sans unicode\">Bearer of the legacy of Trauma Bear<br /> Need a dice-roller? Check out <a href=\"http://bit.ly/dicemat\" target=\"_blank\">Dicemat</a>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/43-fata-ku","name":"Fata-Ku","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar43_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2240"}]},"thankedby":[]},{"date":"2017-03-16T14:30:24-07:00","id":1063513,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ashenrogue</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063509#post1063509\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">You attempt to do so, and can pinpoint exactly where he was at around 6 hours ago using a combination of Space and Time. He was somewhere out on the highway outside out town heading to the east. From what you can tell he was by himself, driving out of town.</div> </div> </div> </div>Okay, so I need Fata-Ku character with us. If I can pinpoint his location around 6 hours, I can guess his current location by using Postcognition on east roads on my car. I can double that by using Locate Object on him in small radius around the roads. And this won't going to take as much time, because I can go back in time every time I found his location and start my search from the last correct time (don't know if all this is counted as one big scene).","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11880-dark-archon","name":"Dark Archon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11880_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"348"}]},"thankedby":[]},{"date":"2017-03-16T14:34:25-07:00","id":1063517,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MtA p.186</strong> </div> <div class=\"message\">Weak The subject is vastly different; a mage before her Awakening, an item before being imbued, a different building on the same lot, a ruin when it was new. Equals Withstand Sympathy 3</div> </div> </div> </div>I think a corpse version of your Cabal mate vs living version of cabal mate would fall in this category.","signature":"<hr class=\"b-divider\"/><br/><div align=\"center\"><i>\u201cYouth ages, immaturity is outgrown, ignorance can be educated, and drunkenness sobered, but stupid lasts forever.\u201d </i>~ <b>Aristophanes</b><br /> <i>&quot;Virescit Vulnere Virtus&quot;</i> ~ <b>Stewart Clan Motto</b></div> <div align=\"center\"><span style=\"font-size:18px\"><a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/801713-homebrew-of-pale_crusader\" target=\"_blank\">Frailty Chronicles</a></span><a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/801713-homebrew-of-pale_crusader\" target=\"_blank\">;</a><b><a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/801713-homebrew-of-pale_crusader\" target=\"_blank\">Understanding the power of limitations.</a></b></div>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/3279-pale_crusader","name":"Pale_Crusader","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3279_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2014"},{"key":"Posts:","value":"841"}]},"thankedby":[]},{"date":"2017-03-16T14:35:37-07:00","id":1063519,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Pale_Crusader</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063517#post1063517\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I think a corpse version of your Cabal mate vs living version of cabal mate would fall in this category.</div> </div> </div> </div>Well we haven't found his corpse yet, even if he is dead. If we find his corpse, I will have Death stuff I can do. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12981-romulusgloriosus","name":"RomulusGloriosus","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12981_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2017"},{"key":"Posts:","value":"342"}]},"thankedby":[]},{"date":"2017-03-16T14:36:34-07:00","id":1063520,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Pale_Crusader</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063517#post1063517\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I think a corpse version of your Cabal mate vs living version of cabal mate would fall in this category.</div> </div> </div> </div>That's cool, because I thought of taking Postcognition as my Praxis (as my player did). If we use standard rules, then I can penetrate temporal Withstand with ease.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11880-dark-archon","name":"Dark Archon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11880_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"348"}]},"thankedby":[]},{"date":"2017-03-16T14:42:53-07:00","id":1063525,"title":"","content":"So, for brevity's sake i guess we talk and Archon explains the circumstances. I attempt to leave a magically-disguised back-door in their system so that i can come back later, making them think they successfully fight me off.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:lucida sans unicode\">Bearer of the legacy of Trauma Bear<br /> Need a dice-roller? Check out <a href=\"http://bit.ly/dicemat\" target=\"_blank\">Dicemat</a>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/43-fata-ku","name":"Fata-Ku","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar43_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2240"}]},"thankedby":[]},{"date":"2017-03-16T14:45:25-07:00","id":1063527,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Pale_Crusader</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063517#post1063517\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I think a corpse version of your Cabal mate vs living version of cabal mate would fall in this category.</div> </div> </div> </div>Honestly, given what I know happened I'm probably making this a lot easier than it normally would be, but I'm kinda hand waving a lot, since I don't wanna make this that big of a thing.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dark Archon</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063513#post1063513\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Okay, so I need Fata-Ku character with us. If I can pinpoint his location around 6 hours, I can guess his current location by using Postcognition on east roads on my car. I can double that by using Locate Object on him in small radius around the roads. And this won't going to take as much time, because I can go back in time every time I found his location and start my search from the last correct time (don't know if all this is counted as one big scene).</div> </div> </div> </div>Yes, you can pinpoint where he was up until about 5 hours ago. At which point, he seems to vanish from your senses. He had made it out to the woods about 30 minutes car travel outside of the city, and then spent about another 30 minutes wandering into the woods, after which point your divination abruptly ends.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Fata-Ku</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/1063365-time-magic-ultimate-mystery-solver?p=1063525#post1063525\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So, for brevity's sake i guess we talk and Archon explains the circumstances. I attempt to leave a magically-disguised back-door in their system so that i can come back later, making them think they successfully fight me off.</div> </div> </div> </div>Noted.<br /> <br /> So, brave mages, what do?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2309-ashenrogue","name":"Ashenrogue","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2309_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"1388"}]},"thankedby":[]},{"date":"2017-03-16T14:48:06-07:00","id":1063529,"title":"","content":"This is a super fun mental exercise to watch by the way.<br /> <br /> Had a nasty thought: Life Unmake via space sympathy.<br />","signature":"<hr class=\"b-divider\"/><br/><div align=\"center\"><i>\u201cYouth ages, immaturity is outgrown, ignorance can be educated, and drunkenness sobered, but stupid lasts forever.\u201d </i>~ <b>Aristophanes</b><br /> <i>&quot;Virescit Vulnere Virtus&quot;</i> ~ <b>Stewart Clan Motto</b></div> <div align=\"center\"><span style=\"font-size:18px\"><a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/801713-homebrew-of-pale_crusader\" target=\"_bla