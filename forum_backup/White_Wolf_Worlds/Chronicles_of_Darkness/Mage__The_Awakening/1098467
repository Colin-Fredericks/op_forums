 href=\"https://goo.gl/gSjfm5\" target=\"_blank\">Hunter</a> l <a href=\"https://goo.gl/qj5aX9\" target=\"_blank\">Mage</a> | <a href=\"https://goo.gl/2HCpjg\" target=\"_blank\">Mummy</a> | <a href=\"https://goo.gl/68yRHY\" target=\"_blank\">Promethean</a> | <a href=\"https://goo.gl/a4mjqA\" target=\"_blank\">Vampire</a> | <a href=\"https://goo.gl/hrULtN\" target=\"_blank\">Werewolf</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4433-second-chances","name":"Second Chances","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4433_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"4202"}]},"thankedby":[]}]}