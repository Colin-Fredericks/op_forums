.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1757_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"1892"}]},"thankedby":[]},{"date":"2016-04-07T11:53:45-07:00","id":861185,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Acrozatarim</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/855314-the-sundered-world?p=861014#post861014\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> \u200bYes, he is.</div> </div> </div> </div><br /> Where's Bull?<br /> <br /> Astral? Shadow? Stuck somewhere in the Gauntlet?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/618-branford","name":"branford","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar618_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1904"}]},"thankedby":[]},{"date":"2016-04-07T12:01:04-07:00","id":861188,"title":"","content":"I assumed 'this era' referred to the current state in the Neolithic, post-Fox but pre-Sundering.<br /> <br /> In the modern age? God knows what's happened to Bull.<br />","signature":"<hr class=\"b-divider\"/><br/>- Chris Allen, Aberrant Line Developer, Freelance Writer<br /> <br /> \u200bLike my work? Feel like helping me stay supplied with tea? Check out my <b><a href=\"https://www.patreon.com/acrozatarim\" target=\"_blank\">Patreon</a></b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/1757-acrozatarim","name":"Acrozatarim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1757_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"1892"}]},"thankedby":[]},{"date":"2016-04-07T12:13:38-07:00","id":861197,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Acrozatarim</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/855314-the-sundered-world?p=861188#post861188\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> God knows what's happened to Bull.</div> </div> </div> </div>Which god knows? That sounds like a great plot hook for a chronicle. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/618-branford","name":"branford","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar618_2.gif","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1904"}]},"thankedby":[]},{"date":"2016-04-07T13:55:05-07:00","id":861270,"title":"","content":"The Red God that rests underneath the mountain knows what happened to Bull. If you believe yourself worthy then descend into the tunnels and find your way to the ruins of the age that never was!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":7}],"user":{"link":"https://forum.theonyxpath.com/member/1734-asaram","name":"Asaram","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1734_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"331"}]},"thankedby":[]},{"date":"2016-04-07T14:13:04-07:00","id":861284,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asaram</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/mage-the-awakening/855314-the-sundered-world?p=861270#post861270\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The Red God that rests underneath the mountain knows what happened to Bull. If you believe yourself worthy then descend into the tunnels and find your way to the ruins of the age that never was!</div> </div> </div> </div>Does the Red God sleep under Uluru?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8573-zombiecakes","name":"Zombiecakes","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"213"}]},"thankedby":[]},{"date":"2016-04-07T14:27:34-07:00","id":861304,"title":"","content":"I\u2019ve heard too many stories to tell you the truth. I\u2019ve heard that the Bull is real, that the Bull is a ghost. I\u2019ve heard that the Bull protects the Bird, or else that it keeps her a prisoner in her own Omphalos. There are so many stories.","signature":"<hr class=\"b-divider\"/><br/>Going by Willow now, or Wil for short. She/Her/Hers.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/269-charlaquin","name":"Charlaquin","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar269_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10831"}]},"thankedby":[]},{"date":"2016-04-07T14:27:55-07:00","id":861305,"title":"","content":"The Red God rests under every mountain in every age, it is where It forges new stone, soft and shining with It's light before it is sent forth to make new lands, new mountains, new weapons against the Slumbering one...<br /> <br /> Etc etc.<br /> Suddenly kind of feeling like having a mage game like that, with ancient gods moving in their sleep... twitching.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/1734-asaram","name":"Asaram","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1734_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"331"}]},"thankedby":[]},{"date":"2016-04-08T00:47:55-07:00","id":861665,"title":"","content":"Out of Character question: Where is Red God described?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2016-04-08T00:59:33-07:00","id":861672,"title":"",