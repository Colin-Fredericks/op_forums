ately love.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]}]}