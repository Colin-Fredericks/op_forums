orum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/vampire-the-requiem/461996-claws-of-the-unholy-protean-4?p=463697#post463697\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">If you've got a form with claws, Claws of the Unholy kicks in. If you avoid a form with claws, it doesn't.</div> </div> </div> </div>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12872-edgar-mcalister","name":"Edgar McAlister","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2017"},{"key":"Posts:","value":"69"}]},"thankedby":[]}]}