iration. Thank you.","signature":"<hr class=\"b-divider\"/><br/>Bye.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4443-gibberingeloquence","name":"GibberingEloquence","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4443_5.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"2470"}]},"thankedby":[]}]}