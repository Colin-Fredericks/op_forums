focus on idealism.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/935-cleverest-of-things","name":"Cleverest of Things","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar935_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"650"}]},"thankedby":[]}]}