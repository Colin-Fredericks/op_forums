l sporting Luna's marks.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1385-nickpire84","name":"Nickpire84","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1385_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"99"}]},"thankedby":[]},{"date":"2014-01-25T05:41:47-08:00","id":57370,"title":"","content":"Likes has ben said you are formally a Forsaken when you adhere to the Oaths of the Moon, but you are forsaken from the time of your First Change.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/970-gurkhal","name":"Gurkhal","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"863"}]},"thankedby":[]}]}