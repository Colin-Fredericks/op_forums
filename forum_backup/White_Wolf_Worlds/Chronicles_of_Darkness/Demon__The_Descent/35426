atars/0/0/6/0/4/5/avatar576_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2615"}]},"thankedby":[]},{"date":"2013-12-30T20:54:58-08:00","id":39759,"title":"","content":"Not official, of course, but it seems like maybe this is room to form a new merit; &quot;self-perpetuating cover&quot;, in which a cover makes the motions of life, but not enough to change anything. Just enough to perpetuate the current state of existence. Sort of like an ELIZAbot running your life. Probably wouldn't work on covers with certain merits. Just an idea, one probably full of holes.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1847-grumpbeard","name":"Grumpbeard","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"2"}]},"thankedby":[]}]}