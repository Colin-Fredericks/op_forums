nversion for Inferno, and more!)</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1130-falco1029","name":"falco1029","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1130_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1045"}]},"thankedby":[]}]}