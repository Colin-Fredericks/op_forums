5/avatar7212_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2015"},{"key":"Posts:","value":"5184"}]},"thankedby":[]},{"date":"2017-05-30T20:46:24-07:00","id":1098645,"title":"","content":"i want to play my 1st game of hunter to so lets try together","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/13426-ameraaaaaa","name":"Ameraaaaaa","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2017"},{"key":"Posts:","value":"320"}]},"thankedby":[]},{"date":"2017-05-31T10:00:54-07:00","id":1098808,"title":"","content":"<span style=\"font-family:Helvetica\"><span style=\"font-size:12px\">@Vent0</span></span><br /> <br /> <span style=\"font-family:Helvetica\"><span style=\"color:#000000\"><span style=\"font-size:12px\">So how do </span></span>Specialties work? And what do you mean by \u201coutliner physical skill?\u2019 </span><br /> <br /> <span style=\"font-family:Helvetica\">@Ameraaaaa</span><br /> <br /> <span style=\"font-family:Helvetica\">In order for use to play game, we need to somebody run it. And I don\u2019t think there's anyone who wants to run a \u201ccore\u201d version of Hunter on the Play-by-Post section. Last vigil game ended three years ago and the storyteller who is running it doesn't to be that active anymore.</span><br /> <br /> <span style=\"font-family:Helvetica\"> Have ever played any forum RPs? </span><br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/13491-gunbird","name":"Gunbird","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2017"},{"key":"Posts:","value":"4"}]},"thankedby":[]},{"date":"2017-05-31T10:30:07-07:00","id":1098815,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Gunbird</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/1098432-help-with-character-creation-and-a-place-to-play?p=1098808#post1098808\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><span style=\"font-family:Helvetica\"><span style=\"font-size:12px\">@Vent0</span></span><br /> <br /> <span style=\"font-family:Helvetica\"><span style=\"color:#000000\"><span style=\"font-size:12px\">So how do </span></span>Specialties work? And what do you mean by \u201coutliner physical skill?\u2019 </span><br /> <br /></div> </div> </div> </div>Specialties are modifiers to Skills. Like Firearms (Target Shooting) or (Handguns). Whenever you use the Firearms skill and the Specialty applies (in this case, when target shooting or using handguns), you get +1 die to your roll. They are cheaper than Skill dots and establish that the character isn't generally better, just focused in one area.<br /> <br /> As for outlier Skill, say Physical is Tertiary, but Firearms has 3 or 4 dots. The other skills suffer, and they aren't a physical person, but they can shoot.","signature":"<hr class=\"b-divider\"/><br/>Malkydel: &quot;And the Machine dictated; let there be adequate illumination.&quot;<br /> Yossarian: &quot;And lo, it was optimal.&quot;","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/7212-vent0","name":"Vent0","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7212_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2015"},{"key":"Post