.com/core/avatars/0/0/6/0/4/5/avatar2_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"2361"}]},"thankedby":[]},{"date":"2017-07-21T21:29:12-07:00","id":1119179,"title":"","content":"I wander if the new hunter will be good or not hopefully it's good but the new endowment system is bothering me so hopefully it all go's well","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/13426-ameraaaaaa","name":"Ameraaaaaa","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2017"},{"key":"Posts:","value":"320"}]},"thankedby":[]},{"date":"2017-07-21T23:29:22-07:00","id":1119194,"title":"","content":"The new endowment system reveal was an early draft. It will change before the release.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1526-diggs","name":"Diggs","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"986"}]},"thankedby":[]},{"date":"2017-07-22T02:43:32-07:00","id":1119212,"title":"","content":"Yes endowment ftw then thank you good sir","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/13426-ameraaaaaa","name":"Ameraaaaaa","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2017"},{"key":"Posts:","value":"320"}]},"thankedby":[]}]}