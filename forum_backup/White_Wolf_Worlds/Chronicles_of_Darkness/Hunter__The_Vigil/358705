0/0/6/0/4/5/avatar134_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"3003"}]},"thankedby":[]},{"date":"2015-03-26T05:51:11-07:00","id":457963,"title":"","content":"I'm glad you like it.<br /> <br /> Are there any other parts you think are especially good/bad/iffy? Part of me wants to write up Yellow Dysphoria and Green Disorder, though I'm not <i>sure</i> what to give them (they'd probably collectively have only 7 powers, too; the other Figment needed to unlock Green Disorder \u2022\u2022\u2022\u2022 doesn't exist yet, after all.)","signature":"<hr class=\"b-divider\"/><br/>I have decided, after some thought, that I don't really feel happy on these forums. I might decide to come back to post. Who knows - but right now, I'm gone.<br /> <br /> So good bye, good luck, and have a nice day.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1170-amechra","name":"amechra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1170_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2316"}]},"thankedby":[]},{"date":"2015-04-01T17:49:04-07:00","id":465397,"title":"","content":"I'm curious, should being Checked In also protect you from Breaking Points from being hit by supernatural powers?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3514-zealouschristian24","name":"ZealousChristian24","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2014"},{"key":"Posts:","value":"1796"}]},"thankedby":[]},{"date":"2015-04-02T00:54:28-07:00","id":465772,"title":"","content":"I rule that all Hunters are immune to that - they treat supernatural powers like bullet wounds, shocks to their self identity, or whatever they are but they don't give it explicit bonuses just because it's supernatural.","signature":"<hr class=\"b-divider\"/><br/>\u201cThere are no rules. Only Principles and natural laws.\u201d - Promethius<br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/17686-the-kings-raven-s-homebrwe-index\" target=\"_blank\">My Homebrew no longer fits in a signature, you can find an index of it here</a>.<br /> <b>Full length fan-books I contributed too: </b><a href=\"https://sites.google.com/site/princessthehopeful/files/PrincessTheHopeful.pdf?attredirects=0&amp;d=1\" target=\"_blank\">Princess: the Hopeful</a>, <a href=\"https://drive.google.com/drive/folders/0B9DMG5y7ZdngekVaMGNQbTF4RzA\" target=\"_blank\">Leviathan: the Tempest</a>, <a href=\"https://sites.google.com/site/thekingsraven/files/DreamCatchers.pdf?attredirects=0&amp;d=1\" target=\"_blank\">Dream Catchers</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/134-the-kings-raven","name":"The Kings Raven","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar134_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"3003"}]},"thankedby":[]},{"date":"2015-04-02T15:00:00-07:00","id":466553,"title":"","content":"So, the spoilers posted for Hurt Locker...<br /> <br /> Damn, the Dreamers would combine well with the Hotel. I might have to see if I can swing that mix.","signature":"<hr class=\"b-divider\"/><br/>I have decided, after some thought, that I don't really feel happy on these forums. I might decide to come back to post. Who knows - but right now, I'm gone.<br /> <br /> So good bye, good luck, and have a nice day.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1170-amechra","name":"amechra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1170_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2316"}]},"thankedby":[]},{"date":"2015-04-05T15:58:02-07:00","id":469646,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>amechra</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/hunter-the-vigil/358705-gmc-hotel-mascarone-some-tweaks?p=466553#post466553\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So, the spoilers posted for Hurt Locker...<br /> <br /> Damn, the Dreamers would combine well with the Hotel. I might have to see if I can swing that mix.</div> </div> </div> </div> I wasn't really able to understand the Dreamers and Cursed sections, so I'll have to take your word for it. <br /> <br /> Otherwise, I think you could remake the Hotel into a Minor Template pretty easy. Add a merit to serve as the &quot;core&quot;, probably with a benefit of its own to counteract the fact you need to have it equal to or higher than your highest Figment, and if you want them to be more generic, remove or replace Black Depression(though I admit I'm not sure with what).","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3514-zealouschristian24","name":"ZealousChristian24","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2014"},{"key":"Posts:","value":"1796"}]},"thankedby":[]}]}