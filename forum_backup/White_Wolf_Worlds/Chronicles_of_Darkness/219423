path.com/member/1958-krobeles","name":"Krobeles","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1958_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"499"}]},"thankedby":[]},{"date":"2014-08-05T18:31:34-07:00","id":219712,"title":"","content":"No clue, has this hit PoD yet? I've been away from the internets.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1064-miss_minty","name":"miss_minty","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"283"}]},"thankedby":[]},{"date":"2014-08-05T23:33:22-07:00","id":219923,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>miss_minty</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/demon-the-descent/219423-why-flowers-of-hell?p=219712#post219712\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">No clue, has this hit PoD yet? I've been away from the internets.</div> </div> </div> </div>Not yet; Mike Chaney is/was looking at the PoD proof this week.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/51-marin","name":"marin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2019"}]},"thankedby":[]},{"date":"2014-08-08T09:47:47-07:00","id":222236,"title":"","content":"<d