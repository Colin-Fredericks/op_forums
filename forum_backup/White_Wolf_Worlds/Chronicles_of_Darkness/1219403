.","signature":"<hr class=\"b-divider\"/><br/><b>A god is just a monster you kneel to. </b>- ArcaneArts, Quoting &quot;Fall of Gods&quot; <div align=\"center\"><a href=\"http://www.nodiatis.com/personality.htm\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://www.nodiatis.com/pub/6.jpg\" border=\"0\" alt=\"\" /></a> </div>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/7920-master-aquatosic","name":"Master Aquatosic","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7920_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2015"},{"key":"Posts:","value":"2369"}]},"thankedby":[]}]}