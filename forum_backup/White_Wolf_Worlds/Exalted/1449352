rs/0/0/6/0/4/5/avatar893_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"401"}]},"thankedby":[]},{"date":"2021-06-24T10:56:45-07:00","id":1453381,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>reaperfrost8</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453380#post1453380\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> I assume there going to put a sidebar in theirs section going yeah go for it if you want them to be playable just make sure to go over it with the group and make sure everyone's characters are alright with it as Heareater powers are required to be extremely antagonistic even compared to other exalt types.</div> </div> </div> </div>Yeah, Hearteaters touch on a lot of uncomfortable things, definetly something to talk of lines and veils if you want to include them.","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#b22222\"><b>.</b></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3742-iceblade44","name":"Iceblade44","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"707"}]},"thankedby":[]},{"date":"2021-06-24T11:39:29-07:00","id":1453383,"title":"","content":"Almost all the protagonist \u201cHearteaters\u201d I can think of in fiction have the same theme of guilt ridden and resisting the temptation of their powers to solve their problems. That\u2019s not a bad story of course, but it\u2019s a pretty restrictive one for the non-villains of an entire splat.<br /> <br /> The only major exception I can think of are the Confessors in the Sword of Truth series... but I think that has more to do with Terry Goodkind being weird and kinda creepy","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2021-06-24T11:51:57-07:00","id":1453388,"title":"","content":"Just play them as anti heroes.<br /> <br /> Yes, I am a monster. But we're fighting against an army of the dead who wants to kill you all.<br /> <br /> Yes, I may have possessed these guys, but she ate a bunch of people's hearts to shape-shift into them.<br /> <br /> Let me worry about how villainous the powers are. Just give me the mechanics.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/899114-the-official-exalted-forum-introduction-thread?p=899399#post899399\" target=\"_blank\">Hi, I'm JohnDoe244</a>. My posts represent my opinions, not facts.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/531-johndoe244","name":"JohnDoe244","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar531_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2958"}]},"thankedby":[]},{"date":"2021-06-24T21:24:37-07:00","id":1453432,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Iceblade44</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453381#post1453381\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Yeah, Hearteaters touch on a lot of uncomfortable things, definetly something to talk of lines and veils if you want to include them.</div> </div> </div> </div>Apparently like, one of the recent media examples of someone who is good Hearteater inspiraiton is Kilgrave from <b>Jessica Jones</b>. So yeah, you gotta go super careful on those guys as PCs IMHO.","signature":"<hr class=\"b-divider\"/><br/>And stuff.<br /> <sub><a href=\"https://blaqueandstuff.deviantart.com/\" target=\"_blank\">My DeviantArt Page</a> // <a href=\"http://blaqueandstuff.tumblr.com/\" target=\"_blank\">My tumblr</a> // <a href=\"http://www.dropbox.com/sh/trxegr5hl27s1l5/AAAegBBzxbDhvk1YpYJqdhz8a?dl=0\" target=\"_blank\">Exalted 3e Houserules</a></sub>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/353-blaque","name":"Blaque","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar353_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2976"}]},"thankedby":[]},{"date":"2021-06-26T15:04:52-07:00","id":1453602,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JohnDoe244</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453388#post1453388\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Yes, I am a monster. But we're fighting against an army of the dead who wants to kill you all.</div> </div> </div> </div> You can even play the guy at the head of that genocidal undead army!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/97-the-mg","name":"The MG","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar97_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2460"}]},"thankedby":[]},{"date":"2021-06-26T15:23:46-07:00","id":1453604,"title":"","content":"Well, a lot of the Hearteater territory seems to cover some of the core villanous identity of manipulative masterminds. When Killer B.O.B, Kilgrave, All for One feel like the most natural forms of Hearteaters, it is easy to understand why they are not &quot;hero material&quot;- but on the other hand, Abyssals, Infernals and even Lunars could all be very monstrous, so covering the archetype does not immediately makes them into &quot;irredeemable villains&quot;. A lot about how heroic the Hearteater can actually be depends on how much control do they have over creating Pawns- if anyone they have some Intimacy towards, for example, is doomed to become a Pawn, it will be very hard to play a heroic Hearteater. If they have more control, however, playing a Hearteater which takes over those people they deem as worse than them could allow them to be quit heroic, IMO. And even if the former is correct, it is possible to play &quot;villains with redeeming qualities&quot; as those who embrace their monstrosity and try to treat carefully when around those people they deem as &quot;worthy to live&quot;, or even just see them as sacrifices which must be made for the greater good.<br /> <br /> Sure, it does require some very thorough session zero discussion to make sure everyone are feeling comfortable with an Hearteater, and perhaps some ho0userules to make Circlemates immune into becoming Pawns ion case that other Exalts can be &quot;hearteaten&quot;, but it is not that all &quot;heroic Hearteaters&quot; must be the same.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.storytellersvault.com/browse.php?author=Shachar%20Gold\" target=\"_blank\">Check my STV content</a>, <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/28219-my-weekly-wod-project-program\" target=\"_blank\">Or My Homebrew</a><br /> <br /> &quot;And all our knowledge is, Ourselves to know&quot;- An Essay on Man<br /> <br /> I now blog in <a href=\"https://chroniclesoflostlight.wordpress.com/\" target=\"_blank\">here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/503-lostlight","name":"LostLight","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar503_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"4531"}]},"thankedby":[]},{"date":"2021-06-26T15:28:58-07:00","id":1453606,"title":"","content":"For me at least, I'm kinda hoping Hearteaters can fill the &quot;Alex Mercer from Prototype as an Exalted&quot; niche that they explicitly removed from the Lunars. (If not, I can go always go with an Exigent of Han-Tha, but its nice to have an official, if non-canonical, write-up for things.)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/526-schizopop","name":"schizoPOP","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"108"}]},"thankedby":[]},{"date":"2021-06-26T16:11:32-07:00","id":1453607,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>schizoPOP</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453606#post1453606\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">For me at least, I'm kinda hoping Hearteaters can fill the &quot;Alex Mercer from Prototype as an Exalted&quot; niche that they explicitly removed from the Lunars. (If not, I can go always go with an Exigent of Han-Tha, but its nice to have an official, if non-canonical, write-up for things.)</div> </div> </div> </div>The Hearteater aesthetic we know of so far is like, crystals, opals, light, auroras, emotions, and so on. I think honestly that it might indeed be better to try the Exigent, since I think there's at least (to me) a pretty big aesthetic disconnect of Hearteasters and <b>Prototype</b>. The latter is a lot more...meaty.","signature":"<hr class=\"b-divider\"/><br/>And stuff.<br /> <sub><a href=\"https://blaqueandstuff.deviantart.com/\" target=\"_blank\">My DeviantArt Page</a> // <a href=\"http://blaqueandstuff.tumblr.com/\" target=\"_blank\">My tumblr</a> // <a href=\"http://www.dropbox.com/sh/trxegr5hl27s1l5/AAAegBBzxbDhvk1YpYJqdhz8a?dl=0\" target=\"_blank\">Exalted 3e Houserules</a></sub>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/353-blaque","name":"Blaque","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar353_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2976"}]},"thankedby":[]},{"date":"2021-06-26T16:16:26-07:00","id":1453608,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Blaque</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453607#post1453607\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> The Hearteater aesthetic we know of so far is like, crystals, opals, light, auroras, emotions, and so on. I think honestly that it might indeed be better to try the Exigent, since I think there's at least (to me) a pretty big aesthetic disconnect of Hearteasters and <b>Prototype</b>. The latter is a lot more...meaty.</div> </div> </div> </div>They do seem to have a bit of Bones motif. (Corrupted using bones, imprisoned using bones, spread via bones)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/526-schizopop","name":"schizoPOP","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"108"}]},"thankedby":[]},{"date":"2021-06-26T16:23:52-07:00","id":1453609,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>schizoPOP</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453608#post1453608\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> They do seem to have a bit of Bones motif. (Corrupted using bones, imprisoned using bones, spread via bones)</div> </div> </div> </div>I've thought that the only bone motif was them having crystal bones through which the Exaltation could pass. Is there any more info I missed?","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.storytellersvault.com/browse.php?author=Shachar%20Gold\" target=\"_blank\">Check my STV content</a>, <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/28219-my-weekly-wod-project-program\" target=\"_blank\">Or My Homebrew</a><br /> <br /> &quot;And all our knowledge is, Ourselves to know&quot;- An Essay on Man<br /> <br /> I now blog in <a href=\"https://chroniclesoflostlight.wordpress.com/\" target=\"_blank\">here</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/503-lostlight","name":"LostLight","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar503_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"4531"}]},"thankedby":[]},{"date":"2021-06-26T17:03:14-07:00","id":1453611,"title":"","content":"So, what are the chances that we get Exigents next? I hope we do. Or have they already announced something else as their kickstarter for july?","signature":"<hr class=\"b-divider\"/><br/>Exalted Whose Name is Carved in Leaves of Jade<br /> Senator of the Greater Chamber<br /> Champion of the Silver Pact<br /> Chosen of the Little Gods<br /> Agent of Fate","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/988-mizu","name":"Mizu","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar988_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1520"}]},"thankedby":[]},{"date":"2021-06-26T17:31:02-07:00","id":1453612,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mizu</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453611#post1453611\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So, what are the chances that we get Exigents next? I hope we do. Or have they already announced something else as their kickstarter for july?</div> </div> </div> </div>They generally avoid Kickstarters for the same game lines one after the other because the same fan base is less likely to be able to immediately spend again.","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":1098,"user_link":"https://forum.theonyxpath.com/member/1098-glamourweaver","user":"glamourweaver","date":". 06-26-2021, 08:41 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2021-06-26T17:39:01-07:00","id":1453613,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>glamourweaver</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453612#post1453612\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> They generally avoid Kickstarter\u2019s for the same game lines one after the other because the same fan base is less likely to be able to immediately spend again.</div> </div> </div> </div><br /> That is a sound business decision I have no reasonable argument against, unfortunately. Oh well, maybe 8 directions will drop in a month or two or something to scratch that exalted itch some more.","signature":"<hr class=\"b-divider\"/><br/>Exalted Whose Name is Carved in Leaves of Jade<br /> Senator of the Greater Chamber<br /> Champion of the Silver Pact<br /> Chosen of the Little Gods<br /> Agent of Fate","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/988-mizu","name":"Mizu","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar988_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1520"}]},"thankedby":[]},{"date":"2021-06-26T19:36:43-07:00","id":1453619,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mizu</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453611#post1453611\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So, what are the chances that we get Exigents next? I hope we do. Or have they already announced something else as their kickstarter for july?</div> </div> </div> </div>We know for a fact the next KS is <b>Squeaks of the Deep</b> for Pugmire. I think that there's also slated to be <b>Trinity Continuum: Anima</b> after that. Which would take up July through like, August/September. And this is assuming either launches like, next week.<br /> <br /> That said, I believe Exigents is appraoching ready to be Kickstarted and they said in a recent stream that they do want to do Sidereals next year. So I woudln't be surprised of Exigents were the last KS of this year or one of the first next year from OPP.<br /> <br /> If you're interested, this is the current upcomign products form the game thougH:<ul><li><b>Pre-Drafting Stages: </b>Essence Stretchgoal stuff.</li> <li><b>First Draft: </b>Exalted Essay Collection</li> <li><b>Redlines: </b>Dragon-Blooded Novella #2</li> <li><b>Development: </b>Adversaries of the Righteous</li> <li><b>Post-Approval Development: </b>Exigents: Out of the Ashes, Many-Faced Strangers</li> <li><b>Editing: </b>Exalted Essence, Crucible of Legends, Across the Eight Directions, Lunar Novella #1</li> <li><b>Art Direction: </b>Exalted Essence Edition, Hundred Devils Night Parade</li> <li><b>Backer Preview: </b>Heirs to the Shogunate</li> </ul><br /> The tenative release schedule for Exalt Kickstarters, as a note is:<ul><li>Exigents (Next)</li> <li>Sidereals</li> <li>Abyssals</li> <li>Infernals</li> <li>Alchemicals</li> </ul><br /> With Getimians and Liminals getting their own, non-Kickstarter books along with Sidereals and Abyssals respectively.","signature":"<hr class=\"b-divider\"/><br/>And stuff.<br /> <sub><a href=\"https://blaqueandstuff.deviantart.com/\" target=\"_blank\">My DeviantArt Page</a> // <a href=\"http://blaqueandstuff.tumblr.com/\" target=\"_blank\">My tumblr</a> // <a href=\"http://www.dropbox.com/sh/trxegr5hl27s1l5/AAAegBBzxbDhvk1YpYJqdhz8a?dl=0\" target=\"_blank\">Exalted 3e Houserules</a></sub>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/353-blaque","name":"Blaque","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar353_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2976"}]},"thankedby":[]},{"date":"2021-06-26T23:56:01-07:00","id":1453627,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Blaque</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453619#post1453619\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> We know for a fact the next KS is <b>Squeaks of the Deep</b> for Pugmire. I think that there's also slated to be <b>Trinity Continuum: Anima</b> after that. Which would take up July through like, August/September. And this is assuming either launches like, next week.<br /> <br /> That said, I believe Exigents is appraoching ready to be Kickstarted and they said in a recent stream that they do want to do Sidereals next year. So I woudln't be surprised of Exigents were the last KS of this year or one of the first next year from OPP.</div> </div> </div> </div>James is going on holiday next week, so... I'd expect them holding off on a new KS until he gets back.<br /> <br /> Eyeballing the Editing list in the Monday Meeting notes, the only other potential KSes I can see are They Came From [Classified]! and Once and Future, and I'm a bit dubious about [Classified] what with it already having a jumpstart. So... fair chance at Exigents this year, I think.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/51-marin","name":"marin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2019"}]},"thankedby":[]},{"date":"2021-06-27T00:20:17-07:00","id":1453628,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Blaque</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453619#post1453619\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> We know for a fact the next KS is <b>Squeaks of the Deep</b> for Pugmire. I think that there's also slated to be <b>Trinity Continuum: Anima</b> after that. Which would take up July through like, August/September. And this is assuming either launches like, next week.<br /> <br /> That said, I believe Exigents is appraoching ready to be Kickstarted and they said in a recent stream that they do want to do Sidereals next year. So I woudln't be surprised of Exigents were the last KS of this year or one of the first next year from OPP.<br /> <br /> If you're interested, this is the current upcomign products form the game thougH:<ul><li><b>Pre-Drafting Stages: </b>Essence Stretchgoal stuff.</li> <li><b>First Draft: </b>Exalted Essay Collection</li> <li><b>Redlines: </b>Dragon-Blooded Novella #2</li> <li><b>Development: </b>Adversaries of the Righteous</li> <li><b>Post-Approval Development: </b>Exigents: Out of the Ashes, Many-Faced Strangers</li> <li><b>Editing: </b>Exalted Essence, Crucible of Legends, Across the Eight Directions, Lunar Novella #1</li> <li><b>Art Direction: </b>Exalted Essence Edition, Hundred Devils Night Parade</li> <li><b>Backer Preview: </b>Heirs to the Shogunate</li> </ul><br /> <br /> The tenative release schedule for Exalt Kickstarters, as a note is:<ul><li>Exigents (Next)<br /> <b><u></li> <li>Sidereals</li> <li>Abyssals</u></b></li> <li>Infernals</li> <li>Alchemicals</li> </ul><br /> <br /> With Getimians and Liminals getting their own, non-Kickstarter books along with Sidereals and Abyssals respectively.</div> </div> </div> </div><br /> I fling my sour grapes at the people who are more interested in sidereal martial arts then necromancy, lol. In retrospect necromancy should have just been in the corebook since its at least available up to the first circle for pretty much everyone and solars can get up to second. Maybe cheap out on word space by not putting in any 3rd circle spells just like they didn't put in any sidereal martial arts to still leave some stuff to put in the abyssal book for abyssal necromancers to look forward to. Of course that thing is already a behemoth whose physical collectors edition I could use as a deadly weapon so not much room to squeeze in even two circles of spells.<br />","signature":"<hr class=\"b-divider\"/><br/>Exalted Whose Name is Carved in Leaves of Jade<br /> Senator of the Greater Chamber<br /> Champion of the Silver Pact<br /> Chosen of the Little Gods<br /> Agent of Fate","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/988-mizu","name":"Mizu","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar988_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1520"}]},"thankedby":[]},{"date":"2021-06-27T00:28:12-07:00","id":1453630,"title":"","content":"Somebody else noticed the advantage of crafting ventures in the manuscript? There is one that talks about 'increasing the traits' of the object, and I'm thinking... does that means that you can create some pseudo-artifact weapons with a high enough roll?<br /> <br /> After all, the Artifact Tag gives +2 Overwhelming, and either +1 to Damage or Accuracy. But if I'm reading the advantage, right, you can increase a weapon Overwhelming by 2, which means that you just miss the +1 Damage/Accuracy to have the Artifact tag.<br /> <br /> And then the Artifact advantage gives +3... does that means you can have some truly outrageous weapons, like +6 Accuracy light weapons or +6 Damage heavy weapons?<br /> <br /> Seems a little extreme, but I cannot think about what other 'traits' the advantage could me talk about...<br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/25288-shapechanger","name":"Shapechanger","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25288_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2019"},{"key":"Posts:","value":"51"}]},"thankedby":[]},{"date":"2021-06-27T02:12:34-07:00","id":1453633,"title":"","content":"According to Chapter 8, items have &quot;statistics&quot; and &quot;tags&quot;.<br /> Clearly, referring to &quot;traits&quot; is a versioning error.<br /> <br /> I expect it will be quietly deleted.<br /> <br /> ****<br /> <br /> <br /> That said, Accuracy and Damage are still hit by the 5 success cap (and overwhelming is capped at 4).<br /> <br /> But you could make a weapon... <br /> Long Range<br /> +4 Accuracy<br /> +2/4 Damage<br /> 4 Overwhelming.<br /> <br /> Start with the Light Ranged Weapon profile (Long Range, +3 Accuracy, +0 Damage, 1 Overwhelming).<br /> Craft it (+1 Accuracy, +1 Damage)<br /> Balanced tag (+1 Overwhelming)<br /> Powerful tag (+2 Damage, NB: close range only)<br /> Artifact (+1 Damage, +2 Overwhelming)<br /> <br /> A 4/4/4 weapon is pretty much nightmare fuel already. Let's make it worse.<br /> <br /> Throw on a Soulsteel Caste at Iconic with a 5 in Force and Ranged Combat and...<br /> <br /> At Close Range:<br /> You roll 10 dice with 10 automatic (cap breaking) successes to hit.<br /> You gain a minimum of 4 Initiative on Withering attacks, even if you miss.<br /> You get +9 levels of Decisive Damage on your attacks. Levels. Not dice. (And this is cap breaking.)<br /> <br /> (At Short and Medium Range you drop to just +7 Damage Levels, and at Long Range you are down to only +9 Successes To Hit.)<br /> <br /> You automatically hit 3CDs, and hit Deathlords with at least +5 Threshold successes (PLUS rolled successes).<br /> <br /> This costs 0 motes. <br /> <br /> You can 1m Excellency for another 5 dice on your attack roll, I guess. You could also add another +1 Damage from Charms if you have it... maybe something that adds the Flame tag to your attacks?<br /> <br /> On your starting character.<br /> <br /> But, sure, this has been extensively playtested and isn't broken.<br /> <br /> ****<br /> <br /> [Edit for tone]<br /> <br /> I like Essence. I do. It's clearly a labor of love, and at it's core, there's a good game here.<br /> <br /> But the PR around this game has been shockingly bad. Writers with great emotional investment in their work have reacted personally to criticism of everything from marketing (which they have nothing to do with) to mechanics (which is their personal work).<br /> <br /> I have great sympathy.<br /> <br /> And Scion 2E had a lot of cleanup between KS Manuscript and release. We've got a proven team of dedicated professionals here.<br /> <br /> I don't want people to take my criticism, or my snark, as an attack.<br /> <br /> But as examples like the above show, there are GAPING holes in this Beta that need to be fixed. This might be a 95% finished game, but that last 5% <b>needs</b> fixing. <br /> <br /> That's not snark. There's 15(?) types of venture, with 5 different characteristics, so of the 75 elements for ventures, there's a game-warping problem with 2 of them. That means the Venture System is 97% done. I think 97% of the Venture System is perfect. Great work! Getting 97% of the way there from your closed Beta is insanely good. Help us help you to get that last 3%.<br /> <br /> And this is an easy fix: delete the line about adding traits from the venture section. Done.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/899114-the-official-exalted-forum-introduction-thread?p=899399#post899399\" target=\"_blank\">Hi, I'm JohnDoe244</a>. My posts represent my opinions, not facts.","edited":{"userid":531,"user_link":"https://forum.theonyxpath.com/member/531-johndoe244","user":"JohnDoe244","date":". 06-27-2021, 06:09 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/531-johndoe244","name":"JohnDoe244","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar531_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2958"}]},"thankedby":[]},{"date":"2021-06-27T04:02:02-07:00","id":1453636,"title":"","content":"I think deleting is excessive, but the options need to either be more costly or less numerous. Or both.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/25288-shapechanger","name":"Shapechanger","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25288_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2019"},{"key":"Posts:","value":"51"}]},"thankedby":[]},{"date":"2021-06-27T05:46:49-07:00","id":1453642,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mizu</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453628#post1453628\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> I fling my sour grapes at the people who are more interested in sidereal martial arts then necromancy, lol. In retrospect necromancy should have just been in the corebook since its at least available up to the first circle for pretty much everyone and solars can get up to second. Maybe cheap out on word space by not putting in any 3rd circle spells just like they didn't put in any sidereal martial arts to still leave some stuff to put in the abyssal book for abyssal necromancers to look forward to. Of course that thing is already a behemoth whose physical collectors edition I could use as a deadly weapon so not much room to squeeze in even two circles of spells.</div> </div> </div> </div>Personally, I'm more excited about SMA than Necromancy because I feel like sorcery does a very good job of being necromancy - I can already have a character who stalks through soporific mist hunting their foes with a whip made of blood, who draws power by sacrificing to their own ghost and sends people nightmares to bedevil their sleep. The only things I really need for a necromancer are calling ghosts and raising zombies.<br /> More spooky initiations and spells would be nice, but treating Necromancy as the Underworld-Themed parts of Sorcery works quite well (and fixes the problem where Necromancy is all Underworld-Themed but Sorcery contains themes of Creation, Malfeas, Yu-Shan and also the Wyld, so Sorcery is much more versatile than Necromancy)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/23597-autxauty","name":"autXautY","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2017"},{"key":"Posts:","value":"286"}]},"thankedby":[]},{"date":"2021-06-27T07:26:21-07:00","id":1453647,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>autXautY</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453642#post1453642\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I can already have a character who stalks through soporific mist hunting their foes with a whip made of blood, who draws power by sacrificing to their own ghost and sends people nightmares to bedevil their sleep. The only things I really need for a necromancer are calling ghosts and raising zombies.</div> </div> </div> </div> This.<br /> Necromancy is a completely vestigial game and setting element, and 3e should have merged it and sorcery together.<br /> <br /> In the meantime, there's a ghost-summoning spell in one of the Adversaries entries, and either a spell or Charm (which can be retooled into a spell) for raising zombie battle groups.<br /> <br /> Take those, retool the Mara fuckmurder ritual into more traditional human sacrifice, and boom: necromancer.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/97-the-mg","name":"The MG","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar97_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2460"}]},"thankedby":[]},{"date":"2021-06-27T07:28:08-07:00","id":1453648,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>autXautY</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453642#post1453642\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Personally, I'm more excited about SMA than Necromancy because I feel like sorcery does a very good job of being necromancy - I can already have a character who stalks through soporific mist hunting their foes with a whip made of blood, who draws power by sacrificing to their own ghost and sends people nightmares to bedevil their sleep. The only things I really need for a necromancer are calling ghosts and raising zombies.<br /> More spooky initiations and spells would be nice, but treating Necromancy as the Underworld-Themed parts of Sorcery works quite well (and fixes the problem where Necromancy is all Underworld-Themed but Sorcery contains themes of Creation, Malfeas, Yu-Shan and also the Wyld, so Sorcery is much more versatile than Necromancy)</div> </div> </div> </div><br /> I mean, by that logic whats the point of SMA when we already have weird stuff like dreaming pearl courtesan in regular supernatural martial arts? If something has to be as broadly useful and applicable as sorcery to be valid then nothing but sorcery is valid &lt;_&lt;<br /> <br /> Edit: Heck, sorcery can make you better at punching people in weird ways like giving you a body of bronze so why have martial arts? Just roll it into sorcery &gt;_&gt;","signature":"<hr class=\"b-divider\"/><br/>Exalted Whose Name is Carved in Leaves of Jade<br /> Senator of the Greater Chamber<br /> Champion of the Silver Pact<br /> Chosen of the Little Gods<br /> Agent of Fate","edited":{"userid":988,"user_link":"https://forum.theonyxpath.com/member/988-mizu","user":"Mizu","date":". 06-27-2021, 10:34 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/988-mizu","name":"Mizu","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar988_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1520"}]},"thankedby":[]},{"date":"2021-06-27T13:08:35-07:00","id":1453664,"title":"","content":"Oh and one thing: I assume this is just because it's a preview of the real thing, but I do kinda miss each charm having a cool as hell 1-2 sentence summation of its themes at the beginning of its text. Stuff like God-King's Shrike's &quot;Sage-emperors returned from their long slumber, the Solars\u2019 great beards have shattered their stone tables. In their great and terrible throes, they may call upon the forces of doom in order to save their world&quot; for instance is <i>so damn cool</i> to me. I really hope that's not gone.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mizu</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453648#post1453648\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> I mean, by that logic whats the point of SMA when we already have weird stuff like dreaming pearl courtesan in regular supernatural martial arts? If something has to be as broadly useful and applicable as sorcery to be valid then nothing but sorcery is valid &lt;_&lt;<br /> <br /> Edit: Heck, sorcery can make you better at punching people in weird ways like giving you a body of bronze so why have martial arts? Just roll it into sorcery &gt;_&gt;</div> </div> </div> </div>Well the point of SMA is that it is barely martial arts at that point and is more wild fate-manipulation shit. Also DPCS is explicitly mentioned as being <i>dangerously</i> close to SMA to the point that its capstone charm can insta-kill the character using it (actually, does that effect apply to Sidereal users of it? I'm going to guess that it cannot).<br />","signature":"","edited":{"userid":4801,"user_link":"https://forum.theonyxpath.com/member/4801-frostav","user":"Frostav","date":". 06-27-2021, 04:10 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4801-frostav","name":"Frostav","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2015"},{"key":"Posts:","value":"220"}]},"thankedby":[]},{"date":"2021-06-27T14:50:39-07:00","id":1453668,"title":"","content":"I agree, I was pointing out how silly their logic for why necromancy might as well not even be a thing is. Especially since necromancy isn't even actually released yet so that we can even compare it to sorcery and make a judgement on how it compares. I don't actually think we should scrap SMA to just have regular martial arts with some of them being weird trippy stuff or that martial arts should just be rolled into being sorcery that helps you punch things.","signature":"<hr class=\"b-divider\"/><br/>Exalted Whose Name is Carved in Leaves of Jade<br /> Senator of the Greater Chamber<br /> Champion of the Silver Pact<br /> Chosen of the Little Gods<br /> Agent of Fate","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/988-mizu","name":"Mizu","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar988_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1520"}]},"thankedby":[]},{"date":"2021-06-27T15:26:55-07:00","id":1453670,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JohnDoe244</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453633#post1453633\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I like Essence. I do. It's clearly a labor of love, and at it's core, there's a good game here.<br /> <br /> But the PR around this game has been shockingly bad. Writers with great emotional investment in their work have reacted personally to criticism of everything from marketing (which they have nothing to do with) to mechanics (which is their personal work).<br /> <br /> I have great sympathy.<br /> <br /> And Scion 2E had a lot of cleanup between KS Manuscript and release. We've got a proven team of dedicated professionals here.<br /> <br /> I don't want people to take my criticism, or my snark, as an attack.<br /> <br /> But as examples like the above show, there are GAPING holes in this Beta that need to be fixed. This might be a 95% finished game, but that last 5% <b>needs</b> fixing.</div> </div> </div> </div>This is basically my opinion. In some ways, it reminds me of the original Ex3 game. There's interesting new ideas, some are great, some need more work (and some are good but too complex). There's sacred cows that have been slain from previous editions, but there's a few that are still stuck around and are awkward. There are new ideas and mechanics brought in to solve problems from previous editions, which do that, but have their own issues. And it needs a good hard edit.<br /> <br /> Unlike the 3rd ed Core, I think it might actually get a good edit. And they did say that they would consider altering stuff if people found ways to break the game.<br /> The other stuff, not sure.<br /> I can't really judge it until the final version though. I would like to be able to judge it now, but some of the stuff (withering attacks, milestones) is beset with versioning issues that makes it too awkward to judge.*<br /> <br /> *I could run it, I think, as the writers did explain sort of how it's supposed to be on Discord, but it wasn't 100% clear and that's no good for people who don't read the Exalted Discord.<br /> <br /> Tbh, I was very excited by Essence, but it just isn't what I wanted. I would have cancelled my pledge but didn't get round to in time.<br /> If I run Exalted again (and I'm not sure I will, but I might run an Essence 1 DB game some time or maybe a short game to let people play their old, beloved characters again), I'll probably stick with the Core rules. They're a bit more complex, but they've had more errata, and we know them, which makes them simpler for our game than learning Essence.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":2402,"user_link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","user":"The Wizard of Oz","date":". 06-28-2021, 08:30 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2021-06-28T01:05:35-07:00","id":1453686,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mizu</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453628#post1453628\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> I fling my sour grapes at the people who are more interested in sidereal martial arts then necromancy, lol. In retrospect necromancy should have just been in the corebook since its at least available up to the first circle for pretty much everyone and solars can get up to second. Maybe cheap out on word space by not putting in any 3rd circle spells just like they didn't put in any sidereal martial arts to still leave some stuff to put in the abyssal book for abyssal necromancers to look forward to. Of course that thing is already a behemoth whose physical collectors edition I could use as a deadly weapon so not much room to squeeze in even two circles of spells.</div> </div> </div> </div>Actually, if I am reading EE right we have one Necromancy tradition/initiation in E3 already. It 'retcons' the Wanasaan Exorcist tradition from WFHW as necromancy.<br /> So it seems like there is a great deal of equivilancy between the two, so I imagine Workings will get more guidelines when Abyssals drops, (even if it is just in the form of &quot;Here is a list of things Necromancy can do that Sorcery shouldn't&quot;).","signature":"<hr class=\"b-divider\"/><br/>Thoughts ripple out, birthing others","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1624-falleneco","name":"FallenEco","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1624_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"1927"}]},"thankedby":[]},{"date":"2021-06-28T04:38:11-07:00","id":1453692,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JohnDoe244</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453633#post1453633\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Throw on a Soulsteel Caste at Iconic with a 5 in Force and Ranged Combat and...<br /></div> </div> </div> </div>I just noticed that one of my players is a Soulsteel and read his Iconic anima bonus. This seems a little bit over the top. 4-5 Automatic successes, who don't break the cap, on every Attack and Damage roll, I just don't get it.","signature":"<hr class=\"b-divider\"/><br/>My homebrew (Leave comments if you want to help improve) : <a href=\"https://docs.google.com/spreadsheets/d/1hPx-Q2jlDgAIZX_d0wQWmJkZMN51jas4QNp5meeQjgo/edit?usp=sharing\" target=\"_blank\">A quick recap of all the pools and stats for Quick Exalted 3E characters</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24291-chausse","name":"Chausse","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24291_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2018"},{"key":"Posts:","value":"1139"}]},"thankedby":[]},{"date":"2021-06-28T13:28:39-07:00","id":1453714,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Chausse</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453692#post1453692\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I just noticed that one of my players is a Soulsteel and read his Iconic anima bonus. This seems a little bit over the top. 4-5 Automatic successes, who don't break the cap, on every Attack and Damage roll, I just don't get it.</div> </div> </div> </div>Based on my reading of the manuscript and listening to interviews and such of the devs, actually hitting that 10th Anima to trigger your iconic is pretty tricky to do in a useful time frame so the iconic powers are intentionally kinda gonzo.","signature":"<hr class=\"b-divider\"/><br/><div align=\"center\"><b><i>Exalted Behind a Screen of Jade, Savant of the Immaculate Texts, No Moon Scholar</i>, Good Sitting Dog, Best Lurking Cat with Bones, Pioneer Pooch, Corsair, <i>Director, Keeper of the Karstein Manor</i>, Scion with Shield of Knowledge, Erymanthian Boar,<i> Seeking Awakened, Cloaked Changeling, Family Head, Kindred, Agent, Poltergeist</i>, Disciple of the Antler Crown, Wraith, Conspiracy Theorist, <i>First Time Traveler</i></b></div>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/882-samuraimujuru","name":"SamuraiMujuru","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar882_3.jpg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1129"}]},"thankedby":[]},{"date":"2021-06-28T14:28:01-07:00","id":1453719,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>SamuraiMujuru</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453714#post1453714\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Based on my reading of the manuscript and listening to interviews and such of the devs, actually hitting that 10th Anima to trigger your iconic is pretty tricky to do in a useful time frame so the iconic powers are intentionally kinda gonzo.</div> </div> </div> </div>Interesting it's true than in 3e it's excessively easy and the dynamic might not be the same in Essence","signature":"<hr class=\"b-divider\"/><br/>My homebrew (Leave comments if you want to help improve) : <a href=\"https://docs.google.com/spreadsheets/d/1hPx-Q2jlDgAIZX_d0wQWmJkZMN51jas4QNp5meeQjgo/edit?usp=sharing\" target=\"_blank\">A quick recap of all the pools and stats for Quick Exalted 3E characters</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24291-chausse","name":"Chausse","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24291_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2018"},{"key":"Posts:","value":"1139"}]},"thankedby":[]},{"date":"2021-06-28T22:51:32-07:00","id":1453741,"title":"","content":"So, apart from Solars who get a bunch of bonus anima Charms, you gotta spend 10m. You have 5m.<br /> <br /> You're not hitting Iconic until round 5.<br /> <br /> It doesn't seem super likely that most fights will get to round 5. Especially with stuff like the Dawn anima in play, just reflexively deleting enemies.<br /> <br /> It's just that the Soulsteel power is a boss deleter. You can have some epic fight with the Mask of Winters, on the back of Juggernaut, with zombie maggots ripping their way out of the behemoth's flesh... for 5 rounds. Then killbot comes online, and it's honestly not even worth rolling at that point.<br /> <br /> The sample Deathlord as 6 Defence. You hit even of all 10 dice fail. It has 10 health levels. You kill even if all 10 dice fail. It's literally not worth rolling. (You do need Guard Breaking Technique <i>or</i> two attacks from teammates to bring the Hardness down. But even a non-crafted artifact weapon is giving you 8 successes To Hit then 9 successes on Damage.)<br /> <br /> Crafted Artifact Light Crossbow up there is still doing the following, without the Soulsteel Anima power<br /> <br /> 10 dice and 5 successes To Hit.<br /> Minimum Power Gain of 4 (even if you miss).<br /> +4 levels of Damage on Decisives.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/899114-the-official-exalted-forum-introduction-thread?p=899399#post899399\" target=\"_blank\">Hi, I'm JohnDoe244</a>. My posts represent my opinions, not facts.","edited":{"userid":531,"user_link":"https://forum.theonyxpath.com/member/531-johndoe244","user":"JohnDoe244","date":". 06-29-2021, 02:02 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/531-johndoe244","name":"JohnDoe244","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar531_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2958"}]},"thankedby":[]},{"date":"2021-06-29T05:32:16-07:00","id":1453749,"title":"","content":"Yeah some of the scaling definitively seems a bit awkward.<br /> <br /> I also just noticed this : <span style=\"color:#000000\"> <span style=\"font-family:TimesNewRomanPS\">Accuracy: </span><span style=\"font-family:TimesNewRomanPSMT\">A weapon\u2019s accuracy adds successes to the attack roll.<br /> <br /> So Light Melee weapons add +2 successes on every attack roll ? And Light Range medium weapons +3 ? </span><br /> <br /> <br /> </span><br />","signature":"<hr class=\"b-divider\"/><br/>My homebrew (Leave comments if you want to help improve) : <a href=\"https://docs.google.com/spreadsheets/d/1hPx-Q2jlDgAIZX_d0wQWmJkZMN51jas4QNp5meeQjgo/edit?usp=sharing\" target=\"_blank\">A quick recap of all the pools and stats for Quick Exalted 3E characters</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24291-chausse","name":"Chausse","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24291_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2018"},{"key":"Posts:","value":"1139"}]},"thankedby":[]},{"date":"2021-06-29T07:20:14-07:00","id":1453752,"title":"","content":"To be fair, +2 successes is equivalent to the +4 dice light weapons give you in Ex3.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2021-06-29T07:20:44-07:00","id":1453753,"title":"","content":"But presumably isn't cap breaking.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2021-06-29T07:56:04-07:00","id":1453754,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JohnDoe244</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453741#post1453741\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So, apart from Solars who get a bunch of bonus anima Charms, you gotta spend 10m. You have 5m.<br /> <br /> You're not hitting Iconic until round 5.<br /> <br /> It doesn't seem super likely that most fights will get to round 5. Especially with stuff like the Dawn anima in play, just reflexively deleting enemies.</div> </div> </div> </div>Committed charms do let you break this - committing a mote gets you 1 anima, and when you drop commitment you get the mote back. Depending on how steps interact with scene-long charms it may be feasible to get to anima 10 on turn 2 or 3 - commit 5m worth of charms round 1, immediately uncommit them, then either spend 5m on turn 2 or flicker your committed charms again turn 3.<br /> Sidereals can also get Anima by spending stunt dice on charms.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/23597-autxauty","name":"autXautY","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2017"},{"key":"Posts:","value":"286"}]},"thankedby":[]},{"date":"2021-06-29T11:48:19-07:00","id":1453774,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>autXautY</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453754#post1453754\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Committed charms do let you break this - committing a mote gets you 1 anima, and when you drop commitment you get the mote back. Depending on how steps interact with scene-long charms it may be feasible to get to anima 10 on turn 2 or 3 - commit 5m worth of charms round 1, immediately uncommit them, then either spend 5m on turn 2 or flicker your committed charms again turn 3.<br /> Sidereals can also get Anima by spending stunt dice on charms.</div> </div> </div> </div>...<br /> <br /> I did not even consider that.<br /> <br /> It's only 1 Charm per Step though. Which is something.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/899114-the-official-exalted-forum-introduction-thread?p=899399#post899399\" target=\"_blank\">Hi, I'm JohnDoe244</a>. My posts represent my opinions, not facts.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/531-johndoe244","name":"JohnDoe244","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar531_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2958"}]},"thankedby":[]},{"date":"2021-06-29T14:27:52-07:00","id":1453789,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JohnDoe244</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453774#post1453774\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> ...<br /> <br /> I did not even consider that.<br /> <br /> It's only 1 Charm per Step though. Which is something.</div> </div> </div> </div>The most generous arguments are a) that that only applies to charms which make sense in steps, ie ones that create or modify an action or b) there's no rule saying you can't activate charms on steps of other people's actions (in fact, you must be able to, or defensive charms wouldn't work), such you can just activate all your duration charms on other people's actions. Or c) that some charms create special reflexive actions which have their own steps, specifically only a step 1, which that charm is activated on.<br /> <br /> Glorious Solar Arsenal, though a Solar-Only charm, at essence 2 is a reflexive action. So, arguably it happens on step 1 of the reflexive action it creates, meaning you can use it an infinite number of times.<br /> It also generates 2 anima per activation, and also generates power at close combat 5. <br /> So you could spend 5m on turn 1 building a ton of power and 10 anima, then immediately drop all activations (or all but 1 or 2 if you actually need a weapon and/or armor)<br /> <br /> Even if the build power gets house ruled to once/scene or something, unless the charm overall does you can get anima 10 pretty easily","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/23597-autxauty","name":"autXautY","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2017"},{"key":"Posts:","value":"286"}]},"thankedby":[]},{"date":"2021-06-30T06:03:51-07:00","id":1453836,"title":"","content":"Having my first real game tonight of ExEss (last week we did charge and 1 scene introduction). I'm really excited to try out the new stuff. I already love the Venture System as my players head-on decided on their first scene last time &quot;We want to start a revolution to overthrow the government&quot; (Exalted players are so predictable) and I could quickly devise some answers and step-by-step process to help them execute that with the Ventures, all the while having actual dramatic scenes to keep the tension.<br /> <br /> I just noticed going through my NPC's that basic Qualities only marginally covers &quot;Defensive powers&quot;, so I guess the whole fighting system will be rather &quot;agressive&quot; at least for the Antagonists. Lots of Dramatic Injuries coming through I predict","signature":"<hr class=\"b-divider\"/><br/>My homebrew (Leave comments if you want to help improve) : <a href=\"https://docs.google.com/spreadsheets/d/1hPx-Q2jlDgAIZX_d0wQWmJkZMN51jas4QNp5meeQjgo/edit?usp=sharing\" target=\"_blank\">A quick recap of all the pools and stats for Quick Exalted 3E characters</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24291-chausse","name":"Chausse","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24291_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2018"},{"key":"Posts:","value":"1139"}]},"thankedby":[]},{"date":"2021-06-30T07:14:49-07:00","id":1453841,"title":"","content":"I would be very interested to see how you find it.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2021-06-30T15:03:24-07:00","id":1453866,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Wizard of Oz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1449352-essence-ks-27th-may-21?p=1453841#post1453841\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I would be very interested to see how you find it.</div> </div> </div> </div>It went quite nicely, with some drawbacks of course, but also many good parts. I'll try to put my thoughts out there when I have some time.","signature":"<hr class=\"b-divider\"/><br/>My homebrew (Leave comments if you want to help improve) : <a href=\"https://docs.google.com/spreadsheets/d/1hPx-Q2jlDgAIZX_d0wQWmJkZMN51jas4QNp5meeQjgo/edit?usp=sharing\" target=\"_blank\">A quick recap of all the pools and stats for Quick Exalted 3E characters</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24291-chausse","name":"Chausse","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24291_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2018"},{"key":"Posts:","value":"1139"}]},"thankedby