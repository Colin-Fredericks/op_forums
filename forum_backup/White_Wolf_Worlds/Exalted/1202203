xpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2018-04-02T12:12:07-07:00","id":1202279,"title":"","content":"Huh. From the Elemental Bolt, it looks like the innate Elemental Bolt Charm doesn't let a bunch of Dragonbloods supercharge a Sentai Finishing Move.<br /> <br /> That may be something done between Sworn Kinships?","signature":"<hr class=\"b-divider\"/><br/>Disclaimer: In favor of fun and enjoyment, but may speak up to warn you that you're gonna step on a metaphorical land mine","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2142-kyman201","name":"Kyman201","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2142_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"4086"}]},"thankedby":[]},{"date":"2018-04-02T12:57:24-07:00","id":1202293,"title":"","content":"Now this is cool, the boosted immaculate style effects are tied to the emelental aura. THAT is how you make an immaculate style better for a DB than a solar. It still feels wrong, but it balances out because it also feels wrong to let a Solar say that he\u2019s so damn good at martial arts that his very soul becomes a pillar of elemental power, from the inside out.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/1121-drlovemonkey","name":"DrLoveMonkey","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1121_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"4736"}]},"thankedby":[]},{"date":"2018-04-02T14:14:49-07:00","id":1202305,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>DrLoveMonkey</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/dragon-blooded/1202203-wfhw-kickstarter-preview-images-transcribed?p=1202293#post1202293\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Now this is cool, the boosted immaculate style effects are tied to the emelental aura. THAT is how you make an immaculate style better for a DB than a solar. It still feels wrong, but it balances out because it also feels wrong to let a Solar say that he\u2019s so damn good at martial arts that his very soul becomes a pillar of elemental power, from the inside out.</div> </div> </div> </div>That\u2019s so damn obvious now, I feel dumb for not having realized sooner that that would be the trick.","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]}]}