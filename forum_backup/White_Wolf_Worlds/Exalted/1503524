svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2019"},{"key":"Posts:","value":"296"}]},"thankedby":[]},{"date":"2023-03-20T20:32:47-07:00","id":1506008,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>habitableexoplanet</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1503524-exalted-essence-preview-is-out?p=1505904#post1505904\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Second Circle Sorcery and First Circle Necromancy.</div> </div> </div> </div>Guess this might just be a &quot;Well, I guess I'll implement it this way at my table&quot; thing, but I'm surprised that they don't have both Second Circle Sorcery AND Necromancy, to reflect their dualistic nature. I know it's game balance because of how good they are at SMA, but it's still a bit of a surprise.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26317-critian-caceorte","name":"Critian Caceorte","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2020"},{"key":"Posts:","value":"246"}]},"thankedby":[]},{"date":"2023-03-21T01:20:55-07:00","id":1506020,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Critian Caceorte</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1503524-exalted-essence-preview-is-out?p=1506008#post1506008\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Guess this might just be a &quot;Well, I guess I'll implement it this way at my table&quot; thing, but I'm surprised that they don't have both Second Circle Sorcery AND Necromancy, to reflect their dualistic nature. I know it's game balance because of how good they are at SMA, but it's still a bit of a surprise.</div> </div> </div> </div>One bit that wasn't mentioned is that Essence also says there are rumors of internal alchemical transformations that allow Gets to switch their access, going from Second Circle Sorcery and First Circle Necromancy to First Circle Sorcery and Second Circle Necromancy.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/51-marin","name":"marin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2019"}]},"thankedby":[]}]}