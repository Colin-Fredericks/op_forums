ified.angelasasser.com\" target=\"_blank\">My Exalted Fanfiction</a>","edited":{"userid":11990,"user_link":"https://forum.theonyxpath.com/member/11990-angelicshadow","user":"angelicshadow","date":". 06-24-2016, 12:38 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11990-angelicshadow","name":"angelicshadow","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11990_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"181"}]},"thankedby":[]},{"date":"2016-06-22T12:32:55-07:00","id":919264,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/362-darkon\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar362_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"362\" data-vbnamecard=\"362\">Darkon</a> Awesome! I hope you enjoy the story when you do get a chance to read.<br /> <a href=\"https://forum.theonyxpath.com/member/476-argonometra\" style=\"background-image:url('data:image/svg+xml;base64,');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"476\" data-vbnamecard=\"476\">Argonometra</a> Glad you enjoy my art! Ah that Persephone piece is an old classic I've been meaning to redo.<br /> <a href=\"https://forum.theonyxpath.com/member/4939-adimar\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar4939_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"4939\" data-vbnamecard=\"4939\">adimar</a> I'm happy you've enjoyed the story thus far!","signature":"<hr class=\"b-divider\"/><br/><hr /><a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/918857-ang-s-exalted-sketchbook\" target=\"_blank\">My Exalted Art</a> | <a href=\"http://theuncrucified.angelasasser.com\" target=\"_blank\">My Exalted Fanfiction</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11990-angelicshadow","name":"angelicshadow","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11990_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"181"}]},"thankedby":[]},{"date":"2016-06-23T19:30:25-07:00","id":920093,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>angelicshadow</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/916510-the-uncrucified-an-eclipse-caste-fanfiction-text-podfic-audiobook?p=919264#post919264\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><span class=\"b-bbcode-user js-bbcode-user\">Guest</span> Awesome! I hope you enjoy the story when you do get a chance to read.</div> </div> </div> </div>Meant to listen to the first chapter last night before bed. Wound up binge-listening to it all. Great stuff, loved it. Looking forward to the next chapter!","signature":"<hr class=\"b-divider\"/><br/><i>Good night sweet Green Sun Prince: And flights of demons beat thee to thy rest...with billyclubs! <img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://theonyxpath.com/forum/core/images/smilies/biggrin.png\" border=\"0\" alt=\"\" /></i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/362-darkon","name":"Darkon","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar362_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"228"}]},"thankedby":[]},{"date":"2016-06-23T21:30:54-07:00","id":920143,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/362-darkon\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar362_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"362\" data-vbnamecard=\"362\">Darkon</a> knowing that my story has been binged on fills with me happy! <img src=\"https://forum.theonyxpath.com/core/images/smilies/biggrin.png\" border=\"0\" alt=\"\" title=\"Big Grin\" smilieid=\"3\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><hr /><a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/918857-ang-s-exalted-sketchbook\" target=\"_blank\">My Exalted Art</a> | <a href=\"http://theuncrucified.angelasasser.com\" target=\"_blank\">My Exalted Fanfiction</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11990-angelicshadow","name":"angelicshadow","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11990_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"181"}]},"thankedby":[]},{"date":"2016-06-29T07:25:54-07:00","id":923235,"title":"","content":"Another Wednesday, another release day! <b>Chapter 6</b> is live. We march inexorably towards Kalara\u2019s Exaltation, the defining moment of her \u2018choosing\u2019, a dark day of destiny cast in the shadow of the Eclipse.<div style=\"margin-left:40px\"><b>SUMMARY:</b> <i>Kalara\u2019s world falls apart around her as her ideals are challenged by tragedy. Friends become enemies and the one person she could trust in the world is gone. But Fate isn\u2019t finished with her yet\u2026</i></div><div align=\"center\"> <div align=\"left\"><b><span style=\"color:#8B4513\"><img src=\"http://66.media.t