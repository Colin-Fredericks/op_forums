ey":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"112"}]},"thankedby":[]},{"date":"2016-07-01T05:37:53-07:00","id":924406,"title":"","content":"Incidentally, his blog shows that somebody has finally brought Exalted itself to Abaddon's attention.<br /> <br /> \u200bHe seems to have responded positively to it.","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#00ffff\">I have approximate knowledge of many things.</span><br /> <a href=\"https://forum.rpg.net/index.php?threads/wip-xenoblade-chronicles-the-sword-can-see-the-future.835575/\" target=\"_blank\">Write up as I play Xenoblade Chronicles.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/158-isator-levi","name":"Isator Levi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar158_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"17901"}]},"thankedby":[]},{"date":"2016-07-01T07:19:05-07:00","id":924435,"title":"","content":"Have a link for that? I can only seem to find his Tumblr.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2016-07-01T07:45:15-07:00","id":924448,"title":"","content":"Tumblr's a blog service, yes.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/11538-kingcrackers","name":"kingcrackers","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11538_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2016"},{"key":"Posts:","value":"305"}]},"thankedby":[]},{"date":"2016-07-01T11:14:19-07:00","id":924542,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>kingcrackers</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/85157-kill-six-billion-demons?p=924448#post924448\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Tumblr's a blog service, yes.</div> </div> </div> </div>Yes, that's helpful.<br /> <br /> <a href=\"https://forum.theonyxpath.com/member/1144-exthalion\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar1144_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"1144\" data-vbnamecard=\"1144\">Exthalion</a>: <a href=\"http://killsixbilliondemons.tumblr.com/post/146620914715/have-you-ever-played-or-read-up-on-exalted-it\" target=\"_blank\">Here you go.</a>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/97-the-mg","name":"The MG","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar97_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2460"}]},"thankedby":[]},{"date":"2016-07-01T12:20:03-07:00","id":924561,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/97-the-mg\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar97_2.png');\" class=\"b-bbcode-user b-bbc