0/6/0/4/5/avatar541_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"902"}]},"thankedby":[]},{"date":"2016-01-27T09:10:08-08:00","id":817673,"title":"","content":"Metatron lives!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/97-the-mg","name":"The MG","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar97_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2460"}]},"thankedby":[]},{"date":"2016-01-27T09:34:32-08:00","id":817689,"title":"","content":"I kept reading it as Megatron for a little bit.","signature":"<hr class=\"b-divider\"/><br/>\u201cThe very existence of flame-throwers proves that some time, somewhere, someone said to themselves, You know, I want to set those people over there on fire, but I'm just not close enough to get the job done.\u201d George Carlin","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/123-trax","name":"Trax","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar123_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"176"}]},"thankedby":[]},{"date":"2016-01-27T17:02:59-08:00","id":818064,"title":"","content":"I read it as Mettaton first.","signature":"<hr class=\"b-divider\"/><br/><b>Dex Davican wrote:</b> I can say without exaggeration or dishonesty that I am the most creative man <i>ever to have lived</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/75-weimann","name":"Weimann","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar75_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1279"}]},"thankedby":[]},{"date":"2016-01-28T04:01:35-08:00","id":818326,"title":"","content":"Abaddon posted a new, retroactive page:<br /> <br /> <div class=\"b-bbcode b-bbcode__url b-bbcode__url--preview\"> <a href=\"http://killsixbilliondemons.com/comic/ksbd-2-29-5/\" target=\"_blank\" class=\"urlimg_container\"> <img class=\"js-img-fallback\" src=\"https://killsixbilliondemons.com/wp-content/uploads/2013/10/KSBDinsert2r2.jpg\"> </a> <div class=\"urlinfo\"> <div class=\"title ellipsis\"> <a href=\"http://killsixbilliondemons.com/comic/ksbd-2-29-5/\" target=\"_blank\"> KSBD 2-29.5 &ndash; Kill Six Billion Demons </a> </div> <div class=\"url ellipsis\"> <a href=\"http://killsixbilliondemons.com/comic/ksbd-2-29-5/\" target=\"_blank\"> http://killsixbilliondemons.com/comic/ksbd-2-29-5/ </a> </div> <div class=\"meta\"> </div> </div> </div>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/8890-nullapostle","name":"NullApostle","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar8890_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"202"}]},"thankedby":[]},{"date":"2016-01-28T08:12:03-08:00","id":818435,"title":"","content":"Some stuff we already knew, explained earlier and with greater clarity. Doesn't seem too out of place, luckily. Though White Chain's last speech bubble is a bit strange when just in the previous page she remarked that her kin could do little about Throne and the Law was broken.<br /> <br /> As for the latest chronological update: goddamn, what did they do to White Chain?<br /> (Also, I like Dark Spear's design the most out of those angels there.)","signature":"","edited":{"userid":188,"user_link":"https://forum.theonyxpath.com/member/188-yeoflittlefaith","user":"YeOfLittleFaith","date":". 01-28-2016, 03:31 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/188-yeoflittlefaith","name":"YeOfLittleFaith","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar188_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1159"}]},"thankedby":[]},{"date":"2016-01-28T14:23:02-08:00","id":818733,"title":"","content":"I have certain mixed feeling about this direct confirmation that demons are in fact discrete entities prior to being masked.<br /> <br /> On the one hand, I liked the idea that they were all melded together in an inchoate chaos, only even being given distinctions when bound by others.<br /> <br /> On the other, I quite like the distant image of the numerous unmasked devils we see in that one shot of the whole Wheel and Void, as well as some of the backstory images of faceless devils reaching out for masks.<br /> <br /> Ah well.<br /> <br /> So, how long until we get a revised page in which White Chain punches first?","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#00ffff\">I have approximate knowledge of many things.</span><br /> <a href=\"https://forum.rpg.net/index.php?threads/wip-xenoblade-chronicles-the-sword-can-see-the-future.835575/\" target=\"_blank\">Write up as I play Xenoblade Chronicles.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/158-isator-levi","name":"Isator Levi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar158_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"17901"}]},"thankedby":[]},{"date":"2016-01-28T16:15:02-08:00","id":818819,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Isator Levi</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/85157-kill-six-billion-demons?p=818733#post818733\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I have certain mixed feeling about this direct confirmation that demons are in fact discrete entities prior to being masked.<br /> <br /> On the one hand, I liked the idea that they were all melded together in an inchoate chaos, only even being given distinctions when bound by others.<br /> <br /> On the other, I quite like the distant image of the numerous unmasked devils we see in that one shot of the whole Wheel and Void, as well as some of the backstory images of faceless devils reaching out for masks.</div> </div> </div> </div>Oh, so I wasn't the only one. It has me conflicted, but I'm also fine with either to more or less the same degree - or both. I think it's fair to interpret unbound demons as amorphous feral entities that are spilled from the hungry chaos of the Black Flame. At least until we learn something to the contrary.","signature":"","edited":{"userid":188,"user_link":"https://forum.theonyxpath.com/member/188-yeoflittlefaith","user":"YeOfLittleFaith","date":". 01-28-2016, 07:17 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/188-yeoflittlefaith","name":"YeOfLittleFaith","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar188_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1159"}]},"thankedby":[]},{"date":"2016-01-29T20:45:56-08:00","id":819666,"title":"","content":"I'll be honest, I don't particularly care for the retroactive exposition.<br /> <br /> It feels.......<br /> <br /> Okay, well. It fits in with the flow of narration around it. It just feels off to me.<br /> <br /> <br /> In any event;<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>YeOfLittleFaith</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/85157-kill-six-billion-demons?p=818435#post818435\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">As for the latest chronological update: goddamn, what did they do to White Chain?<br /> (Also, I like Dark Spear's design the most out of those angels there.)</div> </div> </div> </div><br /> Well, the answer(along with the update) is up if you're really that interested.<br /> <br /> Poor White Chain. For a spirit of the void, made of Cold White Flame with numerous eyes and wings and who knows of one of the syllables of Royalty, she is just on the <i>wrong</i> end of the Cthulhu Mythos here.","signature":"<hr class=\"b-divider\"/><br/><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://s3.amazonaws.com/ksr/avatars/3507685/Exalted_Back.small.jpg?1370109312\" border=\"0\" alt=\"\" /> <hr />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/446-nervaqus987","name":"Nervaqus987","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar446_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"246"}]},"thankedby":[]},{"date":"2016-01-30T05:26:13-08:00","id":819775,"title":"","content":"The angel turned into the tempter?<br /> <br /> <div class=\"b-bbcode b-bbcod