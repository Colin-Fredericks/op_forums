ath.com/core/avatars/0/0/6/0/4/5/avatar188_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1159"}]},"thankedby":[]},{"date":"2017-05-07T18:16:12-07:00","id":1089505,"title":"","content":"So Incubus is acting as Alison's unwoven coadjutor?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1047-vampire-hunter-d","name":"vampire hunter D","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1047_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1727"}]},"thankedby":[]},{"date":"2017-05-08T03:24:45-07:00","id":1089679,"title":"","content":"I prefer to see him as her personal Bad Idea Bear.","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#00ffff\">I have approximate knowledge of many things.</span><br /> <a href=\"https://forum.rpg.net/index.php?threads/wip-xenoblade-chronicles-the-sword-can-see-the-future.835575/\" target=\"_blank\">Write up as I play Xenoblade Chronicles.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/158-isator-levi","name":"Isator Levi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar158_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"17901"}]},"thankedby":[]},{"date":"2017-05-09T11:49:41-07:00","id":1090399,"title":"","content":"People who aren't patrons might think that they know what's coming, but they have no idea. <img src=\"https://forum.theonyxpath.com/core/images/smilies/cool.png\" border=\"0\" alt=\"\" title=\"Cool\" smilieid=\"6\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#00ffff\">I have approximate knowledge of many things.</span><br /> <a href=\"https://forum.rpg.net/index.php?threads/wip-xenoblade-chronicles-the-sword-can-see-the-future.835575/\" target=\"_blank\">Write up as I play Xenoblade Chronicles.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/158-isator-levi","name":"Isator Levi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar158_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"17901"}]},"thankedby":[]},{"date":"2017-05-09T12:26:18-07:00","id":1090428,"title":"","content":"I will admit that I have no idea what's coming. There have been so many curveballs in KSBD from what I expected that I've given up on trying to guess.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/9034-bulshock","name":"Bulshock","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"380"}]},"thankedby":[]},{"date":"2017-05-09T18:58:44-07:00","id":1090551,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Isator Levi</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/85157-kill-six-billion-demons?p=1090399#post1090399\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">People who aren't patrons might think that they know what's coming, but they have no idea. <img src=\"https://forum.theonyxpath.com/core/images/smilies/cool.png\" border=\"0\" alt=\"\" title=\"Cool\" smilieid=\"6\" class=\"inlineimg\" /></div> </div> </div> </div>I don't know, <a href=\"http://killsixbilliondemons.com/comic/seeker-of-thrones-5-50/\" target=\"_blank\">this is almost exactly what I was expecting.</a>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1144-exthalion","name":"Exthalion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1144_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2306"}]},"thankedby":[]},{"date":"2017-05-09T20:41:02-07:00","id":1090577,"title":"","content":"So this is what it looks like when you're on the receiving end of sidereal marital arts.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/4578-zale","name":"Zale","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4578_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"156"}]},"thankedby":[]},{"date":"2017-05-10T02:56:36-07:00","id":1090658,"title":"","content":"Is.. that Goddess Final Fantasy style summon?<br /> <br /> Also Exthalion, are you posting as <span style=\"color:#EA2F45\"><span style=\"font-family:Arial\"><b><span style=\"font-size:16px\">108 Sage King Turns the Wheel</span></b></span></span> in the website comments?<br /> <br /> The pulsar / supernova image seems to be the same.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1794-doran","name":"doran","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1794_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"89"}]},"thankedby":[]},{"date":"2017-05-10T03:09:45-07:00","id":1090660,"title":"","content":"Going by the note under the comic, I think it's more of an invocation than a summoning. Given how it's the patron goddess of the poor and downtrodden, I think it's a manifestation of Allison's black soul framed through an attitude of &quot;in the name of the moon, I'll punish you&quot;.<br />","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#00ffff\">I have approximate knowledge of many things.</span><br /> <a href=\"https://forum.rpg.net/index.php?threads/wip-xenoblade-chronicles-the-sword-can-see-the-future.835575/\" target=\"_blank\">Write up as I play Xenoblade Chronicles.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/158-isator-levi","name":"Isator Levi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar158_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"17901"}]},"thankedby":[]},{"date":"2017-05-11T08:17:11-07:00","id":1091138,"title":"","content":"Alison has sorta summoned Ys Myra? The Arts of K6BD is basically lying to the universe in specific and skillful ways so that the universe then reorders itself to make your lie reality. And Ys Myra is extremely, very dead. Like, you can see her corpse and live in it.<br /> <br /> But through the Arts, not only is Ys Myra before you in all her fabulous and grimy glory, she is ready to smite the touchy-touchy outta whoever your Will directs her to smite. Theoretically, you could even use this against her when she was alive! But why call on gods when you can lie whatever you like into existence, you ask? Well, as the saying goes, the most powerful lies have a seed of truth inside.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1516-solarious","name":"Solarious","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1516_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"152"}]},"thankedby":[]},{"date":"2017-05-12T23:20:57-07:00","id":1091838,"title":"","content":"So, is there a Charm to do this in Exalted? (Almost seems like SMA to me)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1047-vampire-hunter-d","name":"vampire hunter D","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1047_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1727"}]},"thankedby":[]},{"date":"2017-05-13T01:25:28-07:00","id":1091864,"title":"","content":"Well, as with any circumstance, application of the Magma Kracken serves to call on external forces to wreak havoc on your command. It is roughly a Sapphire circle spell. You might not always be able to call up a dead goddess to smash face, but it is somewhere in that range.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1516-solarious","name":"Solarious","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1516_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"152"}]},"thankedby":[]},{"date":"2017-05-13T01:44:57-07:00","id":1091869,"title":"","content":"Maybe ivoke the memory of a fallen Deva instead?<br /> <br /> would that be Saphire Sorcery? Adamant? Or wouldmit be a form of Necromancy?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1047-vampire-hunter-d","name":"vampire hunter D","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1047_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1727"}]},"thankedby":[]},{"date":"2017-05-13T08:12:18-07:00","id":1091950,"title":"","content":"Zoss does stuff and he's dead, so I don't see why a goddess wouldn't.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4578-zale","name":"Zale","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4578_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"156"}]},"thankedby":[]},{"date":"2017-05-13T09:02:04-07:00","id":1091968,"title":"","content":"Well, what the gods do while being dead is tell the story that is the multiverse, so it's not as if they're wholly absent.<br /> <br /> \u200bBut then main reason I prefer to read this as a kind of manifestation arising from Allison taking an action resonant with that goddess's purview, rather than some kind of summon magic, is because the latter doesn't really seem to exist in this form in this cosmology, and I would feel that it would kind of detract from this being Allison's action.","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#00ffff\">I have approximate knowledge of many things.</span><br /> <a href=\"https://forum.rpg.net/index.php?threads/wip-xenoblade-chronicles-the-sword-can-see-the-future.835575/\" target=\"_blank\">Write up as I play Xenoblade Chronicles.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/158-isator-levi","name":"Isator Levi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar158_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"17901"}]},"thankedby":[]},{"date":"2017-05-13T11:33:01-07:00","id":1092016,"title":"","content":"I very much agree- I feel this is more like some sort of martial arts move she's channeling from incubus than an actual manifestation of a deity. <br /> <br /> Sidereal Martial Arts, man, where you question if it's really just head butting people with gods or if you're summoning a god to headbutt people.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/4578-zale","name":"Zale","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4578_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"156"}]},"thankedby":[]},{"date":"2017-05-27T02:00:03-07:00","id":1097462,"title":"","content":"<a href=\"http://killsixbilliondemons.com/comic/seeker-of-thrones-5-52/\" target=\"_blank\">You rise when the king appears.</a>","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#00ffff\">I have approximate knowledge of many things.</span><br /> <a href=\"https://forum.rpg.net/index.php?threads/wip-xenoblade-chronicles-the-sword-can-see-the-future.835575/\" target=\"_blank\">Write up as I play Xenoblade Chronicles.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/158-isator-levi","name":"Isator Levi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar158_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"17901"}]