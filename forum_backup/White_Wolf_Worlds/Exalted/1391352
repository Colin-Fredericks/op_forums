path.com/core/avatars/0/0/6/0/4/5/avatar24291_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2018"},{"key":"Posts:","value":"1139"}]},"thankedby":[]},{"date":"2020-08-25T03:18:15-07:00","id":1410258,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Chausse</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1391352-map-of-creation?p=1410256#post1410256\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><a href=\"https://drive.google.com/file/d/12aimmpdoJTehYYPGfBb3BMGtZnlG60Ck/view?usp=sharing\" target=\"_blank\">This link</a> should function, I did not put it in public indeed</div> </div> </div> </div>Are you sure you downloaded the right map? That looks like Base Map, but when I download Custom Map Simplified I get the map with the features.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11290-rj-au","name":"rj.au","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2016"},{"key":"Posts:","value":"63"}]},"thankedby":[]},{"date":"2020-08-25T03:28:40-07:00","id":1410260,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>rj.au</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1391352-map-of-creation?p=1410258#post1410258\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Are you sure you downloaded the right map? That looks like Base Map, but when I download Custom Map Simplified I get the map with the features.</div> </div> </div> </div>I'll try again when I have time and keep you updated. Thanks for answering anyway.","signature":"<hr class=\"b-divider\"/><br/>My homebrew (Leave comments if you want to help improve) : <a href=\"https://docs.google.com/spreadsheets/d/1hPx-Q2jlDgAIZX_d0wQWmJkZMN51jas4QNp5meeQjgo/edit?usp=sharing\" target=\"_blank\">A quick recap of all the pools and stats for Quick Exalted 3E characters</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24291-chausse","name":"Chausse","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24291_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2018"},{"key":"Posts:","value":"1139"}]},"thankedby":[]},{"date":"2020-09-17T01:05:06-07:00","id":1414151,"title":"","content":"I've uploaded another map to Google Drive (same public folder as the others). This one is called 'location map', and has less information about locations than Custom Map (so as to avoid the long lines of symbols next to locations), as well as being more conservative on how much information on location warrants guessing, but still tries to include all locations apparent in any editions, along with a small amount of additional information (major stuff like 'Realm satrapy', 'Lunar dominion', 'Great house ancestral seat' and 'Illuminated training camp'). It also includes more in the way of comparison between editions - major differences in terrain are shown as horizontal stripes and old locations of places that have moved are shown in orange. I am, as before, interested in feedback. I will probably not be updating Custom Map any more unless someone requests I do so, although I am open to requests for maps with specific information that was on it and am planning on making more maps that try to include some of the information that Location Map doesn't.<br /> I have, since the last update of Custom Map, also discovered the maps at the back of the 1E lunar, abyssal and fair folk books, so Location Map contains the locations from these.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11290-rj-au","name":"rj.au","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2016"},{"key":"Posts:","value":"63"}]},"thankedby":[]}]}