6","name":"Sandact6","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1183_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1236"}]},"thankedby":[]},{"date":"2020-09-22T16:35:16-07:00","id":1415133,"title":"","content":"Ghost Armor Prana is the Abyssal Charm that does this in 2e. IIRC it's 3m per reduction to Mobility or Fatigue.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/617-heavy-arms","name":"Heavy Arms","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar617_2.jpeg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"12634"}]},"thankedby":[]}]}