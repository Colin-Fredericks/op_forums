atar177_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10857"}]},"thankedby":[]},{"date":"2020-06-15T22:07:18-07:00","id":1396816,"title":"","content":"I'm not a lawyer but that sounds like it won't hold up in court.","signature":"<hr class=\"b-divider\"/><br/>Please be warned: this is not champagne, this is most likely a duck.<br /> -<i>Chausse</i><br /> <br /> <span style=\"color:#800080\"><i>Message me for Japanese translations.</i></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/8830-sorcerous-overlord","name":"Sorcerous Overlord","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar8830_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"873"}]},"thankedby":[]},{"date":"2020-06-15T22:37:41-07:00","id":1396822,"title":"","content":"I work in IT sector so working from home is no problem for me<a href=\"https://basketballlegendsunblocked.club\" target=\"_blank\">,</a> I usually don't go outside if it isn't necessary and when I do I always wear mask and wash my hands after coming back home<a href=\"https://gamealchemy.us\" target=\"_blank\">.</a> So far so good I am okay <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/26237-aldamoran","name":"aldamoran","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2020"},{"key":"Posts:","value":"1"}]},"thankedby":[]},{"date":"2020-06-15T23:25:47-07:00","id":1396825,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Sorcerous Overlord</strong> <a href=\"https://forum.theonyxpath.com/forum/general/off-topic/1376047-staying-safe-from-the-virus?p=1396816#post1396816\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'm not a lawyer but that sounds like it won't hold up in court.</div> </div> </div> </div>In a just universe, I'd agree with you. As it is, Trump has spent the last three-and-a-half years packing federal courts with &quot;judges&quot; whose only qualifications he cared about was whether they were right-wing enough to rule against stuff like abortions or treating immigrants like people.","signature":"<hr class=\"b-divider\"/><br/>He/him","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/177-thecountalucard","name":"TheCountAlucard","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar177_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10857"}]},"thankedby":[]},{"date":"2020-06-16T18:55:30-07:00","id":1396985,"title":"","content":"<a href=\"https://www.nytimes.com/2020/06/16/business/meat-industry-china-pork.html?smid=tw-share\" target=\"_blank\">Oh, hey, the meat industry was lying when they said there'd be meat shortages if they didn't stay open?</a> And it turns out we sent a record-breaking quantity of pork to China? And eighty-nine meatpackers <i>died</i> because of this?<br /> <br /> \u200bCool, cool, cool. Cool.<br /> <br /> \u200bExcuse me. I need to go punch something.","signature":"<hr class=\"b-divider\"/><br/>He/him","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/177-thecountalucard","name":"TheCountAlucard","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar177_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10857"}]},"thankedby":[]},{"date":"2020-06-20T18:54:30-07:00","id":1397871,"title":"","content":"US billionaires wealth added since the beginning of the pandemic: ~$584,000,000,000<br /> US unemployment claims since the beginning of pandemic: ~44,000,000","signature":"<hr class=\"b-divider\"/><br/>He/him","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/177-thecountalucard","name":"TheCountAlucard","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar177_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10857"}]},"thankedby":[]},{"date":"2020-06-23T08:29:01-07:00","id":1398366,"title":"","content":"So until we finally managed to reduce the number of infected people to practically nothing, because that a lot of people decided that &quot;the corona has passed&quot;, or &quot;that corona is just a flew&quot;, or &quot;that corona doesn't exist/ dangerous&quot;, everything was opened up too quickly, and no one cares for social distancing, and now we return to where we left. In their defense, the government did practically nothing to help small buisnesses which were harmed by the quarantine- but between that and having stupid conspiracy theories about how the New World Order tries to kill the democracy there is quit a leap.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.storytellersvault.com/browse.php?author=Shachar%20Gol