deviantart.com/gallery/55265686/the-fall\" target=\"_blank\">http://xanroth.deviantart.com/gallery/55265686/the-fall</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4455-xanroth","name":"Xanroth","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4455_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1072"}]},"thankedby":[]},{"date":"2015-09-12T02:57:22-07:00","id":661713,"title":"","content":"<div class=\"b-bbcode b-bbcode__url b-bbcode__url--preview\"> <a href=\"http://xanroth.deviantart.com/art/First-age-Harrowers-559776174\" target=\"_blank\" class=\"urlimg_container\"> <img class=\"js-img-fallback\" src=\"https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com/f/98ddf18e-aadc-4ad8-bc8b-0ed5efaeaa4f/d999y26-9ae8768e-b6d3-4347-b056-c2ea5008dcf6.png/v1/fill/w_751,h_1063,q_70,strp/first_age_harrowers_by_xanroth_d999y26-pre.jpg?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..Tm-EoMyaVEEBqE7Cwv31lYeW_angItIhzodNLW79Llk\"> </a> <div class=\"urlinfo\"> <div class=\"title ellipsis\"> <a href=\"http://xanroth.deviantart.com/art/First-age-Harrowers-559776174\" target=\"_blank\"> First age Harrowers by xanroth on DeviantArt </a> </div> <div class=\"url ellipsis\"> <a href=\"http://xanroth.deviantart.com/art/First-age-Harrowers-559776174\" target=\"_blank\"> http://xanroth.deviantart.com/art/First-age-Harrowers-559776174 </a> </div> <div class=\"meta\"> First age Harrowers &mdash; artwork by xanroth on DeviantArt. Published: 2015-09-12 &middot; Likes: 4 &middot; Views: 746 &middot; Tags: abomination, exalted, magitech, mortals, harrower, talesofexalts </div> </div> </div><br /> <span style=\"color:#2C3635\"><span style=\"font-family:Verdana\"><span style=\"font-size:12px\">here are the first age version of the reaper of the mortal harvest's harrowers, unlike their age of sorrows descendants, they posses no sorcerous or necromantic abilities, instead they have a orichalcum sorcery-capturing cord entwined with their nervous-system, this grants the first age harrowers the ability to absorb any one energy based attack they can perceive. the absorbed energy is broken down into raw essence that the harrower can use to empower itself. It must spend all of the excess essence it has gained from an absorbed energy attack before it can absorb another one. It can fire of a energy beam using absorbed essence or it can give itself a significant boost to it's physical capabilities. However, doing this comes with a risk, using to much energy can overload it's nervous-system causing it's disturbing and painful death followed by it's self-destruct mechanism triggering causing it to explode.</span></span></span><br /> <span style=\"color:#2C3635\"><span style=\"font-family:Verdana\"><span style=\"font-size:12px\">The first age harrowers where used as combat assassins by the reapers forces, waiting in the background behind the parasite troopers and harvesters before revealing itself once it found a sorcerer or exalted foe, leaping into battle with the sole purpose of eliminating whatever it was that dared to stand in the way of the reapers will.</span></span></span>","signature":"<hr class=\"b-divider\"/><br/>I'm making the Tales of Exalts webcomic<br /> <a href=\"http://xanroth.deviantart.com/gallery/50854781/tales-of-exalts\" target=\"_blank\">http://xanroth.deviantart.com/galler...ales-of-exalts</a><br /> alchemical report <a href=\"http://xanroth.deviantart.com/gallery/54812164/Alchemical-Report\" target=\"_blank\">http://xanroth.deviantart.com/galler...hemical-Report</a><br /> the fall <a href=\"http://xanroth.deviantart.com/gallery/55265686/the-fall\" target=\"_blank\">http://xanroth.deviantart.com/gallery/55265686/the-fall</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/me