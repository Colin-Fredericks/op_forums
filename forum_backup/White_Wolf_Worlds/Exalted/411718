atars/0/0/6/0/4/5/avatar681_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2747"}]},"thankedby":[]},{"date":"2015-05-16T14:29:50-07:00","id":516453,"title":"","content":"Those are more D&amp;D than Exalted though","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1047-vampire-hunter-d","name":"vampire hunter D","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1047_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1727"}]},"thankedby":[]},{"date":"2015-05-16T14:34:19-07:00","id":516454,"title":"","content":"Mostly links, but their all going to be awesome:<br /> <a href=\"http://dresdencodak.tumblr.com/post/47724463171/inspired-by-anita-sarkeesians-video-game-tropes\" target=\"_blank\">Zelda as the hero of Legend of Zelda</a>, <a href=\"http://www.dorkly.com/post/67933/badass-zelda-fan-art\" target=\"_blank\">Nothing but badass zelda art</a>, <a href=\"http://www.dorkly.com/post/71160/awesome-alternate-art-takes-on-the-legend-of-zelda\" target=\"_blank\">Alternate Zelda art</a>, <a href=\"http://www.dorkly.com/post/56281/fearsome-disney-princess-art\" target=\"_blank\">Disney princesses as warriors (beep you ponies, disney princesses do it better),</a> <a href=\"http://www.dorkly.com/post/58645/best-disney-princess-mash-ups/page:5\" target=\"_blank\">the first one here should be a martial art</a>, <a href=\"http://skirtzzz.deviantart.com/art/Berserker-Pocahontas-191715143\" target=\"_blank\">premade lunar barbarian with familiar</a>, <a href=\"http://ceruleanraven.deviantart.com/gallery/37123143/Disney-Elementals\" target=\"_blank\">How elementals can interact with mortals</a>, <a href=\"http://venamalfoy.deviantart.com/art/Elemental-Rangers-289216197\" target=\"_blank\">demonified elementals </a><a href=\"http://venamalfoy.deviantart.com/art/Elemental-Mages-287801252\" target=\"_blank\">or dragon bloods</a>, and finally,<a href=\"http://nickinamerica.deviantart.com/art/Bionicle-Nova-Orbis-Anguis-493286291\" target=\"_blank\"> something to eat up your ships and then scuttle onto land and eat your villages</a>.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://jaxushomebrew.blogspot.ie/2016/06/introduction-site-map-and-catalogue.html\" target=\"_blank\">My homebrew blog</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1291-mr-jaxus","name":"Mr.Jaxus","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1291_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"379"}]},"thankedby":[]},{"date":"2015-05-16T20:12:23-07:00","id":516670,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>vampire hunter D</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/411718-inspirational-art-exalted-3e-edition?p=516453#post516453\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Those are more D&amp;D than Exalted though</div> </div> </div> </div><br /> Well, the character classes certainly are, but the art design is just the sort of JRPG/anime-style that can fit Exalted so well! Here's another (can you name the splats/castes?<img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" />):<br /> <br /> <img src=\"http://fc07.deviantart.net/fs71/i/2015/006/2/4/effects___mlp_fantasy_heroes_by_mono_phos-d8ctki3.png\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/681-hand-of-omega","name":"Hand-of-Omega","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar681_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2747"}]},"thankedby":[]},{"date":"2015-05-16T20:24:01-07:00","id":516677,"title":"","content":"Solar (Zenith), Solar (Night), mortal, Solar (Twilight), Solar (Dawn), Solar (Twilight), Solar (Eclipse), and Solar (Eclipse).<br /> <br /> <img src=\"https://forum.theonyxpath.com/core/images/smilies/tongue.png\" border=\"0\" alt=\"\" title=\"Stick Out Tongue\" smilieid=\"5\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2034-jaytee","name":"JayTee","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2034_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"1805"}]},"thankedby":[]},{"date":"2015-05-17T06:17:42-07:00","id":516979,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JayTee</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/411718-inspirational-art-exalted-3e-edition?p=516677#post516677\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Solar (Zenith), Solar (Night), mortal, Solar (Twilight), Solar (Dawn), Solar (Twilight), Solar (Eclipse), and Solar (Eclipse).<br /> <br /> <img src=\"https://forum.theonyxpath.com/core/images/smilies/tongue.png\" border=\"0\" alt=\"\" title=\"Stick Out Tongue\" smilieid=\"5\" class=\"inlineimg\" /></div> </div> </div> </div>Really? I always thought of Flutterhul-I mean Fluttershy to be a Zenith type, with a focus on survival ability/charms and Integrity. *shrug*","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1401-rungok","name":"rungok","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1401_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"141"}]},"thankedby":[]},{"date":"2015-05-17T06:48:27-07:00","id":516986,"title":"","content":"I actually don't watch the show at all, but enough of the websites I'm on have been saturated with such an excessive degree of pony nonsense that I feel can make informed decisions like this through <i>sheer second hand knowledge.</i>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2034-jaytee","name":"JayTee","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2034_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"1805"}]},"thankedby":[]},{"date":"2015-05-17T07:15:48-07:00","id":516997,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>JayTee</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/411718-inspirational-art-exalted-3e-edition?p=516986#post516986\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I actually don't watch the show at all, but enough of the websites I'm on have been saturated with such an excessive degree of pony nonsense that I feel can make informed decisions like this through <i>sheer second hand knowledge.</i></div> </div> </div> </div>Yeah that's me too. All I know about MLP is that I always think Princess Celestia or whoever seems like the coolest of the lot, she always has the raddest style in pony to human art or whatever","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/117-solar","name":"Solar","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar117_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1267"}]},"thankedby":[]},{"date":"2015-05-17T07:19:26-07:00","id":516998,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>rungok</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/411718-inspirational-art-exalted-3e-edition?p=516979#post516979\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Really? I always thought of Flutterhul-I mean Fluttershy to be a Zenith type, with a focus on survival ability/charms and Integrity. *shrug*</div> </div> </div> </div>Agreed, although based on that pic, I'd go with Wood Aspect. And Pinkie strikes me more as a Chosen of Serenity, as well.<br /> <br /> And JayTee, the girl with <i>green flames</i> bursting from her eyes and hands strikes you as...Solar? Isn't there another splat that fits that much better?<img src=\"https://forum.theonyxpath.com/core/images/smilies/tongue.png\" border=\"0\" alt=\"\" title=\"Stick Out Tongue\" smilieid=\"5\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/681-hand-of-omega","name":"Hand-of-Omega","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar681_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2747"}]},"thankedby":[]},{"date":"2015-05-17T07:27:55-07:00","id":517002,"title":"","content":"For me, the narrative role of the character has just as much consideration as their personal aesthetics. This is why, for example, I consider Captain America to be either a Dawn or a Zenith depending on if the story takes place during WW2 or in modern times.<br /> <br /> I don't know too much about green fire girl, but I know she's a magician and that 90% of all fictional characters fall within the Solar archetype spectrum, so I made an educated guess and declared her a Twilight.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2034-jaytee","name":"JayTee","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2034_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"1805"}]},"thankedby":[]},{"date":"2015-05-18T00:50:25-07:00","id":517754,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Solar</strong> </div> <div class=\"message\">I always think Princess Celestia or whoever seems like the coolest of the lot, she always has the raddest style in pony to human art or whatever</div> </div> </div> </div> That actually reminds me of a picture I outright think of as inspiration for the Lover Clad in the Raiment of Tears: <img src=\"http://th05.deviantart.net/fs70/PRE/i/2013/063/8/e/celestia_by_uzukinokaze-d5wxx8n.jpg\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/>","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#00ffff\">I have approximate knowledge of many things.</span><br /> <a href=\"https://forum.rpg.net/index.php?threads/wip-xenoblade-chronicles-the-sword-can-see-the-future.835575/\" target=\"_blank\">Write up as I play Xenoblade Chronicles.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/158-isator-levi","name":"Isator Levi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar158_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"17901"}]},"thankedby":[]},{"date":"2015-05-18T07:20:47-07:00","id":517962,"title":"","content":"Pony Steals the Spotlight: Activated!<img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /><br /> <br /> I was always rather fond of this image as being that of a First Age Solar Queen:<br /> <img src=\"https://th04.deviantart.net/fs70/PRE/f/2011/040/8/0/mlp_celestia_human_version_by_kreoss-d396orv.jpg\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/><br /> <br /> And her Lunar Mate?<img src=\"https://mlpforums.com/uploads/monthly_09_2014/post-27099-0-35269800-1409721773.jpeg\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/681-hand-of-omega","name":"Hand-of-Omega","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar681_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2747"}]},"thankedby":[]},{"date":"2015-05-18T10:30:36-07:00","id":518285,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Hand-of-Omega</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/411718-inspirational-art-exalted-3e-edition?p=516385#post516385\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> Those are pretty cool, but I confess to still liking <a href=\"http://didj.deviantart.com/art/My-Little-Mages-Complete-287590233\" target=\"_blank\">My Little Mages</a> better! (this was the only version I could find that was this embiggenable! And it looks like the artist did some more since the last time I saw this...Lord Tirek is pretty sweet!)</div> </div> </div> </div>I personally prefer the non-anthropomorphised versions<br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display !