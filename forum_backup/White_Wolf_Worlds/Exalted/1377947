in: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> I believe Ragara was in Second Edition. Oh wait maybe that was Mnemon?</div></div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#b22222\"><b>.</b></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3742-iceblade44","name":"Iceblade44","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"707"}]},"thankedby":[]},{"date":"2020-04-15T07:01:39-07:00","id":1381637,"title":"","content":"Ragara hasn't been statted up before, no.<br /> <br /> He was never a sorcerer, I guess to contrast him with Mnemon and his mother.<br />","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2020-04-15T08:09:20-07:00","id":1381647,"title":"","content":"I wonder if Beckon back the lost and other Numen Eclipse charms need to be used in the forest or can be used anywhere.","signature":"<hr class=\"b-divider\"/><br/>The Book of Laughing Serpents Series(Latest <a href=\"https://www.storytellersvault.com/product/293793/Book-of-Laughing-Serpents-Volume-7\" target=\"_blank\">Here</a>)<br /> <a href=\"https://www.storytellersvault.com/product/287741/Many-Limbed-Manual?src=hottest_filtered&amp;filters=45622\" target=\"_blank\">Many Limbed Manual</a><br /> Patreon here: <a href=\"https://patreon.com/undeadauthorsociety\" target=\"_blank\">https://patreon.com/undeadauthorsociety</a><br /> San Jeanro Co-Op writer. Volume 1 <a href=\"https://www.drivethrurpg.com/product/278871/The-Short-Games-Digest-Volume-1\" target=\"_blank\">here</a> Volume 2 <a href=\"https://t.co/SXRLElZlw4?amp=1\" target=\"_blank\">here</a> Volume 3 <a href=\"https://www.drivethrurpg.com/product/297692/The-Short-Games-Digest-Volume-3?affiliate_id=389642\" target=\"_blank\">here</a><br /> My folklore and horror blog, here:<a href=\"http://undeadauthorsociety.wordpres.com/\" target=\"_blank\">http://undeadauthorsociety.com</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11835-epee102","name":"Epee102","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11835_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"2102"}]},"thankedby":[]},{"date":"2020-04-15T08:13:08-07:00","id":1381648,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Epee102</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381647#post1381647\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I wonder if Beckon back the lost and other Numen Eclipse charms need to be used in the forest or can be used anywhere.</div> </div> </div> </div>Beckon says in must be in the forest so I guess yeah, others probably not. Since Numens are player options, they probably don't want to limit them that much","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#b22222\"><b>.</b></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3742-iceblade44","name":"Iceblade44","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"707"}]},"thankedby":[]},{"date":"2020-04-15T09:02:26-07:00","id":1381658,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Epee102</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381647#post1381647\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I wonder if Beckon back the lost and other Numen Eclipse charms need to be used in the forest or can be used anywhere.</div> </div> </div> </div>While Beckon Back the Lost is limited to those who've died within the forest, you don't have to be in the forest to use it.","signature":"<hr class=\"b-divider\"/><br/>Developer for Exalted<br /> <br /> Want to write for Exalted? Look at the <a href=\"http://theonyxpath.com/submission-guidelines/\" target=\"_blank\">freelancer submission guidelines.</a><br /> <br /> <a href=\"https://www.patreon.com/user?u=451515\" target=\"_blank\">Robert Vance's Patreon</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/527-robert-vance","name":"Robert Vance","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar527_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10044"}]},"thankedby":[]},{"date":"2020-04-15T09:28:12-07:00","id":1381666,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Iceblade44</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381648#post1381648\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Beckon says in must be in the forest so I guess yeah, others probably not. Since Numens are player options, they probably don't want to limit them that much</div> </div> </div> </div>You I believe misunderstand my intent, as an eclipse caste looking to plunder the secrets of the occult for my own power. But limiting it to corpses that died in the woods does limit it fairly well.","signature":"<hr class=\"b-divider\"/><br/>The Book of Laughing Serpents Series(Latest <a href=\"https://www.storytellersvault.com/product/293793/Book-of-Laughing-Serpents-Volume-7\" target=\"_blank\">Here</a>)<br /> <a href=\"https://www.storytellersvault.com/product/287741/Many-Limbed-Manual?src=hottest_filtered&amp;filters=45622\" target=\"_blank\">Many Limbed Manual</a><br /> Patreon here: <a href=\"https://patreon.com/undeadauthorsociety\" target=\"_blank\">https://patreon.com/undeadauthorsociety</a><br /> San Jeanro Co-Op writer. Volume 1 <a href=\"https://www.drivethrurpg.com/product/278871/The-Short-Games-Digest-Volume-1\" target=\"_blank\">here</a> Volume 2 <a href=\"https://t.co/SXRLElZlw4?amp=1\" target=\"_blank\">here</a> Volume 3 <a href=\"https://www.drivethrurpg.com/product/297692/The-Short-Games-Digest-Volume-3?affiliate_id=389642\" target=\"_blank\">here</a><br /> My folklore and horror blog, here:<a href=\"http://undeadauthorsociety.wordpres.com/\" target=\"_blank\">http://undeadauthorsociety.com</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11835-epee102","name":"Epee102","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11835_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"2102"}]},"thankedby":[]},{"date":"2020-04-15T09:34:53-07:00","id":1381667,"title":"","content":"Great job on Hundred-Devil Masquerade and Majestic Nightmare Visage, Vance! The two link together beautifully. Exactly what I was looking for!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1092-tribute-of-a-dark-heart","name":"Tribute of a Dark Heart","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1092_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"42"}]},"thankedby":[]},{"date":"2020-04-15T10:04:26-07:00","id":1381676,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Tribute of a Dark Heart</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381667#post1381667\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Great job on Hundred-Devil Masquerade and Majestic Nightmare Visage, Vance! The two link together beautifully. Exactly what I was looking for!</div> </div> </div> </div>Yay! ^___^","signature":"<hr class=\"b-divider\"/><br/>Developer for Exalted<br /> <br /> Want to write for Exalted? Look at the <a href=\"http://theonyxpath.com/submission-guidelines/\" target=\"_blank\">freelancer submission guidelines.</a><br /> <br /> <a href=\"https://www.patreon.com/user?u=451515\" target=\"_blank\">Robert Vance's Patreon</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/527-robert-vance","name":"Robert Vance","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar527_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10044"}]},"thankedby":[]},{"date":"2020-04-15T10:07:46-07:00","id":1381680,"title":"","content":"thumbsup.gif<br />","signature":"<hr class=\"b-divider\"/><br/>He/him","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/177-thecountalucard","name":"TheCountAlucard","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar177_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10857"}]},"thankedby":[]},{"date":"2020-04-15T10:15:19-07:00","id":1381685,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Moss Reynholm</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381623#post1381623\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">QC discussion below, now spoilered:<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> Have Ragara and V'Neef ever been statted up before? Feels a big moment if not. Always had Ragara as a sorceror in my head, but quite like that he isn't.<br /> <br /> Also, Deled seems to have been softened a little from the complete and utter psychopath of yore. White Reaper user now too... </div></div> </div> </div></div> </div> </div> </div>Ragara is not like I expected and I'm delighted by this development. Too many NPC write-ups feel like they're extrapolated entirely from what we already knew or would logically assume about the character and the end result is something that my group considers a waste of space. Thankfully, I don't think that really applies to any of these.","signature":"<hr class=\"b-divider\"/><br/><b><a href=\"https://swordofcreation.net/\" target=\"_blank\">Sword of Creation</a> a hub for Exalted related content</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/7-lioness","name":"Lioness","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7_2.png","title":"Moderator","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"5443"}]},"thankedby":[]},{"date":"2020-04-15T11:10:23-07:00","id":1381707,"title":"","content":"Some random comments / questions on various minor details:<br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"><br /> <br /> <b>Empyrean Aegis</b>: Does anyone want to figure out the optimal build to defend someone who's defending you with this shield so it's impossible to effectively attack either of you?<br /> <br /> <b>Majestic Nightmare Visage</b>: I guess the implication is that most people believe there's this famous fey called &quot;Midnight's Childe&quot; that got up to all these adventures, not a series of DBs? Otherwise disguising yourself as Midnight's Childe would not be so effective. I wonder what people think of Midnight's Childe - I don't think the writeup really says, although I only skimmed it briefly. <br /> <br /> <b>White Lizard's Tongue</b>: Exalted cowboy, sweet.<br /> <br /> &quot;<i>the aurochs-dragon of Hellbender Mesa</i>&quot;: There's dragon-animal hybrids? Maybe mentioned before but I didn't notice it. Cool! I guess they could be a dragon that herds aurochs but that seems a little silly.<br /> <br /> <br /> <b>Blazerider</b>: It's very Exalted that the first, Essence 1 evocation of this thing sees you jumping off your flying motorcycle thingy, sending it careening at your foe, hitting them with it, then falling down onto it as it returns to you. I feel like that would be the most dramatic action seen in the movie it occurred in.<br /> <br /> <b>Conquering Tide</b>: It's cool that they have another first age warship. I was surprised that it seems to have a definite location (currently in Peleps hands), which most of the most powerful artifacts don't, to allow for more ST/player freedom I guess. <br /> <br /> &quot;<i>The verdicts passed on the wicked by Conquering Tide\u2019s captain are as divine writ, a law beyond even those of Heaven and Hell</i>.&quot; I don't think this is intended to be taken literally but if you do it sort of implies that Shinmas are real.<br /> <br /> <b>Fivefold Dragons\u2019 Grasp</b>: Has there been an artifact before that is basically only usable by one Exalt type? Probably, I guess.<br /> <br /> <b>Ragara</b>: If you're immortal, isn't someone asking to be named as your heir very suspicious? Especially if one of the strategies they take to achieve this a campaign of assassinations against all other possible heirs?<br /> <br /> <b>Saloy Hin</b>: When he's ordered home, he calls that a naked power grab, then immediately starts grabbing power for himself? Seems like a bit of a hypocrite. <br /> <br /> &quot;<i>As Western routes progressed from being accessible only through rare feats of Dragon-Blooded naval prowess to being open to regular mortal mercantile traffic, House Peleps \u2014 now fully invested in the Imperial Navy \u2014 established footholds there</i>. &quot; - What change over time is this in reference to?<br /> <br /> </div></div> </div> </div>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/25834-habitableexoplanet","name":"habitableexoplanet","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2019"},{"key":"Posts:","value":"296"}]},"thankedby":[]},{"date":"2020-04-15T11:33:25-07:00","id":1381716,"title":"","content":"I'm slightly disappointed that Tepet Arada doesn't have Divine Wind Approach.<br /> <br /> Part of the original idea for that Charm was &quot;something like Tepet Arada would use.&quot; &gt;_&gt;<br /> <br /> (But then, he's only Essence 4 now, which was quite a surprise.)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11237-jefepato","name":"Jefepato","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11237_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2016"},{"key":"Posts:","value":"557"}]},"thankedby":[]},{"date":"2020-04-15T11:39:23-07:00","id":1381718,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>habitableexoplanet</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381707#post1381707\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">&quot;<i>the aurochs-dragon of Hellbender Mesa</i>&quot;: There's dragon-animal hybrids?</div> </div> </div> </div>Bear in mind that adding -dragon to an animal's name in Creation doesn't necessarily mean they're a hybrid between an animal and a powerful elemental. -dragon is used as an adjective to mean &quot;really huge and tough, and probably ferocious&quot; quite often. See the ox-dragon and river dragon in the Ex 3e core book for examples. Since there's already an ox-dragon in Creation, I'd personally guess that an <i>aurochs</i>-dragon was probably a related creature, but a more desert-adapted one than the ox-dragon. The ox-dragon is a <a href=\"https://en.wikipedia.org/wiki/Triceratops\" target=\"_blank\">triceratops</a>, so I'd base the aurochs-dragon on another <a href=\"https://en.wikipedia.org/wiki/Ceratopsidae\" target=\"_blank\">ceratopsid</a>, maybe <a href=\"https://en.wikipedia.org/wiki/Diabloceratops\" target=\"_blank\">diabloceratops</a>.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>habitableexoplanet</strong> </div> <div class=\"message\"><b>Fivefold Dragons\u2019 Grasp</b>: Has there been an artifact before that is basically only usable by one Exalt type? Probably, I guess.</div> </div> </div> </div>There are several artifacts in the core book and Arms of the Chosen have Solar charms as prereqs for some or all of their evocations. But the devs have generally said that those aren't exclusively for use by Solars, just that other Exalt types who picked them up would unlock different evocations based on other charms from their charmset. Likewise, I would think that if a Solar or someone got Fivefold Dragons' Grasp, she'd be able to develop evocations for it that built on her own stuff. Note that even the basic attunement bonus refers to boosting &quot;elemental spells&quot; as well as Elemental Bolt Attack, and a Solar, Lunar, etc. sorcerer could certainly cast those and thus use that bit as-is.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>habitableexoplanet</strong> </div> <div class=\"message\"><b>Ragara</b>: If you're immortal, isn't someone asking to be named as your heir very suspicious?</div> </div> </div> </div>I don't know if the Scarlet Empress has ever <i>claimed</i> to be immortal. I mean, she's obviously much more long-lived than any Dragon-blood in the 2nd Age, but I don't think she's out-and-out told anyone &quot;Oh, BTW, I can't actually die&quot;. Claiming to be actively immortal would probably have political consequences for her (people are going to ask &quot;how do you <i>get</i> immortality?&quot;, and if she doesn't answer, at least some of them are going to speculate that the method is unsavory), and as long as she doesn't openly claim it, she can't really object to people asking her to clarify the succession.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>habitableexoplanet</strong> </div> <div class=\"message\">&quot;<i>As Western routes progressed from being accessible only through rare feats of Dragon-Blooded naval prowess to being open to regular mortal mercantile traffic, House Peleps \u2014 now fully invested in the Imperial Navy \u2014 established footholds there</i>. &quot; - What change over time is this in reference to?</div> </div> </div> </div>It's referenced in a bit more detail in the Fajad writeup in The Realm - apparently, the route to the West via Wu Jian didn't open up until less than a century ago. Why it was that Wu Jian wasn't accessible before then is unknown, though.","signature":"<hr class=\"b-divider\"/><br/>Interested in chatting with other Exalted fans online? Join us on the <a href=\"https://discord.gg/kGsyF5jhdy\" target=\"_blank\">Exalted Discord server</a>!","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1533-kelly-pedersen","name":"Kelly Pedersen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1533_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"929"}]},"thankedby":[]},{"date":"2020-04-15T12:35:18-07:00","id":1381737,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lioness</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381685#post1381685\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Ragara is not like I expected and I'm delighted by this development. Too many NPC write-ups feel like they're extrapolated entirely from what we already knew or would logically assume about the character and the end result is something that my group considers a waste of space. Thankfully, I don't think that really applies to any of these.</div> </div> </div> </div>Yeah, I found this gave some depth to his current motivations and actions and how he'd changed as a person. Quite a nuanced character.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2020-04-15T12:38:56-07:00","id":1381740,"title":"","content":"On the heir and immortality thing, note that at the time Ragara was wanting to try and get that postion named, the Empress wasn't apparnetly going to live as long as she ended up going. Ragara even ahd the strategy of &quot;I'll just outlive you then&quot; and well, that didn't work as expected. There's a lot of implications that until a while in, folks thought she'd eventually have to pick a successor sooner or later.","signature":"<hr class=\"b-divider\"/><br/>And stuff.<br /> <sub><a href=\"https://blaqueandstuff.deviantart.com/\" target=\"_blank\">My DeviantArt Page</a> // <a href=\"http://blaqueandstuff.tumblr.com/\" target=\"_blank\">My tumblr</a> // <a href=\"http://www.dropbox.com/sh/trxegr5hl27s1l5/AAAegBBzxbDhvk1YpYJqdhz8a?dl=0\" target=\"_blank\">Exalted 3e Houserules</a></sub>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/353-blaque","name":"Blaque","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar353_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2976"}]},"thankedby":[]},{"date":"2020-04-15T13:26:27-07:00","id":1381754,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Kelly Pedersen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381718#post1381718\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Bear in mind that adding -dragon to an animal's name in Creation doesn't necessarily mean they're a hybrid between an animal and a powerful elemental. -dragon is used as an adjective to mean &quot;really huge and tough, and probably ferocious&quot; quite often. See the ox-dragon and river dragon in the Ex 3e core book for examples. Since there's already an ox-dragon in Creation, I'd personally guess that an <i>aurochs</i>-dragon was probably a related creature, but a more desert-adapted one than the ox-dragon. The ox-dragon is a <a href=\"https://en.wikipedia.org/wiki/Triceratops\" target=\"_blank\">triceratops</a>, so I'd base the aurochs-dragon on another <a href=\"https://en.wikipedia.org/wiki/Ceratopsidae\" target=\"_blank\">ceratopsid</a>, maybe <a href=\"https://en.wikipedia.org/wiki/Diabloceratops\" target=\"_blank\">diabloceratops</a>.</div> </div> </div> </div>Something more-or-less like this <i>was</i> going to be my reply, but since you made it the other way, I'm gonna play Devil's Advocate for a second and point out that Neomah, Fair Folk, and sorcerous workings allow for some <i>strange</i> singular hybrids to be created - perhaps a sorcerer of an experimental bent decided to grow in a vat some strange fusion of tyrant lizard and aurochs?","signature":"<hr class=\"b-divider\"/><br/>He/him","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/177-thecountalucard","name":"TheCountAlucard","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar177_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10857"}]},"thankedby":[]},{"date":"2020-04-15T16:26:58-07:00","id":1381794,"title":"","content":"It's cool to see my custom charm being used on a character as big and important as Ragara.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://swordofcreation.net/\" target=\"_blank\">https://swordofcreation.net/</a> : A secondary forum focusing on archiving homebrew, both mechanical and fluff, and receiving critique on it.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/108-flare","name":"Flare","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar108_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"492"}]},"thankedby":[]},{"date":"2020-04-15T16:44:48-07:00","id":1381799,"title":"","content":"Oh what was your charm?","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#b22222\"><b>.</b></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3742-iceblade44","name":"Iceblade44","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"707"}]},"thankedby":[]},{"date":"2020-04-15T18:03:03-07:00","id":1381829,"title":"","content":"Noticed Ragara seems to have pools in excess of 11.<br /> Is that an oversight or is this how they're going to make QCs badass enough so that combat orientated PCs aren't by far the strongest people in the world?","signature":"<hr class=\"b-divider\"/><br/><b><a href=\"https://swordofcreation.net/\" target=\"_blank\">Sword of Creation</a> a hub for Exalted related content</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/7-lioness","name":"Lioness","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7_2.png","title":"Moderator","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"5443"}]},"thankedby":[]},{"date":"2020-04-15T18:30:05-07:00","id":1381839,"title":"","content":"Are you talking about his action pools? Since at his combat dicepools only one goes over 10","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#b22222\"><b>.</b></span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3742-iceblade44","name":"Iceblade44","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"707"}]},"thankedby":[]},{"date":"2020-04-15T19:25:21-07:00","id":1381846,"title":"","content":"The pool for Blood Zenith should be capping at 14 dice for Melee 5/Dexterity 5 +1 specialty and +3 accuracy from a Medium artifact weapon.<br /> I think its an oversight since its Overwhelming 4 consistent with Short Daiklaves yet he has a parry of 7.","signature":"<hr class=\"b-divider\"/><br/><b><a href=\"https://swordofcreation.net/\" target=\"_blank\">Sword of Creation</a> a hub for Exalted related content</b>","edited":{"userid":7,"user_link":"https://forum.theonyxpath.com/member/7-lioness","user":"Lioness","date":". 04-15-2020, 10:28 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/7-lioness","name":"Lioness","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7_2.png","title":"Moderator","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"5443"}]},"thankedby":[]},{"date":"2020-04-15T19:48:52-07:00","id":1381848,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lioness</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381846#post1381846\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The pool for Blood Zenith should be capping at 14 dice for Melee 5/Dexterity 5 +1 specialty and +3 accuracy from a Medium artifact weapon.<br /> I think its an oversight since its Overwhelming 4 consistent with Short Daiklaves yet he has a parry of 7.</div> </div> </div> </div>I mean, it's a QC/NPC, not a Player Character.<br /> They don't have to play by the same rules.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/8011-imadaman","name":"imadaman","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar8011_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2015"},{"key":"Posts:","value":"58"}]},"thankedby":[]},{"date":"2020-04-16T02:34:15-07:00","id":1381876,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lioness</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381829#post1381829\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Noticed Ragara seems to have pools in excess of 11.<br /> Is that an oversight or is this how they're going to make QCs badass enough so that combat orientated PCs aren't by far the strongest people in the world?</div> </div> </div> </div>The high-essence Lunars have a few dice pools at 12 base.<br /> <br /> Though maybe he should have Overwhelming 5? Maybe they forgot Balanced?<br /> <br /> <br /> I'll be honest though, Blood Zenith really feels like it should be soulsteel. Or at least a mix of jade and soulsteel.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":2402,"user_link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","user":"The Wizard of Oz","date":". 04-16-2020, 05:38 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2020-04-16T02:41:34-07:00","id":1381879,"title":"","content":"On Wu-Jian, since it's so tiny and in the middle of nowhere, I wondered if it was simply only discovered a century ago.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2020-04-16T07:13:21-07:00","id":1381914,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Wizard of Oz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381876#post1381876\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> The high-essence Lunars have a few dice pools at 12 base.<br /> <br /> Though maybe he should have Overwhelming 5? Maybe they forgot Balanced</div> </div> </div> </div>It looks like the attack profile of a light artifact weapon (i.e. not a Reaper Daiklave), which would explain the 16 dice pool and low overwhelming.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>imadaman</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381848#post1381848\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I mean, it's a QC/NPC, not a Player Character.<br /> They don't have to play by the same rules.</div> </div> </div> </div>No they don't, I'm just trying to understand the nature of the departure from normal rules and if that's intentional.","signature":"<hr class=\"b-divider\"/><br/><b><a href=\"https://swordofcreation.net/\" target=\"_blank\">Sword of Creation</a> a hub for Exalted related content</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/7-lioness","name":"Lioness","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7_2.png","title":"Moderator","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"5443"}]},"thankedby":[]},{"date":"2020-04-16T09:28:43-07:00","id":1381935,"title":"","content":"16 dice is a lot to hit, true.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2020-04-16T09:48:40-07:00","id":1381937,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lioness</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381914#post1381914\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> No they don't, I'm just trying to understand the nature of the departure from normal rules and if that's intentional.</div> </div> </div> </div>I was surprised he is as much of a physical badass as statted, but then I realised the idea of him being decrepit is more of a meme than anything really stated in 3e, e.g. his depiction in WFHW:<br /> <br /> <i>Ragara is an old man, sustained beyond his years by his daiklave Blood Zenith, as it feeds him the last stolen dregs of a Solar Anathema\u2019s soul. Even so, his days are running out.</i><br /> <br /> My jumping to conclusions head canon pretty much had him at full <a href=\"https://www.amc.com/shows/breaking-bad/cast-crew/hector-salamanca\" target=\"_blank\">Hector Salamanca</a>. That said, he is 230 years older than Mnemon and yet is still throwing more dice at attacks than either Berit or Cainan.<br /> <br /> In his prime he must have been <i>terrifying</i>.","signature":"","edited":{"userid":24647,"user_link":"https://forum.theonyxpath.com/member/24647-moss-reynholm","user":"Moss Reynholm","date":". 04-16-2020, 12:58 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24647-moss-reynholm","name":"Moss Reynholm","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24647_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2018"},{"key":"Posts:","value":"223"}]},"thankedby":[]},{"date":"2020-04-16T12:13:08-07:00","id":1381958,"title":"","content":"I like Peleps Najah and Cathak Setod. They seem like the kind of Wyld Hunt that could potentially be turned to helping Solars or Lunars (or at least not hunting a particular group of Solars or Lunars) under the right circumstances. And, even if they do continue hunting someone, they have enough nuance to them that it will make for interesting conflicts.","signature":"<hr class=\"b-divider\"/><br/>....","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/226-brilliantrain","name":"BrilliantRain","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar226_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"3718"}]},"thankedby":[]},{"date":"2020-04-16T12:19:11-07:00","id":1381959,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lioness</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381829#post1381829\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Noticed Ragara seems to have pools in excess of 11.<br /> Is that an oversight or is this how they're going to make QCs badass enough so that combat orientated PCs aren't by far the strongest people in the world?</div> </div> </div> </div>The 16 dice to attack is definitely an error.","signature":"<hr class=\"b-divider\"/><br/>Developer for Exalted<br /> <br /> Want to write for Exalted? Look at the <a href=\"http://theonyxpath.com/submission-guidelines/\" target=\"_blank\">freelancer submission guidelines.</a><br /> <br /> <a href=\"https://www.patreon.com/user?u=451515\" target=\"_blank\">Robert Vance's Patreon</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/527-robert-vance","name":"Robert Vance","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar527_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10044"}]},"thankedby":[]},{"date":"2020-04-16T12:35:19-07:00","id":1381960,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Iceblade44</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381799#post1381799\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Oh what was your charm?</div> </div> </div> </div>Spilling the Mountain's Blood.<br /> <br /> I like this version of Ragara, but I admit the decrepit Ragara had some useful ideas in it to. The way I see it, there's two distinct storylines here with Ragara, and you can play either of them, even like this, and I think that flexiblity is important.<br /> <br /> A non-physically decrepit Ragara might still appear tiny and weak; he may still be in a wheelchair, he may slouch or walk with a cane. But that state isn't coming from a deteriorating physical body but rather a poor mental state. In effect, he's old, he's under the Great Curse. He's just Achilles, skulking in his tent rather then fighting; and his block is entirely mental. This kind of Ragara just needs to decide to get up and become active, and what might have seemed like an old, withered man reveals he's actually quite buff, and he stands up strong and takes up his Daiklave and you realize 'oh fuck he's about to kick my ass'.<br /> <br /> A Physically busted Ragara with Blood Zenith might still be scheming, might be plotting, but is utterly locked into his own body and unable to do anything. In this case, he could be portrayed like Mumm-ra. A busted old mummy unable to physically encounter the Heroes, until one of his grandchildren finds a Solar or Lunar, grabs the useless old man's hand with the Daiklave in it and forcibly rams it through the Exalt's chest. And you watch him drain their life force to empower his own, and now you have a Prime Dragonblooded with hundreds of years of experience, directly descended from the Empress, ready to break someone's face.<br />","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://swordofcreation.net/\" target=\"_blank\">https://swordofcreation.net/</a> : A secondary forum focusing on archiving homebrew, both mechanical and fluff, and receiving critique on it.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/108-flare","name":"Flare","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar108_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"492"}]},"thankedby":[]},{"date":"2020-04-16T13:44:22-07:00","id":1381971,"title":"","content":"Depicted <a href=\"https://www.youtube.com/watch?v=bBJ8HOHRLtY\" target=\"_blank\">here</a>, two young mortal Dynasts who's dabbling in necromancy went too far, until Ragara fights his way into their house with nothing but his party clothes, a broken table leg, and his mitts.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/1121-drlovemonkey","name":"DrLoveMonkey","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1121_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"4736"}]},"thankedby":[]},{"date":"2020-04-16T14:54:21-07:00","id":1381988,"title":"","content":"Do we know Ragara\u2019s marital history? Did he Mary an adopted Patrician or something in order for his kids to be in his house?","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2020-04-16T15:06:31-07:00","id":1381992,"title":"","content":"As he was given his own house, it probably didn't matter who he married. Judging from other examples, he was probably married with kids already and then they were all declared part of his house.<br /> <br /> In fact, considering how old he is, it was probably at a time when Dynasts were a minority and most Dragonblood were remnants of Shogunate gens. In which case declaring her son, his wife, their kids, and the wife's entire Gens to now be a Dynastic House under the leadership of her son would be a good way for the Empress to bind a Gens into her new order via a &quot;reward&quot; while stripping them of political legitimacy beyond that order. Making them reliant on power given to them by the Empress, not power they'd earned. Mix in a few patrician families and outcastes to dilute the Gens.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2020-04-16T15:10:14-07:00","id":1381994,"title":"","content":"I've forgotten the details now, but I think there was an old fallen House or Gens that got rolled into V'neef? I liked that.<br /> (Any L5R fans? Thinking of the Mantis who were made of 3 minor clans, so had their own interesting and varied traditions. I could see interesting V'neef scions whose parents are from different Patrician families, strange foreign cultures before joining the Legions, etc, etc. Like maybe your mum is a shaman from the Desert of Iron Ghosts and taught you their secret ferromantic sorcery, while your dad and aunts/uncles are from a Patrician house that guards an entrance to the Mountain Folk kingdom. Etc.)<br /> <br /> I also wonder if V'neef has more inter-House marriages than most as part of its House Formation.","signature":"<hr class=\"b-divider\"/><br/>STing Bronze Age Exalted","edited":{"userid":2402,"user_link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","user":"The Wizard of Oz","date":". 04-16-2020, 06:18 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2402-the-wizard-of-oz","name":"The Wizard of Oz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2402_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"10350"}]},"thankedby":[]},{"date":"2020-04-16T15:23:41-07:00","id":1381997,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>glamourweaver</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381988#post1381988\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Do we know Ragara\u2019s marital history? Did he Mary an adopted Patrician or something in order for his kids to be in his house?</div> </div> </div> </div>Ragara exposed the trechery of House Jerah and what was left of them was folded into his House.<br />","signature":"<hr class=\"b-divider\"/><br/><b><a href=\"https://swordofcreation.net/\" target=\"_blank\">Sword of Creation</a> a hub for Exalted related content</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/7-lioness","name":"Lioness","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7_2.png","title":"Moderator","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2013"},{"key":"Posts:","value":"5443"}]},"thankedby":[]},{"date":"2020-04-16T16:29:36-07:00","id":1382009,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lioness</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381829#post1381829\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Noticed Ragara seems to have pools in excess of 11.<br /> Is that an oversight or is this how they're going to make QCs badass enough so that combat orientated PCs aren't by far the strongest people in the world?</div> </div> </div> </div>I realize Vance said this was a mistake, but QC dicepools are addressed in the Core, page 495. QC pools go upto 14 by default, with the specific caveat &quot;In order to settle on a dice pool for a QC, consult the table below and pick a number that looks right. Don\u2019t worry too much about precise bonuses from things like weapons and specialties\u2014if the QC is using good equipment or is specialized for a task, just feel free to nudge him toward the upper end of a given dice pool range. They\u2019re Quick Characters, not Precise Characters.&quot;","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/899114-the-official-exalted-forum-introduction-thread?p=899399#post899399\" target=\"_blank\">Hi, I'm JohnDoe244</a>. My posts represent my opinions, not facts.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/531-johndoe244","name":"JohnDoe244","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar531_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2958"}]},"thankedby":[]},{"date":"2020-04-16T17:37:02-07:00","id":1382018,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Wizard of Oz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381994#post1381994\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I've forgotten the details now, but I think there was an old fallen House or Gens that got rolled into V'neef?</div> </div> </div> </div>I cannot any mention this time around. In third edition : V'Neef Herself is but six decades old, married to the slightly older Tepet Igan, and she has a handful of blood children. Most of the house scions are patricians and outcastes adopted when the Great House was founded but fourteen years prior.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Wizard of Oz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381994#post1381994\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">(Any L5R fans? Thinking of the Mantis who were made of 3 minor clans, so had their own interesting and varied traditions. I could see interesting V'neef scions whose parents are from different Patrician families, strange foreign cultures before joining the Legions, etc, etc. Like maybe your mum is a shaman from the Desert of Iron Ghosts and taught you their secret ferromantic sorcery, while your dad and aunts/uncles are from a Patrician house that guards an entrance to the Mountain Folk kingdom. Etc.)</div> </div> </div> </div>Indeed. House V'Neef should be quite the interesting mix<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Wizard of Oz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381994#post1381994\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I also wonder if V'neef has more inter-House marriages than most as part of its House Formation.</div> </div> </div> </div>Well, the hundreds of adoptees are <i>legally</i> siblings.","signature":"","edited":{"userid":487,"user_link":"https://forum.theonyxpath.com/member/487-greyman","user":"Greyman","date":". 04-16-2020, 08:51 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/487-greyman","name":"Greyman","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar487_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1308"}]},"thankedby":[]},{"date":"2020-04-16T19:25:06-07:00","id":1382034,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Wizard of Oz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381994#post1381994\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I've forgotten the details now, but I think there was an old fallen House or Gens that got rolled into V'neef? I liked that.</div> </div> </div> </div>In the backstory for the Dragon-Dancer's Wings, it mentions House Jurul, which was stricken from the Imperial ledgers because of its founder's treachery. Some of the formerly-Jurul families ended up as House Ledaal, and at least some of the remainder ended up among the patricians adopted into House V'neef.<br /> <br /> I don't know if that's what you were thinking of. Given that V'neef adopted a variety of outcastes and patricians, there could very well be remnants of more than one important fallen family in the mix.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11237-jefepato","name":"Jefepato","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11237_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2016"},{"key":"Posts:","value":"557"}]},"thankedby":[]},{"date":"2020-04-16T19:53:44-07:00","id":1382042,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lioness</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1381997#post1381997\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Ragara exposed the trechery of House Jerah and what was left of them was folded into his House.</div> </div> </div> </div>That is literally House Ledaal\u2019s origin story.","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":1098,"user_link":"https://forum.theonyxpath.com/member/1098-glamourweaver","user":"glamourweaver","date":". 04-16-2020, 10:57 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2020-04-16T20:01:09-07:00","id":1382043,"title":"","content":"Error, delete","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2020-04-16T20:24:30-07:00","id":1382047,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Jefepato</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1377947-heirs-to-the-shogunate-backers-preview-just-dropped?p=1382034#post1382034\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> In the backstory for the Dragon-Dancer's Wings, it mentions House Jurul, which was stricken from the Imperial ledgers because of its founder's treachery. Some of the formerly-Jurul families ended up as House Ledaal, and at least some of the remainder ended up among the patricians adopted into House V'neef.<br /> <br /> I don't know if that's what you were thinking of. Given that V'neef adopted a variety of outcastes and patricians, there could very well be remnants of more than one important fallen family in the mix.</div> </div> </div> </div>I came up with that for the wings\u2019 background tying them now to V\u2019neef.<br /> <br /> My thinking is that after everyone actually implicated in Jurul\u2019s conspiracy had been executed or fled, and Jurul Ledaal\u2019s household was elevated to House Ledaal, those fellow Jurul whose loyalty was beyond question and willing to swear to Ledaal\u2019s Shadow Crusade were adopted into her new House. Those households that weren\u2019t implicated in treason but for whatever reason didn\u2019t reach Ledaal\u2019s standards were demoted to Patrician houses when Jurul was striken (I\u2019m sure there was a small rush to adopt newly Patrician DBs into their fathers\u2019 or spouses\u2019 Houses, but the mortal ex-Dynasts were shit out of luck.)<br /> <br /> One of those DB-producing Patrician lines was one of the founding adopted families of House V\u2019neef centuries later.","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":1098,"user_link":"https://forum.theonyxpath.com/member/1098-glamourweaver","user":"glamourweaver","date":". 04-17-2020, 03:49 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2020-04-16T20:32:37-07:00","id":1382049,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--g