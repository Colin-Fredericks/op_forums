=\"_blank\">http://undeadauthorsociety.com</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11835-epee102","name":"Epee102","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11835_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"2102"}]},"thankedby":[]},{"date":"2019-04-05T07:37:21-07:00","id":1302819,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Rand Brittain</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/exalted/1302570-the-thousand-sanctioned-beasts-elementals-redux?p=1302623#post1302623\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> They're castle-sized. They can really be as big as the castle bees want to spend time making them, and they tend to expand over time, but once they hit &amp;quot;way bigger than we could ever need even if all our human neighbors move in (oh please do)&amp;quot;, they usually start to focus on their homemade jam instead.</div> </div> </div> </div>Ooh, thanks!<br /> <br /> <br /> I'm going to be running a catch-up solo session with a player tonight in a massive haunted manor featuring an Ashcap hearth keeper and a Cobblethrone butler. Looking forward to posting about it this weekend.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://exalted-golden-shackles-iron-crowns.obsidianportal.com\" target=\"_blank\">https://exalted-golden-shackles-iron...dianportal.com</a> Visit Golden Shackles, Iron Crowns; a 3rd Edition Exalted Campaign ongoing since 2014","edited":{"userid":0,"user_link":"","user":"","date":""},"