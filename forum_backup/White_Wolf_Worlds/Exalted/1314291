not facts.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/531-johndoe244","name":"JohnDoe244","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar531_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2958"}]},"thankedby":[]},{"date":"2019-05-26T14:41:56-07:00","id":1314598,"title":"","content":"Here\u2019s my completely unhelpful advice:<br /> Lean heavily on Evocations, you can justify all sorts of useful melee competency charms by dint of it being Your Sword.and an artifact can easily have as many charms as a whole ability.<br /> <br /> Concerned about losing your sword? Even better.<br /> Be a sorcerer with Wood Dragon Claw as your control spell. First evocation In is Permanent, and makes the claw manifest as a sword.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1247-maseiken","name":"Maseiken","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1247_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"170"}]},"thankedby":[]}]}