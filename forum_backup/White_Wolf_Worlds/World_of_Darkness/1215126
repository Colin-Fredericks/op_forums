0/6/0/4/5/avatar27083_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2021"},{"key":"Posts:","value":"85"}]},"thankedby":[]},{"date":"2021-10-03T09:37:33-07:00","id":1462560,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>TrueMrMultiverse</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/changeling-the-dreaming/1215126-the-jongleur-a-new-kith?p=1462531#post1462531\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The Jongleur Kith and its Thaillan counterpart are pretty neat.</div> </div> </div> </div>Thank you!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/857-astromancer","name":"Astromancer","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar857_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2195"}]},"thankedby":[]},{"date":"2021-10-03T09:48:26-07:00","id":1462563,"title":"","content":"<b>Stereotypes</b><br /> <br /> \u200bMister Aton pronounces on the worth of others.<br /> <br /> <b>On Boggans</b><br /> <br /> Their compassion is a disgusting random element. Still, ply them for their gossip. They have so much news. News that let's you use others.<br /> <br /> <br /> <b>On Cluricauns</b><br /> <br /> This scum are mere chaos. Mine you, they can be used to inflict chaos on competitors.<br /> <br /> <b>On Eshu</b><br /> <br /> <span style=\"font-family:Helvetica\">\u200bYou can.t control them. Get rid of them.</span><br /> <br /> <b>On Nockers</b><br /> <br /> <span style=\"font-family:Helvetica\">They are useful, remember that. And when they aren't useful, let them know it.</span><br /> <br /> <b>On Piskies</b><br /> <br /> <span style=\"font-family:Helvetica\">\u200bWhy bother?</span><br /> <br /> <b>On Pookas</b><br /> <br /> <span style=\"font-family:Helvetica\">People trust them. That makes it easier for you to hurt people through them.</span><br /> <br /> <b>On Redcaps</b><br /> <br /> <span style=\"font-family:Helvetica\">\u200bThey make good enforcers. Use their hungers to control them.</span><br /> <br /> <span style=\"font-family:Helvetica\">\u200b</span><b>On Satyrs</b><br /> <br /> <span style=\"font-family:Helvetica\">Their passions always foul up your plans. But their lusts give you a way to control and punish them. </span><br /> <br /> <b>On Selkies</b><br /> <br /> <span style=\"font-family:Helvetica\">Unimportant. </span><br /> <br /> <b>On Arcadian Sidhe</b><br /> <br /> <span style=\"font-family:Helvetica\">\u200bTheir greed for power and glory, and their blindness to the feelings and needs of others, makes them amusing puppets. They are so much fun to degrade. </span><br /> <br /> <b>On Autumn Sidhe</b><br /> <br /> <span style=\"font-family:Helvetica\">These are less fun than their cousins. Sometimes they can actually be <b>NOBLE!!</b></span><br /> <br /> <span style=\"font-family:Helvetica\">\u200b</span><b>On Sluagh</b><br /> <br /> <span style=\"font-family:Helvetica\">\u200bThey know too much.</span><br /> <br /> <b>On Trolls</b><br /> <br /> <span style=\"font-family:Helvetica\">\u200bOnce they are Oathbound, they are your slaves. </span><br /> <br /> \u200b","signature":"","edited":{"userid":857,"user_link":"https://forum.theonyxpath.com/member/857-astromancer","user":"Astromancer","date":". 10-04-2021, 07:28 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/857-astromancer","name":"Astromancer","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar857_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2195"}]},"thankedby":[]},{"date":"2021-10-03T20:53:26-07:00","id":1462609,"title":"","content":"The Director stereotypes are interesting. Their mocking attitude to other Kiths is very much in character.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/27083-truemrmultiverse","name":"TrueMrMultiverse","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar27083_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2021"},{"key":"Posts:","value":"85"}]},"thankedby":[]},{"date":"2021-10-04T16:25:14-07:00","id":1462730,"title":"","content":"The Stereotypes up all up!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/857-astromancer","name":"Astromancer","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar857_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2195"}]},"thankedby":[]},{"date":"2026-04-24T18:59:42-07:00","id":1559611,"title":"","content":"Is there something that the Jongleur or the Director needs?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/857-astromancer","name":"Astromancer","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar857_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2195"}]},"thankedby":[]}]}