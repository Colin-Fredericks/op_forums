xpath.com/core/avatars/0/0/6/0/4/5/avatar12085_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2016"},{"key":"Posts:","value":"313"}]},"thankedby":[]},{"date":"2018-03-04T02:29:33-08:00","id":1191581,"title":"","content":"I have another question, but relative in this post, Onix Path gonna write another book after Beckkets Jihad Diary and Legacy of Lies, or that was the last books before V5","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/13083-yeisson-d-velandia","name":"Yeisson D. Velandia","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar13083_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2017"},{"key":"Posts:","value":"20"}]},"thankedby":[]},{"date":"2018-03-04T07:00:13-08:00","id":1191609,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Yeisson D. Velandia</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/1190880-where-can-i-find-a-list-of-books?p=1191581#post1191581\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I have another question, but relative in this post, Onix Path gonna write another book after Beckkets Jihad Diary and Legacy of Lies, or that was the last books before V5</div> </div> </div> </div>In terms of VtM material, there doesn't appear to be anything in the pipe but there are other WoD books in development. Though it's also worth noting that OPP isn't actually doing V5. New White Wolf is doing it so we really don't know what's happening with OPP and the WoD going forward at 