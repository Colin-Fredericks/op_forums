125q90/829/8seg.png\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3506-uniform-two-six","name":"Uniform Two Six","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3506_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2014"},{"key":"Posts:","value":"455"}]},"thankedby":[]},{"date":"2016-09-21T18:41:31-07:00","id":974167,"title":"","content":"Hmmmn wonder how much explaining to do someone who gets caught by the authoritys would have to do, or would they just be laughed at as a kook.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://imagizer.imageshack.us/a/img829/1897/8seg.png\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imagizer.imageshack.us/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imageshack.com/i/2iw20supportergarou125p\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imageshack.com/i/0j5hz8j\" border=\"0\" alt=\"\" /></a><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/i/idnSdTJkj\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://i.imgsafe.org/97fd805379.png\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1153-prince-of-the-night","name":"Prince of the Night","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"4205"}]},"thankedby":[]},{"date":"2016-09-21T18:45:22-07:00","id":974171,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Prince of the Night</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/974046-how-to-justify-enemys-not-having-silver-weaponry?p=974157#post974157\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">On SAD something else ive wondered about, ideas on how to incorporate them into a mixed hunters group<br /> <br /> I see two possibletys<br /> <br /> the SAD , Reluctantly sees that desperate times breed desperate measures.<br /> <br /> or he's infiltrating a group of civilian hunters, to see how competent or dangerous they are.</div> </div> </div> </div> Hunter had a supplement (I think it was &quot;First Contact&quot; or something like that) that touched on exactly this issue. An SAD team led by a Special Agent Dhurvasula, while investigating a vampire thing in Texas, runs across what is left of a team of Hunters and figure out that they're something new (and terms them as &quot;Type-9 entities&quot; if memory serves). The FBI begins investigating them and their activities, and comes to the conclusion that (while further study is needed), their tendency to go bug-nuts means that the SAD can't afford the potential political and legal complications of pal-ing up with them, and elects to keep them at arm's length.<br />","signature":"<hr class=\"b-divider\"/><br/><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imagizer.imageshack.us/v2/125x125q90/19/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imagizer.imageshack.us/v2/125x125q90/546/wpur.jpg\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imagizer.imageshack.us/v2/125x125q90/545/7z8m.jpg\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imagizer.imageshack.us/v2/125x125q90/829/8seg.png\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3506-uniform-two-six","name":"Uniform Two Six","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3506_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2014"},{"key":"Posts:","value":"455"}]},"thankedby":[]},{"date":"2016-09-21T18:47:47-07:00","id":974173,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Prince of the Night</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/974046-how-to-justify-enemys-not-having-silver-weaponry?p=974167#post974167\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hmmmn wonder how much explaining to do someone who gets caught by the authoritys would have to do, or would they just be laughed at as a kook.</div> </div> </div> </div>Well, that is hard to say. Silver bullets wouldn't be illegal so I don't know if police necessarily would ask questions about it. It does seem rather odd though and would be particularly noteworthy if silver bullets are found at crime scene. If a hunter routinely uses silver bullets then it is very likely that it would not be convenient to retrieve every fired bullet - which means that bullets would be all over the place - walls, the ground, bodies, etc. If the police find silver bullets at a crime scene then they certainly will be asking some very hard questions if they catch anybody with a gun loaded with silver bullets.<br /> <br /> Another thing to consider is that a silver bullet, because of how much harder silver is than lead, might make a good armor piercing round. Police wouldn't take to kindly to finding somebody who has, to their way of thinking, armor piercing bullets.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1129-sergeant-brother","name":"Sergeant Brother","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1129_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2016-09-21T20:16:30-07:00","id":974202,"title":"","content":"As mentioned before, look at the Patricia Briggs article. Silver is going to have similar performance to steel against organic targets (and probably most forms of ballistic armor), so they are going to be armor piercing. Of course, if someone actually set up a workshop to make quality silver bullets, they could provide armor piercing rounds without violating federal law, since they are technically not considered to be military grade weapons.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/11683-aya-tari","name":"Aya Tari","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11683_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2016"},{"key":"Posts:","value":"5986"}]},"thankedby":[]},{"date":"2016-09-21T21:28:38-07:00","id":974222,"title":"","content":"I find having bad guys or hunters using silver is a good way to encourage PCs to really enforce the Veil. Once werewolf activity is known, then there are people who will prepare and go out after them (to a reasonable degree). More ignorant foes may believe silver is always effective (and pay for that price), but some factions knows that while it is generally useful that there are exceptions.<br /> <br /> When the PCs know that even a goon bad guy can do unsoakable aggravated damage, it makes them far less likely to do stupid things or resort to violence first. It also encourages other solutions to problems, and the use of other forms than crinos.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/3046-black-fox","name":"Black Fox","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3046_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"4187"}]},"thankedby":[]},{"date":"2016-09-22T04:58:21-07:00","id":974337,"title":"","content":"One reason to have most enemys NOT Having silver, is, everyone, lets face it, wants to go on a power trip every now and then, Like read the Short Story &quot;the Lost&quot; in &quot;Rites of Renown<br /> <br /> it also lets the power of Regeneration, actualy carry its own weight.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://imagizer.imageshack.us/a/img829/1897/8seg.png\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imagizer.imageshack.us/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imageshack.com/i/2iw20supportergarou125p\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imageshack.com/i/0j5hz8j\" border=\"0\" alt=\"\" /></a><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/i/idnSdTJkj\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://i.imgsafe.org/97fd805379.png\" border=\"0\" alt=\"\" />","edited":{"userid":1153,"user_link":"https://forum.theonyxpath.com/member/1153-prince-of-the-night","user":"Prince of the Night","date":". 09-22-2016, 08:09 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1153-prince-of-the-night","name":"Prince of the Night","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"4205"}]},"thankedby":[]},{"date":"2016-09-22T05:49:38-07:00","id":974353,"title":"","content":"And it is honestly a realistic position. Werewolves are rare and, thanks, to the Delirium, have a self-reinforcing Masquerade. One of the primart reasons for the Veil though is not protect Garou, it protects Human Kinfolk and Wolf Kinfolk from the enemies of the Garou. It is much easier to kill Kinfolk than it is to kill Garou.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11683-aya-tari","name":"Aya Tari","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11683_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2016"},{"key":"Posts:","value":"5986"}]},"thankedby":[]},{"date":"2016-09-22T09:35:11-07:00","id":974468,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Uniform Two Six</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/974046-how-to-justify-enemys-not-having-silver-weaponry?p=974171#post974171\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hunter had a supplement (I think it was &quot;First Contact&quot; or something like that) that touched on exactly this issue. An SAD team led by a Special Agent Dhurvasula, while investigating a vampire thing in Texas, runs across what is left of a team of Hunters and figure out that they're something new (and terms them as &quot;Type-9 entities&quot; if memory serves). The FBI begins investigating them and their activities, and comes to the conclusion that (while further study is needed), their tendency to go bug-nuts means that the SAD can't afford the potential political and legal complications of pal-ing up with them, and elects to keep them at arm's length.</div> </div> </div> </div><br /> was asking for a ST whos running a Hunters Hunted II game and wants a way to rationalize people from different groups working together.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://imagizer.imageshack.us/a/img829/1897/8seg.png\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imagizer.imageshack.us/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imageshack.com/i/2iw20supportergarou125p\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imageshack.com/i/0j5hz8j\" border=\"0\" alt=\"\" /></a><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/i/idnSdTJkj\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://i.imgsafe.org/97fd805379.png\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1153-prince-of-the-night","name":"Prince of the Night","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"4205"}]},"thankedby":[]},{"date":"2016-09-22T11:02:14-07:00","id":974538,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Prince of the Night</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/974046-how-to-justify-enemys-not-having-silver-weaponry?p=974468#post974468\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> was asking for a ST whos running a Hunters Hunted II game and wants a way to rationalize people from different groups working together.</div> </div> </div> </div>\u200bThat's always easy. Group A and Group B are in the dark and scary forest looking for the werewolf that both groups think has been eating people, only to find out the hard way that a werewolf is generally not a solitary monster and that dark scary forest is full of them. While running for their lives, they bump into each other and need each other to survive the night. Necessity is the mother of invention.","signature":"<hr class=\"b-divider\"/><br/><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imagizer.imageshack.us/v2/125x125q90/19/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imagizer.imageshack.us/v2/125x125q90/546/wpur.jpg\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imagizer.imageshack.us/v2/125x125q90/545/7z8m.jpg\" border=\"0\" alt=\"\" /><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"https://imagizer.imageshack.us/v2/125x125q90/829/8seg.png\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}