rdless of what form's traits your mixing with your current form.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/617-heavy-arms","name":"Heavy Arms","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar617_2.jpeg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"12634"}]},"thankedby":[]}]}