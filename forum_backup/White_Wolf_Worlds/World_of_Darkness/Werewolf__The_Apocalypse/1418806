 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">I confess my ending was kind of hilarious where it turns out that my plan for a peaceful resolution was constantly sabotaged by my own team.<br /> <br /> And they are so PISSED that it still works.<br /> <br /> &quot;Peace with humans is impossible! It won't last!&quot;<br /> <br /> *cries*<br /> <br /> &quot;Why are you so mean! I just want to slaughter people!&quot;<br /> </div></div> </div> </div></div> </div> </div> </div><div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">NGL, its the 'peace with humans is impossible' aspect of W5 that I'm most worried about. Because for all the crap garou talk bad about them in WtA, they sure do lean strongly on them/their clothes/their mentalities. Plus most are homid anyway, so they aren't even that far from understanding them. Stuff like the Second Impegrium just seem so out of place for modern garou.</div></div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://ana-mizuki.deviantart.com/\" target=\"_blank\">My gallery.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/110-ana-mizuki","name":"Ana Mizuki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar110_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2484"}]},"thankedby":[]},{"date":"2020-10-21T05:45:07-07:00","id":1419359,"title":"","content":"Apparently, there's an Achievement for becoming a Get of Fenris so they're NOT just the baddies in this.<br /> <br /> <a href=\"https://twitter.com/PChelchowski/status/1318862852887904258\" target=\"_blank\">https://twitter.com/PChelchowski/sta...62852887904258</a><br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px r