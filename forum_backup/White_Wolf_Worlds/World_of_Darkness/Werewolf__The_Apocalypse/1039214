 were made so you could join a Werewolf pack or any sort of Fera group combined group.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/754-eldagusto","name":"Eldagusto","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar754_2.gif","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"6435"}]},"thankedby":[]}]}