xt&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2021-11-05T00:20:43-07:00","id":1466750,"title":"","content":"Mack looks like Silent Strider and he's bio isn;t revelaed or I missed something.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1784-werewolf43","name":"werewolf43","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1784_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"315"}]},"thankedby":[]},{"date":"2021-11-05T15:48:15-07:00","id":1466825,"title":"","content":"<span style=\"font-size:14px\"><span style=\"font-family:times new roman\">CRIMSON THAW is a very different comic from WINTER'S TEETH and has the kind of black comedy I love from my World of Darkness games. Its like Seattle by Night vs. LA by Night. The entire war between the vampires and the Lupines is because it turns out Calder Wendt (World's Worst Tremere) bought a wedding venue then erected a bunch of Wards against Lupines. The Garou interpreted it as an occult attack against them since it was their catering business/caern. I mean, that's not a joke. That is the actual plot and I love it.</span></span> <div align=\"left\"><br /> <span style=\"font-size:14px\"><span style=\"font-family:times new roman\"><span style=\"color:#1D1C1D\">Crimson Thaw's section on werewolves has some interesting bits. Reya, the obviously Native American member, is listed a being of the Ghost Council tribe. Do you suppose this replaced the controversial Wendigo name or Unites both native tribes?</span></span></span></div> <br /> <span style=\"font-size:14px\"><span style=\"font-family:times new roman\"><span style=\"color:#1D1C1D\">Steph, whose portrait shows her wolf form so I'm guessing is lupus, doesn't have a tribe listed. She does have something redacted after her name, but that's not where a tribe would be. Her text makes her sound like a red talon. Maybe they're getting rebranded because of how the tribe's reputation was blackened?</span></span></span>","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 11-05-2021, 07:24 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2021-11-05T17:35:16-07:00","id":1466840,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1466825#post1466825\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><span style=\"font-size:14px\"><span style=\"font-family:times new roman\"><span style=\"color:#1D1C1D\">Steph, whose portrait shows her wolf form so I'm guessing is lupus, doesn't have a tribe listed. She does have something redacted after her name, but that's not where a tribe would be. Her text makes her sound like a red talon. Maybe they're getting rebranded because of how the tribe's reputation was blackened?</span></span></span></div> </div> </div> </div>Even given their hatred of humans, it'd be hard for Red Talons to be further in the hole than the Get of Fenris, who nonetheless still managed to make a comeback from being saddled with the Swords of Heimdall.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]},{"date":"2021-11-05T22:40:21-07:00","id":1466901,"title":"","content":"<i>deleted message</i>","signature":"<hr class=\"b-divider\"/><br/>Author of <a href=\"https://www.storytellersvault.com/product/448972/Hearthbound-Tribe-Supplement?affiliate_id=4046720\" target=\"_blank\">Hearthbound</a> and Project Director for <a href=\"https://www.tumblr.com/songoftrillium/729204622290550784/likes-dont-increase-visibility-to-others-please\" target=\"_blank\">Werewolf: the Essentials</a>","edited":{"userid":27167,"user_link":"https://forum.theonyxpath.com/member/27167-mundusartis","user":"mundusartis","date":".  making a thread instead 11-06-2021, 01:50 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/27167-mundusartis","name":"mundusartis","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar27167_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2021"},{"key":"Posts:","value":"89"}]},"thankedby":[]},{"date":"2021-11-08T18:17:59-08:00","id":1467211,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1466825#post1466825\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><span style=\"font-size:14px\"><span style=\"font-family:times new roman\">CRIMSON THAW is a very different comic from WINTER'S TEETH and has the kind of black comedy I love from my World of Darkness games. Its like Seattle by Night vs. LA by Night. The entire war between the vampires and the Lupines is because it turns out Calder Wendt (World's Worst Tremere) bought a wedding venue then erected a bunch of Wards against Lupines. The Garou interpreted it as an occult attack against them since it was their catering business/caern. I mean, that's not a joke. That is the actual plot and I love it.</span></span></div> </div> </div> </div> <div align=\"left\"><br /> <br /> I didn't read Winter's Teeth, maybe that's why I found Crimson Thaw #1 a little meh, but Crimson Thaw #2 was much better. And, yes, I too liked the plot!<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1466825#post1466825\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><span style=\"font-size:14px\"><span style=\"font-family:times new roman\"><span style=\"color:#1D1C1D\">Crimson Thaw's section on werewolves has some interesting bits. Reya, the obviously Native American member, is listed a being of the Ghost Council tribe. Do you suppose this replaced the controversial Wendigo name or Unites both native tribes?</span></span></span></div> </div> </div> </div></div> <br /> <br /> There was a multitribal camp open to Uktena and Wendigo called Ghost Dance, really cool. I won't like if they simply change one Tribe's name, but I think it can be interesting if they go with this camp's idea and say the two tribes merged into the Ghost Council Tribe.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1466825#post1466825\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><span style=\"font-size:14px\"><span style=\"font-family:times new roman\"><span style=\"color:#1D1C1D\">Steph, whose portrait shows her wolf form so I'm guessing is lupus, doesn't have a tribe listed. She does have something redacted after her name, but that's not where a tribe would be. Her text makes her sound like a red talon. Maybe they're getting rebranded because of how the tribe's reputation was blackened?</span></span></span></div> </div> </div> </div>I think the redacted word is &quot;Wendigo&quot;. The text certainly could describe a Wendigo Ahroun. But, yes, I'd say she and Mack are Lupus.<br /> <br /> I believe the second Tribe to left the Nation (along with the Stargazers) are the Red Talons. They may even have denounced the Concolation that ended the Impergium and started hunting humans again, and that's why we now have only 11 Tribes.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-09T10:10:03-08:00","id":1467265,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Wolfen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467211#post1467211\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"> [LEFT]<br /> <br /> I believe the second Tribe to left the Nation (along with the Stargazers) are the Red Talons. They may even have denounced the Concolation that ended the Impergium and started hunting humans again, and that's why we now have only 11 Tribes.</div> </div> </div> </div>On one hand, that would be completely ridiculous, because the Talons themselves have harped on how there's no chance that they can do the Impergium again, and humanity practically is doing it against them instead.<br /> <br /> But then, this is W5, and well, we've seen what the proposed changes are, with the Avatar Storm suddenly affecting Garou and other such nonsense, so maybe.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]},{"date":"2021-11-09T20:58:46-08:00","id":1467323,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Saur Ops Specialist</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467265#post1467265\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">On one hand, that would be completely ridiculous, because the Talons themselves have harped on how there's no chance that they can do the Impergium again, and humanity practically is doing it against them instead.<br /> <br /> But then, this is W5, and well, we've seen what the proposed changes are, with the Avatar Storm suddenly affecting Garou and other such nonsense, so maybe.</div> </div> </div> </div>An all out war would be ridiculous indeed. Suicidal. But a guerrilla war is another thing. And, as you pointed out, they're nearly wiped out anyway, so why not die standing?<br /> <br /> But this is just speculation, from all we know the defecting tribe could even be the Children of Gaia...","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-10T22:14:51-08:00","id":1467413,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Wolfen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467323#post1467323\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> An all out war would be ridiculous indeed. Suicidal. But a guerrilla war is another thing. And, as you pointed out, they're nearly wiped out anyway, so why not die standing?<br /> <br /> But this is just speculation, from all we know the defecting tribe could even be the Children of Gaia...</div> </div> </div> </div>When someone says &quot;The Impergium&quot; it means the opposite of a shadowy guerilla war. It means open and naked displays of force. That's what the Impergium was. That's why the Delirium exists. Stealthy resistance is basically the anti-Impergium.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]},{"date":"2021-11-11T04:40:41-08:00","id":1467427,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Saur Ops Specialist</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467413#post1467413\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">When someone says &quot;The Impergium&quot; it means the opposite of a shadowy guerilla war. It means open and naked displays of force. That's what the Impergium was. That's why the Delirium exists. Stealthy resistance is basically the anti-Impergium.</div> </div> </div> </div>The Impergium was the culling of humans so they were kept on a manageable population. Thousands of years ago it was done by naked displays of force and that created the Delirium, but in the current days this culling can only be done with a stealthy hunt of humans.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-11T05:21:32-08:00","id":1467431,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Saur Ops Specialist</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467413#post1467413\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">When someone says &quot;The Impergium&quot; it means the opposite of a shadowy guerilla war. It means open and naked displays of force. That's what the Impergium was. That's why the Delirium exists. Stealthy resistance is basically the anti-Impergium.</div> </div> </div> </div>I think this is splitting hairs over technicalities.<br /> <br /> The issue isn't if you call it Impergium or want a new name for the new take, it isn't about overt vs covert. It is about systematic culling of human population based solely on keeping the numbers manageable, regardless of the specific people being killed.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2021-11-11T06:05:59-08:00","id":1467437,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467431#post1467431\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The issue isn't if you call it Impergium or want a new name for the new take, it isn't about overt vs covert. It is about systematic culling of human population based solely on keeping the numbers manageable, regardless of the specific people being killed.</div> </div> </div> </div>Exactly!!! Different method, but still the same objective: get rid of those pesky humans...","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-11T07:14:29-08:00","id":1467441,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467431#post1467431\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I think this is splitting hairs over technicalities.<br /> <br /> The issue isn't if you call it Impergium or want a new name for the new take, it isn't about overt vs covert. It is about systematic culling of human population based solely on keeping the numbers manageable, regardless of the specific people being killed.</div> </div> </div> </div>You don't have systematic culling without a system, and you don't have a system if you're not in control.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]},{"date":"2021-11-11T07:59:59-08:00","id":1467446,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Saur Ops Specialist</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467441#post1467441\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">You don't have systematic culling without a system, and you don't have a system if you're not in control.</div> </div> </div> </div>That's definitely not true. Control isn't what defines a system.<br /> <br /> You have a system in the moment you define it enough to act upon it. If you don't have the power to achieve your goals with it is another problem.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2021-11-11T09:50:32-08:00","id":1467453,"title":"","content":"If Red Talons have decided to full on start the Impegrium, they will do it as openly as they can. First of all, they never agreed to some tenets of the Litany. Second, they consider skulking around while humans destroy Gaia extremely demeaning.<br /> <br /> They are not a subtle tribe, if they have decided to just go for it, then they will fight and kill humans until the last of them are gone. Fuck the Veil and other tribes.<br />","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://ana-mizuki.deviantart.com/\" target=\"_blank\">My gallery.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/110-ana-mizuki","name":"Ana Mizuki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar110_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2484"}]},"thankedby":[]},{"date":"2021-11-11T10:13:34-08:00","id":1467454,"title":"","content":"Imagine if some crazy ass Garou simply came up with the plan that a new Impergium (not looking at any Red Talon...) should be brought alongside the Apocalypse. Like &quot;if this shite is coming/has come, than we shall bring it&quot;, and they help cause all the environmental destructions, wars and hell on earth type of things so that humanity is destroyed by the systems they themselves created or put themselves into. After all, when humanity falls, Gaia will get stronger again, like any place (even cities) where humans dwelt but have forsaken. Of course, radical doesn't begin to describe this, and flirts hard with Spiral Dancer territory. <br /> <br /> Other thing... have Garou or Werewolf material mentioned about the situation in nuclear disaster areas where no humans live any longer? Like, best I know is the places where nuclear bombs felt are tainted as hell spiritually, but I can't remember about radiation exclusion zones. <br /> <br /> I think an interesting point the new edition should bring (as the older editions did) is what the Garou should be fighting against, and who/what they are fighting for. Are they fighting for humans, spirits, the world? What is Gaia? How can she be helped? All these questions may have already been answered, but, there never is one true response. Which also makes me think Werewolf could take on nasty topics that the Garou might dwell given their belligerent existence such as war economy, soldier's and merc's life, war crimes (to not mention the specifics).","signature":"<hr class=\"b-divider\"/><br/><i>Strange... When coincidence seems too convenient, I prefer to call it fate.</i><br /> <br /> <b><sup>-Blood Omen: Legacy of Kain</sup> </b>d=","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/25534-banu_saulot","name":"Banu_Saulot","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25534_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2019"},{"key":"Posts:","value":"335"}]},"thankedby":[]},{"date":"2021-11-11T12:52:15-08:00","id":1467463,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Banu_Saulot</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467454#post1467454\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Other thing... have Garou or Werewolf material mentioned about the situation in nuclear disaster areas where no humans live any longer?</div> </div> </div> </div>That's a complicated matter because reality straight up contradicted what the canon lore says.<br /> <br /> I don't hold this against the authors. What happened was that we lacked a lot of information on radiation's effects on ecosystems at the time, and the game went with the common assumptions between environmentalists, up to and including the ones working in research.<br /> <br /> Fortunately the result is that almost all our predictions were based on the effects of radiation on humans, but during the following decades we found out that we are actually the most susceptible species to radiation sickness, by a large margin. First we found out that scorpions and cockroaches would survive the nuclear war. Now we know that we're basically going to die alone.<br /> <br /> Not that nuclear disasters don't have a negative environmental effect, of course they do. But the actual result seriously contradicts assumptions in the game.<br /> <br /> But it would be interesting to see this New Impergium Movement working to end humanity with the weapons the Garou most feared before.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2021-11-11T14:41:31-08:00","id":1467479,"title":"","content":"The whole concept of Red Talons doing stealthy cunning of humanity makes no bloody sense. The uptick in death rates would be picked up by somebody, even if they were causing it with natural disasters. There are people who will react to this crap, including the Garou themselves. The moment the cat is out of the bag, their plan comes to a screeching halt.<br /> <br /> That's specifically why if they do go down this route they go all in - which was gloriously demonstrated in Apocalypse.<br />","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2021-11-11T15:06:57-08:00","id":1467485,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467479#post1467479\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The whole concept of Red Talons doing stealthy cunning of humanity makes no bloody sense. The uptick in death rates would be picked up by somebody, even if they were causing it with natural disasters. There are people who will react to this crap, including the Garou themselves. The moment the cat is out of the bag, their plan comes to a screeching halt.<br /> <br /> That's specifically why if they do go down this route they go all in - which was gloriously demonstrated in Apocalypse.</div> </div> </div> </div>Honestly, I wouldn't be surprised if the Red Talons let alone the Garou Nation as a whole are aware this is suicidal. They might in fact be of the mind it's better to die on all fours than on their back.<br />","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2021-11-11T15:13:38-08:00","id":1467486,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467463#post1467463\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">That's a complicated matter because reality straight up contradicted what the canon lore says.<br /> <br /> I don't hold this against the authors. What happened was that we lacked a lot of information on radiation's effects on ecosystems at the time, and the game went with the common assumptions between environmentalists, up to and including the ones working in research.<br /> <br /> Fortunately the result is that almost all our predictions were based on the effects of radiation on humans, but during the following decades we found out that we are actually the most susceptible species to radiation sickness, by a large margin. First we found out that scorpions and cockroaches would survive the nuclear war. Now we know that we're basically going to die alone.<br /> <br /> Not that nuclear disasters don't have a negative environmental effect, of course they do. But the actual result seriously contradicts assumptions in the game.<br /> <br /> But it would be interesting to see this New Impergium Movement working to end humanity with the weapons the Garou most feared before.</div> </div> </div> </div>Yeah, basically the presence of modern human societies is more disruptive than high environmental radioactivity.<br /> <br /> For most mammals they will still develop cancers due to prolonged exposures but the overwhelming majority will reproduce and die of other causes well before it becomes an issue. We just live too long and think we have value to the universe other than perpetuating the species, other animals are not so burdened.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/479-damian-may","name":"Damian May","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar479_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1199"}]},"thankedby":[]},{"date":"2021-11-11T17:06:34-08:00","id":1467498,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467485#post1467485\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Honestly, I wouldn't be surprised if the Red Talons let alone the Garou Nation as a whole are aware this is suicidal. They might in fact be of the mind it's better to die on all fours than on their back.</div> </div> </div> </div>So your logic is, they would skulk around doing small scale murder rather then go out in a glorious make it or break it movement that will be the last song of the Wolf?<br />","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2021-11-11T18:58:44-08:00","id":1467508,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467498#post1467498\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> So your logic is, they would skulk around doing small scale murder rather then go out in a glorious make it or break it movement that will be the last song of the Wolf?</div> </div> </div> </div>I'm assuming they're still killing huge numbers of humans. Its just going to lead to a war with humanity and Garou eventually.<br />","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2021-11-11T20:10:19-08:00","id":1467515,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467479#post1467479\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">That's specifically why if they do go down this route they go all in - which was gloriously demonstrated in Apocalypse.</div> </div> </div> </div>That's certainly true. But we're talking about a Tribe that not just parted ways but probably became antagonistic to the entire Nation. Of course, this <b>is </b>only speculation as we are speculating about who did this, but if they decide to go with the Talons it may very well be that they go down that hard.<br /> <br /> What would be short but awesome and I don't believe they'll do. It can also only be protracted and badly written, which is where my bet is regardless. It may also be that they don't go down that road, but then the defection don't make sense for <b>anyone</b>.<br /> <br /> It's pretty much like the A Tribe Falls all over again. Actually, it probably <b>is</b> A Tribe Falls adjusted for a continued setting. Whatever tribe they choose, that scenario is our best guess to how it will work, just with less Wyrm on it. And just as that scenario, actually any tribe fit the bill and no sensible guess can be made to which one. None of them actually make sense.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Damian May</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467486#post1467486\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">For most mammals they will still develop cancers due to prolonged exposures but the overwhelming majority will reproduce and die of other causes well before it becomes an issue. We just live too long and think we have value to the universe other than perpetuating the species, other animals are not so burdened.</div> </div> </div> </div>That would still be pretty bad. No, it is far more than that.<br /> <br /> Our likelihood of developing cancer upon radiation exposure is higher than other mammals. Our likelihood of birth defects, of developing sterility, and a host of other things radiation causes. Our likelihood of developing mutations is higher, <b>and</b> the likelihood of those mutations being life threatening is also higher. And it builds up, one effect over the other.<br /> <br /> It has zero to do with fearing death or living too much. No, it is that our actual bodies are uniquely susceptible to radiation sickness, biologically speaking. We are <b><u>orders of magnitude</u></b> weaker to radiation than most other mammals, and mammals do have the short straw in the matter. Some fare worse and are only 5 or 6 times more resistant to radiation's effects than us.<br /> <br /> Although, to be fair, the <i>possibility</i> of some other animal being in an even worse situation against radiation as we are exists, no such animal was yet discovered.<br /> <br /> Chernobyl as an example, while the radiation does increase the frequency of mutations and cancer, for most of its wildlife the increase was sensible (IIRC some have 5 or 6 times more mutations than normal), but not enough to cause perceptive impact in the species' population as it simply doesn't surpass more pressing matters. That in areas where a human being is almost certainly doomed to a painful death in a couple years if we stay a whole afternoon.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2021-11-11T21:22:17-08:00","id":1467522,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467508#post1467508\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I'm assuming they're still killing huge numbers of humans. Its just going to lead to a war with humanity and Garou eventually.</div> </div> </div> </div>So, the &quot;release all the methane clathrate offshore from the coasts all at once, collapsing vast amounts of coastline via undersea landslides&quot; plan from Apocalypse, then.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]},{"date":"2021-11-12T01:14:19-08:00","id":1467529,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467515#post1467515\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> That would still be pretty bad. No, it is far more than that.<br /> <br /> Our likelihood of developing cancer upon radiation exposure is higher than other mammals. Our likelihood of birth defects, of developing sterility, and a host of other things radiation causes. Our likelihood of developing mutations is higher, <b>and</b> the likelihood of those mutations being life threatening is also higher. And it builds up, one effect over the other.<br /> <br /> It has zero to do with fearing death or living too much. No, it is that our actual bodies are uniquely susceptible to radiation sickness, biologically speaking. We are <b><u>orders of magnitude</u></b> weaker to radiation than most other mammals, and mammals do have the short straw in the matter. Some fare worse and are only 5 or 6 times more resistant to radiation's effects than us.<br /> <br /> Although, to be fair, the <i>possibility</i> of some other animal being in an even worse situation against radiation as we are exists, no such animal was yet discovered.<br /> <br /> Chernobyl as an example, while the radiation does increase the frequency of mutations and cancer, for most of its wildlife the increase was sensible (IIRC some have 5 or 6 times more mutations than normal), but not enough to cause perceptive impact in the species' population as it simply doesn't surpass more pressing matters. That in areas where a human being is almost certainly doomed to a painful death in a couple years if we stay a whole afternoon.</div> </div> </div> </div>Ah, fair enough. I must be out of date. I thought I'd read, probably a decade or so ago now, that it was mainly due to our long lifespan giving more time for issues to develop. Thanks for the update.<br /> <br /> Is that just hominids or is it across most primates?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/479-damian-may","name":"Damian May","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar479_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1199"}]},"thankedby":[]},{"date":"2021-11-12T01:41:22-08:00","id":1467530,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467515#post1467515\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">What would be short but awesome and I don't believe they'll do. It can also only be protracted and badly written, which is where my bet is regardless. It may also be that they don't go down that road, but then the defection don't make sense for <b>anyone</b>.<br /> <br /> It's pretty much like the A Tribe Falls all over again. Actually, it probably <b>is</b> A Tribe Falls adjusted for a continued setting. Whatever tribe they choose, that scenario is our best guess to how it will work, just with less Wyrm on it. And just as that scenario, actually any tribe fit the bill and no sensible guess can be made to which one. None of them actually make sense.</div> </div> </div> </div>It's funny really that they're trying to follow up Apocalypse. It was a Tour de Force for the Werewolf crew and the book that got &quot;The End&quot; best of the lot. Anything they do as a &quot;continuation&quot; after that is really going to be compared to that, and Parawolf's track record for writing leaves things to be desired.<br /> <br />","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2021-11-12T02:35:08-08:00","id":1467532,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>monteparnas</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467515#post1467515\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">No, it is that our actual bodies are uniquely susceptible to radiation sickness, biologically speaking. We are <b><u>orders of magnitude</u></b> weaker to radiation than most other mammals</div> </div> </div> </div>I\u2019d be interested in seeing your sources for this, as I\u2019m not finding much to support it. (In an admittedly limited search.)","signature":"<hr class=\"b-divider\"/><br/><i>Writer. Developer.</i> <b>World of Darkness</b> | <b>Chronicles of Darkness</b> | <b>The Trinity Continuum</b>","edited":{"userid":156,"user_link":"https://forum.theonyxpath.com/member/156-bunyip","user":"Bunyip","date":". 11-12-2021, 05:37 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/156-bunyip","name":"Bunyip","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar156_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1880"}]},"thankedby":[]},{"date":"2021-11-12T05:07:56-08:00","id":1467537,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Saur Ops Specialist</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467265#post1467265\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> On one hand, that would be completely ridiculous, because the Talons themselves have harped on how there's no chance that they can do the Impergium again, and humanity practically is doing it against them instead.<br /> <br /> But then, this is W5, and well, we've seen what the proposed changes are, with the Avatar Storm suddenly affecting Garou and other such nonsense, so maybe.</div> </div> </div> </div><br /> If, just as they did with Vampire and Gehenna, they are taking cues from &quot;Apocalypse&quot; (the book), the dangerous Umbra doesn't need to be caused by an Avatar Storm-lookalike, it may be the fallout of something like &quot;The Last Battleground&quot; scenario. It would be appropriate.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/12590-manfr","name":"Manfr","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"449"}]},"thankedby":[]},{"date":"2021-11-12T05:08:46-08:00","id":1467538,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467530#post1467530\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> It's funny really that they're trying to follow up Apocalypse. It was a Tour de Force for the Werewolf crew and the book that got &quot;The End&quot; best of the lot. Anything they do as a &quot;continuation&quot; after that is really going to be compared to that, and Parawolf's track record for writing leaves things to be desired.<br /></div> </div> </div> </div>Probably the best &quot;End of Times&quot; book: the failing Tribes scenario were all very interesting and well developed. As for writing quality, ParaWolf has also employed very competent people like Matthew Dawkins, and Justin Achilli is writing W5: he surely is no newbie to ttrpg writing.","signature":"","edited":{"userid":12590,"user_link":"https://forum.theonyxpath.com/member/12590-manfr","user":"Manfr","date":". 11-12-2021, 08:11 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12590-manfr","name":"Manfr","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"449"}]},"thankedby":[]},{"date":"2021-11-12T05:24:52-08:00","id":1467539,"title":"","content":"Achilli's first new work is the new Sabbat book. How encouraging is that?","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2021-11-12T05:48:48-08:00","id":1467542,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467539#post1467539\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Achilli's first new work is the new Sabbat book. How encouraging is that?</div> </div> </div> </div>Well, that's a different question: you may not agree with the direction of the book (and I do not agree with the idea of keeping the Sabbat as NPCs, even though I find bizarre that people raged against the mention of Brujah alt righters but now want Vampire Suprematists as playable options) , but the book sticks to its concept and writing is solid.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/12590-manfr","name":"Manfr","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"449"}]},"thankedby":[]},{"date":"2021-11-12T05:55:17-08:00","id":1467543,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467479#post1467479\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The whole concept of Red Talons doing stealthy cunning of humanity makes no bloody sense. The uptick in death rates would be picked up by somebody, even if they were causing it with natural disasters. There are people who will react to this crap, including the Garou themselves. The moment the cat is out of the bag, their plan comes to a screeching halt.<br /> <br /> That's specifically why if they do go down this route they go all in - which was gloriously demonstrated in Apocalypse.</div> </div> </div> </div>Once they go all in they'll burn quickly, so the wisest thing to do is to use both strategies: stealthy culling until they are detected and confronted and then, only when cornered, make a last stand. That's the most effective approach, because there is no sense in drawing attention right from the start.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-12T05:59:52-08:00","id":1467544,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Wolfen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467543#post1467543\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Once they go all in they'll burn quickly, so the wisest thing to do is to use both strategies: stealthy culling until they are detected and confronted and then, only when cornered, make a last stand. That's the most effective approach, because there is no sense in drawing attention right from the start.</div> </div> </div> </div>I think we need to discuss what words actually mean here. Culling is a systemic removal of a species. The species in question is humans. If you are talking about murdering a human here and there and disposing of the corpses, that's what Red Talons have been doing for ages now. If they're actually culling we're talking about hundreds and thousands of excess deaths. That's neither stealthy nor subtle.<br />","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2021-11-12T06:10:20-08:00","id":1467545,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Manfr</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467538#post1467538\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">ParaWolf has also employed very competent people like Matthew Dawkins, and Justin Achilli is writing W5: he surely is no newbie to ttrpg writing.</div> </div> </div> </div>Dawkins is not involved with W5, which is sad.<br /> <br /> Achilli will most likely turn Apocalypse into a Forsaken imitation. While I really liked Forsaken's 2nd Edition, there is no point in having too games so similar, it'll upset the fanbase and it won't attract more players...","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-12T06:28:19-08:00","id":1467549,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467544#post1467544\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I think we need to discuss what words actually mean here. Culling is a systemic removal of a species. The species in question is humans. If you are talking about murdering a human here and there and disposing of the corpses, that's what Red Talons have been doing for ages now. If they're actually culling we're talking about hundreds and thousands of excess deaths. That's neither stealthy nor subtle.</div> </div> </div> </div>Hundreds of deaths on a population of 8 billion specimens is not a big deal, they could do this for a while until someone notices. And even then the Glass Walkers would be forced to cover up the deaths to protect the Veil, giving the Red Talons a little more time to act. And the more subtle they are the more time the Garou Nation will take to finally move his hand. And then we have all out war.<br /> <br /> It's a strategy, there is a method, a system. Regardless of the final number of deaths, I'd say it's a culling.<br /> <br /> And even if there's a more adequate term for this strategy (English is not my first language), what's really important is that this is the strategy with the best kill ratio.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-12T06:33:14-08:00","id":1467550,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Wolfen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467545#post1467545\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Achilli will most likely turn Apocalypse into a Forsaken imitation. While I really liked Forsaken's 2nd Edition, there is no point in having too games so similar, it'll upset the fanbase and it won't attract more players...</div> </div> </div> </div>Achilli is not someone I'd really want with their paws in Werewolf in general. His attitudes toward Werewolf in the olden days were... controversial to say the least. Mind you I don't think he has the final word here. It's not about him or Dawkins or anyone else as much as it's about a vision Paradox has for what the brand should be and what it should look like. We've spent the better part of last 10 years actually with people doing their best to create games that continue what used to be and make sure they don't close off options and playstyles. It made the 20th anniversary games big and horribly dense for any new players without the help of the older fans, but it was pretty much a continuation of what was there.<br /> <br /> Fifth Edition is a statement where they are defining the one true way to play these games based on their own perspective and vision of them. This vision seems strangely set in the earliest days of the gamelines when they had a number of very rough and silly ideas without considering the great work latter White Wolf did with them. They claim that they are a continuation, but the way the material is treated, it's clearly a reboot. Actually communicating this would be much more fair, and allow people to temper their expectations. It would also eliminate a lot of the complaints from the people reading this material and expecting it to be a logical continuation of where we left off. If they dropped this pretense of continuation it would free them up to actually create interesting changes.<br /> <br /> But I don't think they can. There is already a split in the gaming population and confusion between oWOD, nWOD and WOD5, and they cannot really clear this confusion up if they want the recognizeable iconic IP elements that they feel are the marketable part of the game. So we're stuck like this.<br /> <br />","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2021-11-12T06:44:01-08:00","id":1467552,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Wolfen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467549#post1467549\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Hundreds of deaths on a population of 8 billion specimens is not a big deal, they could do this for a while until someone notices. And even then the Glass Walkers would be forced to cover up the deaths to protect the Veil, giving the Red Talons a little more time to act. And the more subtle they are the more time the Garou Nation will take to finally move his hand. And then we have all out war.<br /> <br /> It's a strategy, there is a method, a system. Regardless of the final number of deaths, I'd say it's a culling.<br /> <br /> And even if there's a more adequate term for this strategy (English is not my first language), what's really important is that this is the strategy with the best kill ratio.</div> </div> </div> </div>You cannot distribute these deaths without the Red Talons actually doing something, and you cannot distribute them where the Red Talons don't operate. Heck, they're not even a cosmopolitan tribe that can easily travel and blend in - they're actually the tribe most tied to their hunting grounds and least likely to leave them. Not just that, but they're not a highly organised tribe with centralised command structure of any kind, Red Talons are not a singular entity, they are a bunch of disparate wolf communities and Caerns accross Americas, Africa and Europe.<br /> <br /> Killing a hundred humans over a year is not even beginning a culling, it's what they're up to now. What they need to do is kill MILLIONS, ideally billions.<br /> <br /> And hundreds of deaths on a population of 8 billion is how, almost 2 years ago, we realised we had a messed up pandemic on our hands and i'd say that the whole planet reacted to that.<br /> <br />","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2021-11-12T07:09:07-08:00","id":1467557,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467550#post1467550\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Achilli is not someone I'd really want with their paws in Werewolf in general. His attitudes toward Werewolf in the olden days were... controversial to say the least.</div> </div> </div> </div>100% agreed.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467550#post1467550\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">it's about a vision Paradox has for what the brand should be and what it should look like.</div> </div> </div> </div>I never payed much attention to V5, werewolf is my monster, so I don't really know what Paradox wants. And not knowing makes me worry...<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467550#post1467550\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Fifth Edition is a statement where they are defining the one true way to play these games based on their own perspective and vision of them.</div> </div> </div> </div>Oh, the arrogance. I don't need someone telling me what can or can't happen on my table. But this seems to be getting quite common these days...<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467550#post1467550\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">It would also eliminate a lot of the complaints from the people reading this material and expecting it to be a logical continuation of where we left off. If they dropped this pretense of continuation it would free them up to actually create interesting changes.</div> </div> </div> </div>It's already clear that W5 will be a continuation just in name, because they are changing many of the most basic concepts of the game. And I'm not liking what I see...","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-12T07:23:26-08:00","id":1467558,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467552#post1467552\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">they're not a highly organised tribe with centralised command structure of any kind, Red Talons are not a singular entity, they are a bunch of disparate wolf communities and Caerns accross Americas, Africa and Europe.</div> </div> </div> </div>Yeah... I guess I'm thinking too much like a human...<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467552#post1467552\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">What they need to do is kill MILLIONS, ideally billions.</div> </div> </div> </div>Did a quick research, the human population grows roughly 2 million people/week. So, yes, killing small numbers wont be effective.<br /> <br /> To be honest, I don't know how it would make any difference, regardless of what they do. When I was a kid the human population was around 5 billion people, so if the Talons killed 3 billion people the humanity would simply regrow it's numbers in a few decades.<br />","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-12T07:43:41-08:00","id":1467560,"title":"","content":"What was Achilli's views on Werewolf?","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2021-11-12T07:59:06-08:00","id":1467561,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467560#post1467560\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">What was Achilli's views on Werewolf?</div> </div> </div> </div>In the old days on usenet, LJ, and on the convention circuit he was quite a character with strong stances on what he wants from games and how valid other people's opinions are. Mind you this is great, because he was one of the first devs you could actually talk to and discuss things with, and he had the propensity to be even funny about it. It was awesome to actually see what the writers think and what their thought proceses are. Unlike many, I don't begrudge him his vampire work, as I feel it was the strongest under his tenure. However, he did not take kindly to other lines and would regularly be dismissive and treat them as second fiddle to vampire. There was something along the lines of Vampires rule and Werewolves drool.<br /> <br /> And while I can appreciate him as an author, and even assume that in the past 20 years he has changed in many ways I can be rather apprehensive about someone like that getting reigns of Werewolf.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2021-11-12T10:35:19-08:00","id":1467570,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467561#post1467561\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">he was quite a character with strong stances on what he wants from games and how valid other people's opinions are.</div> </div> </div> </div>In other words, he tended to act &quot;me right, you wrong&quot; most of the time. He would talk to you, yes, but not listen to you. And from what we've seen of W5 I believe this attitude hasn't changed.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://tinyurl.com/mxyvsy9\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img19/986/w20supporterheavymetal1.png\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/k5qe4j4\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img546/6111/wpur.jpg\" border=\"0\" alt=\"\" /></a><a href=\"http://tinyurl.com/nd6kms2\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://imageshack.com/a/img829/1897/8seg.png\" border=\"0\" alt=\"\" /></a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/2766-wolfen","name":"Wolfen","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2766_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"45"}]},"thankedby":[]},{"date":"2021-11-12T10:39:42-08:00","id":1467571,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Wolfen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467558#post1467558\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Did a quick research, the human population grows roughly 2 million people/week. So, yes, killing small numbers wont be effective.<br /> <br /> To be honest, I don't know how it would make any difference, regardless of what they do. When I was a kid the human population was around 5 billion people, so if the Talons killed 3 billion people the humanity would simply regrow it's numbers in a few decades.</div> </div> </div> </div>It isn't the numbers, not really. If Red Talons decide to restart the Impegrium openly, they are at the point where they think everything is already lost. This means they will not care if they publicly reveal werewolves are real, they don't care if their actions hurt other tribes or kill them to a wolf. It is all over anyway, so who cares.<br /> <br /> Basically, a bunch of people dying might not garner attention. But a bunch of raging crinos and wolves out in the open sure will.<br /> <br /> When W5 was first announced, they spoke of the second Impegrium, which to me made no sense. 99% of the tribes, post past and current, are still tied to human cultures. Even as far back as during the Howler days, it was clear these garou cared a LOT of their human kinfolk and their cultures. It is even stronger in the modern day. Basically, it would make zero sense to restart the Impegrium now.<br /> <br /> <br />","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://ana-mizuki.deviantart.com/\" target=\"_blank\">My gallery.</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/110-ana-mizuki","name":"Ana Mizuki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar110_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2484"}]},"thankedby":[]},{"date":"2021-11-12T11:57:50-08:00","id":1467584,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Wolfen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467570#post1467570\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> In other words, he tended to act &quot;me right, you wrong&quot; most of the time. He would talk to you, yes, but not listen to you. And from what we've seen of W5 I believe this attitude hasn't changed.</div> </div> </div> </div>Having had plenty of conversations with him back in the day... I'm not sure that's fair. He'd listen, but it would take work to get him to, and it helped if he had a way to save face regarding any public statements (like the whole &quot;how does XP in Revised work?&quot; thing). One of the things that led to us talking online way back in ye olden times, was that we had a massive flame war that went on for pages. It was in no way a healthy way to go about things, but it earned me enough cred in terms of debate skills and passion for the game in his mind that suddenly he was way more casual and chatty, and much more likely to listen.<br /> <br /> I would say he's mellowed a bit with age, but he still seems to have a bit of that, &quot;you need to prove yourself to me,&quot; way of approaching things.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/617-heavy-arms","name":"Heavy Arms","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar617_2.jpeg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"12634"}]},"thankedby":[]},{"date":"2021-11-12T14:59:07-08:00","id":1467602,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Heavy Arms</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467584#post1467584\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Having had plenty of conversations with him back in the day... I'm not sure that's fair. He'd listen, but it would take work to get him to, and it helped if he had a way to save face regarding any public statements (like the whole &quot;how does XP in Revised work?&quot; thing). One of the things that led to us talking online way back in ye olden times, was that we had a massive flame war that went on for pages. It was in no way a healthy way to go about things, but it earned me enough cred in terms of debate skills and passion for the game in his mind that suddenly he was way more casual and chatty, and much more likely to listen.<br /> <br /> I would say he's mellowed a bit with age, but he still seems to have a bit of that, &quot;you need to prove yourself to me,&quot; way of approaching things.</div> </div> </div> </div>I have to agree with Heavy Arms here. It's been a long time and I think we've all grown up quite a bit since. Including Justin. He's a smart man passionate about his work. Usenet was... informative, but not really the most civilised of places. Any of the mods here would be breaking out in hives over most random topics and conversation flows there.<br /> <br /> Edit: And oh God, the Current Vs New XP discussion brings back so much facepalm.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":1182,"user_link":"https://forum.theonyxpath.com/member/1182-asmodai","user":"Asmodai","date":". 11-12-2021, 06:06 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2021-11-12T19:11:21-08:00","id":1467626,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Damian May</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467529#post1467529\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Is that just hominids or is it across most primates?</div> </div> </div> </div>I'm not sure as this is a relatively recent discovery, I actually have the same doubt, but as far as I could see it seems to be really worse with us even if other primates aren't as far as other mammals.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467530#post1467530\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">It's funny really that they're trying to follow up Apocalypse. It was a Tour de Force for the Werewolf crew and the book that got &quot;The End&quot; best of the lot.</div> </div> </div> </div>For now it's only a guess. As a rule of thumb X5 assumes Revised occurred and this is the setting &quot;after the Millennium events&quot;, so in some form the Time of Judgement line came and happened.<br /> <br /> So in this sense, it is a no-win situation: if they don't have an Apocalypse, they throw away the book, if they have it, they'll hardly make it justice. They aren't exactly doing justice to Gehenna, and that was an easier mark. But at least I don't think Mage have much to fear in that regard, I won't be sad with not following anything from Ascension.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Bunyip</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467532#post1467532\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I\u2019d be interested in seeing your sources for this, as I\u2019m not finding much to support it. (In an admittedly limited search.)</div> </div> </div> </div>I was thinking about bringing them anyway, but I'll need some time to find again, so it'll have to wait a little.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Wolfen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467557#post1467557\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I never payed much attention to V5, werewolf is my monster, so I don't really know what Paradox wants. And not knowing makes me worry...</div> </div> </div> </div>Still time to change attitude and take a look. Even if you don't play Vampire, reading about V5 is relevant to understand the people behind WoD right now and useful for fans of every gameline.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Wolfen</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1467558#post1467558\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">To be honest, I don't know how it would make any difference, regardless of what they do. When I was a kid the human population was around 5 billion people, so if the Talons killed 3 billion people the humanity would simply regrow it's numbers in a few decades.</div> </div> </div> </div>It is a stupid idea at face value, but if well written it probably wouldn't be something to take at face value.<br /> <br /> They can go this route in some different ways, regardless of how likely it is for the Talons to follow any of those:<br /> <br /> 1 - Desperate terrorism. They may decide the Nation failed and they're just going to die as the last true warriors of Gaia (in their eyes). Tragic, cathartic, but no real chance of ever working and not written as if it had;<br /> <br /> 2 - Protracted war. They get around some resources that give them enough of an edge to survive and keep the war going. Then they can't expect to cull the humans just by their killings, but they can pursue actual long term strategic objectives to have a shot in the long run;<br /> <br /> 3 - Environmental Sabotage. Instead of doing the killings themselves, they set in motion plans to make human society unsustainable for itself. Maybe going for rare metals mines, maybe causing disasters that will damage us more than damage Gaia, maybe they concoct some other nasty evil plan to bring about the end of civilization. Maybe they even grow new twirling mustaches in their wolf forms;<br /> <br /> 4 - Garou Manipulation. Instead of expecting to fight humanity and Garou Nation alike, they may do their killings in a way that uses the Litany not just as protection, but presses the other tribes into either eventually going with their plan or declare their betrayal.<br /> <br /> I don't think any of those make sense for the Talons, by the way, but they're at least not bad ideas on how to do it once doing it is a given.","signature":"<hr class=\"b-divider\"/><br/>#NothingAboutUsWithoutUs<br /> #AutismPride<br /> She/her pronouns","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/5826-monteparnas","name":"monteparnas","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5826_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"6710"}]},"thankedby":[]},{"date":"2021-12-08T09:49:05-08:00","id":1469925,"title":"","content":"Third crimson thaw out. <br /> Weird. I'm glad about Werewolf comics upcoming","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1784-werewolf43","name":"werewolf43","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1784_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"315"}]},"thankedby":[]},{"date":"2021-12-08T10:13:53-08:00","id":1469928,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>werewolf43</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1460916-werewolf-5th-edition-information-in-crimson-thaw?p=1469925#post1469925\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Third crimson thaw out.<br /> Weird. I'm glad about Werewolf comics upcoming</div> </div> </div> </div>any new spoiler about w5?","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#800000\">-'' </span>We are the unsullied.<br /> We are the inheritors.<br /> We are the Pure <span style=\"color:#800000\">''-</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3773-helur","name":"Helur","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3773_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"352"}]},"thankedby":[]},{"date":"2021-12-08T11:33:53-08:00","id":1469943,"title":"","content":"Not exactly. They ended the plot did something to the pack ( don't want to spoil anything)and announced upcoming Werewolf comics that will continue crimson thaw.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1784-werewolf43","name":"werewolf43","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1784_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"315"}]},"thankedby":[]},{"date":"2021-12-08T19:02:31-08:00","id":1469986,"title":"","content":"I don't think any of us here particular care about spoilers for a vampire comic but you could just gray them out if you want.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/479-damian-may","name":"Damian May","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar479_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1199"}]},"thankedby":[]},{"date":"2021-12-08T19:20:13-08:00","id":1469988,"title":"","content":"I am a tad confused looking at those first two pages though. There are silver manacles around the garous wrists, head and legs are unbound and we can see from the panels that the ' binding circle' doesn't prevent shifting.<br /> <br /> And that Tremere gets well within eating distance for that entire monologue. Shift to Crinos, battle scar your hands, eviscerate it with your foot talons and bisect it with a bite, Its a full moon so your rage rolls are awesome, you've got silver damage so your rage is even higher........spend all of those and go full blender...theres essentially no reason to not do so and nothing to stop you from doing so.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/479-damian-may","name":"Damian May","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar479_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1199"}]},"thankedby":[]},{"date":"2021-12-08T19:46:34-08:00","id":1469990,"title":"