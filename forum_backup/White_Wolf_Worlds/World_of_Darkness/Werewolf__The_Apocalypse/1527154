e=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2023-12-24T02:41:31-08:00","id":1527357,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1527355#post1527355\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Actually no.<br /> <br /> Because Gaia dying doesn't mean the end of everything as the Bone Gnawers used to have a faction about fleeing her to other worlds.</div> </div> </div> </div>Actually yes, that is how the Apocalypse is defined in the Lexicon in the Introduction.<br /> <br /> Besides it's questionable to what degree any reference to previous editions can be applied. It's &quot;re-imaginatiok, not continuation &quot; after all.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/27535-knightingale","name":"Knightingale","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar27535_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2022"},{"key":"Posts:","value":"1492"}]},"thankedby":[]},{"date":"2023-12-24T03:02:53-08:00","id":1527359,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Knightingale</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1527357#post1527357\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Actually yes, that is how the Apocalypse is defined in the Lexicon in the Introduction.<br /> <br /> Besides it's questionable to what degree any reference to previous editions can be applied. It's &quot;re-imaginatiok, not continuation &quot; after all.</div> </div> </div> </div>Okay.<br /> <br /> Still, I always felt that was weird. Then again, some editions tried to make Gaia the spirit of everything instead of just Earth. I felt that was a mistake.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2023-12-24T03:38:36-08:00","id":1527364,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1527359#post1527359\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Okay.<br /> <br /> Still, I always felt that was weird. Then again, some editions tried to make Gaia the spirit of everything instead of just Earth. I felt that was a mistake.</div> </div> </div> </div>There is a spirit of the planet Earth, Eshtarra I think?<br /> <br /> This is why the Apocalypse in W5, even in the previews, felt really disjointed. Because the whole point of the thing is that it is the end of everything. What the garou are fighting for is the very existence of the universe.<br /> <br /> To lessen that into just Earth is to lower the stakes in a very Musk way. You know, there is always another world to go to.<br /> <br /> So when W5 Apocalypse is something that doesn't even affect the mundane world much, it basically makes the stakes into steaks. Sure it hurts when they hit, but they aren't very pointed and tend to be floppy.<br /> <br /> Another reason why I feel they could have just made a new werewolf setting rather than used WtA's.<br /> <br /> EDIT: Actually, I think we need to talk about tone differences that affect this. W5 has taken a tone much closer to VtM, where there is a constant sense of futility. What the kindred/cainites do is often tainted by their monstrous nature and often good acts come back to bite them in the ass. Even the higher up vampires mostly focus on fighting each other through catspaws.<br /> <br /> For VtM, this is great because the cynical theme fits the game. Nothing truly matters and all that.<br /> <br /> But WtA isn't cynical, it is a game of genuine things. It is a game about things that matter and things that you truly care about. As stated, it is about caring so much it makes you mad.<br /> <br /> In such a setting and tone, the Apocalypse needs to be real.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://ana-mizuki.deviantart.com/\" target=\"_blank\">My gallery.</a>","edited":{"userid":110,"user_link":"https://forum.theonyxpath.com/member/110-ana-mizuki","user":"Ana Mizuki","date":". 12-24-2023, 06:57 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2},{"type":"\ud83e\udd70","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/110-ana-mizuki","name":"Ana Mizuki","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar110_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2484"}]},"thankedby":[]},{"date":"2023-12-24T05:42:39-08:00","id":1527366,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ana Mizuki</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1527348#post1527348\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">In fairness about the nationality thing, though; I have seen so many Nordic versions of <a href=\"https://www.urbandictionary.com/define.php?term=Styrofoam%20Scot\" target=\"_blank\">Styrofoam Scot</a> in WtA games. Characters from the USA who know old norse/icelandic and apparently have kept to the traditions. Unless the PC is from Ymir's Sweat, those characters would know Swedish,Danish, Nowegian, Finnish OR Icelandic if their immigrant families were from there.</div> </div> </div> </div>I find myself so very thankful for the players I have found over the last three decades......in that none of the anecdotes shared here and on reddit have ever been experienced by our groups. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/479-damian-may","name":"Damian May","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar479_1.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1199"}]},"thankedby":[]},{"date":"2023-12-24T07:56:32-08:00","id":1527372,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ana Mizuki</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1527364#post1527364\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> There is a spirit of the planet Earth, Eshtarra I think?<br /></div> </div> </div> </div>She's the planetary Incarna in the Aetherial Realm, and pulls double shifts as Danu. The default assumption of the game is that Gaia is bigger and much more important than this. Sometimes dissenting opinions are given, but the books aren't written from those perspectives, so those different takes are strictly opt-in for the Storyteller.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]},{"date":"2023-12-24T12:58:03-08:00","id":1527392,"title":"","content":"It's weird the planetary Incarna for Earth would be an Incarna when Jupiter is a Celestine.<br /> <br /> For once, I say Exalted did it better.<br /> <br /> Plus I'm a Luna/Gaia shipper. Let that lesbian/nonbinary couple fly their mythological flag!","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2023-12-24T15:02:26-08:00","id":1527398,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1527392#post1527392\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">It's weird the planetary Incarna for Earth would be an Incarna when Jupiter is a Celestine.</div> </div> </div> </div>Gaia is more than just the world, even the rock we live on may have other spirits representing it and being a lesser aspect of it. Her destruction would cause vast damage to realities on all possible levels, but the cosmos is vast and would not stop existing just because she was gone. As things stand, though, Gaia's creation may be a rare opportunity for reality to untangle itself from the horrible spiral the Weaver and Wyrm have plunged into. Or well. It was before W5.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1527392#post1527392\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">For once, I say Exalted did it better.<br /> <br /> Plus I'm a Luna/Gaia shipper. Let that lesbian/nonbinary couple fly their mythological flag!</div> </div> </div> </div>\u200b<br /> <br /> Apples. Oranges. Luna and Gaia of Werewolf have nothing to do with Exalted's need for everything to shag everything else. I love Exalted, but it's cosmology is ridiculously anthropomorphised.","signature":"<hr class=\"b-divider\"/><br/><span style=\"font-family:arial\">What doesn't kill you, makes you...<i> stranger</i>.</span>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1182-asmodai","name":"Asmodai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1182_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2989"}]},"thankedby":[]},{"date":"2023-12-24T18:05:45-08:00","id":1527400,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Asmodai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1527398#post1527398\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Apples. Oranges. Luna and Gaia of Werewolf have nothing to do with Exalted's need for everything to shag everything else. I love Exalted, but it's cosmology is ridiculously anthropomorphised.</div> </div> </div> </div>But isn't anthropomorphizing planets....the point?","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2023-12-25T00:06:57-08:00","id":1527410,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1527392#post1527392\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">It's weird the planetary Incarna for Earth would be an Incarna when Jupiter is a Celestine.</div> </div> </div> </div>Jupiter has the planetary Incarna Zarok. Every planet has a corresponding Incarna to mark its presence in the Aetherial Realm. Celestines have a lot of Incarnae to work with and some of them can get far outside of the expected - for example, Kronos is an Incarna of Luna that stands outside of time and monitors aberrations in time so that it doesn't get warped, kind of like Sailor Pluto. Rorg is the exception because his original Celestine got wrecked and he holds on tenaciously to what he was while also on the lookout for times to lob asteroids at his enemies.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> For once, I say Exalted did it better.<br /> <br /> Plus I'm a Luna/Gaia shipper. Let that lesbian/nonbinary couple fly their mythological flag! </div> </div> </div>Completely different characters and goals, there. If you kill a river god in Exalted, the river is still there. If you kill a river spirit in W:tA, the river will get cut off from its source of water and dry up.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]},{"date":"2024-01-07T02:54:45-08:00","id":1528149,"title":"","content":"I'm adding this to my review:<br /> <br /> <span style=\"font-size:14px\"><span style=\"font-family:Times New Roman\">In terms of mechanics, the game remains a game about being a murder machine that can transform between five different forms (man, wolf, manwolf, mostly man, mostly wolf). The vast difference in lore means that some of these changes make a few things feel redundant. Auspices and Breed are far less important since Garou have had most of the differences leveled out between them. Being a Lupus-born werewolf (i.e. born of wolves) used to be a fun chance to be an alien mindset but has been greatly de-emphasized because I suspect people kept asking about whether you were expected to boink other wolves. No, I'm not kidding. Forums are weird.<br /> <br /> The handling of Hauglosk and Harano alongside Touchstones is also not very well designed. In theory, I like the mechanical focus on personal horror. I feel like the struggles with being a werewolf and how it can destroy your personal life and drive you to existential depression or murderous evils was de-emphasized after First and Second Edition. However, the mechanics for both in this game are just bad. There doesn't seem to be a way listed to remove points in either of these stats and that means Garou are doomed for very short lives before becoming NPCs. Which is not how the game portrays running Chronicles and thus is probably just bad game design.<br /> <br /> The game also meanders about what exactly Garou are supposed to be doing with their time as furry killing machines. Previous games had the easiest to explain and most-well defined purpose of all the games: &quot;You are a werewolf. You are to save the Mother Goddess from the Wyrm. Go kill evil spirits and the corporate bigwigs destroying the world.&quot; The book focuses overmuch on how the Garou have screwed up this task and how their &quot;kill everything bad&quot; attitude has not improved things. It gives mixed messages about what you're expected to do as a werewolf. The Renown System thus feels tacked up even though its central to acquiring Gifts.<br /> <br /> Another major change to the game is the fact the role of the Umbra has been massively de-emphasized. The Garou no longer can step sideways into the spirit world as long as there's a nearby reflective surface but have to use a rite called &quot;The Rite of the Shadow Passage.&quot; Furthermore, Garou will take a point of Aggravated Damage for every scene they are in the Umbra unless they spend a point of willpower. Previous Chronicles could spend entire adventures in the Umbra, so this feels like crippling it in a way like the Avatar Storm of <i>Mage: The Ascension </i>Revised.<br /> <br /> I feel the systems are a lot faster and some of the overpowered nature of the Garou have been shed in the changes. Certainly, Werewolf: The Apocalypse Fifth Edition feels like it could be more easily ported over to other lines (in this case Vampire: The Masquerade and Hunter: The Reckoning). I'm not sure that is the best use of game designers' time, though, as they're still extremely different in scope as well as theme. Some of the obvious flaws of interaction are also not dealt with like the fact hunters are aid to react differently to the Delerium then it says some act exactly the same while giving no examples why they would.</span></span><br />","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2024-01-07T09:59:45-08:00","id":1528154,"title":"","content":"Being &quot;overpowered&quot; really depends on the basis of comparison. To a neonate? Sure, but Garou don't usually care about what vampires are doing unless it crosses them personally or the vampire got in with metaphysically corrupt interests, and even then, they tend to be behind even secondary targets.<br /> <br /> But to a thunderwyrm? To a skull pig? Optimized combat mockeries? Not even remotely. And you lose this perspective if you concentrate entirely on personal horror and not the horror of people around you being suddenly cut down for dumb and nonsensical reasons like in Berserk, Gundam, or one of the more serious arcs of Martian Successor Nadesico*. Garou endeavor to die meaningfully, and getting shot from the shadows after a successful mission is <i>their</i> ultimate fear.<br /> <br /> <span style=\"font-size:8px\">* Fuck I'm old.</span>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]},{"date":"2024-01-07T10:41:55-08:00","id":1528157,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Saur Ops Specialist</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1528154#post1528154\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Being &quot;overpowered&quot; really depends on the basis of comparison. To a neonate? Sure, but Garou don't usually care about what vampires are doing unless it crosses them personally or the vampire got in with metaphysically corrupt interests, and even then, they tend to be behind even secondary targets.<br /> <br /> But to a thunderwyrm? To a skull pig? Optimized combat mockeries? Not even remotely. And you lose this perspective if you concentrate entirely on personal horror and not the horror of people around you being suddenly cut down for dumb and nonsensical reasons like in Berserk, Gundam, or one of the more serious arcs of Martian Successor Nadesico*. Garou endeavor to die meaningfully, and getting shot from the shadows after a successful mission is <i>their</i> ultimate fear.<br /> <br /> <span style=\"font-size:8px\">* Fuck I'm old.</span></div> </div> </div> </div>+! Martian Nadesico Point<br /> <br /> One of my longest running NPCs was based on Ruri as the PCs super genius daughter.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2024-01-07T15:07:23-08:00","id":1528176,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1528149#post1528149\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I feel the systems are a lot faster and some of the overpowered nature of the Garou have been shed in the changes. Certainly, Werewolf: The Apocalypse Fifth Edition feels like it could be more easily ported over to other lines (in this case Vampire: The Masquerade and Hunter: The Reckoning). I'm not sure that is the best use of game designers' time, though, as they're still extremely different in scope as well as theme. Some of the obvious flaws of interaction are also not dealt with like the fact hunters are aid to react differently to the Delerium then it says some act exactly the same while giving no examples why they would.</div> </div> </div> </div>One interesting bit is that V5 was far more concerned with allowing both for &quot;Three rounds and done&quot; and advanced combat-options than the W5 corebook. In fact, with the way Rage (in terms of various things triggering Rage-checks during combat) and the Crinos-Form, you pretty much <i>have to</i> use &quot;Three rounds and done&quot; in W5. Additionally, when you look at the adventures like &quot;No Matter How Small&quot; and &quot;Deepest of Wounds&quot; the antagonists are given these huge dice-pools that they can throw at the PCs in combat and anything beyond &quot;Three rounds and done&quot; is unimaginable with those stats. And while the Crinos-Form can lead to PCs having some massive dice-pools to throw at enemies, it's still dice at the end of the day which means when you try to match that this can lead to problems. The bigger these dice-pools are the more things can get out of hand and imbalanced in a contest. If the Garou-PC has low Rage or has already been wounded, they might not even make it to the third round of combat when you use the stats suggested in the adventure.<br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":5}],"user":{"link":"https://forum.theonyxpath.com/member/27535-knightingale","name":"Knightingale","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar27535_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2022"},{"key":"Posts:","value":"1492"}]},"thankedby":[]},{"date":"2024-01-07T17:29:57-08:00","id":1528189,"title":"","content":"If you really want a fast system and speed is the only concern, don't bother using anything other than single rolls. Just use the pursuit mechanics and assume that anyone who fell behind *really fell* behind. Garou and most Fera can still get a roll to revive via Rage.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/werewolf-the-apocalypse-aa/1527154-my-even-haded-review-of-werewolf-the-apocalypse-fifth-edition?p=1528157#post1528157\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> +! Martian Nadesico Point<br /> <br /> One of my longest running NPCs was based on Ruri as the PCs super genius daughter.</div> </div> </div> </div>It also makes a handy explanation tool for the Clans in BattleTech (even if, in all likelihood, they are inspired more directly from the Zentraedi if anything).","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/23-saur-ops-specialist","name":"Saur Ops Specialist","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"9371"}]},"thankedby":[]}]}