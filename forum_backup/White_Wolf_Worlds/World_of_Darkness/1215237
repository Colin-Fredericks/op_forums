,{"key":"Posts:","value":"4568"}]},"thankedby":[]},{"date":"2018-05-06T12:24:42-07:00","id":1215870,"title":"","content":"Nanomachines are one of the go-to Foci for Iteration-X Technocrat Mages.<br /> I think that nanomachines are most fitting for Prime, Life, Matter and Entropy Procedures.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/3254-muad-dib","name":"Muad'Dib","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3254_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2014"},{"key":"Posts:","value":"2059"}]},"thankedby":[]}]}