 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">Katsumi, for all that she's nice to individual troubles, is a pretty ruthless politician, constantly throwing inconvenient Anarchs under Camarilla to get killed by the Sheriff. And my read on her and Campbell's relationship was that Campbell branded Katsumi as a political move to appease the anarch-haters in the court, which Katsumi begrudgingly respects, as it made her a beacon to the thin-bloods and made her bid at rulership of the Anarchs much easier.</div></div> </div> </div>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\ude0e","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2347-mahasamatman","name":"Mahasamatman","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2347_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"681"}]},"thankedby":[]},{"date":"2025-10-31T21:39:23-07:00","id":1554909,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mahasamatman</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1554554-an-old-1990s-gamer-s-opinion-on-bloodlines-2-review?p=1554887#post1554887\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I don't think this is true.<br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\">Katsumi, for all that she's nice to individual troubles, is a pretty ruthless politician, constantly throwing inconvenient Anarchs under Camarilla to get killed by the Sheriff. And my read on her and Campbell's relationship was that Campbell branded Katsumi as a political move to appease the anarch-haters in the court, which Katsumi begrudgingly respects, as it made her a beacon to the thin-bloods and made her bid at rulership of the Anarchs much easier.</div></div> </div> </div></div> </div> </div> </div>Yeah, she's definitely more nuanced than I'm presenting her.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2025-11-05T11:00:57-08:00","id":1555128,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1554554-an-old-1990s-gamer-s-opinion-on-bloodlines-2-review?p=1554875#post1554875\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I think they did a decent job with creating Seattle as a setting. With no spoilers about the in-game situation but spoilers for background.<br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"><br /> + Lou Graham and her sister Rosalind were the children of a 6th generation vampire that Embraced them both.<br /> + Lou caused the Seattle fire to wipe out much of the city's Elder Kindred and cover up the diablerie of her sire.<br /> + Lou built over Old Seattle and a lot of magical caerns and places of power were buried beneath.<br /> + The court of Seattle was eventually hit by a Hunter named Santiago who killed Rosalind and all the remaining court that opposed Lou ascending to Prince.<br /> + Lou Embraced her ghoul, JJ Campbell, who was a 1920s police chief and made him her Sheriff before making him Prince of the City when she &quot;retired.&quot;<br /> + Lou has been living in her hotel penthouse for decades like Ms. Havisham. She doesn't even hunt but has vessels brought to her.<br /> + JJ Campbell became fascinated by the Blood Trade and made a deal with a Thin Blood named Katsumi to allow Seattle to be a safe haven for Thin Bloods as long as he allowed them to make Alchemical Potions for Kindred.<br /> + Katsumi is a former surgeon branded with a M on her face. She is very much a consolidator but the brand makes her hate Campbell.<br /> + Thin Blooded Alchemy allows blood that is much more nourishing than regular Kine blood as well as actual superpowered blood. It's also addictive as hell and being distributed across the United States.<br /> + The city is INFESTED with Thin Bloods to an absurd degree. The Anarchs are also debating making a revolt against them because the problem has gotten so huge. The blood trade means independent ghouls are more common here than anywhere else too.<br /> + The seneschal, Ryong, is upset with Campbell's focus on the blood trade as he's using tens of millions of his legitimate businesses to finance the Tremere Safia's experiments with blood.<br /> + Benny the Brujah Sheriff wants to purge all the Anarchs in the city and hates that JJ is making too much money to care.<br /> + Benny is a psychopath with a very gentle caring Kindred father named Max.<br /> + The city has accepted some Lasombra in the city but Lou is the only one who approves them and only if they pledge loyalty to her.<br /> + There's no Tremere chantry but Mrs. Thorn runs a occult book shop and has gotten into the Blood Trade and magic trade herself. She calls herself &quot;Magistar&quot; but there's only one other Tremere in the city.<br /> + Ysabella is the local Toreador Primogen who runs a cult out of her nightclub, Atrium, and absolutely DETESTS the Masquerade.<br /> + The Ventrue Primogen, Fletcher, is a power in name only as Lou, Campbell, and Ryong all act without him. He runs a piano bar and basically just acts like an asshole to everyone.<br /> + Banu Haqim Niko lives with Toreador Patience in a pawn shop. Niko uses his job to find stories of desperation and executes those he judges to be evil. Patience makes sculptures from bones and murder victims' items.<br /> + Silky is a big Hells Angels looking guy who is actually a gay man and one of the modern Prometheans, being an incredibly well-read self-taught philosopher and anarchist who is loyal to the Camarilla. He's also lovers with a werewolf and believes Seattle has a spiritual wound that is corrupting it somewhere in the Underground.<br /> + The IAO is planning a major operation in the city but has absolute shit luck finding real Kindred but a lot of luck with Thin Bloods. Its led by Mother Hen, a Inquisitor who is dying of cancer and notably deciding that alternatives to death are within reach.<br /> </div></div> </div> </div></div> </div> </div> </div><br /> \u2026 man, no wonder Petrodon set up in Seattle. I\u2019m astonished he didn\u2019t burn the whole place to the ground!<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/28339-atticus-cleanclaw","name":"Atticus Cleanclaw","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2024"},{"key":"Posts:","value":"638"}]},"thankedby":[]},{"date":"2026-05-02T14:21:04-07:00","id":1559705,"title":"","content":"I just finished my review of LOOSE CANNON and I am torn on my opinion because it's extremely good content...for while it lasts. Benny Muldoon was not a character that I particularly wanted to revisit because he's a Thin Blood hating scumbag psychopath with all the depth of a puddle. I wanted more Phyre and Fabien with possibly some of the game's lost content being restored but I always secretly knew that was never going to happen. If they were going to hire voice actors or other people then they would have done it for the original announcement of the DLC to replace the cordoned off Clans.<br /> <br /> Still, I have to say this is probably some of the best content for V:TM:B2. Benny has a quality about him that separates him from 90% of Bloodlines 2's NPCs: he's actually interesting and has a personality. Benny hates the courts, hates Thin Bloods, and loves his sire but while this isn't much of a personality, it's more than most of Seattle's Kindred. We get to see his promotion to Sheriff, his reaction to Campbell's death, and what events led him to being recruited into the Sabbat.<br /> <br /> The gameplay is really the biggest benefit, though, because Benny can use melee weapons and has a gun that compensates for his lack of telekinesis. Only having the Brujah tree of powers also makes the character challenges more difficult. The ability to use melee weapons is also something that carries over to the main game. Plus, you can reload Benny's gunwiht the Anarchs you kill. I suspect the Toreador DLC will add the ability to use every variety of gun.<br /> <br /> The problem with the game is that it is still blindingly short. I finished it at about an hour and a half with no real ability to expand beyond that. You slaughter a bunch of Thin Bloods and Sabbat with a decent boss fight against a Lasombra before it's over. Is it work 15 dollars? I don't know, really, but the improvements to the main game are probably the real benefit of the game. Still, it wasn't boring and I appreciated that.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2026-05-03T22:08:29-07:00","id":1559751,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1554554-an-old-1990s-gamer-s-opinion-on-bloodlines-2-review?p=1559705#post1559705\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I just finished my review of LOOSE CANNON and I am torn on my opinion because it's extremely good content...for while it lasts.</div> </div> </div> </div>Prequel / Prologue DLC's are stupid. If you're playing it after the main campaign, then it's basically like having the whole thing spoiled for you.<br /> <br /> We already know everything that happens with Benny, because we saw how it turned out for him during the lead up to the boss fight. And you're still fighting nothing but Ghouls and Thinbloods the entire time.<br /> <br /> If they wanted to pull a prequel DLC, they should have done it from the hunter's point of view. At least then we could see the thought process that goes from <i>&quot;I'm protecting humanity from monsters&quot;</i> to <i>&quot;I have cancer, better cut a deal with the blood suckers.&quot;</i><br /> <br /> The only thing cool or interesting about the Loose Cannon DLC was the fact it let you actually use melee weapons. Which are so strong in Benny's hands, they make fisticuffs Phyre look like a damn fledgling.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/29009-darkking","name":"DarkKing","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar29009_1.png","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2025"},{"key":"Posts:","value":"639"}]},"thankedby":[]},{"date":"2026-05-04T08:45:27-07:00","id":1559756,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>DarkKing</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1554554-an-old-1990s-gamer-s-opinion-on-bloodlines-2-review?p=1559751#post1559751\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Prequel / Prologue DLC's are stupid. If you're playing it after the main campaign, then it's basically like having the whole thing spoiled for you.<br /> <br /> We already know everything that happens with Benny, because we saw how it turned out for him during the lead up to the boss fight. And you're still fighting nothing but Ghouls and Thinbloods the entire time.<br /> <br /> If they wanted to pull a prequel DLC, they should have done it from the hunter's point of view. At least then we could see the thought process that goes from <i>&quot;I'm protecting humanity from monsters&quot;</i> to <i>&quot;I have cancer, better cut a deal with the blood suckers.&quot;</i></div> </div> </div> </div>Yeah, I would have preferred more Phyre content. Possibly adapting some of the Mitsoda or Avelone material if possible.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> The only thing cool or interesting about the Loose Cannon DLC was the fact it let you actually use melee weapons. Which are so strong in Benny's hands, they make fisticuffs Phyre look like a damn fledgling. </div> </div> </div>Note the DLC allows Phyre to use them as well.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2026-05-04T09:37:29-07:00","id":1559758,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1554554-an-old-1990s-gamer-s-opinion-on-bloodlines-2-review?p=1559756#post1559756\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Yeah, I would have preferred more Phyre content. Possibly adapting some of the Mitsoda or Avelone material if possible.</div> </div> </div> </div>Another point towards a Hunter themed DLC, is that we could possibly see the moments following her embrace, and how she managed to successfully escape the SI facility after Phyre left her there.<br /> <br /> Not only that, but they could have had a mission where we take down whichever target Phyre decided to point us at during the epilogue.<br /> <br /> Shit, the more I think about it, the more I realize this idea had actual potential.<br /> <br /> Instead, we get Benny. A character who shows up in a cutscene, disappears until the boss fight, and then disappears again with the rest of the cast forgetting about him entirely.<br /> <br /> Edit: Also, Benny had to have been super young, if he didn't even know what the Sabbat was, or recognize a Vaulderie.","signature":"","edited":{"userid":29009,"user_link":"https://forum.theonyxpath.com/member/29009-darkking","user":"DarkKing","date":". 05-04-2026, 12:41 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/29009-darkking","name":"DarkKing","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar29009_1.png","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2025"},{"key":"Posts:","value":"639"}]},"thankedby":[]},{"date":"2026-05-04T09:47:01-07:00","id":1559759,"title":"","content":"On Sunday I sat down and played the new DLC, so I want to add my two cents here.<br /> <br /> The first thing I was thinking about while I reinstalled the game was how my experience with the main-game had been sitting with me. A couple of months has passed and you just kinda reflect on how your opinion may or may not have changed since then. With good games you just go through your day sometimes and you suddenly remember a good moment or character. With Bloodlines 2 the process has gone into the other direction actually. Honestly while I was reinstalling the game all I felt was total ambivalence. The characters, the story, the locations\u2026 honestly couldn\u2019t care less about any of it after all these months. Although it also wasn\u2019t such a huge disaster as a gaming-experience that it became memorable that way. Looking back on it now, the released game itself is for me the least remarkable part of this whole affair. The troubled development-history, the turning-point it created for Paradox\u2026 Pretty much everything else surrounding this game is more interesting to talk about.<br /> <br /> Anyway, the DLC\u2026 I think giving a verdict is very easy here. The content you get from the DLC is <i>extremely </i>short and not that interesting. It\u2019s absolutely not worth 15 bucks.<br /> <br /> I played it for two and a half hours. But I played a bit around with Phyre to look at the quality-of-life-updates as well. And they\u2019re good. There\u2019s some nice stuff there (saving your game is better now, for example and there\u2019s a FOV slider). Being able to hold a melee-weapon is a good addition. But on the other hand, it also does have the whiff of \u201ctoo little, too late\u201d.<br /> <br /> As for the actual DLC\u2026 I\u2019m really not sure why this story was picked. The main-game gave more than enough story on Benny, I think. Then again, I wasn\u2019t a fan of the characters in general in the main-game so naturally I also wasn\u2019t particularly curious to find out more about any of them. Maybe with good storytelling this could\u2019ve been changed. But the story was both very short and not that interesting. Especially because the main-game already had shown how Benny\u2019s story would end. Benny\u2019s super-jump he uses for traversal also made me think it would\u2019ve been really cool if the game allowed access to different ways of traversal linked to what Clan or Discipline-powers you had access to.<br /> <br /> But yeah, on the whole\u2026 it\u2019s just worth a shrug in my opinion. It does improve Bloodlines 2 and adds a new story. But in terms of length, it\u2019s extremely short and neither the story nor the new mechanics are huge game-changers either.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/27535-knightingale","name":"Knightingale","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar27535_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2022"},{"key":"Posts:","value":"1492"}]},"thankedby":[]},{"date":"2026-05-04T10:22:40-07:00","id":1559761,"title":"","content":"On that note, can we all agree that <i>&quot;Mr. Night&quot;</i> was a shovelhead? Because I refuse to believe that a properly sired and educated Lasombra would make an introduction like that!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/29009-darkking","name":"DarkKing","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar29009_1.png","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2025"},{"key":"Posts:","value":"639"}]},"thankedby":[]},{"date":"2026-05-06T14:25:23-07:00","id":1559811,"title":"","content":"I'm not sure we want to be arguing that shovelheads can pull other vampires into the Abyss as well as conjure armies of shadow copies of themselves.<br />","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2026-05-07T15:17:48-07:00","id":1559827,"title":"","content":"Honestly, all this DLC confirmed for me is that Paradox has given up on it. Not just in choosing to focus on these specific characters with this DLC and the upcoming one but if (as I suspect) the upcoming Toreador-focused DLC will be similar to this one, it will also end up being a VERY short affair. <br /> <br /> But how about a DLC of revisiting the main-story through the lens of the Sabbat instead? Or as <a href=\"https://forum.theonyxpath.com/member/12002-ctphipps\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar12002_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"12002\" data-vbnamecard=\"12002\">CTPhipps</a>mentioned exploring more of Phyre's background? At the same time, though... that's just so much work. And it doesn't seem like Paradox was interested in paying for it. (Although that sort of thing does sound like something I would happily pay fifteen bucks for, at least)<br /> <br /> So, rather, I would describe it more as &quot;too little, too late&quot; and therefore, I'm just left wondering what's the point of any of this... Is it really worth the effort to improve the game on a very small scale without any offer of long-term-support? Why even bother to pay a guy to give this game a better saving system, for example, or allow for the option to wield weapons in your hand? The game's gonne be dead and not gonna get any support anymore within a year.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/27535-knightingale","name":"Knightingale","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar27535_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2022"},{"key":"Posts:","value":"1492"}]},"thankedby":[]},{"date":"2026-05-18T12:19:49-07:00","id":1560071,"title":"","content":"Yeah, my take on this was that Bloodlines 2 under the Chinese Room was, &quot;How do we recoup ANY of our losses from this boondoggle&quot; not, &quot;We're not quite there yet but we believe in this project.&quot;<br />","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]}]}