0/6/0/4/5/avatar302_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"753"}]},"thankedby":[]},{"date":"2016-08-13T16:20:25-07:00","id":950295,"title":"","content":"The most recent numbers were adjusted 15 years ago.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11683-aya-tari","name":"Aya Tari","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11683_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2016"},{"key":"Posts:","value":"5986"}]},"thankedby":[]},{"date":"2016-08-14T13:10:13-07:00","id":950709,"title":"","content":"Which is why I like that the 20th editions simply do not state numbers, and instead roughly go by<br /> <br /> 0 - On the street or working poor, paycheck to paycheck<br /> 1 - Standard lower class, with rather seldom spending sprees<br /> 2 - Standard Middle class<br /> 3 - Higher Middle Class, can maintain 1-dot standard indefinitely<br /> 4 - Upper Class, can maintain 2-dot standard indefinitely<br /> 5 - Member of the 1%, can maintain a 3-dot standard indefinitely<br /> <br /> And the somewhat rethorical in player-hands<br /> 6 - Hollywood money<br /> 7 - Billionaire<br /> 8 - Bruce Wayne<br /> 9 - Tony Stark<br /> 10 - Bill Gates<br /> <br /> <br /> There is no inflation to take into consideration anymore, thankfully.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://is.gd/wodchart\" target=\"_blank\">cWoD Dice Probability Chart</a> ||| <a href=\"https://is.gd/wodcalc\" target=\"_blank\">cWoD Dice Statistics Calculator</a> ||| <a href=\"https://is.gd/wodarmor\" target=\"_blank\">cWoD Alternative Armor System</a><br /> <a href=\"https://is.gd/woddamage\" target=\"_blank\">cWoD Alternative Damage Roll System</a> ||| <a href=\"https://is.gd/woddamage2\" target=\"_blank\">My explanation of cWoD Damage Levels</a> ||| <a href=\"https://is.gd/wodstrength\" target=\"_blank\">'Interesting' Strength Attribute Stuff</a><br /> <a href=\"https://is.gd/wodboom\" target=\"_blank\">EXPLOSIVE cWoD STUFF!</a> ||| <a href=\"https://is.gd/wodheresy\" target=\"_blank\">How Technocrats don't think they are Mages</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/6606-ambrosia","name":"Ambrosia","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar6606_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2015"},{"key":"Posts:","value":"1567"}]},"thankedby":[]},{"date":"2016-08-14T13:14:22-07:00","id":950715,"title":"","content":"I dug out V:TM 1st ed. Are you ready?<br /> <br /> 1 - assets worth $1,000, an allowance of $500 a month.<br /> 2 - assets worth $8,000, an allowance of $1,200 a month.<br /> 3 - assets worth $50,000, an allowance of $3,000 a month.<br /> 4 - assets worth $500,000, an allowance of $9,000 a month.<br /> 5 - assets worth $5,000,000, an allowance of $30,000 a month.<br /> <br /> EDIT:<br /> <br /> V:TM got released in 1991. Between 1991 and 2016, 100 olde 90's dollars became 175 dollars in worth, so the new numbers going by old V:TM 1st ed guidelines are..<br /> <br /> 1 - assets worth $1,750, an allowance of $875 a month.<br /> 2 - assets worth $14,000, an allowance of $2,100 a month.<br /> 3 - assets worth $87,500, an allowance of $5,250 a month.<br /> 4 - assets worth $875,000, an allowance of $15,750 a month.<br /> 5 - assets worth $8,750,000, an allowance of $52,500 a month.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://is.gd/wodchart\" target=\"_blank\">cWoD Dice Probability Chart</a> ||| <a href=\"https://is.gd/wodcalc\" target=\"_blank\">cWoD Dice Statistics Calculator</a> ||| <a href=\"https://is.gd/wodarmor\" target=\"_blank\">cWoD Alternative Armor System</a><br /> <a href=\"https://is.gd/woddamage\" target=\"_blank\">cWoD Alternative Damage Roll System</a> ||| <a href=\"https://is.gd/woddamage2\" target=\"_blank\">My explanation of cWoD Damage Levels</a> ||| <a href=\"https://is.gd/wodstrength\" target=\"_blank\">'Interesting' Strength Attribute Stuff</a><br /> <a href=\"https://is.gd/wodboom\" target=\"_blank\">EXPLOSIVE cWoD STUFF!</a> ||| <a href=\"https://is.gd/wodheresy\" target=\"_blank\">How Technocrats don't think they are Mages</a>","edited":{"userid":6606,"user_link":"https://forum.theonyxpath.com/member/6606-ambrosia","user":"Ambrosia","date":". 08-14-2016, 04:24 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/6606-ambrosia","name":"Ambrosia","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar6606_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2015"},{"key":"Posts:","value":"1567"}]},"thankedby":[]},{"date":"2016-08-14T13:16:47-07:00","id":950718,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ambrosia</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/950195-when-did-the-resource-background-first-appear?p=950715#post950715\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I dug out V:TM 1st ed. Are you ready?<br /> <br /> 1 - assets worth $1,000, an allowance of $500 a month.<br /> 2 - assets worth $8,000, an allowance of $1,200 a month.<br /> 3 - assets worth $50,000, an allowance of $3,000 a month.<br /> 4 - assets worth $500,000, an allowance of $9,000 a month.<br /> 5 - assets worth $5,000,000, an allowance of $30,000 a month.</div> </div> </div> </div>Doesn't seem to have really changed much through editions then. I certainly like V20s approach better.","signature":"<hr class=\"b-divider\"/><br/><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://drive.google.com/uc?export=view&amp;id=0B9RzepSqCby3Mi1KUmJ5aWUwRVk\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/805-idpersona","name":"idpersona","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar805_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2117"}]},"thankedby":[]},{"date":"2016-08-14T18:35:44-07:00","id":950836,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ambrosia</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/950195-when-did-the-resource-background-first-appear?p=950709#post950709\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Which is why I like that the 20th editions simply do not state numbers, and instead roughly go by<br /> <br /> 0 - On the street or working poor, paycheck to paycheck<br /> 1 - Standard lower class, with rather seldom spending sprees<br /> 2 - Standard Middle class<br /> 3 - Higher Middle Class, can maintain 1-dot standard indefinitely<br /> 4 - Upper Class, can maintain 2-dot standard indefinitely<br /> 5 - Member of the 1%, can maintain a 3-dot standard indefinitely<br /> <br /> And the somewhat rethorical in player-hands<br /> 6 - Hollywood money<br /> 7 - Billionaire<br /> 8 - Bruce Wayne<br /> 9 - Tony Stark<br /> 10 - Bill Gates<br /> <br /> <br /> There is no inflation to take into consideration anymore, thankfully.</div> </div> </div> </div>Top 1% would probably be more like Resources 4, since to be in the top 1% you need to make around $400,000 a year.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1129-sergeant-brother","name":"Sergeant Brother","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1129_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2016-08-14T19:34:55-07:00","id":950866,"title":"","content":"Technically, in the USA, middle class is defined as having a household income of $100,000 to $1,000,000 per year (people often confuse middle income with middle class, so it is an understandable mistake), which would be the top 5% to top 0.1% of households. If you look at the description in V20 for a character with a job, I would think that 0 would be lower class ($25,000- per year in the USA), 1 would be working class ($25,001-$100,000 per year), 2 would be middle class ($100,001-$1,000,000 per year in the USA), 3 would be lower upper class ($1,000,001-$10,000,000 per year in the USA), 4 would be middle upper class ($10,000,001-$100,000,000 per year in the USA), and 5 would be upper upper class ($100,000,0001-$1,000,000,000 per year in the USA). Resources 5 should not be allowed in a campaign unless you want your characters to be constantly pursued by con men and entrepreneurs looking for investors.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11683-aya-tari","name":"Aya Tari","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11683_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2016"},{"key":"Posts:","value":"5986"}]},"thankedby":[]},{"date":"2016-08-15T00:33:06-07:00","id":950966,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Aya Tari</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/950195-when-did-the-resource-background-first-appear?p=950866#post950866\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Technically, in the USA, middle class is defined as having a household income of $100,000 to $1,000,000 per year (people often confuse middle income with middle class, so it is an understandable mistake), which would be the top 5% to top 0.1% of households.</div> </div> </div> </div>Not really. What you describe would already be the upper middle class (which coincidentally starts around 100k a year), not the 'middle class' per se. Somebody (not a household) with an annual income of 40-50k can be well in the middle class. Upper class would already start at 500k a year.<br /> <br /> Likewise, your numbers for the resources levels are a little skewed towards the high end.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://is.gd/wodchart\" target=\"_blank\">cWoD Dice Probability Chart</a> ||| <a href=\"https://is.gd/wodcalc\" target=\"_blank\">cWoD Dice Statistics Calculator</a> ||| <a href=\"https://is.gd/wodarmor\" target=\"_blank\">cWoD Alternative Armor System</a><br /> <a href=\"https://is.gd/woddamage\" target=\"_blank\">cWoD Alternative Damage Roll System</a> ||| <a href=\"https://is.gd/woddamage2\" target=\"_blank\">My explanation of cWoD Damage Levels</a> ||| <a href=\"https://is.gd/wodstrength\" target=\"_blank\">'Interesting' Strength Attribute Stuff</a><br /> <a href=\"https://is.gd/wodboom\" target=\"_blank\">EXPLOSIVE cWoD STUFF!</a> ||| <a href=\"https://is.gd/wodheresy\" target=\"_blank\">How Technocrats don't think they are Mages</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/6606-ambrosia","name":"Ambrosia","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar6606_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2015"},{"key":"Posts:","value":"1567"}]},"thankedby":[]},{"date":"2016-08-15T06:26:43-07:00","id":951069,"title":"","content":"No, you are confusing middle income with middle class. A $50,000 household income is a working class income because it is less than 400% of the federal poverty level for the average household in the USA, which qualified them for health care subsidies under ACA. You are not middle class until you stop qualifying for programs designed to help poorer Americans. <br /> <br /> For the average household, the middle class starts at over $80,000 a year in a rural area in the USA. In New York City, due to the high rents, middle class starts at over $160,000. In Silicon Valley, due to very high rents, middle class starts at over $320,000. If you are below these income thresholds in these areas, you are, at best, working class.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11683-aya-tari","name":"Aya Tari","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11683_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2016"},{"key":"Posts:","value":"5986"}]},"thankedby":[]},{"date":"2016-08-15T07:24:50-07:00","id":951097,"title":"","content":"I really can't find that definition anywhere.<br /> But, no matter how you turn it, it would make the Resources dots useless as one area's middle class is another area's working class (Again a separate class I can't find an exact definition for, aside of being part of the middle class itself). And thus the dots would suddenly change depending on where you go within the same country.<br /> <br /> It would make much more sense to fix the resource levels around things like low income, middle income, upper income, 1% etc., as those stay the same no matter where you go. Unless you actually switch countries all of a sudden. But that's better than having the dots flop around within the same country.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://is.gd/wodchart\" target=\"_blank\">cWoD Dice Probability Chart</a> ||| <a href=\"https://is.gd/wodcalc\" target=\"_blank\">cWoD Dice Statistics Calculator</a> ||| <a href=\"https://is.gd/wodarmor\" target=\"_blank\">cWoD Alternative Armor System</a><br /> <a href=\"https://is.gd/woddamage\" target=\"_blank\">cWoD Alternative Damage Roll System</a> ||| <a href=\"https://is.gd/woddamage2\" target=\"_blank\">My explanation of cWoD Damage Levels</a> ||| <a href=\"https://is.gd/wodstrength\" target=\"_blank\">'Interesting' Strength Attribute Stuff</a><br /> <a href=\"https://is.gd/wodboom\" target=\"_blank\">EXPLOSIVE cWoD STUFF!</a> ||| <a href=\"https://is.gd/wodheresy\" target=\"_blank\">How Technocrats don't think they are Mages</a>","edited":{"userid":6606,"user_link":"https://forum.theonyxpath.com/member/6606-ambrosia","user":"Ambrosia","date":". 08-15-2016, 10:34 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/6606-ambrosia","name":"Ambrosia","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar6606_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2015"},{"key":"Posts:","value":"1567"}]},"thankedby":[]},{"date":"2016-08-15T09:07:58-07:00","id":951143,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ambrosia</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/950195-when-did-the-resource-background-first-appear?p=950709#post950709\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">8 - Bruce Wayne<br /> 9 - Tony Stark<br /> 10 - Bill Gates</div> </div> </div> </div>This part always makes me wonder: is Bill Gates really that much richer than Tony Stark, who in turn is richer than Bruce Wayne? Or are these empty comic book platitudes being thrown around.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12085-beriorn","name":"Beriorn","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12085_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2016"},{"key":"Posts:","value":"313"}]},"thankedby":[]},{"date":"2016-08-15T10:01:47-07:00","id":951176,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Beriorn</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/950195-when-did-the-resource-background-first-appear?p=951143#post951143\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">This part always makes me wonder: is Bill Gates really that much richer than Tony Stark, who in turn is richer than Bruce Wayne? Or are these empty comic book platitudes being thrown around.</div> </div> </div> </div>I would say they're somewhat misleading numbers.<br /> Forbes Fictional 15 puts Tony Stark at $12.4B and Bruce Wayne at 9.2B.<br /> (Forbes calculates out the 15 richest fictional characters every year. The math behind their numbers can be fascinating.)<br /> In any case, Bill Gates is at 78.3B according to Google.<br /> <br /> For the sake of the Resources background I would say the difference between Wayne and Stark is negligible. While the jump from $12 billion to 78 billion is a difference of a few dots.<br />","signature":"<hr class=\"b-divider\"/><br/><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://drive.google.com/uc?export=view&amp;id=0B9RzepSqCby3Mi1KUmJ5aWUwRVk\" border=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/805-idpersona","name":"idpersona","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar805_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2117"}]},"thankedby":[]},{"date":"2016-08-15T10:32:16-07:00","id":951189,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>idpersona</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/950195-when-did-the-resource-background-first-appear?p=951176#post951176\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I would say they're somewhat misleading numbers.<br /> Forbes Fictional 15 puts Tony Stark at $12.4B and Bruce Wayne at 9.2B.<br /> (Forbes calculates out the 15 richest fictional characters every year. The math behind their numbers can be fascinating.)<br /> In any case, Bill Gates is at 78.3B according to Google.<br /> <br /> For the sake of the Resources background I would say the difference between Wayne and Stark is negligible. While the jump from $12 billion to 78 billion is a difference of a few dots.</div> </div> </div> </div>The Wayne/Stark difference isn't that big, but there's the difference between 10 and 11 digits. Gates claims the top spot just because there are none richer rather than any actual money he has.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12085-beriorn","name":"Beriorn","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12085_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2016"},{"key":"Posts:","value":"313"}]},"thankedby":[]},{"date":"2016-08-16T13:33:39-07:00","id":951974,"title":"","content":"social class in the usa (as of 2005 i think goes like this)<br /> <br /> 35 to 70 thousand dollars income per year makes you lower middle class/ 30% of the populace or so<br /> <br /> 70+ but commonly above 100 makes you upper middle 15% of the populace<br /> <br /> 400(or was it 500 i can't remember) and above makes you rich. also known as the upper 1 %<br /> <br /> this is pretty ironic considering the fact that many poor people in the usa see themselves as middle class or worse&quot;temporarily inconvenienced millionaires&quot;<br /> <br /> i imagine that in countries like germany with a lower gini numbers would be different","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1492-mark","name":"mark","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1492_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"1379"}]},"thankedby":[]},{"date":"2016-08-16T14:53:46-07:00","id":952049,"title":"","content":"How can people who qualify for a poverty subsidy (the ACA) be considered to be even lower middle class?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11683-aya-tari","name":"Aya Tari","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11683_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2016"},{"key":"Posts:","value":"5986"}]},"thankedby":[]},{"date":"2016-08-16T23:25:15-07:00","id":952345,"title":"","content":"Wait. You think the ACA subsidies are only for <i>people beneath the poverty line</i>?<br /> <br /> Well, that explains that.<br /> You realize that the official federal poverty threshold is measured at 11k-14k *annual income* for a single person household? <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /> For a family of 4 it would be around 25-30k total, annualy.<br /> People are eliglible for *Medicaid* if they are at 133% of that poverty threshold.<br /> ACA subsidies are possible below an annual income of 100k, but it has nothing to do with any poverty measurements.<br /> .<br /> That should put things a little more in perspective.<br /> Heck, an electrical engineer with a degree from a good University and years of studying makes an average of ~75k a year.<br /> ..seriously, go tell somebody who's earning 7k dollars a month that they are lower class poverty. Tell us the results.<br /> <br /> <br /> .","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://is.gd/wodchart\" target=\"_blank\">cWoD Dice Probability Chart<