8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 06-27-2020, 03:58 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-27T13:36:08-07:00","id":1399361,"title":"","content":"Your interpretation of Tremere, by your own admision in other threads, has been one of mustache twirling villainy, has it not? Did you perchance <i>sell </i>the idea of house carna to players?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-27T13:47:44-07:00","id":1399367,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399361#post1399361\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Your interpretation of Tremere, by your own admission in other threads, <b>has been one of mustache twirling villainy, </b>has it not? Did you perchance <i>sell </i>the idea of house carna to players?</div> </div> </div> </div>That's a weird idea to have.<br /> <br /> Karl Schrekt is like my 2nd or 3rd all-time favorite character and a badass demon hunter who is one of the most legitimately awesome ass-kicker who ever lived.<br /> <br /> Ailsing Sturbridge is a feature in every of my games.<br /> <br /> I mean the Council of Seven is an enormous pile of shit but it is the rare Methuselah who isn't.<br /> <br /> I mean, my Sabbat and Old Clan Tzimisce hate the Tremere, but that's the Sabbat and Old Clan Tzimisce.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 06-27-2020, 04:52 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-27T14:13:40-07:00","id":1399373,"title":"","content":"I don't actually want to search for a quote but I do recall that you use Tremere for villains quite a bit and you make their power structure overtly abusive. You may have said you like them as one dimensional badguys but I might be projecting my reactions here a bit. A good deal of Carna justification is at least in part to exaggerating the evils of Tremere hierarchy.<br /> <br /> <br /> If someone could find the quotes, that'd be great, but I think you, CTphipps should have at least a vague recollection of such Tremere related posts.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-27T14:14:59-07:00","id":1399375,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399351#post1399351\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Who rolls up to a V5 game and picks Tremere? Advanced players don't get the spells and basic players have a lot of baggage without much incentive.</div> </div> </div> </div>before v5, it was &quot;who rolls vtm and doesn't pick Tremere?&quot;<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399361#post1399361\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Your interpretation of Tremere, by your own admision in other threads, has been one of mustache twirling villainy, has it not?</div> </div> </div> </div>what's wrong with moustache twirling villany?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399367#post1399367\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I mean, my Sabbat and Old Clan Tzimisce hate the Tremere, but that's the Sabbat and Old Clan Tzimisce.</div> </div> </div> </div>off topic,<br /> one thing that has always bothered me and that no edition has ever managed to solve for me is:<br /> <br /> how the fuck are you supposed to play sabbat without thaumaturgy?","signature":"<hr class=\"b-divider\"/><br/><b>-</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/10998-pleiades","name":"Pleiades","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10998_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"1844"}]},"thankedby":[]},{"date":"2020-06-27T14:33:58-07:00","id":1399385,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399373#post1399373\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I don't actually want to search for a quote but I do recall that you use Tremere for villains quite a bit and you make their power structure overtly abusive. You may have said you like them as one dimensional badguys but I might be projecting my reactions here a bit. A good deal of Carna justification is at least in part to exaggerating the evils of Tremere hierarchy.</div> </div> </div> </div>The Pyramid is a brainwashing overtly abusive mind-controlling cult. The people inside the Pyramid are a mixture of the Good, the Bad, and the Hungry like most Kindred. The evil heart of the Tremere is the Seven but that doesn't mean Tremere characters can't be as good as any other. It's just they're all enslaved to the Seven by the Blood Bond, which is evil.<br /> <br /> Now the Tremere are free and have to figure out what they want to do with that freedom.<br /> <br /> You can tone up or down the Pyramid's abusiveness based on the preferences of your game but every Tremere has the organization looming over them.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> If someone could find the quotes, that'd be great, but I think you, CTphipps should have at least a vague recollection of such Tremere related posts. </div> </div> </div>I don't feel like I have to put on my mod hat to tell you that you shouldn't lecture people on their own opinions.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 06-27-2020, 05:37 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-27T14:35:24-07:00","id":1399386,"title":"","content":"-The Tremere anti's taught it before they were destroyed<br /> -Chantry plunder<br /> -Some ancient thaumaturgy was held onto (pre-tremere blood magic) <br /> -Dark thaumaturgy<br /> -Assamite sorcerers have the same thing, settite anti's have near-the same thing. <br /> -I highly recomend <i>Rites of the Blood</i>. Basically, thaumaturgy with different paradigms for all (mostly anarchs). <br /> <br /> Counter question: How is it sane that the major sects largely lack necromancers and you'd be lucky to have one in your city, but there's also cities that are mostly necromancers?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-27T14:55:54-07:00","id":1399395,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399386#post1399386\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Counter question: How is it sane that the major sects largely lack necromancers and you'd be lucky to have one in your city, but there's also cities that are mostly necromancers?</div> </div> </div> </div>they lack both thaumaturgists and necromancers usually<br /> <br /> you don't need as many necromancers however, since there are fewer paths in necromancy,<br /> and fewer paths are required to deal with &quot;ghost problems&quot;<br /> <br /> thaumaturgy on the other hand, is used to deal with way more varried problems (blood bonds, interrogation, wards, punishment, lupines, spirits, mages, tracking, assassination, database wipes and so on),<br /> <br /> so, even if you have a few thaumaturgists in town, it won't necessarily be enough, since they probably don't have all the paths/rituals you may need<br /> <br /> that was an even bigger problem in the sabbat,<br /> not only was magic less available, it was more expensive xp wise, and attracted Inquisition attention","signature":"<hr class=\"b-divider\"/><br/><b>-</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/10998-pleiades","name":"Pleiades","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10998_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"1844"}]},"thankedby":[]},{"date":"2020-06-27T15:05:20-07:00","id":1399398,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Pleiades</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399395#post1399395\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> they lack both thaumaturgists and necromancers usually<br /> <br /> you don't need as many necromancers however, since there are fewer paths in necromancy,<br /> and fewer paths are required to deal with &quot;ghost problems&quot;<br /> <br /> thaumaturgy on the other hand, is used to deal with way more varried problems (blood bonds, interrogation, wards, punishment, lupines, spirits, mages, tracking, assassination, database wipes and so on),<br /> <br /> so, even if you have a few thaumaturgists in town, it won't necessarily be enough, since they probably don't have all the paths/rituals you may need<br /> <br /> that was an even bigger problem in the sabbat,<br /> not only was magic less available, it was more expensive xp wise, and attracted Inquisition attention</div> </div> </div> </div>I understand that you can perform even the supernatural ritae of the Sabbat without Thaumaturgy. You just need a &quot;Rituals&quot; skill.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-27T15:06:51-07:00","id":1399399,"title":"","content":"Honestly, here's some thoughts about the Thin-Bloods. I wanted to post in more detail but I've been kind of stuck between a rock and a hard place with house repairs, hotel stays, and a few other bits of unpleasantness.<br /> <br /> Some thoughts about the changes to the Thin-Bloods for V5.<br /> <br /> 1. <b>I'm not really a fan of Thin-Blood Alchemy</b>: Honestly, I think it's a weird thing that isn't justified in story. I want to know how every Thin-Blood knows it, who came up with it, and why they're now doing it. If this was invented by a Thin-Blooded version of <b>Walter White</b> or <b>Elon Musk</b> that makes sense but then it would be &quot;Thin-Blood Chemistry.&quot; I mean, it's also not something that could easily be spread unless the Thin-Bloods have their own version of Hunter.net and that would be more interesting to me than the Discipline itself.<br /> <br /> I think it might have been more interesting to just restrict Thin-Bloods to having a single Discipline and offering them a Clan cost to raising it. Something like Telekinesis, Bat Powers, or what we have in <i>Bloodlines 2</i>. Maybe also allow them to have a single dot Discipline in anything else. It isn't a strong build but is certainly a workable one. So a character might have &quot;Bat Powers 5, Auspex 1, Presence 1.&quot; Add in the Daytime activity, permanent Blush of Life, and ability to drink animal blood regularly--a very solid character. Then again, some people like to play ghouls so maybe a workable build is missing the point.<br /> <br /> 2. <b>I like the relative Humanity of Thin-Bloods</b>: One of my favorite parts of Bloodlines was the discovery of the Thin-Bloods under Santa Monica's pier. They're a likable bunch that is completely unlike the rest of the Kindred you meet. The sweet love story between Lily and E, Rosa's visions, and that poor guy who still believes there is a cure for his condition. They really do seem mostly harmless and you could argue that is because their Beasts are so weak. Still divorced from humanity, still Damned, but almost human.<br /> <br /> Yes, they are the Half-Elves of V:TM.<br /> <br /> 3. <b>I love what they bring to the War of Ages</b>: I like the idea of the Thin-Bloods at war with the rest of vampire society and having a real understandable motive to become repeat diablerists. The fact the Thin-Bloods are tied to modern humanity and have access to all the tech as well as modern world's cultures puts them as the perfect embodiment of the Movement. Then again, I just love Jenna Cross and her army of Thin-Bloods ready to go guerilla on the Elders.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-27T15:08:56-07:00","id":1399401,"title":"","content":"Thaumaturgy is nice to have but the services are mostly ritual based. It's more convenient than disciplines but most things you mentioned can deal with disciplines or equipment. <br /> <br /> If there's an angry ghost fucking with the local kindred and you don't have a necromancer to deal with it, you're in trouble. You can't really know the fetters if you don't know the person.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-27T15:43:21-07:00","id":1399414,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399398#post1399398\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I understand that you can perform even the supernatural ritae of the Sabbat without Thaumaturgy. You just need a &quot;Rituals&quot; skill.</div> </div> </div> </div>yeah, but apart from the vinculum, there's a few ritae that have mechanical effects, fewer have any useful effects<br /> <br /> some paths of enlightenment require thaumaturgy or some form of blood magic (like death and the soul, metamorphosis),<br /> some paths feel naked without it (like power and the inner voice),<br /> <br /> ironically, vampires with the highest path ratings always have magic (Vykos, Mon\u00e7ada) or a friend that has magic (the rose)<br /> <br /> some sabbat concepts don't work without it:<br /> Inquisitors, lupine hunter,<br /> how does a tzimisce fight a lasombra without magic? how does anyone fight a lasombra without magic?<br /> how do I make a toreador antitribu tattoo artist, hell how do I even make a toreador anti at all?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399401#post1399401\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Thaumaturgy is nice to have but the services are mostly ritual based. It's more convenient than disciplines but most things you mentioned can deal with disciplines or equipment.</div> </div> </div> </div>there's too many things that disciplines can't deal with, especially when limited to your 3 clan disciplines<br /> <br /> for one, you can't deal with blood mages of any kind (their ghosts, their spirits, their wards),<br /> how do you deal with a tremere/infernalist with fire and teleportation? hell they can even nullify your dominate","signature":"<hr class=\"b-divider\"/><br/><b>-</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/10998-pleiades","name":"Pleiades","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10998_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"1844"}]},"thankedby":[]},{"date":"2020-06-27T16:06:09-07:00","id":1399419,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399401#post1399401\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Thaumaturgy is nice to have but the services are mostly ritual based. It's more convenient than disciplines but most things you mentioned can deal with disciplines or equipment.<br /> <br /> If there's an angry ghost fucking with the local kindred and you don't have a necromancer to deal with it, you're in trouble. You can't really know the fetters if you don't know the person.</div> </div> </div> </div>And that's why la Famiglia is wealthier than the Pyramid will ever be. Better marketing. (/s)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24808-draconis","name":"Draconis","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24808_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2018"},{"key":"Posts:","value":"805"}]},"thankedby":[]},{"date":"2020-06-27T16:17:55-07:00","id":1399420,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Pleiades</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399414#post1399414\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">some paths of enlightenment require thaumaturgy or some form of blood magic (like death and the soul, metamorphosis),<br /> some paths feel naked without it (like power and the inner voice),<br /> <br /> ironically, vampires with the highest path ratings always have magic (Vykos, Mon\u00e7ada) or a friend that has magic (the rose)<br /> <br /> some sabbat concepts don't work without it:<br /> Inquisitors, lupine hunter,<br /> how does a tzimisce fight a lasombra without magic? how does anyone fight a lasombra without magic?<br /> how do I make a toreador antitribu tattoo artist, hell how do I even make a toreador anti at all?</div> </div> </div> </div>And this is why I'm glad sorcery got nerfed in V5. If <i>an entire sect</i> becomes infeasible without everyone having access to sorcery, it's too strong imo.<br /> <br /> I'm curious, though, why do you say the toreador antitribu need magic?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24808-draconis","name":"Draconis","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24808_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2018"},{"key":"Posts:","value":"805"}]},"thankedby":[]},{"date":"2020-06-27T16:45:32-07:00","id":1399425,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Draconis</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399420#post1399420\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'm curious, though, why do you say the toreador antitribu need magic?</div> </div> </div> </div>for one, one of their main paths of enlightenemnt requires it (death and the soul)<br /> <br /> in the sabbat, they're one of the weakest clans power-wise (in a sect that's all about power...),<br /> and their &quot;unique&quot; concepts are usually better done by other clans or (of course) blood mages<br /> <br /> with celerity and auspex, they can make art faster (combo discipline), but not permanent (tattoos, piercings)<br /> <br /> a tzimisce can make themselves beautiful, can have/make permanent tattoos/piercings,<br /> better fleshcrafting, torture and so on,<br /> <br /> a thaumaturgist can not only do that, but also use conjuring to get the ink and the priercings on the fly<br /> <br /> if you play as informant, thaumaturgy also allows you to gather information from blood (nice for toreador cathari/prostitutes)<br /> <br /> plus, thaumaturgy also solves the power probem, since some paths allow you to better defend yourself (try winning monomacy against a lasombra without lure of flames)<br /> <br /> and the canon seems to agree, since one of the few toreador antis acting like one had both vicissitude and thaumaturgy (conjuring), used vicissitude to make herself beautiful and conjuring to make jewelry and path of blood to act as an informant<br /> <br /> <br /> without thaumaturgy, you're...very limited,<br /> you have to rely on 3rd party support alot (vinculum and presence helps),<br /> you need people to fight for you, you need to avoid monomacies,<br /> you need tzimisce to make your body modifications permanent or change your appearance,<br /> imo that's too much stuff you're supposed to do but can't do on your own","signature":"<hr class=\"b-divider\"/><br/><b>-</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/10998-pleiades","name":"Pleiades","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10998_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"1844"}]},"thankedby":[]},{"date":"2020-06-28T02:55:40-07:00","id":1399538,"title":"","content":"I can't take people very seriously when they act like thaumaturgy is the god discipline that does everything and other disciplines don't even enter the equation. Like, sure, it can do a lot of things if you put all your exp into it or have your character stay in-chantry all the downtimes to learn rituals whilst everyone else makes friends and influences people. It looks really cool and you can show it off well, but it isn't more powerful than equal XP in potence or dominate or animalism or obfuscate. And you can't use it at all in frenzy. There are some standouts (Mercury is OP) it should be pretty clear that V5 overcorrected here and it's a bit laughable that some of you wanna pat it on the back for fixing a percieved wrong that doesn't reflect the reality of the game. The Tremere market it as the best thing ever and you internalised that so hard you can't even see it's real value in context with everything else.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-28T04:00:26-07:00","id":1399554,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399538#post1399538\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I can't take people very seriously when they act like thaumaturgy is the god discipline that does everything and other disciplines don't even enter the equation.</div> </div> </div> </div>disciplines do enter the equation,<br /> however they cannot compete with thaumaturgy<br /> and they're gated by generation<br /> <br /> thaumaturgy is god, the simple fact that you can't fight magic without magic already makes magic god<br /> <br /> you can't convince me that a lasombra on path of power could be presented with an opportunity to learn thaumaturgy or mysticim and go &quot;nah, don't wanna&quot;<br /> <br /> the canon doesn't even challenge that assertion,<br /> the moment Tremere antis died, the sabbat lost New York, and they couldn't fight off the kuei-jin,<br /> the Inquisition sent groups to abandonned tremere-anti chantries to study thaumaturgy<br /> and the sabbat begged kolduns for help and tutoring in koldunism (which by some Revised miracle, they accepted)<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> It looks really cool and you can show it off well, but it isn't more powerful than equal XP in potence or dominate or animalism or obfuscate. </div> </div> </div>spirit manipulation man, spirit manipulation is god...literally (they nuked in v20 though...sad)","signature":"<hr class=\"b-divider\"/><br/><b>-</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/10998-pleiades","name":"Pleiades","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10998_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"1844"}]},"thankedby":[]},{"date":"2020-06-28T04:21:12-07:00","id":1399558,"title":"","content":"That thaumaturgy would need to come with significant investment in learning. you would shut your doors to getting money, power and influence whilst you studied. Not to mention the high willpower/occult/intellegence requirement (Ok, a lasombra would likely have most of that) and time spent decoding the books. Someone on path of power and the inner voice would be right to turn it down.<br /> <br /> also, you need thaumaturgy to fight thaumaturgy? rediculous. Just hit hard and ideally first. Grapple and bite. Tremere do not excell at fighting, even if you don't acount for celerity they don't do especially well. A Nos or gangrel will usually win. The Ventrue has more guys, They'd probably beat the malk. Brujah/ toreador would trounce the thaumaturge. Thaumaturge superiority is silly propaganda.","signature":"","edited":{"userid":25794,"user_link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","user":"MyWifeIsScary","date":". 06-30-2020, 05:07 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-28T04:59:18-07:00","id":1399567,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399558#post1399558\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> also, you need thaumaturgy to fight thaumaturgy?</div> </div> </div> </div>you need magic to fight magic (thaumaturgy is just the easiest to get for most clans)<br /> <br /> how do you counter a koldun without magic?<br /> how do you fight spirits, elementals, ghosts, shades without magic?<br /> nothing else works on them, not even obfuscate, not that you can do anything while sleeping during the day<br /> <br /> you said it yourself: &quot;If there's an angry ghost fucking with the local kindred and you don't have a necromancer to deal with it, you're in trouble.&quot;<br /> <br /> how do you counter a mage of any kind attacking your haven, when you don't have wards,<br /> how do you counter their own wards?<br /> <br /> the only non-magic solution to these is to bloodbond a mage or have them under presence and hope they don't spend willpower to resist it","signature":"<hr class=\"b-divider\"/><br/><b>-</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/10998-pleiades","name":"Pleiades","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10998_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"1844"}]},"thankedby":[]},{"date":"2020-06-28T05:32:55-07:00","id":1399570,"title":"","content":"Faith, or you just kill the guy controlling the spirit. There are no wards for ordinary humans or animals. Just send those in to deal with your mage problem. Ordanance works well too. Just explode stuff. All that effort learning magic when you could just use the stuff mortals do. <br /> <br /> Presence works on spirits by the way. I don't think elemental spirits can really do much for long.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-28T06:18:53-07:00","id":1399581,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399570#post1399570\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Presence works on spirits by the way.</div> </div> </div> </div>is it mentioned anywhere?<br /> afaik, only spirit manipulation allows you to command spirits (and maybe koldunism)","signature":"<hr class=\"b-divider\"/><br/><b>-</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/10998-pleiades","name":"Pleiades","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10998_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"1844"}]},"thankedby":[]},{"date":"2020-06-28T08:26:24-07:00","id":1399601,"title":"","content":"Yes. I cant remember specifics, and i dont have the books with me now, but somewhere it was mentioned that Dominate does not work on spirits, Presence does. Jury is out on animalism though. Presence works on everything except where it says it does not.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-28T09:37:42-07:00","id":1399609,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399570#post1399570\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">There are no wards for ordinary humans or animals. Just send those in to deal with your mage problem. Ordanance works well too. Just explode stuff. All that effort learning magic when you could just use the stuff mortals do.</div> </div> </div> </div>Which is, of course, the explanation given in V5 for the fall of Vienna\u2014which a lot of fans insist is absolutely impossible because ordinary humans with weapons and explosives could never overcome the power of Thaumaturgy.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24808-draconis","name":"Draconis","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24808_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2018"},{"key":"Posts:","value":"805"}]},"thankedby":[]},{"date":"2020-06-28T10:19:46-07:00","id":1399614,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399538#post1399538\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">There are some standouts (Mercury is OP) it should be pretty clear that V5 overcorrected here and it's a bit laughable that some of you wanna pat it on the back for fixing a percieved wrong that doesn't reflect the reality of the game.</div> </div> </div> </div>I honestly agree with part of this; I don't think V5's solution was the best way to fix the problem. But there absolutely <i>was</i> a problem.<br /> <br /> Yes, Thaumaturgy was somewhat balanced\u2026if you had to invest all your time and effort in learning it, giving it a heavy opportunity cost. But in all my time playing V20, MET, and earlier editions, I've never really seen it run that way. Players by default assume they have access to every path and ritual they could ever want, for free, with no cost.<br /> <br /> V5 tried to put teeth on the time cost, by saying learning a new ritual takes the square of its level in weeks (so a level-five ritual takes half a year to learn). But in most games this doesn't matter: either the timeframes are long enough that this time cost is inconsequential, or the timeframes are short enough that &quot;takes half a year&quot; is equivalent to &quot;impossible&quot;. So this isn't particularly helpful.<br /> <br /> Instead, I wish they'd put some universal restrictions on all Thaumaturgy and balanced it that way, and emphasized that you need a teacher for each individual thing you want to learn: no Chantry is handing out free access to the Library of Every Ritual Ever Published.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24808-draconis","name":"Draconis","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24808_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2018"},{"key":"Posts:","value":"805"}]},"thankedby":[]},{"date":"2020-06-28T10:26:14-07:00","id":1399616,"title":"","content":"<br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399601#post1399601\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Yes. I cant remember specifics, and i dont have the books with me now, but somewhere it was mentioned that Dominate does not work on spirits, Presence does. Jury is out on animalism though. Presence works on everything except where it says it does not.</div> </div> </div> </div>I'll take your word for it, no need to look for it if you don't have the time,<br /> <br /> however, if you do come across it, I'd like to see it cause it's one thing that's been eluded me for years<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Draconis</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399609#post1399609\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Which is, of course, the explanation given in V5 for the fall of Vienna\u2014which a lot of fans insist is absolutely impossible because ordinary humans with weapons and explosives could never overcome the power of Thaumaturgy.</div> </div> </div> </div>I'd say thaumaturgy still wins,<br /> <br /> there's a ward vs technology (technology being anything more advanced than a crossbow),<br /> <br /> however, it's an Inconnu ward,<br /> the Tremere may not have it,<br /> and even if they did have, there's a good chance they wouldn't be using it<br />","signature":"<hr class=\"b-divider\"/><br/><b>-</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/10998-pleiades","name":"Pleiades","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar10998_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2016"},{"key":"Posts:","value":"1844"}]},"thankedby":[]},{"date":"2020-06-28T11:01:24-07:00","id":1399622,"title":"","content":"Found it<br /> Rites of the blood 143<br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> \u2022\u2022 Astral Cant<br /> The languages of the spirit world are infinitely<br /> varied and mainly incomprehensible to mortal (and<br /> immortal) minds. Astral Cant does not teach the<br /> thaumaturge the tongues of the spirits, but it does<br /> allow him to understand them as they speak to him<br /> and to reply in their own languages. The use of this<br /> power is not always necessary; many spirits speak<br /> human tongues, but choose to feign ignorance when<br /> dealing with vampires. <b>Spirits are not affected by<br /> Dominate, but may be manipulated by Presence. Some<br /> thaumaturges theorize that this is because spirits are<br /> not actually sentient as a vampire would understand<br /> the concept, but are manifestations based on the<br /> perception of those that are self-aware.</b><br /> System: Astral Cant allows the thaumaturge to speak to<br /> any spirit visible via Hermetic Sight for fifteen minutes.<br /> Each additional level of success on the activation roll<br /> increases the duration of this power by an additional<br /> fifteen minutes to the duration </div> </div> </div><br /> RE: Vienna prime.<br /> The thing here is that the Tremere would have had <i>Both</i> impressive thaumaturgical security <i>and</i> Impressive mundane security. It's likely this would've not just been an additive, but a multiplier. Super powerful things struggle because of wards, and also security. Mundane people struggle because of security, but also wards...<br /> <br /> A minefield isn't very effective at keeping a force away, a few gunmen aren't very effective at keeping an equal or greater force away, but a few gunmen and a minefield can be defended impressively. Vienna prime was more than that.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-28T13:43:00-07:00","id":1399654,"title":"","content":"@<b><a href=\"http://forum.theonyxpath.com/member/12002-ctphipps\">CTPhipps</a> </b>I am sorry that I helped derail this thread. I would love to read your Tremere list. Maybe also the Certamen afterwards...<br /> <br /> Blowing up Vienna with most inside should be very difficult, but I am sure it can be explained. I got the feeling that the description we have so far was supposed to to make you say &quot;No way!&quot;. It is a mystery you can explain yourself or in a latter book. I would expect a mix of Inquisition, Inside Job, Camerilla backstabbing, etc.<br /> <br /> Old Thaumaturgy was very versatile and potentially very powerful. OP? Depends on your storyteller. I think something had to be done, because so many people hated it.<br /> <br /> <b>As for Thinbloods:</b><br /> <br /> - TB Alchemy by it self is nice. How it interacts with the setting - difficult. I like the idea of renaming it to chemistry. I would have rather seen it in a latter book giving it a less prominent roll and described as <b>very rare</b>.<br /> <br /> - I also very much liked the TB in bloodlines. Humane? yes, but my flavors would include clueless, oppressed, powerless (seemingly)<br /> For me I would like the embrace for a TB to be worse than into Clan Nosferatu in a way. They do not need a workable build they are a valuable perspective.","signature":"","edited":{"userid":26030,"user_link":"https://forum.theonyxpath.com/member/26030-mfalkenb","user":"mfalkenb","date":". 06-28-2020, 05:15 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26030-mfalkenb","name":"mfalkenb","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2020"},{"key":"Posts:","value":"49"}]},"thankedby":[]},{"date":"2020-06-28T13:46:36-07:00","id":1399656,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399622#post1399622\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Found it<br /> Rites of the blood 143<br /> <br /> RE: Vienna prime.<br /> The thing here is that the Tremere would have had <i>Both</i> impressive thaumaturgical security <i>and</i> Impressive mundane security. It's likely this would've not just been an additive, but a multiplier. Super powerful things struggle because of wards, and also security. Mundane people struggle because of security, but also wards...<br /> <br /> A minefield isn't very effective at keeping a force away, a few gunmen aren't very effective at keeping an equal or greater force away, but a few gunmen and a minefield can be defended impressively. Vienna prime was more than that.</div> </div> </div> </div>Almost certainly, it was Tremere (i.e. the ANTEDILUVIAN) who destroyed the Chantry since V20 established Etrius was now worshiping the Snake-Lot monster and offering it human sacrifices.<br /> <br /> And there's no way that Tremere couldn't just wave his fucking hand and wipe it out.<br /> <br /> As BORING an answer as that may be.<br /> <br /> I have a simple philosophy, though. If you're so min/maxed that you can say, &quot;But how could the government defeat them&quot; then you AUTOMATICALLY should be destroyed by the Storyteller. Because you are missing the point of the game. The Seven broke the Masquerade by being twinks and paid the price. Yes, the true killer of Vienna were the All-Powerful Storytellers.<br /> <br /> <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /><br /> <br /> But how defended could the Chantry be if Christof and his coterie killed like 30 Tremere there in the Dark Ages?","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 06-28-2020, 04:48 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-28T17:47:52-07:00","id":1399701,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <br /> I have a simple philosophy, though. If you're so min/maxed that you can say, &quot;But how could the government defeat them&quot; then you AUTOMATICALLY should be destroyed by the Storyteller. </div> </div> </div>This works both ways.<br /> <br /> Why us, the human race, should fear vampires IF even the most well blood-magic warded vampire fortress within the 7 most powerfull milenar bloodmages in the entire planet can be destroyed by our SWAT team? <br /> <br /> We can kill any fucking vampire, licker or ancient, anytime and anywhere we fucking want.<br /> <br /> Us, the human race, have everything under control. We are the boss.<br /> If you guys cross the line, we can BOOOOM you to the ground and handwave it as &quot;cuz terrorist&quot;.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24832-blailton","name":"blailton","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24832_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2018"},{"key":"Posts:","value":"389"}]},"thankedby":[]},{"date":"2020-06-28T17:56:25-07:00","id":1399705,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>blailton</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399701#post1399701\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> This works both ways.<br /> <br /> Why us, the human race, should fear vampires IF even the most well blood-magic warded vampire fortress within the 7 most powerfull milenar bloodmages in the entire planet can be destroyed by our SWAT team?<br /> <br /> We can kill any fucking vampire, licker or ancient, anytime and anywhere we fucking want.<br /> <br /> Us, the human race, have everything under control. We are the boss.<br /> If you guys cross the line, we can BOOOOM you to the ground and handwave it as &quot;cuz terrorist&quot;.</div> </div> </div> </div>Yep.<br /> <br /> Which is why we're playing the vampires not the humans.<br /> <br /> There's no reason for a Masquerade if humans as a group can't crush any vampire.<br /> <br /> But on a more serious note, do we really want a bunch of ancient vampires as the top of the food chain versus humanity's strongest militaries?","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 06-28-2020, 09:00 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-28T18:40:24-07:00","id":1399714,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399705#post1399705\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Yep.<br /> <br /> Which is why we're playing the vampires not the humans.<br /> <br /> There's no reason for a Masquerade if humans as a group can't crush any vampire.<br /></div> </div> </div> </div>I agree with you if things go full true blood. The unmasquerade world, where the entire humanity, literally speaking start a purge, yes, humanity can crush vampires. But I do not think a group can. Ok, maybe can, but only in v5 where vampires are Human+. In prior editions no way.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <br /> But on a more serious note, do we really want a bunch of ancient vampires as the top of the food chain versus humanity's strongest militaries? </div> </div> </div>V5 don't give us the former neither the latter. <br /> I think we both agree, without advanced disciplines the elders are weak. Not a worth top of the food chain.<br /> There's no SI NPCs to be targeted, and as SI is so loose in connections and without hierarchy, theres no leader to target and no reward to kill someone specific or to destroy any SI base. In other words, the top in food chain are not Cleo the SI CEO either.","signature":"","edited":{"userid":24832,"user_link":"https://forum.theonyxpath.com/member/24832-blailton","user":"blailton","date":". 06-28-2020, 09:43 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24832-blailton","name":"blailton","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24832_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2018"},{"key":"Posts:","value":"389"}]},"thankedby":[]},{"date":"2020-06-28T23:15:02-07:00","id":1399740,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>blailton</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399701#post1399701\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> This works both ways.<br /> <br /> Why us, the human race, should fear vampires IF even the most well blood-magic warded vampire fortress within the 7 most powerfull milenar bloodmages in the entire planet can be destroyed by our SWAT team?<br /> <br /> We can kill any fucking vampire, licker or ancient, anytime and anywhere we fucking want.<br /> <br /> Us, the human race, have everything under control. We are the boss.<br /> If you guys cross the line, we can BOOOOM you to the ground and handwave it as &quot;cuz terrorist&quot;.</div> </div> </div> </div>Because. The human race doesn't, and shouldn't fear vampires AS A RACE. They fear them as individuals, because a vampire vs an average human is pretty heavily biased towards the vampire. Because they are an unknown, scary threat.<br /> <br /> But no. The &quot;Seven most powerful blood mages on the planet&quot; were most definitely not in the Vienna chantry, nowhere near it in fact. Why? Because even before V5, Ur-Shulgi literally waved his hand and removed a curse imposed by those seven. Nor was it &quot;Just a swat team&quot; it was a highly trained military special ops, undergoing a planned raid with the resources from a few countries, in addition to holy relics, and inquisitors armed with true faith.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>blailton</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399714#post1399714\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I agree with you if things go full true blood. The unmasquerade world, where the entire humanity, literally speaking start a purge, yes, humanity can crush vampires. But I do not think a group can. Ok, maybe can, but only in v5 where vampires are Human+. In prior editions no way.<br /> <br /> <br /> <br /> V5 don't give us the former neither the latter.<br /> I think we both agree, without advanced disciplines the elders are weak. Not a worth top of the food chain.<br /> There's no SI NPCs to be targeted, and as SI is so loose in connections and without hierarchy, theres no leader to target and no reward to kill someone specific or to destroy any SI base. In other words, the top in food chain are not Cleo the SI CEO either.</div> </div> </div> </div>I mean. In old editions, they had an existential threat from HUMANS WITH PITCHFORKS. The inquisition was a literal species threatening threat that has defined vampires to the modern day.<br /> <br /> As for elders not being weak? It's objectively false. An elder can look at a person and tell themselves to intentionally blow themselves up. An elder can make people fall in love with them via a TV or over the phone. They can rip apart a man in full swat armor with their bare hands. And their dice pools? Almost impossible for a mortal to beat.","signature":"","edited":{"userid":24893,"user_link":"https://forum.theonyxpath.com/member/24893-necroticbinder","user":"Necroticbinder","date":". 06-29-2020, 02:19 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24893-necroticbinder","name":"Necroticbinder","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2018"},{"key":"Posts:","value":"103"}]},"thankedby":[]},{"date":"2020-06-28T23:17:56-07:00","id":1399741,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Necroticbinder</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399740#post1399740\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Because. The human race doesn't, and shouldn't fear vampires AS A RACE. They fear them as individuals, because a vampire vs an average human is pretty heavily biased towards the vampire. Because they are an unknown, scary threat.<br /> <br /> But no. The &quot;Seven most powerful blood mages on the planet&quot; were most definitely not in the Vienna chantry, nowhere near it in fact. Why? Because even before V5, Ur-Shulgi literally waved his hand and removed a curse imposed by those seven. Nor was it &quot;Just a swat team&quot; it was a highly trained military special ops, undergoing a planned raid with the resources from a few countries, in addition to holy relics, and inquisitors armed with true faith.</div> </div> </div> </div>I admit, I wish they had just said it was a bomb dropped on the place. That's something I can see them having no wards or defenses against it.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-29T02:44:45-07:00","id":1399767,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <br /> But no. The &quot;Seven most powerful blood mages on the planet&quot; were most definitely not in the Vienna chantry, nowhere near it in fact. Why? Because even before V5, Ur-Shulgi literally waved his hand and removed a curse imposed by those seven.<br /> </div> </div> </div>Ok my bad. I was refering to the most powerfull thaum. Users.<br /> <br /> The seven were indeed in the chantry. The book says most of them died inside, and whoever survived reest in torpor under the rumble. Was this retconned?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> it was a highly trained military special ops, undergoing a planned raid with the resources from a few countries, in addition to holy relics, and inquisitors armed with true faith. </div> </div> </div>Headcanon.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24832-blailton","name":"blailton","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24832_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2018"},{"key":"Posts:","value":"389"}]},"thankedby":[]},{"date":"2020-06-29T03:46:36-07:00","id":1399781,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>blailton</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399767#post1399767\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Ok my bad. I was refering to the most powerfull thaum. Users.<br /> <br /> The seven were indeed in the chantry. The book says most of them died inside, and whoever survived reest in torpor under the rumble. Was this retconned?</div> </div> </div> </div>The seven are PRESUMED dead but no one can confirm their deaths.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> Headcanon. </div> </div> </div>No, the attack was actually described in THE CAMARILLA.<br /> <br /> They attacked during the day, killed a bunch of ghouls and decapitated sleeping vampires, stole some relics, and then blew up the building with a bomb they blamed on ISIS.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-29T04:07:40-07:00","id":1399783,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399781#post1399781\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> The seven are PRESUMED dead but no one can confirm their deaths.<br /> <br /> <br /> <br /> No, the attack was actually described in THE CAMARILLA.<br /> <br /> They attacked during the day, killed a bunch of ghouls and decapitated sleeping vampires, stole some relics, and then blew up the building with a bomb they blamed on ISIS.</div> </div> </div> </div>And they indeed have true faith (this is even a thing in v5?), money from many countries happy to give it and mc guffin holy relics (what is the roll or system to use those anyway? They exist just as one-use-only? What is their lore? How many?) as that guy said? What are those holy helics anyway. They have invisible cape or similar things?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24832-blailton","name":"blailton","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24832_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2018"},{"key":"Posts:","value":"389"}]},"thankedby":[]},{"date":"2020-06-29T04:52:56-07:00","id":1399789,"title":"","content":"Do you think that's enough? <br /> <br /> A fortified possition filled with gunmen, you can just 'kill a bunch of ghouls, decapitate sleeping vampires, take the time to steal some relics, and blow up the building which certainly isn't filled with their own dead? <br /> <br /> Who did you recruit to make that easy? Did You send in Superman first to pave the way for your Jedi? Were your trenchcoats bulletproof, Did your katanas help you slice through metre thick walls?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-29T05:00:39-07:00","id":1399790,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>blailton</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399783#post1399783\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> And they indeed have true faith (this is even a thing in v5?), money from many countries happy to give it and mc guffin holy relics (what is the roll or system to use those anyway? They exist just as one-use-only? What is their lore? How many?) as that guy said? What are those holy helics anyway. They have invisible cape or similar things?</div> </div> </div> </div>Yes, the Second Inquisition has military grade ordinance, nearly unlimited funding, thousands of soldiers, the covert support of most Western governments, and the entire Society of Leopold that has been revived to its full power at its strongest heights. That's why it's a threat. Why else would vampires be afraid of them?<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>The Camarilla</strong> </div> <div class=\"message\">Every connection one of us has made with another<br /> potentially appears on these maps as a link; with<br /> enough links, a counterintelligence analyst can trace<br /> the pattern even though they have no comprehension<br /> of its true significance. That is how the Second<br /> Inquisition determined that the Tremere chantry<br /> in Vienna was a crucial hub of our activities, even if<br /> they believed it to be \u201cthe vampire conspiracy global<br /> headquarters\u201d rather than the center of one clan\u2019s<br /> activities.<br /> <br /> Regardless of their misperceptions, however,<br /> the IAO, BOES, and ESOG Team X did in fact destroy<br /> the Prime Chantry in 2008 <b>with an as-yet-unknown<br /> combination of holy relics and ground-penetrating<br /> ordnance. </b>The site of the \u201cterrorist atrocity\u201d has<br /> remained cordoned off since then, and the SI keeps a<br /> permanent bureaucratic presence in the UN Office on<br /> Drugs and Crime in the city.</div> </div> </div> </div>And this bit.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> Think of Vienna as if it<br /> was the Vatican City of vampires.<br /> So many powerful Warlocks with<br /> secure havens, well-equipped staff,<br /> and secret magics tucked away in<br /> every nook and cranny. And no<br /> one really to look after it anymore.<br /> <b>The one thing that bugs me<br /> about how Vienna went down is<br /> the inconsistency. I can believe<br /> the Inquisition were behind this,<br /> though don\u2019t ask me how they did<br /> it. But \u2014 and it\u2019s a big but \u2014 why<br /> did they only target the Tremere?</b><br /> And why did they then up the ante<br /> in London by purging the whole<br /> bad batch? Something doesn\u2019t add<br /> up. I kind of wish the Tremere<br /> were still a solid enough unit to<br /> ask to investigate the whole thing. </div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 06-29-2020, 08:08 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-29T05:06:50-07:00","id":1399791,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399789#post1399789\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Do you think that's enough?<br /> <br /> A fortified possition filled with gunmen, you can just 'kill a bunch of ghouls, decapitate sleeping vampires, take the time to steal some relics, and blow up the building which certainly isn't filled with their own dead?<br /> <br /> Who did you recruit to make that easy? Did You send in Superman first to pave the way for your Jedi? Were your trenchcoats bulletproof, Did your katanas help you slice through metre thick walls?</div> </div> </div> </div>Ducheski Revenants die from gunfire the same as mortals. If they broke out the Society of Leopold's most powerful relics, they could basically countermagic anyone they wanted.<br /> <br /> The Society of Leopold isn't helpless either, it has powerful Theruges who are every bit as powerful as non-ancient vampires.<br />","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-29T05:31:58-07:00","id":1399794,"title":"","content":"The security personel of Vienna prime have a big advantage in terms of home turf and fortifications. They have superior cover, vantage points, kill zones, difficult to breach doors, plenty of time to set up traps...<br /> <br /> <br /> They say if you want to attack a castle, you need to outnumber the enemy by a factor of 3. <br /> <br /> You are certainly not going to have an easy time of it.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-29T05:51:12-07:00","id":1399797,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399794#post1399794\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The security personel of Vienna prime have a big advantage in terms of home turf and fortifications. They have superior cover, vantage points, kill zones, difficult to breach doors, plenty of time to set up traps...<br /> <br /> <br /> They say if you want to attack a castle, you need to outnumber the enemy by a factor of 3.<br /> <br /> You are certainly not going to have an easy time of it.</div> </div> </div> </div>Which is why Tremere probably betrayed it. It's still a boring answer.<br /> <br /> I really wish they hadn't gone inside and just had bombed the place.<br /> <br /> &quot;Are you sure there's a castle there, sir?&quot;<br /> <br /> &quot;Yep. The intelligence agencies say we just can't see it.&quot;<br /> <br /> &quot;Well, if you say so.&quot;","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-29T07:05:08-07:00","id":1399812,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1398793#post1398793\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Honestly, the previous Thin Bloods felt like Neonates lite.<br /> <br /> Not nearly as different from regular Cainites as they could be.<br /> <br /> &quot;Oh, we can only get up to a 3 in a Discipline. Woo, most Neonates stop there.&quot;</div> </div> </div> </div>I agree, V5 has really developed thin-bloods in a much more original way and even culturally than previous editions; I love the whole aspect of thin-blood alchemy; makes it possible for players to home-brew known discipline powers. Really liking how they are being treated in this edition.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/337-joe","name":"Joe","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar337_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"31"}]},"thankedby":[]},{"date":"2020-06-29T07:14:55-07:00","id":1399813,"title":"","content":"Vienna, as Langley or other powerful stronghold are more vulnerable to betrayal than exterior attacks. And all people know that Tremere are all very honorable and respectable: <a href=\"https://pics.filmaffinity.com/inside_job-631822570-large.jpg\" target=\"_blank\">https://pics.filmaffinity.com/inside...2570-large.jpg</a>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24202-justycar","name":"Justycar","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24202_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2018"},{"key":"Posts:","value":"320"}]},"thankedby":[]},{"date":"2020-06-29T07:15:08-07:00","id":1399814,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399797#post1399797\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I really wish they hadn't gone inside and just had bombed the place.<br /> .&quot;</div> </div> </div> </div>The Line in the book is:with <b>holy relics and ground-penetrating ordnance</b><br /> <br /> Sounds to me like they just dropped a bomb on it. It does not mention people storming the place. I would still expect some sort of ground operation.<br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26030-mfalkenb","name":"mfalkenb","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2020"},{"key":"Posts:","value":"49"}]},"thankedby":[]},{"date":"2020-06-29T08:02:21-07:00","id":1399824,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Joe</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399812#post1399812\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I agree, V5 has really developed thin-bloods in a much more original way and even culturally than previous editions; I love the whole aspect of thin-blood alchemy; makes it possible for players to home-brew known discipline powers. Really liking how they are being treated in this edition.</div> </div> </div> </div><br /> But the cultural point of thin bloods was to be the<i> racially inferior</i> bottom feeder that'll either get try to stay out of notice, get kicked around, or eat it's way up to godhood. <br /> <br /> With thinblood alchemy (Which metaphysically should not be a thing) you're too happy. People don't want to kick you around because your useful services give you value, but also you've got no incentive to diablerise and become a 'real' vampire because you'll lose your cool alchemy powers if you do that. You are basically playing an easy-life couch vampire, and to me, vampire is not about that. Vampire is about fighting external pressures and rising above the people who want to push you down (through means which may or may not be horrifying) . Vampire existence is the struggle, and I want to struggle. Playing a thinblood used to be the extreme: More pressure, more effort, more achievment; maybe you'll be happy to get recognised as a person, maybe you'll eat yourself from 15th to God, maybe you can work out how to turn human again; none is supposed to be easy. Thinblood alchemy gives you an absurdly comfortable little niche, and that's fundamentally what vampire is not about.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-29T08:09:03-07:00","id":1399828,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399824#post1399824\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> But the cultural point of thin bloods was to be the<i> racially inferior</i> bottom feeder that'll either get try to stay out of notice, get kicked around, or eat it's way up to godhood.<br /> <br /> With thinblood alchemy (Which metaphysically should not be a thing) you're too happy. People don't want to kick you around because your useful services give you value, but also you've got no incentive to diablerise and become a 'real' vampire because you'll lose your cool alchemy powers if you do that. You are basically playing an easy-life couch vampire, and to me, vampire is not about that. Vampire is about fighting external pressures and rising above the people who want to push you down (through means which may or may not be horrifying) . Vampire existence is the struggle, and I want to struggle. Playing a thinblood used to be the extreme: More pressure, more effort, more achievment; maybe you'll be happy to get recognised as a person, maybe you'll eat yourself from 15th to God, maybe you can work out how to turn human again; none is supposed to be easy. Thinblood alchemy gives you an absurdly comfortable little niche, and that's fundamentally what vampire is not about.</div> </div> </div> </div>Except, now they're a threat and must be exterminated when they were beneath notice before to anyone but Gehenna fanatics.<br />","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-29T08:24:49-07:00","id":1399834,"title":"","content":"Why are they a threat though? They're now invested in not diablerising, they can't ghoul, they will never become personally powerful through disciplines, they're easy to kill if you need to go down that route. They are only a threat to gehenna cultists, who are few. The only issue Thin bloods get now is that maybe someone'll want them to be a precious retainer. <br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/25794-mywifeisscary","name":"MyWifeIsScary","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25794_2.png","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2019"},{"key":"Posts:","value":"3711"}]},"thankedby":[]},{"date":"2020-06-29T08:34:49-07:00","id":1399838,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>MyWifeIsScary</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1398671-essay-top-ten-tips-to-running-thin-bloods-in-v5?p=1399834#post1399834\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Why are they a threat though? They're now invested in not diablerising, they can't ghoul, they will never become personally powerful through disciplines, they're easy to kill if you need to go down that route. They are only a threat to gehenna cultists, who are few. The only issue Thin bloods get now is that maybe someone'll want them to be a precious retainer.<br /></div> </div> </div> </div>Gehenna Cultists are actually massive now and probably have as many followers as the main two sects now.<br /> <br /> But even then, the Thin-Bloods are a threat because they don't belong to any of the Clans and are aligned with humans/The Modern Age plus blind irrational prejudice.<br /> <br /> Which Kindred have boats of.<br /> <br /> Plus most Thin Bloods will choose diablerie over Thin Blooded Alchemy unless they cling to their humanity and are VERY GOOD at making meth.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 06-29-2020, 11:37 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2020-06-29T10:37:29-07:00","id":1399882,"title":"","content":"We have already been introduced to the idea of high generation and thin blood characters having special powers. Inceptors were brought up in Time of Thin Blood as having powers unseen before, we now just have a clearer system for it.<br /> <br /> Additionally, with TBA, you can really only have one power on at any given time, and if you switch to something else, it will take time to brew up another dose of the original power. <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24641-sarcasticjazzhands","name":"SarcasticJazzHands","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-n