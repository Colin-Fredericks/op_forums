F8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2023-08-05T18:14:47-07:00","id":1519910,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lysander</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1519796#post1519796\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I know and that is why they will be a self defeating sect in the end as they get older and more powerful and created a niche for themselves. They will be looking at the younger ones as potentiol rivals or dangers and try to fight them and in the end weaken there movement to the stronger and better organized Camarilla.</div> </div> </div> </div>Eh, there's an argument that the Anarchs aren't necessarily hypocrites.<br /> <br /> Their argument doesn't have to be, &quot;We should all be free and equal!&quot;<br /> <br /> When their argument can be, instead, &quot;Fuck these guys and i'll take their stuff. They're assholes anyway.&quot;","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2023-08-06T00:59:48-07:00","id":1519941,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1519909#post1519909\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I mean, they can be absolutely shitty hypocrites and that was baked into things from the VERY FIRST Anarch (Juggler) but that doesn't mean they're not 100% right the Camarilla is a tyrannical oligarchy and you are someone who has every right to rebel.<br /> <br /> &quot;A Lighter Shade of Black&quot; to quote TV tropes.</div> </div> </div> </div>Ehhhh, If were climbing down that pipeline it becomes quite clear that all three sects are terrible, with the anarchs as so short sighted, incompetant and like the carmailla, evil it's hard to consider them good fuys. ESpecially vs earlier editions pragamatic evil carmarilla or even sabbat in some interpretations where youre effectively arguing which is the lesser of three evils and all have good points as to why they're the least terrible The correct move is actually to drop out and go autarkis if you can or try to arrange the system to minimalise your obligations.<br /> <br /> I'd avoid tv tropes since trying to break down complex stories into a series of clumsy building blocks decided by online nerds, it's a fun read but will result in lazy thinking. What I will conceed is that v5 considers the anarchs the protagonists vs the other sects which are antagonists rather than hero vs villain, although they don't do a great job of it imo.","signature":"","edited":{"userid":26986,"user_link":"https://forum.theonyxpath.com/member/26986-ragged-robin","user":"Ragged Robin","date":". 08-06-2023, 05:31 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/26986-ragged-robin","name":"Ragged Robin","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26986_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2021"},{"key":"Posts:","value":"1720"}]},"thankedby":[]},{"date":"2023-08-06T06:48:58-07:00","id":1519949,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Yab</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat#post1518735\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Anyone doing a hybrid of V5 rules but using V20 Path rules?</div> </div> </div> </div>Frankly, after getting the book (finally) myself, and giving it a good think, you honest to god don't really need path rules. Remember &quot;Humanity&quot; isn't <i>Humanity</i>, but a generic tracker over the level of influence left over the Beast, which happens to be <i>called</i> Humanity. Just create a fairly forgiving set of chronicle tenets which emphasize pack loyalty and not denying basic vampiric nature, and leave it to the players to write convictions replicant of older paths -- or working out something new.<br /> <br /> Like I pointed out in your other thread, you can easily make a vampire that's Road of the Beast in all but name with just the rules at hand. It's weird, but it works.<br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/431-theodrim","name":"Theodrim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar431_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1841"}]},"thankedby":[]},{"date":"2023-08-06T18:36:22-07:00","id":1519999,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Theodrim</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1519949#post1519949\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Frankly, after getting the book (finally) myself, and giving it a good think, you honest to god don't really need path rules. Remember &quot;Humanity&quot; isn't <i>Humanity</i>, but a generic tracker over the level of influence left over the Beast, which happens to be <i>called</i> Humanity. Just create a fairly forgiving set of chronicle tenets which emphasize pack loyalty and not denying basic vampiric nature, and leave it to the players to write convictions replicant of older paths -- or working out something new.<br /> <br /> Like I pointed out in your other thread, you can easily make a vampire that's Road of the Beast in all but name with just the rules at hand. It's weird, but it works.<br /></div> </div> </div> </div>I've run V5 Sabbat chronicles extensively. In my experience, what works best is abandoning the Conviction system completely, and instead giving each Path of Enlightenment its own set of Tenets. The reason being that Convictions exist to mitigate stains from Tenet violations, and that doesn't fit a Sabbat game. Sabbat are religious fanatics who have abandoned their ability to mitigate stains with uniquely individual beliefs.<br /> <br /> In other words, they always eat the full three stains for any Path violation, no Conviction mitigation possible. Sabbat have Path of Enlightenment Tenets, no more, no less. There is no general, universal set of Tenets for them, nor are there individual Convictions.<br /> <br /> As I said, I have run many, many V5 Sabbat games, and I have experimented considerably, and this is what I have found works best.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/3598-cajunkhan","name":"CajunKhan","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3598_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2014"},{"key":"Posts:","value":"1700"}]},"thankedby":[]},{"date":"2023-08-06T23:25:31-07:00","id":1520019,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CajunKhan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1519999#post1519999\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I've run V5 Sabbat chronicles extensively. In my experience, what works best is abandoning the Conviction system completely, and instead giving each Path of Enlightenment its own set of Tenets. The reason being that Convictions exist to mitigate stains from Tenet violations, and that doesn't fit a Sabbat game. Sabbat are religious fanatics who have abandoned their ability to mitigate stains with uniquely individual beliefs.<br /> <br /> In other words, they always eat the full three stains for any Path violation, no Conviction mitigation possible. Sabbat have Path of Enlightenment Tenets, no more, no less. There is no general, universal set of Tenets for them, nor are there individual Convictions.<br /> <br /> As I said, I have run many, many V5 Sabbat games, and I have experimented considerably, and this is what I have found works best.</div> </div> </div> </div>An idea I played with before i decided against running v5 altogether was to allow non human touchstones. For example the pack as a collective or say a death and soul vampires laboratory.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/26986-ragged-robin","name":"Ragged Robin","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26986_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2021"},{"key":"Posts:","value":"1720"}]},"thankedby":[]},{"date":"2023-08-07T05:50:45-07:00","id":1520030,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Ragged Robin</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1520019#post1520019\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> An idea I played with before i decided against running v5 altogether was to allow non human touchstones. For example the pack as a collective or say a death and soul vampires laboratory.</div> </div> </div> </div>I've experimented with that. I don't find it really works. Touchstones are for mitigating stains. Sabbat shouldn't be able to mitigate stains. I've found it important in Sabbat games that you represent that dogmatic fanaticism of the Path follower by making them incapable of mitigating stains with Convictions. They've sacrificed that unique ability of Humanity.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/3598-cajunkhan","name":"CajunKhan","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3598_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2014"},{"key":"Posts:","value":"1700"}]},"thankedby":[]},{"date":"2023-08-08T23:23:02-07:00","id":1520172,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CajunKhan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1520030#post1520030\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I've experimented with that. I don't find it really works. Touchstones are for mitigating stains. Sabbat shouldn't be able to mitigate stains. I've found it important in Sabbat games that you represent that dogmatic fanaticism of the Path follower by making them incapable of mitigating stains with Convictions. They've sacrificed that unique ability of Humanity.</div> </div> </div> </div>That's not a bad idea, I tend to be lean into into alternative outlooks as valid in the push against the beast. I incorperated touchstones as a background in previous edition were you get xp reduction for path/humanity rating dots. Since its an advantage rather than a mandatory I don't really feel obliged to make it exclusive.<br /> <br /> although I personally find the mechanisation of interpersonal relationships a little odd in off itself. Especially as they're largely punitive as presented.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26986-ragged-robin","name":"Ragged Robin","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26986_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2021"},{"key":"Posts:","value":"1720"}]},"thankedby":[]},{"date":"2023-08-10T15:26:32-07:00","id":1520326,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CajunKhan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1519999#post1519999\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I've run V5 Sabbat chronicles extensively. In my experience, what works best is abandoning the Conviction system completely, and instead giving each Path of Enlightenment its own set of Tenets. The reason being that Convictions exist to mitigate stains from Tenet violations, and that doesn't fit a Sabbat game. Sabbat are religious fanatics who have abandoned their ability to mitigate stains with uniquely individual beliefs.<br /> <br /> In other words, they always eat the full three stains for any Path violation, no Conviction mitigation possible. Sabbat have Path of Enlightenment Tenets, no more, no less. There is no general, universal set of Tenets for them, nor are there individual Convictions.<br /> <br /> As I said, I have run many, many V5 Sabbat games, and I have experimented considerably, and this is what I have found works best.</div> </div> </div> </div>The issue is not all vampires on paths are Sabbat, and not all Sabbat are &quot;true believers&quot;. Even the Camarilla -- the sect that nominally forbids paths -- could and did have vampires (secretly) on paths. More humane paths for certain, but still walkers of paths. Meanwhile, the majority of Sabbat simply play-act religious zeal when called upon, and otherwise just go about their usual business. Assuming you're not simply ruling the only vampires left in the Sabbat are crazies, and the ones with half a brain either got whacked or abandoned the sect already.<br /> <br /> Which is a fine enough interpretation, but that's your table. I'm going for -- and approve of -- an interpretation of &quot;alternate moralities&quot; that are inclusive to other sects and independents. <i>Especially</i> for the case of Sabbat vampires which abandoned their sect -- or were driven from it -- and found a place among the Anarchs (for whatever motive).","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/431-theodrim","name":"Theodrim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar431_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1841"}]},"thankedby":[]},{"date":"2023-08-10T17:09:39-07:00","id":1520340,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Theodrim</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1520326#post1520326\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> The issue is not all vampires on paths are Sabbat, and not all Sabbat are &quot;true believers&quot;. .</div> </div> </div> </div>For those, I give them the Humanistic tenets from the main book. Such characters tend to lose Humanity quickly in my games, which is generally a prelude to them learning a Path. Such characters sometimes have Convictions early on, but they rarely keep them for long, since the Sabbat looks down on Touchstones, and punish Shovelheads who maintain them. Moreover, those Convictions are the usual Humanity Convictions, i.e. slightly darker but still very human beliefs.<br /> <br /> I find that at no point are Convictions especially important. Some players like to roleplay the tragedy of having Convictions, and therefore Touchstones, and eventually being forced to kill those Touchstones or face execution themselves. But that's just one story in a long campaign. And, of course, once the Touchstone dies, the Conviction dies with it.<br /> <br /> Most players start with Humanity, and therefore the standard Humanistic tenets, and either never have or quickly lose their Touchstones, and then switch to Paths, which don't lend themselves to Conviction mitigation for the reasons I stated in earlier posts and therefore no Touchstones are required.<br /> <br /> A Path is not a set of Convictions. It is not a way to mitigate stains from actions in opposition to Humanity. A Path is a fanatical set of beliefs so strong that it functions in a mechanically identical way to Humanity tenets, but requires a dogmatic fanaticism that doesn't lend itself to having Convictions or Touchstones.<br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3598-cajunkhan","name":"CajunKhan","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3598_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2014"},{"key":"Posts:","value":"1700"}]},"thankedby":[]},{"date":"2023-08-11T09:22:46-07:00","id":1520392,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CajunKhan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1520340#post1520340\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> For those, I give them the Humanistic tenets from the main book. Such characters tend to lose Humanity quickly in my games, which is generally a prelude to them learning a Path. Such characters sometimes have Convictions early on, but they rarely keep them for long, since the Sabbat looks down on Touchstones, and punish Shovelheads who maintain them. Moreover, those Convictions are the usual Humanity Convictions, i.e. slightly darker but still very human beliefs.<br /> <br /> I find that at no point are Convictions especially important. Some players like to roleplay the tragedy of having Convictions, and therefore Touchstones, and eventually being forced to kill those Touchstones or face execution themselves. But that's just one story in a long campaign. And, of course, once the Touchstone dies, the Conviction dies with it.<br /> <br /> Most players start with Humanity, and therefore the standard Humanistic tenets, and either never have or quickly lose their Touchstones, and then switch to Paths, which don't lend themselves to Conviction mitigation for the reasons I stated in earlier posts and therefore no Touchstones are required.<br /> <br /> A Path is not a set of Convictions. It is not a way to mitigate stains from actions in opposition to Humanity. A Path is a fanatical set of beliefs so strong that it functions in a mechanically identical way to Humanity tenets, but requires a dogmatic fanaticism that doesn't lend itself to having Convictions or Touchstones.<br /></div> </div> </div> </div>I think you're missing some minutiae about the points I'm making. The first thing is convictions serve more purpose than simply mitigating stains -- a character gains stains from violating convictions, as well. Functionally, they're just individualized tenets which can be lost over time.<br /> <br /> I personally dislike the &quot;touchstone = conviction, and if the touchstone is lost so is the conviction&quot; rule, and would disregard it or allow for non-human touchstones. But even then, touchstones merely represent the personification of that conviction, and humanity is a varied beast with <i>many</i> personifications, and nothing states vampires must interact with or have personal connection to their touchstone (to wit, the book gives examples of touchstones in which there's no feasible way the vampire could ever have met their touchstone). An inhumane vampire could well have a touchstone that is, for example, a serial killer, a third-world despot, or a war criminal walking free or imprisoned in the Hague. Hell, there's <i>lots</i> of room for some really meaty storytelling in having a touchstone that is a completely disgusting human being, and how one might deal with that.<br /> <br /> I'm gonna go into some pretty skeevy real-world politics on this one, so be forewarned but bear with me. Let's take, for example, a Lasombra on a Path of Night analog: a conviction for that might be something to the tune of &quot;leave no being untainted by sin&quot;. For all intents and purposes, the character's touchstone for this conviction could be a former CIA operative who participated in raids, armed and trained terrorists, ran a black site, coordinated death squads, and/or personally tortured suspects during the war on terror. Just some of the most monstrous shit humanity has on tap, and to the Lasombra this mortal represents perfection in the art of spreading pain, hatred, and damnation to humanity.<br /> <br /> We don't even have to go to that extreme. A vampire on a Path of Power and the Inner Voice analog, with a conviction of &quot;strive for control by any means necessary&quot; could have as a touchstone...hell, pick a tech bro, the sleazier and wealthier the better. You can't convince me Steve Jobs <i>wasn't</i> on the Path of Power and the Inner Voice, <i>in real life</i>. Dig hard enough, you can identify possibilities for entirely human, still mortal, touchstones even for a path like Caine: a pimp, human trafficker, sweatshop owner, or slumlord treats humans like livestock (and gets away with it) <i>just fine</i>.<br /> <br /> All that loops back to the original point: tenets and convictions <i>don't have to be moral, ethical, or humane</i>. <b>Just because the &quot;Beast control&quot; tracker is <i>called</i> Humanity, doesn't mean it's equitable with the Road/Path of Humanity</b>. Regardless what v5's authors and designers want to claim about &quot;getting back to gothic horror roots&quot; and morality play-esque one true wayism. Touchstones likewise don't have to be good or innocent people, and to be frank, <i>it's better storytelling if they aren't</i>. This is something we already inherently know, as &quot;vampire discovers touchstone isn't the person the vampire thought they were&quot; is practically a rote plot hook for a chronicle.<br /> <br /> Hypocritical, contradictory, even antithetical to professed Sabbat virtues for them to have &quot;favorite humans&quot;? absolutely. Just like everything else about the Sabbat.<br /> <br /> Now, having discussed issues with touchstones, let's loop back around to chronicle tenets. Like I said in the other thread, not every path plays well with others. Those which do, are the ones with shared ethics. A feral, necronomist, and nihilist differ on a whole lot of things, but one thing they all share in common is they only kill out of necessity; they'll beg to differ with a noddist or unifier on the subject, because the former attributes zero innate value to life and the latter kills as a matter of expediency.<br /> <br /> Chronicle tenets is the perfect place for those shared ethics, because it builds the basis for a cohesive pack which won't be at each other's throats over major quandaries like the utility of the Beast, the value of killing versus dispensation by non-lethal means, the meaning of vampirism or the purpose of vampires, or simple ingroup/outgroup dynamics (for those paths which feature them). That's where the storyteller can say &quot;<i>this</i> group of paths is okay, but <i>that</i> group of paths don't fit this chronicle and therefore won't be allowed&quot;.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/431-theodrim","name":"Theodrim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar431_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1841"}]},"thankedby":[]},{"date":"2023-08-11T20:38:02-07:00","id":1520428,"title":"","content":"Lore about the history of various Roads and Paths also doesn't really line up with this idea that pledging yourself to one only allows for unswerving adherence to its decrees or unmitigated degeneration. The Paths themselves were deliberate and concerted efforts to alter the old Roads to make them more suited to Sabbat agendas in many cases, such as the Road of the Beast in comparison to the Path of the Feral Heart, the Path of Blood vs the Path of Caine, the Path of Chivalry vs the Path of Honorable Accord, the Road of Night vs the modern Path of Night (which is also notable for having internal variants with different Virtues in previous editions), and so forth. Some of this could simply be outsiders creating new frameworks for fresh recruits to be inducted into without having to reconcile their divergence from the &quot;source material&quot;, but this can't be 100% true for all of them. For example, the Path of Caine is notably tied to the developing belief systems of Dastur Anosh as he struggled with the teachings of the Path of Blood.<br /> <br /> We also see similar variations with Paths/Roads outside of the Sabbat, such as with the different versions of the Path of Paradox, and the Path of the Warrior being developed as a reaction against perceived inadequacies of the Path of Typhon (and the Path of Typhon itself has some notable differences from the Road of the Serpent that could suggest similar ideological drift). Perhaps even more dramatically, there's the fact that adherents of the Path of Blood could conceive of and internalize changes to the Path for the sake of survival while subject to the Tremere curse, as opposed to simply wallowing just a step short of Wassail at all times as a best-case scenario until Ur-Shulgi intervened.<br /> <br /> I don't see how these sorts of changes would be possible without at least some ability to develop idiosyncratic beliefs about what truly matters in a Road or Path and prioritize certain values or teachings over others accordingly, and this sounds like something that would occupy the same conceptual space as V5 Convictions.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/27894-paramecius","name":"Paramecius","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar27894_1.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2023"},{"key":"Posts:","value":"29"}]},"thankedby":[]},{"date":"2023-08-11T21:34:00-07:00","id":1520429,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Yab</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1518835#post1518835\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I do like the idea of the Ravnos and Salubri antitribu becoming more prominent within the Sabbat due to (at least by old canon) their Antedeluvians actually being destroyed. Has V5 covered why the Tzimisce are starting to recede from the Sabbat, if not so much as the Lasombra?</div> </div> </div> </div>Generally, the Sabbat has become such a shit show of cannon fodder that the Tzimisce have included a lot of defections to the Anarchs.<br /> <br /> They won't lower themselves to the Camarilla but the Sabbat has become almost shovel heads and people hundled down in bunkers.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Paramecius</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1520428#post1520428\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Lore about the history of various Roads and Paths also doesn't really line up with this idea that pledging yourself to one only allows for unswerving adherence to its decrees or unmitigated degeneration. The Paths themselves were deliberate and concerted efforts to alter the old Roads to make them more suited to Sabbat agendas in many cases, such as the Road of the Beast in comparison to the Path of the Feral Heart, the Path of Blood vs the Path of Caine, the Path of Chivalry vs the Path of Honorable Accord, the Road of Night vs the modern Path of Night (which is also notable for having internal variants with different Virtues in previous editions), and so forth. Some of this could simply be outsiders creating new frameworks for fresh recruits to be inducted into without having to reconcile their divergence from the &quot;source material&quot;, but this can't be 100% true for all of them. For example, the Path of Caine is notably tied to the developing belief systems of Dastur Anosh as he struggled with the teachings of the Path of Blood.<br /> <br /> We also see similar variations with Paths/Roads outside of the Sabbat, such as with the different versions of the Path of Paradox, and the Path of the Warrior being developed as a reaction against perceived inadequacies of the Path of Typhon (and the Path of Typhon itself has some notable differences from the Road of the Serpent that could suggest similar ideological drift). Perhaps even more dramatically, there's the fact that adherents of the Path of Blood could conceive of and internalize changes to the Path for the sake of survival while subject to the Tremere curse, as opposed to simply wallowing just a step short of Wassail at all times as a best-case scenario until Ur-Shulgi intervened.<br /> <br /> I don't see how these sorts of changes would be possible without at least some ability to develop idiosyncratic beliefs about what truly matters in a Road or Path and prioritize certain values or teachings over others accordingly, and this sounds like something that would occupy the same conceptual space as V5 Convictions.</div> </div> </div> </div>\u200b<br /> I think the current status of the Sabbat is due to the fact that the current leadership of the Sabbat aren't teaching them the REAL Paths anymore. They're teaching them a bastardized version designed to just encourage them to throw their Blood Bonded degenerate insane bodies into the fray to die at the hands of the Ancients awoken by the Gehenna War.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":12002,"user_link":"https://forum.theonyxpath.com/member/12002-ctphipps","user":"CTPhipps","date":". 08-12-2023, 12:38 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2023-08-12T07:23:52-07:00","id":1520446,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1520429#post1520429\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Generally, the Sabbat has become such a shit show of cannon fodder that the Tzimisce have included a lot of defections to the Anarchs.<br /> <br /> They won't lower themselves to the Camarilla but the Sabbat has become almost shovel heads and people hundled down in bunkers.</div> </div> </div> </div>Also keep in mind that the major Path among the Tzimsci, the Path of Metamorphosis does not work at all with the new pack-based systems you see in Sabbat packs. So Tzimisci on the Path of Metamorphosis have no choice but to choose to either leave their Path or leave the Sabbat. Since the Camarilla doesn't welcome vampires on Paths, the Tzimisci who forego the Sabbat have no choice but to join the Anarchs. So I expect that among the Tzimisci in the Anarchs, a large majority of them will be Metamorphosists.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/741-anubisxy","name":"AnubisXy","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar741_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"5693"}]},"thankedby":[]},{"date":"2023-08-12T08:31:40-07:00","id":1520450,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1520429#post1520429\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I think the current status of the Sabbat is due to the fact that the current leadership of the Sabbat aren't teaching them the REAL Paths anymore. They're teaching them a bastardized version designed to just encourage them to throw their Blood Bonded degenerate insane bodies into the fray to die at the hands of the Ancients awoken by the Gehenna War.</div> </div> </div> </div>Even prior to the v5 metaplot changes, shovelheads were never intended to survive, and it seemed largely preferred by true Sabbat they didn't. They were never really more than disposable &quot;human&quot; wave/shock troops/suicide attackers, and the damage they caused the Masquerade on their way to Final Death was almost always greater than whatever they might do to Camarilla vampires themselves. If one here or there survived sieges and crusades long enough to demonstrate greater value, they'd be given creation rites, sure; but, that was an unintentional value-add opposed to the end.<br /> <br /> That is, if it's to be considered a value-add in any context. Sabbat elders absolutely would have taken note of the Pander &quot;revolt&quot;, and come to an understanding that allowing mass embraces room to organize for their own interests, is almost certainly <i>not</i> in elders' interests. As such, it makes a lot more sense for true Sabbat to just allow shovelheads to degenerate into Wassail, opposed to put time and effort into teaching a vampire that was never intended to survive. Wights are simply more effective for their designated purpose than any vampire with so much as a lingering scrap of humanity left, and it provides a ready-made excuse to put them down once they're no longer needed.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/431-theodrim","name":"Theodrim","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar431_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1841"}]},"thankedby":[]},{"date":"2023-08-12T15:11:51-07:00","id":1520476,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/vampire-the-masquerade/1518735-playing-v5-sabbat?p=1520429#post1520429\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I think the current status of the Sabbat is due to the fact that the current leadership of the Sabbat aren't teaching them the REAL Paths anymore. They're teaching them a bastardized version designed to just encourage them to throw their Blood Bonded degenerate insane bodies into the fray to die at the hands of the Ancients awoken by the Gehenna War.</div> </div> </div> </div>I hadn't even thought of the V5 changes to Path ethics when I was writing, probably because I try not to think of them as a general rule, but they would be quite consistent with this view. The Necronomists are exhorted to &quot;hasten death\u2019s arrival, from humblest insect to the much-lamented flower of human life&quot;, which almost makes me think that the Beelzebeatit ritual from the same book was devised just so they wouldn't be too busy with their contractual obligation to squash bugs to do anything else with their time. The Albigensians now strive to &quot;do whatever the Beast wants them to do&quot;; this means a lot of impassioned and arbitrary killing without any apparent fear of degeneration, which would basically leave them at Path ratings of 3 at best (or more likely 1) in terms of the V20 hierarchy of sins.<br /> <br /> Sure, I've mentioned examples of variants with shifting values, and in a similar vein there is one Path of Lilith variant even in the V20 Black Hand book that doesn't count killing among the sins against the Path, but it's hard to imagine &quot;doing whatever the Beast wants you to do&quot; being a sufficient basis for an actual functioning Path. The Path of Screams comes close, but even they have slavish devotion to infernal masters to keep their own Beasts at bay.<br /> <br /> Edit: I was lazy and took my direct quote for the Path of Cathari from the Paradox wiki summary for the Path. In the interest of referencing the actual source, I'll quote the pertinent corresponding bit from its listed ethics: &quot;Indulge every temptation; give oneself wholly to the wiles of the Beast.&quot; So yeah. Six of one and half a dozen of the other.","signature":"","edited":{"userid":27894,"user_link":"https://forum.theonyxpath.com/member/27894-paramecius","user":"Paramecius","date":". 08-12-2023, 06:22 PM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/27894-paramecius","name":"Paramecius","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar27894_1.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2023"},{"key":"Posts:","value":"29"}]},"thankedby":[]}]}