onyxpath.com/core/avatars/0/0/6/0/4/5/avatar11558_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2016"},{"key":"Posts:","value":"1699"}]},"thankedby":[]},{"date":"2020-05-07T19:43:11-07:00","id":1386597,"title":"","content":"No worries fam and hey, I feel that. I've bowled a late night bowl or two.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11637-gryffon15","name":"Gryffon15","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11637_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2016"},{"key":"Posts:","value":"900"}]},"thankedby":[]},{"date":"2020-05-08T00:46:09-07:00","id":1386633,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/11558-nosimplehiway\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar11558_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"11558\" data-vbnamecard=\"11558\">Nosimplehiway</a> I Liked your post. My sister and her friends used to hang at Waffle House late at night when they were in college.<br /> <br /> If any of you guys don\u2019t know what a Black Cat bar is, check out Anything Goes by Madison Smartt Bell. Awesome book! Plus he told a great story one time about how him and his wife tried to order Fish and Chips at a little restaurant in the back woods of Tennessee.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"","name":"Guest","avatar":"https://forum.theonyxpath.com/core/images/default/default_avatar_large.png","title":"","rank":0,"rank-name":"","custom":[]},"thankedby":[]},{"date":"2020-05-08T17:45:37-07:00","id":1386838,"title":"","content":"<span class=\"b-bbcode-user js-bbcode-user\">Guest</span> <br /> <br /> The great thing about the Awful Waffle is that it's a laid-back, relatively non-judgmental space. There isn't the social pressure of a bar, or the expense of hosting a bunch of people at my house. Just a great hang-out for long, long bull sessions. Just keep the tips flowing, since servers lose money when table turnover stops.<br /> <br /> For Gangrel, I can guarantee that at 2am on Thursday, the guy with the glowing eyes and the furry ears will only be the third strangest person in the joint. <img src=\"https://forum.theonyxpath.com/core/images/smilies/wink.png\" border=\"0\" alt=\"\" title=\"Wink\" smilieid=\"4\" class=\"inlineimg\" /><br /> <br /> I looked at the excerpt on Google books. It looks great. I'll need to add that to my reading queue. Thanks for the suggestion!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11558-nosimplehiway","name":"Nosimplehiway","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11558_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2016"},{"key":"Posts:","value":"1699"}]},"thankedby":[]},{"date":"2020-05-08T19:12:46-07:00","id":1386864,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/11558-nosimplehiway\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar11558_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"11558\" data-vbnamecard=\"11558\">Nosimplehiway</a> welcome \ud83d\ude0a","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"","name":"Guest","avatar":"https://forum.theonyxpath.com/core/images/default/default_avatar_large.png","title":"","rank":0,"rank-name":"","custom":[]},"thankedby":[]}]}