les for it. However, it came long after V20 was originally published so.","signature":"<hr class=\"b-divider\"/><br/><div align=\"center\"><div align=\"left\"><a href=\"http://www.nodiatis.com/personality.htm\" target=\"_blank\"><img itemprop=\"image\" class=\"bbcode-attachment\" src=\"http://www.nodiatis.com/pub/7.jpg\" border=\"0\" alt=\"\" /></a></div></div>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26764-vilenecromancer","name":"Vilenecromancer","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26764_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2021"},{"key":"Posts:","value":"247"}]},"thankedby":[]}]}