res.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26110-ramon-nogueras","name":"Ramon Nogueras","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar26110_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2020"},{"key":"Posts:","value":"10"}]},"thankedby":[]}]}