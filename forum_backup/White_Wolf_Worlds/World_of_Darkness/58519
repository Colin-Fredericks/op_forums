eonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1129_3.jpg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1620"}]},"thankedby":[]},{"date":"2014-05-22T05:11:29-07:00","id":145562,"title":"","content":"Though it's been mentioned, for TV Forever Knight was excellent. X-Files, of course, and even the Highlander TV series.<br /> <br /> As well, Batman: The Animated Series, and Disney's Gargoyles were excellent World of Darkness inspiration.<br /> <br /> Oh, and The Dresden Files short lived TV series.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3078-coffee-zombie","name":"Coffee Zombie","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3078_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"15"}]},"thankedby":[]},{"date":"2014-05-22T08:28:57-07:00","id":145678,"title":"","content":"Has anyone seen Moonlight or Beign human? great shows","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/122-talum","name":"Talum","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar122_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"101"}]},"thankedby":[]},{"date":"2014-05-22T11:09:04-07:00","id":145831,"title":"","content":"The Crow Series: Great way to show the life of a Risen Wraith and was more than likely the inspiration for a lot of WTO stuff<br /> <br /> True Blood<br /> <br /> Black Lagoon: Yes this show has nothing to do with the supernatural but I'd like to think of <span style=\"font-family:sans-serif\"><span style=\"color:#252525\"><span style=\"font-size:14px\">Roanapur as a good example on how a vampire run city is like.</span></span></span><br /> <br /> <span style=\"font-family:sans-serif\"><span style=\"color:#252525\"><span style=\"font-size:14px\">New Getter Robo: That one flash back to the future where everyone is fused with a giant robot of their own and searching for replacement parts seems like a very grim dark future if Threat Null took over.<br /> <br /> John Carpenter's Vampires </span></span></span><br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2256-goblin404","name":"Goblin404","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2256_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"71"}]},"thankedby":[]},{"date":"2014-05-23T00:05:49-07:00","id":146472,"title":"","content":"The Lost Boys<br /> Near Dark<br /> John Carpenter's Vampires<br /> The Crow<br /> The Doom Generation<br /> City of Lost Children<br /> Underworld<br /> Pan's Laberinth<br /> Hellraiser (Cenobites are a great look for the more obvious Nephandi)<br /> Pumpkinhead<br /> American Horror Story<br /> Buffy and Angel<br /> Dollhouse (great for the conspiracy angle)<br /> The Bride with the White Hair<br /> Dog Soilders<br /> Brick<br /> Being Human<br /> Lost Girl<br /> The Matrix<br /> The Hunger<br /> The Cabinet of Doctor Caligari<br /> Nosferatu<br /> The Craft<br /> Supernatural<br /> Fringe<br /> Blood +<br /> Ga Rei Zero<br /> just off the top of my head","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2708-lost_in_the_hedge777","name":"Lost_in_the_Hedge777","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2708_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2014"},{"key":"Posts:","value":"60"}]},"thankedby":[]},{"date":"2014-05-23T01:55:46-07:00","id":146514,"title":"","content":"Wraith:<br /> Jacob's Ladder<br /> The Others<br /> The Orphanage (El Orfanato)<br /> The Devil's Backbone (El Espinazo del Diablo)<br /> What Dreams May Come<br /> The Lovely Bones<br /> <br /> Vampire:<br /> Thirst (2009)<br /> Byzantium<br /> Only Lovers Left Alive<br /> Cronos<br /> <br /> Changeling:<br /> The Fisher King<br /> The Imaginarium of Doctor Parnassus<br /> The Adventures of Baron Munchausen<br /> (Terry Gilliam is probably a Changeling)<br /> <br /> Not supernatural, but creepy good flavor:<br /> Stoker<br /> The Hole (2001)<br /> <br /> Silly, but fun:<br /> Vamps<br /> Vampire Academy<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Lost_in_the_Hedge777</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/58519-favorite-world-of-darkness-esque-movies-and-tv-shows?p=146472#post146472\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The Cabinet of Doctor Caligari</div> </div> </div> </div>Which one(s)? Netflix is showing me three.","signature":"<hr class=\"b-divider\"/><br/><span style=\"color:#800000\"><b>Demon Cat</b></span><br /> <br /> <a href=\"http://flamingporcupine.net/\" target=\"_blank\">Illuminated Dark Ages character sheets and more</a>","edited":{"userid":10,"user_link":"https://forum.theonyxpath.com/member/10-demon-cat","user":"Demon Cat","date":". 05-23-2014, 05:01 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/10-demon-cat","name":"Demon Cat","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avat