ath.com/core/avatars/0/0/6/0/4/5/avatar225_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"292"}]},"thankedby":[]},{"date":"2018-09-04T12:05:57-07:00","id":1251455,"title":"","content":"Dunno anything about Sami people or culture. But I will happily talk about Scandinavia, especially Denmark. <img src=\"https://forum.theonyxpath.com/core/images/smilies/tongue.png\" border=\"0\" alt=\"\" title=\"Stick Out Tongue\" smilieid=\"5\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/>Freelance Writer and Storyteller's Vault contributor. Find my work here: <a href=\"http://www.storytellersvault.com/index.php?affiliate_id=17903\" target=\"_blank\">http://www.storytellersvault.com/ind...liate_id=17903</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1535-jackob","name":"Jackob","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1535_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"293"}]},"thankedby":[]},{"date":"2018-09-04T12:37:25-07:00","id":1251468,"title":"","content":"Excellent we should find a more efficient way to communicate, but beyond that i think we have pretty decent starting point. Yeah i know Sami culture and history is a massive minefield to enter, but just as i think it would be weird to write about native americans without having a native american consultant. I think it would be weird if we don't find a Sami person to help with the process.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8100-caedus","name":"Caedus","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2015"},{"key":"Posts:","value":"300