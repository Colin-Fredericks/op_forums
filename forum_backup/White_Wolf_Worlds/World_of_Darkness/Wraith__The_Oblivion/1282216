.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24734_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2018"},{"key":"Posts:","value":"60"}]},"thankedby":[]},{"date":"2019-01-23T21:20:46-08:00","id":1282380,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>DeadMan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/wraith-the-oblivion/1282216-book-of-oblivion?p=1282329#post1282329\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">i did read somewhere that Onyx is going to open up wraith like they did for Vampire, Werewolf &amp; Mage. that could be fun to see if people will get there own work published.</div> </div> </div> </div>You mean the ST Vault? <a href=\"https://www.storytellersvault.com/browse.php?filters=0_45628_0_0_0_0\" target=\"_blank\">If so, that's been up for Wraith. </a>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4418-tasti-man-lh","name":"tasti man LH","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4418_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1850"}]},"thankedby":[]},{"date":"2019-01-30T19:43:52-08:00","id":1283835,"title":"","content":"I'd laugh and laugh if it were a sourcebook with all blank pages.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/3505-matt-the-bruins-fan","name":"Matt the Bruins fan","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3505_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2014"},{"key":"Posts:","value":"2401"}]},"thankedby":[]},{"date":"2019-01-31T11:20:18-08:00","id":1283970,"title":"","content":"From the WtO 20 Kickstarter Update: RichT here:<br /> <b>Deluxe Wraith 20</b> and the <b>Wraith20 Screen</b> are being packaged up, Rich &quot;Deadguy&quot; Dansky has signed his copies for those of you who pledged for those, and the shipper is getting ready for shipping!<br /> The <b>Book of Oblivion</b> is in Editing and Art Direction, which often happen at the same time since both need the text to be finished first.<br /> The <b>Wraith20 Fiction Anthology</b> writers are writing. <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1208-grumpy-rpg-reviews","name":"Grumpy RPG Reviews","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1208_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1888"}]},"thankedby":[]},{"date":"2019-02-26T01:13:10-08:00","id":1292095,"title":"","content":"Book of Oblivion is now in Post-Editing Development.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4418-tasti-man-lh","name":"tasti man LH","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4418_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"1850"}]},"thankedby":[]},{"date":"2019-02-26T17:39:37-08:00","id":1292303,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Matt the Bruins fan</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/wraith-the-oblivion/1282216-book-of-oblivion?p=1283835#post1283835\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'd laugh and laugh if it were a sourcebook with all blank pages.</div> </div> </div> </div>That'd be the easiest word count I ever got paid to produce.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>tasti man LH</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/the-classic-world-of-darkness/wraith-the-oblivion/1282216-book-of-oblivion?p=1292095#post1292095\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Book of Oblivion is now in Post-Editing Development.</div> </div> </div> </div>One step closer to... well, you know.<br /> <br /> - C.","signature":"<hr class=\"b-divider\"/><br/>Clayton A. Oliver | Formerly Ubiquitous<br /> <br /> <i>When the half-light starts to rise/And the long gone come back again<br /> After the shortcuts and the highs/Comes the pain<br /> And the rain</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2966-tegyrius","name":"Tegyrius","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2966_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"69"}]},"thankedby":[]},{"date":"2019-02-26T18:41:04-08:00","id":1292323,"title":"","c