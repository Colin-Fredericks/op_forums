>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/51-marin","name":"marin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2019"}]},"thankedby":[]},{"date":"2019-02-26T23:55:03-08:00","id":1292397,"title":"","content":"And I've now completed post-editing development!","signature":"<hr class=\"b-divider\"/><br/><b><span style=\"color:#000080\">Matthew Dawkins</span><br /> <span style=\"color:#000080\">In-House Developer for Onyx Path Publishing</span></b><br /> <br /> <i><span style=\"font-family:arial\"><b><span style=\"color:#008080\">Website: </span><a href=\"http://www.matthewdawkins.com\" target=\"_blank\"><span style=\"color:#008080\">https://www.matthewdawkins.com</span></a><br /> <span style=\"color:#008080\">Patreon: </span><a href=\"https://www.patreon.com/matthewdawkins\" target=\"_blank\"><span style=\"color:#008080\">https://www.patreon.com/matthewdawkins</span></a></b></span></i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":3}],"user":{"link":"https://forum.theonyxpath.com/member/152-the-gentleman-gamer","name":"The Gentleman Gamer","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar152_2.jpeg","title":"Member","rank":6,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1698"}]},"thankedby":[]},{"date":"2019-02-27T01:19:34-08:00","id":1292404,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>No One of Consequence</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/