rurpg.com/en/product/481581/powered-inspiration-bundle\" target=\"_blank\">Powered Inspired</a> - Powered Characters using Inspiration and Gifts<br /> <a href=\"https://www.drivethrurpg.com/product/413362/Fists-and-Tomes-BUNDLE\" target=\"_blank\">Fists and Tomes</a> - Inspired Martial Arts and Mysticism for Talents<br /> <a href=\"https://www.drivethrurpg.com/en/product/492147/supertech\" target=\"_blank\">Supertech</a> - Super Science in the hands of Talents","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24985-mateus-luz","name":"Mateus Luz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24985_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2019"},{"key":"Posts:","value":"2950"}]},"thankedby":[]},{"date":"2022-07-21T05:16:47-07:00","id":1487368,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mateus Luz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1487200-trinity-fan-era-cosmic-minds-psi-in-1950s-70s?p=1487358#post1487358\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I really like the idea. Is teh idea to keep it more or less focused in the Cold War? There are so many good ideas for spy games and adding some psi to it may be really fun...</div> </div> </div> </div>If you like, it certainly can be. MKUltra is already mentioned as inspiration. <img src=\"https://forum.theonyxpath.com/core/images/smilies/cool.png\" border=\"0\" alt=\"\" title=\"Cool\" smilieid=\"6\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2022-07-21T05:21:21-07:00","id":1487369,"title":"","content":"Main question - <b>HOW to make Psi, even in limited fashion, as experiments in 50s-70s?</b> Sara Kaur is somewhere in India there, as first (?) Psiad. No Prometheus Chambers ( yet ) and only starting experiments? Experiments leading to Moment of Inspiration then?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2022-07-21T05:36:49-07:00","id":1487374,"title":"","content":"Cap psi in 3-4 and only psiads (mesmerists are basically psiads), or play with Mesmerists from Adventure!<br /> <br /> Or even better, make psi available only using inspired tech (psi induction drugs, crystaltech items, things like that).<br /> <br /> The last option is to use the Aexpanssion ideas of Psions in modern world (that we will have as a Tasty bit soon).","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.drivethrurpg.com/en/product/481584/house-rules-bundle-bundle\" target=\"_blank\">House Rules - The Bundle</a> - House Rules for Everyone<br /> <a href=\"https://www.drivethrurpg.com/en/product/481581/powered-inspiration-bundle\" target=\"_blank\">Powered Inspired</a> - Powered Characters using Inspiration and Gifts<br /> <a href=\"https://www.drivethrurpg.com/product/413362/Fists-and-Tomes-BUNDLE\" target=\"_blank\">Fists and Tomes</a> - Inspired Martial Arts and Mysticism for Talents<br /> <a href=\"https://www.drivethrurpg.com/en/product/492147/supertech\" target=\"_blank\">Supertech</a> - Super Science in the hands of Talents","edited":{"userid":24985,"user_link":"https://forum.theonyxpath.com/member/24985-mateus-luz","user":"Mateus Luz","date":". 07-21-2022, 08:46 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24985-mateus-luz","name":"Mateus Luz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24985_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2019"},{"key":"Posts:","value":"2950"}]},"thankedby":[]},{"date":"2022-08-29T11:38:11-07:00","id":1491790,"title":"","content":"SK Bhurano might be involved with MKUltra, working out exactly <i>how</i> Psi even <i>works</i>. This could be the era in which the subquantum universe is riscovered, along with the \u201cimpossible to access\u201d Quantum universe.<br /> <br /> I\u2019d say 90% of the MKUltra experiments would be a load of hogwash even in the Trinity Continuum, with <i>just enough genuine success</i> to keep the ball rolling.<br /> <br /> I\u2019d restrict psiads to low Psi ratings and low levels 1 or 2 dots at most in various Modes. Bhurano has no one teaching her. She\u2019s figuring this all out on her OWN.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/12219-demigod-beast","name":"Demigod Beast","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2016"},{"key":"Posts:","value":"1154"}]},"thankedby":[]},{"date":"2022-08-29T17:21:09-07:00","id":1491837,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Demigod Beast</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1487200-trinity-fan-era-cosmic-minds-psi-in-1950s-70s?p=1491790#post1491790\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">SK Bhurano might be involved with MKUltra, working out exactly <i>how</i> Psi even <i>works</i>. This could be the era in which the subquantum universe is riscovered, along with the \u201cimpossible to access\u201d Quantum universe.<br /> <br /> I\u2019d say 90% of the MKUltra experiments would be a load of hogwash even in the Trinity Continuum, with <i>just enough genuine success</i> to keep the ball rolling.<br /> <br /> I\u2019d restrict psiads to low Psi ratings and low levels 1 or 2 dots at most in various Modes. Bhurano has no one teaching her. She\u2019s figuring this all out on her OWN.</div> </div> </div> </div>We know from Dr. Bhurano's correspondence with Michael Donighal in Adventure! that she is a very ethical researcher, so would never have been involved in anything like Project MKUltra, even if the CIA were willing to involve a non-white, non-American woman as one of the researchers for their often wildly illegal experiments.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/25506-shepherdboi","name":"Shepherdboi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25506_1.gif","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2019"},{"key":"Posts:","value":"364"}]},"thankedby":[]},{"date":"2022-08-29T17:25:30-07:00","id":1491840,"title":"","content":"Ah! Did not know that! Thanks! Man, I can\u2019t wait for TC Adventure!..","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12219-demigod-beast","name":"Demigod Beast","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2016"},{"key":"Posts:","value":"1154"}]},"thankedby":[]},{"date":"2022-08-30T05:13:11-07:00","id":1491890,"title":"","content":"I think this is an awesome idea, plus I love psychonauts <img src=\"https://forum.theonyxpath.com/core/images/smilies/biggrin.png\" border=\"0\" alt=\"\" title=\"Big Grin\" smilieid=\"3\" class=\"inlineimg\" /><br /> <br /> Just like Aether and the Hammersmith incidents faded with time, I don't see why we couldn't have another similar event happen. Perhaps Bhurano created a special batch of LSD that activates psion potential, but only temporary (and with side effects), it then gets stolen and ends up in the hands of several organizations who try, and fail to replicate it. In the meantime Bhurano's organization, with the help of Aeon, hunts down the remaining batches and organizations till the end of the 70's, all the while using her skills to erase everyone's memories.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/2964-firanai","name":"Firanai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2964_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"672"}]},"thankedby":[]},{"date":"2022-08-30T06:32:21-07:00","id":1491899,"title":"","content":"In Core there is a allegiance called Transcendent Alliance that was split in 2, one half was focused in cyber-enhancement and the other into psychics. The psychics were from the USSR side, and KGB stole most of their work. Worth to check, Core page 190.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.drivethrurpg.com/en/product/481584/house-rules-bundle-bundle\" target=\"_blank\">House Rules - The Bundle</a> - House Rules for Everyone<br /> <a href=\"https://www.drivethrurpg.com/en/product/481581/powered-inspiration-bundle\" target=\"_blank\">Powered Inspired</a> - Powered Characters using Inspiration and Gifts<br /> <a href=\"https://www.drivethrurpg.com/product/413362/Fists-and-Tomes-BUNDLE\" target=\"_blank\">Fists and Tomes</a> - Inspired Martial Arts and Mysticism for Talents<br /> <a href=\"https://www.drivethrurpg.com/en/product/492147/supertech\" target=\"_blank\">Supertech</a> - Super Science in the hands of Talents","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24985-mateus-luz","name":"Mateus Luz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24985_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2019"},{"key":"Posts:","value":"2950"}]},"thankedby":[]},{"date":"2022-08-30T08:42:16-07:00","id":1491909,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Firanai</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1487200-trinity-fan-era-cosmic-minds-psi-in-1950s-70s?p=1491890#post1491890\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Perhaps Bhurano created a special batch of LSD that activates psion potential, but only temporary (and with side effects),</div> </div> </div> </div>Dr. Bhurano knew that new mesmerists and stalwarts could be created by accident if an existing mesmerist or stalwart used their Inspired powers on the person. She was ethically against empowering new people, especially as many early mesmerists went crazy and became villains. It is horribly unethical to try giving powers to people when you lack their fully informed consent, and it is impossible to gain fully informed consent when you yourself don't know the likely consequences of the experiment.<br /> <br /> Michael Donighal, OTOH, felt it was a great idea to go around and try to empower as many people as possible. After all, it isn't as if granting random people poorly understood powers could possibly turn them into deformed and insane aberrations who would go on to bring ruin to large swaths of the Earth, right?<br /> <br /> tl:dr - you can't just inject people with radioactive substances or shove weird drugs down their throats and be absolved of the consequences because you didn't bother doing the research that would have proven you were likely to give them super-cancer. If someone made super LSD, it wouldn't have been Dr. Bhurano.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/25506-shepherdboi","name":"Shepherdboi","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar25506_1.gif","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jul 2019"},{"key":"Posts:","value":"364"}]},"thankedby":[]},{"date":"2022-08-30T09:52:33-07:00","id":1491916,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shepherdboi</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1487200-trinity-fan-era-cosmic-minds-psi-in-1950s-70s?p=1491909#post1491909\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Dr. Bhurano knew that new mesmerists and stalwarts could be created by accident if an existing mesmerist or stalwart used their Inspired powers on the person. She was ethically against empowering new people, especially as many early mesmerists went crazy and became villains. It is horribly unethical to try giving powers to people when you lack their fully informed consent, and it is impossible to gain fully informed consent when you yourself don't know the likely consequences of the experiment.<br /> <br /> Michael Donighal, OTOH, felt it was a great idea to go around and try to empower as many people as possible. After all, it isn't as if granting random people poorly understood powers could possibly turn them into deformed and insane aberrations who would go on to bring ruin to large swaths of the Earth, right?<br /> <br /> tl:dr - you can't just inject people with radioactive substances or shove weird drugs down their throats and be absolved of the consequences because you didn't bother doing the research that would have proven you were likely to give them super-cancer. If someone made super LSD, it wouldn't have been Dr. Bhurano.</div> </div> </div> </div>The way I pictured it, she created it as an accident or byproduct of other research, not as a way to force people to become psiads. I just wanted to connect the triggering event with Bhurano. In any case it's just an idea, it can be done in other ways without having her involved.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/2964-firanai","name":"Firanai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2964_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"672"}]},"thankedby":[]},{"date":"2022-08-30T10:54:54-07:00","id":1491923,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Mateus Luz</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1487200-trinity-fan-era-cosmic-minds-psi-in-1950s-70s?p=1491899#post1491899\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">In Core there is a allegiance called Transcendent Alliance that was split in 2, one half was focused in cyber-enhancement and the other into psychics. The psychics were from the USSR side, and KGB stole most of their work. Worth to check, Core page 190.</div> </div> </div> </div>Yeah, I\u2019d always wondered what happened to them, come the Nova Age...","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12219-demigod-beast","name":"Demigod Beast","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2016"},{"key":"Posts:","value":"1154"}]},"thankedby":[]},{"date":"2022-08-30T11:56:43-07:00","id":1491932,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shepherdboi</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1487200-trinity-fan-era-cosmic-minds-psi-in-1950s-70s?p=1491909#post1491909\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Dr. Bhurano knew that new mesmerists and stalwarts could be created by accident if an existing mesmerist or stalwart used their Inspired powers on the person. She was ethically against empowering new people, especially as many early mesmerists went crazy and became villains. It is horribly unethical to try giving powers to people when you lack their fully informed consent, and it is impossible to gain fully informed consent when you yourself don't know the likely consequences of the experiment.</div> </div> </div> </div>For me, Dr. Bhurano is shown in TC 2E canon timeline in era books as some kind of 'saint', that always does 'good by withstanding' any actions about their powers.\ud83d\ude15 I know she is much more restrained from Donighal, but as saying say 'Everyone live long enough to make a mistake'.<br /> <br /> I think it's <u>totally possible</u> <i>that Bhurano made some special kind LSD in 1950s to expand general understanding of Psi</i> - only to regret this decision, when this tech was taken by other factions from her.<br /> <br /> And it's <u>even more</u> pointing her then that to understand this phenomena of Psi, she needs to hide her researches and not make similar mistake. We have then both Psi research starting even in 1950s <u>and</u> even more lesson for Bhurano to distrust groups other than herself. \ud83d\ude0e","signature":"","edited":{"userid":1437,"user_link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","user":"wyrdhamster","date":". 08-30-2022, 03:00 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2022-08-30T12:20:48-07:00","id":1491936,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Demigod Beast</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1487200-trinity-fan-era-cosmic-minds-psi-in-1950s-70s?p=1491923#post1491923\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Yeah, I\u2019d always wondered what happened to them, come the Nova Age...</div> </div> </div> </div><br /> In case you're curious, you can check out my Non-Canonical take on the transcendence alliance in the nova age. <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1331502-the-transcendent-alliance-in-aberrant\">http://forum.theonyxpath.com/forum/m...ce-in-aberrant</a>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2964-firanai","name":"Firanai","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2964_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"672"}]},"thankedby":[]},{"date":"2022-08-30T14:09:25-07:00","id":1491948,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Shepherdboi</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1487200-trinity-fan-era-cosmic-minds-psi-in-1950s-70s?p=1491909#post1491909\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Dr. Bhurano knew that new mesmerists and stalwarts could be created by accident if an existing mesmerist or stalwart used their Inspired powers on the person. She was ethically against empowering new people, especially as many early mesmerists went crazy and became villains. It is horribly unethical to try giving powers to people when you lack their fully informed consent, and it is impossible to gain fully informed consent when you yourself don't know the likely consequences of the experiment.<br /> <br /> Michael Donighal, OTOH, felt it was a great idea to go around and try to empower as many people as possible. After all, it isn't as if granting random people poorly understood powers could possibly turn them into deformed and insane aberrations who would go on to bring ruin to large swaths of the Earth, right?<br /> <br /> tl:dr - you can't just inject people with radioactive substances or shove weird drugs down their throats and be absolved of the consequences because you didn't bother doing the research that would have proven you were likely to give them super-cancer. If someone made super LSD, it wouldn't have been Dr. Bhurano.</div> </div> </div> </div><br /> To be fair, in at least some cases, Michael Donighal created gods, or perhaps capital G gods. so maybe you have to break eggs to make godly omelets?<br /> <br /> But: as for the idea, I think you need to ask the Doylist question: how much do you want this to diverge from &quot;real&quot; history.<br /> <br /> I mean, restricting everyone to one to three dots will keep most impacts local. Not to say they won't be big, but it's not &quot;turning the world upside down.&quot; If you allow higher levels, <i>especially</i> in psychoportation, then the world is going to start changing, and changing very quickly--at the very least, imagine the impact of A. someone who can peer into the future, and B. someone who can just open a portal into the White House/Kremlin and kick a nuke through. <br /> <br /> So that's ther big question--do you want this to be part of the history of the &quot;real&quot; world as we enjoy it, or the &quot;real&quot; world as described in Aeon, or do you want to go: Canon? We doh't need not stinking canon!<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1458-newk","name":"NewK","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"360"}]},"thankedby":[]},{"date":"2022-08-30T21:43:57-07:00","id":1491978,"title":"","content":"So, for now, we have at least 3 Allegiances/Societies involved with era idea:<br /> <br /> <b>MK-Ultra</b> - Probably basing their info on Bhurano researches, for Psi inducing LSD<br /> <b>Aeon Society</b> - Probably hunting the ill uses of Psi, <u>with</u> help of Bhurano, to redeem her.<br /> <b>Transcendent Alliance</b> ( USSR part ) - Probably stealing researches on the east?<br /> <br /> Any other group involved you can think about?<br /> <br /> P.S. I also can wait to read <i><b>Pheobe Trust</b></i>, modern psychic non-official Tasty Bit from Onyx Path. \ud83d\ude0e","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2022-08-31T00:22:29-07:00","id":1491985,"title":"","content":"Phoebe Trust is not about modern psychic, its about modern psions. Psiads are present in the core as much as in Aeon or Aberrant (probably more often in Aeon and Aberrant, but yes)","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.drivethrurpg.com/en/product/481584/house-rules-bundle-bundle\" target=\"_blank\">House Rules - The Bundle</a> - House Rules for Everyone<br /> <a href=\"https://www.drivethrurpg.com/en/product/481581/powered-inspiration-bundle\" target=\"_blank\">Powered Inspired</a> - Powered Characters using Inspiration and Gifts<br /> <a href=\"https://www.drivethrurpg.com/product/413362/Fists-and-Tomes-BUNDLE\" target=\"_blank\">Fists and Tomes</a> - Inspired Martial Arts and Mysticism for Talents<br /> <a href=\"https://www.drivethrurpg.com/en/product/492147/supertech\" target=\"_blank\">Supertech</a> - Super Science in the hands of Talents","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24985-mateus-luz","name":"Mateus Luz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24985_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2019"},{"key":"Posts:","value":"2950"}]},"thankedby":[]},{"date":"2022-08-31T10:08:10-07:00","id":1492013,"title":"","content":"Soooo....a Nova Age <i>psion</i>? I could see it. The Doyen making a \u201ctest-run\u201d for their prototype Prometheus Chambers?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12219-demigod-beast","name":"Demigod Beast","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2016"},{"key":"Posts:","value":"1154"}]},"thankedby":[]},{"date":"2022-08-31T19:06:17-07:00","id":1492061,"title":"","content":"Phoebe Trust has some awesome ideas for bringing psions to modern day that fit absolutely well with the idea (keep just 1st and 2nd generations)","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.drivethrurpg.com/en/product/481584/house-rules-bundle-bundle\" target=\"_blank\">House Rules - The Bundle</a> - House Rules for Everyone<br /> <a href=\"https://www.drivethrurpg.com/en/product/481581/powered-inspiration-bundle\" target=\"_blank\">Powered Inspired</a> - Powered Characters using Inspiration and Gifts<br /> <a href=\"https://www.drivethrurpg.com/product/413362/Fists-and-Tomes-BUNDLE\" target=\"_blank\">Fists and Tomes</a> - Inspired Martial Arts and Mysticism for Talents<br /> <a href=\"https://www.drivethrurpg.com/en/product/492147/supertech\" target=\"_blank\">Supertech</a> - Super Science in the hands of Talents","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24985-mateus-luz","name":"Mateus Luz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24985_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2019"},{"key":"Posts:","value":"2950"}]},"thankedby":[]},{"date":"2022-09-02T01:31:59-07:00","id":1492144,"title":"","content":"We got <b><a href=\"https://www.drivethrurpg.com/product/405547?affiliate_id=13&amp;src=OnyxPathWeds\" target=\"_blank\">Phoebe Trust</a></b> - non-canonical official mini era about Psions in modern times - and from now on, I treat it as canonical for this <b>Cosmic Minds</b> fan era. ( It costs 2$, you can buy <b>Phoebe Trust</b> for this. \ud83d\ude0e )<br /> <br /> To sum up Trust general story:<ol class=\"decimal\"><li><b>Hammersmith Incident</b> in year 1922.</li> <li><b>Psions Generation 1</b> \u2013 USSR and Britain make invcicvne brain sergury to unlock Psi in target - <b>Comment</b>: I would put it in 1930s till the end of World War 2. It means that his crude Gen 1 Psions would be possible in <b>TC 2E Adventure!</b>, if group wants. \ud83d\ude0e</li> <li><b>Psions Generation 2</b> \u2013 Cold War programs of USA and USSR, based on chemical treatments - <b>Phoebe Trust </b>book points that USSR made project OKB 333 that worked on subject of Gen 2 psions. - <b>Comment</b>: I would put it in 1950s, connected with LSD experimentation. USA side project would simply be called MK-ULTRA, USSR is OKB333. In future, OKB333 will become USSR part of Transcendent Alliance.</li> <li><b>Psions Generation 3</b> ( <b>Aeon</b> era style Psions ) \u2013</li> </ol>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]},{"date":"2022-09-02T02:11:45-07:00","id":1492147,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>wyrdhamster</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/trinity/1487200-trinity-fan-era-cosmic-minds-psi-in-1950s-70s?p=1492144#post1492144\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">[*]<b>Psions Generation 1</b> \u2013 USSR and Britain make invcicvne brain sergury to unlock Psi in target - <b>Comment</b>: I would put it in 1930s till the end of World War 2. It means that his crude Gen 1 Psions would be possible in <b>TC 2E Adventure!</b>, if group wants. \ud83d\ude0e[*]<b>Psions Generation 2</b> \u2013 Cold War programs of USA and USSR, based on chemical treatments - <b>Phoebe Trust </b>book points that USSR made project OKB 333 that worked on subject of Gen 2 psions. - <b>Comment</b>: I would put it in 1950s, connected with LSD experimentation. USA side project would simply be called MK-ULTRA, USSR is OKB333. In future, OKB333 will become USSR part of Transcendent Alliance.[*]<b>Psions Generation 3</b> ( <b>Aeon</b> era style Psions )</div> </div> </div> </div>Phoebe Trust aligns far better than you changed, it says decades later, so I would put the First a generation in the 50s, Second in the 60s and third in the 80s. So for Cosmic Minds, you have the First and Second generations.<br /> <br /> First Generation would have brain implants, fitting better to the 50s tech, with the post war inventions and the first computers available to a great part of the scientists.<br /> Second Generation would be a created after the invention of LSD and other synthetic drugs, first because they need to first be created to later be used, and later be largely tested (creating Psions is significant numbers).<br /> <br /> The first American Psions would appear in early 60s, with people going from USSR to USA, already with both available generations, refocusing the MKUltra from a systematic torture/brainwash to a way to give people powers.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.drivethrurpg.com/en/product/481584/house-rules-bundle-bundle\" target=\"_blank\">House Rules - The Bundle</a> - House Rules for Everyone<br /> <a href=\"https://www.drivethrurpg.com/en/product/481581/powered-inspiration-bundle\" target=\"_blank\">Powered Inspired</a> - Powered Characters using Inspiration and Gifts<br /> <a href=\"https://www.drivethrurpg.com/product/413362/Fists-and-Tomes-BUNDLE\" target=\"_blank\">Fists and Tomes</a> - Inspired Martial Arts and Mysticism for Talents<br /> <a href=\"https://www.drivethrurpg.com/en/product/492147/supertech\" target=\"_blank\">Supertech</a> - Super Science in the hands of Talents","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/24985-mateus-luz","name":"Mateus Luz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24985_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2019"},{"key":"Posts:","value":"2950"}]},"thankedby":[]},{"date":"2023-02-25T11:46:08-08:00","id":1503907,"title":"","content":"John Oliver made video on history of LCD and magic mashrooms - and how it can be beneficially used in psychoterapy in 2020-30s.<br /> <br /> <div class=\"videocontainer with-aspect-ratio videocontainer-horizontal\" style=\"aspect-ratio: 16/9;\"> <a class=\"video-frame\" href=\"https://www.youtube.com/watch?v=a546lxxJIhE\" data-code=\"a546lxxJIhE\" data-provider=\"youtube\" data-height=\"0\" data-width=\"0\" itemprop=\"video\"> <div class=\"videothumbnail\" style=\"\"> <img src=\"https://img.youtube.com/vi/a546lxxJIhE/maxresdefault.jpg\" alt=\"\" /> <div class=\"videothumbnailoverlay\"></div> </div> </a> </div>","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1437-wyrdhamster","name":"wyrdhamster","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1437_5.jpg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"11313"}]},"thankedby":[]}]}