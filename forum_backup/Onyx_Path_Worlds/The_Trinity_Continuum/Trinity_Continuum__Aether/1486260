0, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> I believe Aether is specifically Quantum </div></div> </div> </div></div> </div> </div> </div>I had the same reading for a while...<br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> I think humans identify it as Aether but the Martians are not really Aether users, otherwise they would not need humans to teach them to use it.</div></div> </div> </div><br /> <br /> <div style=\"margin: 5px 20px 5px 20px;\"> <div style=\"margin-bottom:2px; font-size: 80%;\"> <input type=\"button\" value=\"Spoiler\" style=\"width:45px;font-size:10px;margin:0px;padding:0px;\" onClick=\"if (this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display != '') { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"> My theory is something similar to QK, but instead of using Psi to handle Quantum, you use Flux to control Psi and Quantum.<br /> That would be why they can open gates between dimensions and time easier than can open a way to Mars, as they didnt reach real Mars, for example.<br /> Another point is they are kind of like talents, &quot;using Aether to spin reality improving ability and lucky&quot;.</div></div> </div> </div>","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.drivethrurpg.com/en/product/481584/house-rules-bundle-bundle\" target=\"_blank\">House Rules - The Bundle</a> - House Rules for Everyone<br /> <a href=\"https://www.drivethrurpg.com/en/product/481581/powered-inspiration-bundle\" target=\"_blank\">Powered Inspired</a> - Powered Characters using Inspiration and Gifts<br /> <a href=\"https://www.drivethrurpg.com/product/413362/Fists-and-Tomes-BUNDLE\" target=\"_blank\">Fists and Tomes</a> - Inspired Martial Arts and Mysticism for Talents<br /> <a href=\"https://www.drivethrurpg.com/en/product/492147/supertech\" target=\"_blank\">Supertech</a> - Super Science in the hands of Talents","edited":{"userid":0,"user_link":"","user":"","date":""},"