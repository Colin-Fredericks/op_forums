82717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2024-11-05T14:27:59-08:00","id":1545413,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>CTPhipps</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/curseborne/1545398-curseborne-from-a-neuroatypical-perspective?p=1545412#post1545412\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Well I was going for, &quot;the book's themes resonate with my life experience.&quot;<br /> <br /> What did you get?</div> </div> </div> </div>I think the terms &quot;Neurotypical&quot; and &quot;Non neurotypical&quot; are completely useless in the RPG space since the majority of us who engage in RPGs don't fit the definition of 'normal', and bringing attention to it is in fact... trying to bring attention to yourself and somehow make yourself more 'special' than others. It's a way of trying to elevate your viewpoint above others by bringing attention to it as somehow 'different' and therefore more worthy of consideration.<br /> <br /> It comes across as Narcissistic and self indulgent.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4e","count":5},{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/3769-orphan81","name":"Orphan81","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar3769_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2014"},{"key":"Posts:","value":"145"}]},"thankedby":[]},{"date":"2024-11-05T16:27:33-08:00","id":1545416,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Orphan81</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/curseborne/1545398-curseborne-from-a-neuroatypical-perspective?p=1545413#post1545413\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I think the terms &quot;Neurotypical&quot; and &quot;Non neurotypical&quot; are completely useless in the RPG space since the majority of us who engage in RPGs don't fit the definition of 'normal', and bringing attention to it is in fact... trying to bring attention to yourself and somehow make yourself more 'special' than others. It's a way of trying to elevate your viewpoint above others by bringing attention to it as somehow 'different' and therefore more worthy of consideration.<br /> <br /> It comes across as Narcissistic and self indulgent.</div> </div> </div> </div>Got it, thanks for explaining.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews\" target=\"_blank\">I was a Teenage Weredeer</a></i>, <i><a href=\"https://www.amazon.com/Straight-Outta-Fangton-Comedic-Vampire-ebook/dp/B01KNHICCC/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982774&amp;sr=1-1&amp;keywords=Straight+Outta+Fangton\" target=\"_blank\">Straight Outta Fangton</a></i>, <i><a href=\"https://www.amazon.com/Lucifers-Star-C-T-Phipps-ebook/dp/B01MDM9MCT/ref=mt_kindle?_encoding=UTF8&amp;me=&amp;qid=\" target=\"_blank\">Lucifer's Star</a>, </i>and the <i><a href=\"https://www.amazon.com/Rules-Supervillainy-Saga-Book-ebook/dp/B07MB89S33/\" target=\"_blank\">Supervillainy Saga</a>.</i><br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/onyx-path-announcements/206-forum-rules\" target=\"_blank\"><b>Forum Terms of Use</b></a><br /> <a href=\"http://forum.theonyxpath.com/contact-us\" target=\"_blank\">the Contact Us link</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12002-ctphipps","name":"CTPhipps","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12002_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2016"},{"key":"Posts:","value":"13933"}]},"thankedby":[]},{"date":"2024-11-05T18:18:10-08:00","id":1545422,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Orphan81</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/curseborne/1545398-curseborne-from-a-neuroatypical-perspective?p=1545413#post1545413\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> I think the terms &quot;Neurotypical&quot; and &quot;Non neurotypical&quot; are completely useless in the RPG space since the majority of us who engage in RPGs don't fit the definition of 'normal', and bringing attention to it is in fact... trying to bring attention to yourself and somehow make yourself more 'special' than others. It's a way of trying to elevate your viewpoint above others by bringing attention to it as somehow 'different' and therefore more worthy of consideration.<br /> <br /> It comes across as Narcissistic and self indulgent.</div> </div> </div> </div>I personally took it as an invitation for neurodivergent individuals to comes in and chat about the ways Curseborne vibes with them.<br /> <br /> But I personally like to self-indulge in giving people the benefit of the doubt to feed my own sense of personal virtue, so.","signature":"<hr class=\"b-divider\"/><br/><b>Kelly R.S. Steele, Freelance Writer(Feel free to call me Kelly, Arcane, or Arc)</b><br /> The world is not beautiful, therefore it is.-Keiichi Sigsawa, Kino's Journey<br /> Feminine pronouns, please.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83e\udd70","count":5},{"type":"\ud83d\udc4e","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/99-arcanearts","name":"ArcaneArts","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar99_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"11384"}]},"thankedby":[]},{"date":"2024-11-06T09:02:26-08:00","id":1545474,"title":"","content":"I didn't found the post narcissistic or arrogant or anything of the sort, i like having other people voice their views and opinions on games i like and how they relate to them, it can open my eyes to new themes i haven't explored or ideas i didn't considered before.","signature":"<hr class=\"b-divider\"/><br/>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/12946-emerick","name":"Emerick","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12946_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2017"},{"key":"Posts:","value":"156"}]},"thankedby":[]},{"date":"2024-11-06T09:15:51-08:00","id":1545475,"title":"","content":"I was actually hoping to praise the game's writing because I am unabashed fanboy. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /><br /> <br /> But I was actually hoping if anyone else felt it was covering these sorts of themes.","signature":"<hr class=\"b-divider\"/><br/>Author of <i><a href=\"https://www.amazon.com/Cthulhu-Armageddon-C-T-Phipps-ebook/dp/B01KUOM7SI/ref=sr_1_1?s=digital-text&amp;ie=UTF8&amp;qid=1535982844&amp;sr=1-1&amp;keywords=Cthulhu+Armageddon\" target=\"_blank\">Cthulhu Armageddon</a></i>, <i><a href=\"https://www.amazon.com/Teenage-Weredeer-Bright-Falls-Mysteries-ebook/dp/B075TTN2FN/ref=sr_1_2?s=digital-text&amp;ie=UTF8&amp;qid=1535982717&amp;sr=1-2&amp;keywords=Weredeer#customerReviews