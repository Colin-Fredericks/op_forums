5/avatar175_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1477"}]},"thankedby":[]},{"date":"2016-02-28T00:20:43-08:00","id":838525,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>rickayelm</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=836959#post836959\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I am a fan of the Xian Xia genre of Chinese light novels, so I was wondering if it is possible to have a taoist immortal character in 2nd edition.</div> </div> </div> </div>To me that sounds like it could be a variety of the regal scions who come from some grand mortal lineage and are chosen for scionhood as infants ie. Triptolemus or King Arthur maybe?. (As I understand it there are four types of scions, traditional god sired/adopted, mystically created from raw materials, reincarnation of a &quot;dead&quot; god, regal infant chosen at birth)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/5622-sprucestripedgoose","name":"SpruceStripedGoose","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5622_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"394"}]},"thankedby":[]},{"date":"2016-02-28T03:35:26-08:00","id":838564,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>SpruceStripedGoose</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=838525#post838525\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> To me that sounds like it could be a variety of the regal scions who come from some grand mortal lineage and are chosen for scionhood as infants ie. Triptolemus or King Arthur maybe?. (As I understand it there are four types of scions, traditional god sired/adopted, mystically created from raw materials, reincarnation of a &quot;dead&quot; god, regal infant chosen at birth)</div> </div> </div> </div>There's also been mention of playing non-Scion characters.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/51-marin","name":"marin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"2019"}]},"thankedby":[]},{"date":"2016-02-28T12:08:06-08:00","id":838740,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>marin</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=838564#post838564\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> There's also been mention of playing non-Scion characters.</div> </div> </div> </div>That's right, I jumped right to Scion tier, but there should be some gamespace that could work similar to the other magical but mortal peoples like sorceresses and fauns.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/5622-sprucestripedgoose","name":"SpruceStripedGoose","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5622_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"394"}]},"thankedby":[]},{"date":"2016-03-01T08:27:15-08:00","id":839925,"title":"","content":"<br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Nicholas</strong> </div> <div class=\"message\">Do you have any ideas about how Isis Made Ra Weaker in the Scion-verse? the original corebook says he was more powerful than all of the gods,but when Isis stole His true Name He became an equal to the other gods. How are you going to represent that? was Ra a Titan forced to be a part of pantheon? did isis forced him to lower his legend?</div> </div> </div> </div>Any of those are a possibility, or it could've been something that happened during their Creation Myth. Ra is still Legend 12, though.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> atum-R\u00e9 is Still part of the psesjet right? </div> </div> </div>Yes.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>rickayelm</strong> </div> <div class=\"message\">I am a fan of the Xian Xia genre of Chinese light novels, so I was wondering if it is possible to have a taoist immortal character in 2nd edition.</div> </div> </div> </div>Absolutely, it is. <b>Origins</b> has several &quot;mortal level&quot; supernatural templates. The Xian, though, would likely be akin to demigods.<br /> <br /> Gods tend to have an <i>odd </i>interaction with sacred or holy men. You'd think it would be one way, but Vishnu once got his clock cleaned by a <i>rsi</i>, so.<br /> <br /> <div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Purple Snit</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=834845#post834845\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Two things: 1) will the pantheons have an artificial &quot;member limit&quot; of the 10 best-known deities only, or will they be more like real world religions, with a different number for each pantheon, and 2) will there be write-ups with stats for the gods, like Scion Ragnarok?</div> </div> </div> </div>1) I'm not sure they ever did, even in 1e. In any case, we'll probably limit it to 10 deities in the core, but there <i>are </i>more - they're just not mentioned.<br /> 2) Eventually. It won't be done in the Ragnarok/God style, though. I found those writeups similar to the ones in <b>Lords of Creation</b> - fundamentally unusable at the table.","signature":"<hr class=\"b-divider\"/><br/><b><span style=\"color:#B22222\">Neall Raemonn Price</span><br /> Beleaguered Scion Developer</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/137-neall","name":"Neall","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar137_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1204"}]},"thankedby":[]},{"date":"2016-03-01T09:48:45-08:00","id":839979,"title":"","content":"How much of the oldest gods mantles was shaped by the gods actions and will and how much of their mantle was shaped by the will of mortals?,do titans have mantles?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/4621-nicolas-milioni","name":"Nicolas Milioni","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4621_2.jpeg","title":"Banned","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"3605"}]},"thankedby":[]},{"date":"2016-03-01T21:33:46-08:00","id":840387,"title":"","content":"Do some gods have access to multiple Pantheon Specific Purviews?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/754-eldagusto","name":"Eldagusto","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar754_2.gif","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"6435"}]},"thankedby":[]},{"date":"2016-03-01T22:53:49-08:00","id":840423,"title":"","content":"Off hand Ra theory - originally Amun was the creator titan, thus his immediate offspring being Titans. But in defeat he lost his True Name of Ra in the Titan War, which means that Ra is now retroactively the father of Tefnut &amp; Shu, and grandfather of Nut and Geb, despite being a God and not a Titan himself.","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reaction