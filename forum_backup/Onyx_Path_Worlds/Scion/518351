0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2018-01-28T17:11:43-08:00","id":1180291,"title":"","content":"Are the injury conditions referenced in Weapons Tags just outdated, and Bashing/Lethal/Aggravated should refer to Brused/Injured/Maimed or did something else happen there?<br /> <br /> Do you roll your defense to oppose every attack against you?","signature":"<hr class=\"b-divider\"/><br/><b>Violet Green, Freelancer</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/23657-violetdreamer","name":"VioletDreamer","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar23657_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2017"},{"key":"Posts:","value":"163"}]},"thankedby":[]},{"date":"2018-01-28T18:24:36-08:00","id":1180304,"title":"","content":"I assume that Swift Bandaging under the Healer Doctor\u2019s Kit knack heals -2 Injuries, not -1. \u2014-Jim","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4310-jagardner","name":"jagardner","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2014"},{"key":"Posts:","value":"24"}]},"thankedby":[]},{"date":"2018-01-28T18:27:51-08:00","id":1180306,"title":"","content":"Why are 2 of the 5 Pre-Gens Healers? It seems a bit strange for the &quot;default party&quot; to be 40% medics.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2433-highpriest","name":"HighPriest","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2433_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2014"},{"key":"Posts:","value":"360"}]},"thankedby":[]},{"date":"2018-01-28T18:29:55-08:00","id":1180308,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>HighPriest</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180306#post1180306\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Why are 2 of the 5 Pre-Gens Healers? It seems a bit strange for the &quot;default party&quot; to be 40% combat medics.</div> </div> </div> </div><br /> The impression i got is less that they are meant to be a Band. But to show that even with the same callings you can still have very different characters.","signature":"<hr class=\"b-divider\"/><br/>Completed campaign: Scion 2nd Edition. Les L\u00e9gendes Currently playing: Being a dad for a 3 year old daughter and a 2 years old son and now a beautiful new baby.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11312-maitrecorbo","name":"Maitrecorbo","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11312_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2016"},{"key":"Posts:","value":"719"}]},"thankedby":[]},{"date":"2018-01-28T18:44:10-08:00","id":1180315,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Maitrecorbo</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180308#post1180308\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> <br /> The impression i got is less that they are meant to be a Band. But to show that even with the same callings you can still have very different characters.</div> </div> </div> </div>Ah, so they're... not a pre-gen party, then? Since I can't imagine most groups wanting to play with that much overlap?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2433-highpriest","name":"HighPriest","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2433_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2014"},{"key":"Posts:","value":"360"}]},"thankedby":[]},{"date":"2018-01-28T23:53:18-08:00","id":1180357,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/137-neall\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar137_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"137\" data-vbnamecard=\"137\">Neall</a> how are you handling shields? Weapons with an ability to count as hard or soft armor? Or simply add dice to Defence depending on the size?<br /> <br /> EDIT: Oh, and am I right in presuming that with Attributes one dot is around human Average?","signature":"","edited":{"userid":23677,"user_link":"https://forum.theonyxpath.com/member/23677-the-eternal-keeper","user":"The Eternal Keeper","date":". 01-29-2018, 07:32 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/23677-the-eternal-keeper","name":"The Eternal Keeper","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2018"},{"key":"Posts:","value":"19"}]},"thankedby":[]},{"date":"2018-01-29T00:46:20-08:00","id":1180363,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Maitrecorbo</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180308#post1180308\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">The impression i got is less that they are meant to be a Band. But to show that even with the same callings you can still have very different characters.</div> </div> </div> </div>The Scion of Loki isn't even a legal character, as Loki lacks the Healer Calling...<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/258-thesarcasticsage","name":"TheSarcasticSage","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar258_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"226"}]},"thankedby":[]},{"date":"2018-01-29T06:19:02-08:00","id":1180403,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/137-neall\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar137_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"137\" data-vbnamecard=\"137\">Neall</a> I notice that some of the deities have a relative lack of purviews (Frigg for instance has only 2) compared to the average (and especially compared to some others), with a couple lacking any attribute related ones at all. I find this especially noticeable with a major deity like Freyr who are seemingly out muscled by relatively more minor deities like Sif or Skadi. <br /> <br /> How does the system handle this kind of intrinsic difference? I know from experience in 1st edition that people tend to almost exclusively favor those parents providing the most &quot;Bang for your Buck&quot; and logically resulting in issues like &quot;Well this god can't have X Strength/charisma/etc because otherwise it would be favored&quot;.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3835-\u00falfh\u00e9\u00f0nar","name":"\u00dalfh\u00e9\u00f0nar","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"108"}]},"thankedby":[]},{"date":"2018-01-29T06:34:43-08:00","id":1180407,"title":"","content":"<a href=\"https://forum.theonyxpath.com/member/137-neall\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar137_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"137\" data-vbnamecard=\"137\">Neall</a> Also (and im not certain how much im allowed to &quot;Reveal&quot; as it were so im gonna be vague here) I have a question from a couple Shaivite friends of mine regarding Shiva's writeup. <br /> <br /> He has a certain connection to an animal mentioned, why though? Whats the logic here, as it appears to totally stump them.<br /> <br /> (Also they really liked the Rashmi character, so kudos for that one)<br /> <br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3835-\u00falfh\u00e9\u00f0nar","name":"\u00dalfh\u00e9\u00f0nar","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"108"}]},"thankedby":[]},{"date":"2018-01-29T07:02:15-08:00","id":1180410,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>\u00dalfh\u00e9\u00f0nar</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180407#post1180407\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><a href=\"https://forum.theonyxpath.com/member/137-neall\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar137_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"137\" data-vbnamecard=\"137\">Neall</a> Also (and im not certain how much im allowed to &quot;Reveal&quot; as it were so im gonna be vague here) I have a question from a couple Shaivite friends of mine regarding Shiva's writeup. <br /> <br /> He has a certain connection to an animal mentioned, why though? Whats the logic here, as it appears to totally stump them.<br /> <br /> (Also they really liked the Rashmi character, so kudos for that one)<br /></div> </div> </div> </div>He has it because of his most famous Avatar, Hanuman <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" /> I am admittedly a Shakta, not a Shaivite, but given how popular a deity Hanuman is, and how closely connected he is to that Animal, it made sense. <br /> <br /> Same reason Vishnu has Artistry(flute playing) even though Vishnu does not pay the flute, Krishna does.","signature":"","edited":{"userid":1344,"user_link":"https://forum.theonyxpath.com/member/1344-samudra","user":"Samudra","date":". 01-29-2018, 10:10 AM"},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":4}],"user":{"link":"https://forum.theonyxpath.com/member/1344-samudra","name":"Samudra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1344_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"497"}]},"thankedby":[]},{"date":"2018-01-29T10:15:41-08:00","id":1180449,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>\u00dalfh\u00e9\u00f0nar</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180403#post1180403\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><a href=\"https://forum.theonyxpath.com/member/137-neall\" style=\"background-image:url('https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5//avatar137_2.jpeg');\" class=\"b-bbcode-user b-bbcode-user--has-avatar js-bbcode-user\" data-userid=\"137\" data-vbnamecard=\"137\">Neall</a> I notice that some of the deities have a relative lack of purviews (Frigg for instance has only 2) compared to the average (and especially compared to some others), with a couple lacking any attribute related ones at all. I find this especially noticeable with a major deity like Freyr who are seemingly out muscled by relatively more minor deities like Sif or Skadi.<br /> <br /> How does the system handle this kind of intrinsic difference? I know from experience in 1st edition that people tend to almost exclusively favor those parents providing the most &quot;Bang for your Buck&quot; and logically resulting in issues like &quot;Well this god can't have X Strength/charisma/etc because otherwise it would be favored&quot;.</div> </div> </div> </div>Patron Gods no longer give XP discounts, as far as I am aware... the only benefit to your Deity's list of Purviews is that you have the option of channeling any single one of them for free. So while Scions of Frigg have a smaller platter of powers to choose from, they're not really getting any less of a bang for their buck than a Scion of Shiva <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1344-samudra","name":"Samudra","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1344_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"497"}]},"thankedby":[]},{"date":"2018-01-30T12:43:41-08:00","id":1180850,"title":"","content":"I feel like maybe im doing something wrong here, or otherwise the strength feat chart is definitely a bit tough for mortals. <br /> <br /> My hypothetical Might 5/Ath 3 character rolling 8 dice on a strength attempt has a 50% chance to fail to pick up two microwaves, and really should not count on the ability to perform anything else at all?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3835-\u00falfh\u00e9\u00f0nar","name":"\u00dalfh\u00e9\u00f0nar","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"108"}]},"thankedby":[]},{"date":"2018-01-30T14:51:08-08:00","id":1180890,"title":"","content":"well, don't forget that IIRC rolling a 10 gives you another dice in addition to the regular success. So you have a 10% chance of gaining yet another dice<br /> <br /> EDIT: And don't forget that most microwave ovens weigh around 40 pounds (20 kg). Being able to lift one in each hand is pretty good.","signature":"","edited":{"userid":23677,"user_link":"https://forum.theonyxpath.com/member/23677-the-eternal-keeper","user":"The Eternal Keeper","date":". 01-30-2018, 06:10 PM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/23677-the-eternal-keeper","name":"The Eternal Keeper","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2018"},{"key":"Posts:","value":"19"}]},"thankedby":[]},{"date":"2018-01-30T15:35:07-08:00","id":1180903,"title":"","content":"I'm wondering<br /> <br /> from what i'm reading i noticed that &quot;PVP&quot; is not much expected. i'm i got it right?<br /> <br /> (i'm saying this because of the trickster knack where you have to ask to the other players if u can do something to their characters)","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12508-elanconnor","name":"ElanConnor","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12508_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2016"},{"key":"Posts:","value":"172"}]},"thankedby":[]},{"date":"2018-01-30T16:05:57-08:00","id":1180920,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>ElanConnor</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180903#post1180903\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I'm wondering<br /> <br /> from what i'm reading i noticed that &quot;PVP&quot; is not much expected. i'm i got it right?<br /> <br /> (i'm saying this because of the trickster knack where you have to ask to the other players if u can do something to their characters)</div> </div> </div> </div>Yeah, I mean, generally it's a faux pas to do anyway. And since some of these boons change how someone thinks/behaves it makes sense.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/8375-vonpenguin","name":"vonpenguin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"246"}]},"thankedby":[]},{"date":"2018-01-30T17:52:09-08:00","id":1180945,"title":"","content":"There is generally a in game difference between &quot;Ok, im gonna attack you now&quot; and &quot;Ok, im controlling your character now, you have to do this.&quot;<br /> <br /> Almost everyone accepts that their character might face danger due to in character actions that occur, but people tend to balk at rules where they lose control of the actions and behaviors of their own character.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/3835-\u00falfh\u00e9\u00f0nar","name":"\u00dalfh\u00e9\u00f0nar","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"108"}]},"thankedby":[]},{"date":"2018-01-30T18:02:54-08:00","id":1180951,"title":"","content":"Regarding the chinese deity Tai Sui, (grand duke of jupiter/head of celestial ministry of time), It seems like the name tai sui is treated in chinese myth as being either a position that is passed around yearly among a large group of star deities, or as one deity with a bunch of different faces, changing which face it wears yearly.<br /> <br /> Would that kind of deity be best represented as one deity with like sixty different mantles, or can mantles be passed around among a large group of deities, changing hands at the turn of the year? If a mantle gets changed around that frequently, would a scion sired by that mantle just be the scion of that mantle, or would the god wearing the mantle during conception or visitation have any kind of connection to the scion?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2472-trebius","name":"trebius","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2472_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2014"},{"key":"Posts:","value":"31"}]},"thankedby":[]},{"date":"2018-01-30T18:09:35-08:00","id":1180953,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>\u00dalfh\u00e9\u00f0nar</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180850#post1180850\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">I feel like maybe im doing something wrong here, or otherwise the strength feat chart is definitely a bit tough for mortals.<br /> <br /> My hypothetical Might 5/Ath 3 character rolling 8 dice on a strength attempt has a 50% chance to fail to pick up two microwaves, and really should not count on the ability to perform anything else at all?</div> </div> </div> </div>As others have noted, they're heavy, but also you're doing it as an extended action - so milestones.<br /> <br /> You're not grabbing and hucking both of them at once, are you?","signature":"<hr class=\"b-divider\"/><br/><b><span style=\"color:#B22222\">Neall Raemonn Price</span><br /> Beleaguered Scion Developer</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/137-neall","name":"Neall","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar137_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1204"}]},"thankedby":[]},{"date":"2018-01-30T18:10:06-08:00","id":1180954,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>vonpenguin</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180920#post1180920\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Yeah, I mean, generally it's a faux pas to do anyway. And since some of these boons change how someone thinks/behaves it makes sense.</div> </div> </div> </div>My go to move in most games is to carrot it. If a player allows their character to be controlled or manipulated in a way that is interesting to the story but disadvantageous to the character, I give them bonus Xp.<br /> <br /> I learned back in high school how badly a newbie can be turned off roleplaying or even experienced players can turn on other PLAYERS, if they feel like they\u2019re being negatively stripped of agency over their character.","signature":"<hr class=\"b-divider\"/><br/>Check out my expansion to the <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/185084-autochthonia-house-material\" target=\"_blank\">Realm of Brass and Shadow</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/1098-glamourweaver","name":"glamourweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1098_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"7541"}]},"thankedby":[]},{"date":"2018-01-30T18:16:23-08:00","id":1180956,"title":"","content":"Hi Neall,<br /> <br /> Just wanted to ask if Dexterity can be used with close combat to damage foes? Some parts of the text say it\u2019s \u201cAny physical arena Attribute that is justifiable\u201d and others it\u2019s Might + Close Combat Only?<br /> <br /> Oh, and Defence is determined only by the Resilience Attributes (Stamina/Resolve/Composure) or can it be any physical Attribute?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8959-prototype00","name":"prototype00","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar8959_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"964"}]},"thankedby":[]},{"date":"2018-01-30T19:20:55-08:00","id":1180976,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>trebius</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180951#post1180951\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Regarding the chinese deity Tai Sui, (grand duke of jupiter/head of celestial ministry of time), It seems like the name tai sui is treated in chinese myth as being either a position that is passed around yearly among a large group of star deities, or as one deity with a bunch of different faces, changing which face it wears yearly.<br /> <br /> Would that kind of deity be best represented as one deity with like sixty different mantles, or can mantles be passed around among a large group of deities, changing hands at the turn of the year? If a mantle gets changed around that frequently, would a scion sired by that mantle just be the scion of that mantle, or would the god wearing the mantle during conception or visitation have any kind of connection to the scion?</div> </div> </div> </div>This is the kind of difficulty that is had when it comes to the Indian deities as well, some have a considerable number of avatars and incarnations. And should you get really deep into it Tai Sui is far more complex than what is typically explained because of the relationship the concept (the thing it is before it becomes personified) has to every day living and various disciplines in fortunes and astrology (In Chinese cultural spheres that is). Ideally it should all be done individually, but that is going to take far too much space and work.<br /> <br /> I would personally be fine as long as the complexity is fully explained but once (good luck whoever is writing this) and the mechanics are then used to simulate it as best as possible, certainly it won't be perfect","signature":"<hr class=\"b-divider\"/><br/>How can I know if what I claim I know to be true is rejecting the idea that there is something I might not know? How can I know if what I claim I don't know to be true is rejecting the idea that there is something I do know?<br /> -Zhuangzi","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/1715-ostarion","name":"Ostarion","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar1715_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2013"},{"key":"Posts:","value":"305"}]},"thankedby":[]},{"date":"2018-01-30T19:30:46-08:00","id":1180980,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Neall</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180953#post1180953\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> As others have noted, they're heavy, but also you're doing it as an extended action - so milestones.<br /> <br /> You're not grabbing and hucking both of them at once, are you?</div> </div> </div> </div><br /> Oh thanks, that is significantly helpful. I was wondering if they should be run as extended actions given the high success requirements. Much more reasonable.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3835-\u00falfh\u00e9\u00f0nar","name":"\u00dalfh\u00e9\u00f0nar","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Sep 2014"},{"key":"Posts:","value":"108"}]},"thankedby":[]},{"date":"2018-01-30T20:14:57-08:00","id":1180988,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>prototype00</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1180956#post1180956\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hi Neall,<br /> <br /> Just wanted to ask if Dexterity can be used with close combat to damage foes? Some parts of the text say it\u2019s \u201cAny physical arena Attribute that is justifiable\u201d and others it\u2019s Might + Close Combat Only?<br /> <br /> Oh, and Defence is determined only by the Resilience Attributes (Stamina/Resolve/Composure) or can it be any physical Attribute?</div> </div> </div> </div>Personally I would go off of description, with a tendency towards might for intent to damage and dex for intent to trip.disarm/otherfanciness. Not a straight rules interpretation but it's how I'd go as a gm. I mean gms have to have some veto power to keep players from just using their top stat in an arena no matter what they do (sometimes the momentum stick won't be enough, we've all met that guy).","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8375-vonpenguin","name":"vonpenguin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"246"}]},"thankedby":[]},{"date":"2018-01-31T00:59:46-08:00","id":1181039,"title":"","content":"So I have a couple of days' worth of questions bottled up:<br /> <br /> You mentioned that reincarnation is a pretty straightforward process from the Demigod level up - are there other personally crippling threats that come into play then, or do the antagonists need to start focusing on loved ones?<br /> <br /> Reading through the list of gods in Origins, I see there are footnotes about how Athena and Artemis can only have Chosen scions. Should there be a footnote like this for Hestia as well, or has she had an eye-opening few millennia (and on this note, if someone was getting way too excited about having this text and making all their friends write up characters, are there any other virgin goddesses one should watch out for)?<br /> <br /> I'm assuming this one's covered in Hero, but - the Visitation is described as a recasting of the person involved. Is this more of an external transmutation (like, say the Embrace of Vampire) or an internal process (like a Mage's awakening)?<br /> <br /> Will widespread lies have an impact on the growth of Legend, and/or cause the fictional event to happen/have happened on some level?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/13499-not-quite-yoda","name":"Not Quite Yoda","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2017"},{"key":"Posts:","value":"30"}]},"thankedby":[]},{"date":"2018-01-31T05:54:28-08:00","id":1181101,"title":"","content":"So two questions:<br /> <br /> 1) Is it possible for a Pre-Visitation Scion to be a sorcerer?<br /> 2) If yes, is it possible for the Pre-Visitation scion to have access to birthrights that would give them access the purviews needed to be a sorcerer?<br /> <br /> <br /> The inspiration for these questions comes from a player saying he would want to play a wizard based off Harry Dresden. What I'm thinking is that he'd be a scion of Aset, with the Potemkin World origin path and the Detective role path. Basically, instead of the two extra Knacks, I want him to take the 4 dots of birthrights to get access to certain perviews and then use the rules for sorcerer. To create stuff.<br /> <br /> What breaks if I allow this?<br /> <br /> EDIT: I thought it was obvious, but I should point out that I'm referring to Origin level characters here. If I do allow this, I'm probably going to limit the advantages to a +1 enhancement per session to any roll that benefits from the sorcery.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://drive.google.com/open?id=1g_IC644YJoiVAm6ngqcBmsQtff2YYtd3pDbZpaOxx4o\" target=\"_blank\">My Exalted Character Creation Tool may be downloaded here.</a> <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/1086797-demac-s-exalted-character-creation-tool\" target=\"_blank\">The thread talking about the tool can be found here.</a><br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/1136654-exalted-seats-of-power\" target=\"_blank\">Exalted: Seats of Power is a homebrewed manse creation system.</a><br /> <a href=\"https://drive.google.com/open?id=1oaq3wk7lJKZ022SUA4iPfGzMpmBTNXlM\" target=\"_blank\">I have a rewrite of the craft system which can be downloaded here.</a><br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/1070312-i-got-my-book-it-s-super-fancy-and-i-can-t-read-the-cover/page2\" target=\"_blank\">I like the Mesoamerican look</a>.","edited":{"userid":2346,"user_link":"https://forum.theonyxpath.com/member/2346-demac","user":"Demac","date":". 01-31-2018, 09:40 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2346-demac","name":"Demac","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2346_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"385"}]},"thankedby":[]},{"date":"2018-01-31T08:38:33-08:00","id":1181143,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Demac</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1181101#post1181101\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">So two questions:<br /> <br /> 1) Is it possible for a Pre-Visitation Scion to be a sorcerer?<br /> 2) If yes, is it possible for the Pre-Visitation scion to have access to birthrights that would give them access the purviews needed to be a sorcerer?<br /> <br /> <br /> The inspiration for these questions comes from a player saying he would want to play a wizard based off Harry Dresden. What I'm thinking is that he'd be a scion of Aset, with the Potemkin World origin path and the Detective role path. Basically, instead of the two extra Knacks, I want him to take the 4 dots of birthrights to get access to certain perviews and then use the rules for sorcerer. To create stuff.<br /> <br /> What breaks if I allow this?<br /> <br /> EDIT: I thought it was obvious, but I should point out that I'm referring to Origin level characters here. If I do allow this, I'm probably going to limit the advantages to a +1 enhancement per session to any roll that benefits from the sorcery.</div> </div> </div> </div>Actually, now that I think this through a little bit more, it would probably be better to handle this character as a crafter who makes magical artifacts that create one time enhancements. That being said, it would still be good to know if a Pre-visitation scion can still have access to birthrights prior to their visitation.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://drive.google.com/open?id=1g_IC644YJoiVAm6ngqcBmsQtff2YYtd3pDbZpaOxx4o\" target=\"_blank\">My Exalted Character Creation Tool may be downloaded here.</a> <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/1086797-demac-s-exalted-character-creation-tool\" target=\"_blank\">The thread talking about the tool can be found here.</a><br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/1136654-exalted-seats-of-power\" target=\"_blank\">Exalted: Seats of Power is a homebrewed manse creation system.</a><br /> <a href=\"https://drive.google.com/open?id=1oaq3wk7lJKZ022SUA4iPfGzMpmBTNXlM\" target=\"_blank\">I have a rewrite of the craft system which can be downloaded here.</a><br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/1070312-i-got-my-book-it-s-super-fancy-and-i-can-t-read-the-cover/page2\" target=\"_blank\">I like the Mesoamerican look</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2346-demac","name":"Demac","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2346_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"385"}]},"thankedby":[]},{"date":"2018-01-31T10:38:01-08:00","id":1181162,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Demac</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1181143#post1181143\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Actually, now that I think this through a little bit more, it would probably be better to handle this character as a crafter who makes magical artifacts that create one time enhancements. That being said, it would still be good to know if a Pre-visitation scion can still have access to birthrights prior to their visitation.</div> </div> </div> </div>Character creation rules give you the choice between two bonus knacks or four dots of birthrights. We just don't have the birthright rules yet.<br />","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8375-vonpenguin","name":"vonpenguin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"246"}]},"thankedby":[]},{"date":"2018-01-31T12:13:24-08:00","id":1181187,"title":"","content":"This is kind of a strange question, but I noticed it both here in the trinity preview and I'm curious. Why exactly is action-adventure/combat it's own chapter separate from the general system chapter? So far as I'm aware just about every white wolf/onyx path publication has always had all the rules in one chapter, I get that combat generally has more word count devoted to it, but it still seems like you could collapse them into one chapter. Is there a particular reason for the divide?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/3109-lionmanguy","name":"Lionmanguy","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2014"},{"key":"Posts:","value":"167"}]},"thankedby":[]},{"date":"2018-01-31T15:24:37-08:00","id":1181245,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>vonpenguin</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1181162#post1181162\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> Character creation rules give you the choice between two bonus knacks or four dots of birthrights. We just don't have the birthright rules yet.</div> </div> </div> </div><br /> Yeah, but the character creation rules are for all types of Origin level characters, some of whom might naturally have birthrights. And the definition of &quot;Visitation&quot; on p. 10 says its the occasion when scions are gifted their birthrights, so it's still worth knowing whether or not a pre-visitation scion has the option of taking a birthright.","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://drive.google.com/open?id=1g_IC644YJoiVAm6ngqcBmsQtff2YYtd3pDbZpaOxx4o\" target=\"_blank\">My Exalted Character Creation Tool may be downloaded here.</a> <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/1086797-demac-s-exalted-character-creation-tool\" target=\"_blank\">The thread talking about the tool can be found here.</a><br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/1136654-exalted-seats-of-power\" target=\"_blank\">Exalted: Seats of Power is a homebrewed manse creation system.</a><br /> <a href=\"https://drive.google.com/open?id=1oaq3wk7lJKZ022SUA4iPfGzMpmBTNXlM\" target=\"_blank\">I have a rewrite of the craft system which can be downloaded here.</a><br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/exalted/1070312-i-got-my-book-it-s-super-fancy-and-i-can-t-read-the-cover/page2\" target=\"_blank\">I like the Mesoamerican look</a>.","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2346-demac","name":"Demac","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2346_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2014"},{"key":"Posts:","value":"385"}]},"thankedby":[]},{"date":"2018-01-31T15:41:10-08:00","id":1181251,"title":"","content":"It seems to me that if it's possible for a mortal to acquire something that would be a Birthright to a post-Visitation Scion, so can a pre-Visitation Scion. The only question to my mind is whether or not doing so would trigger her Visitation. Traditionally, a Visitation is when a god shows up and tells you what you are; but I'm not sure if that's a <i>necessary</i> condition, or merely the most common one.","signature":"<hr class=\"b-divider\"/><br/><div style=\"margin-left:40px\"> <div align=\"center\">My hacks: <a href=\"http://tinyurl.com/dwtrin\" target=\"_blank\"><span style=\"color:#0000FF\">Trinity Continuum</span></a>, <a href=\"http://tinyurl.com/dwscion\" target=\"_blank\"><span style=\"color:#008000\">Scion</span></a>, <a href=\"http://tinyurl.com/dwExalt\" target=\"_blank\"><span style=\"color:#DAA520\">Exalted</span></a>, <a href=\"http://tinyurl.com/dwcwod\" target=\"_blank\"><span style=\"color:#800000\">World of Darkness</span></a>, <a href=\"http://tinyurl.com/dwnwod\" target=\"_blank\"><span style=\"color:#FF0000\">Chronicles of Darkness</span></a></div> </div>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/421-dataweaver","name":"Dataweaver","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar421_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"8420"}]},"thankedby":[]},{"date":"2018-01-31T15:53:31-08:00","id":1181255,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dataweaver</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1181251#post1181251\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">It seems to me that if it's possible for a mortal to acquire something that would be a Birthright to a post-Visitation Scion, so can a pre-Visitation Scion. The only question to my mind is whether or not doing so would trigger her Visitation. Traditionally, a Visitation is when a god shows up and tells you what you are; but I'm not sure if that's a <i>necessary</i> condition, or merely the most common one.</div> </div> </div> </div>&quot;Did you think it was <b>only</b> a hat?&quot;","signature":"<hr class=\"b-divider\"/><br/>Disclaimer: In favor of fun and enjoyment, but may speak up to warn you that you're gonna step on a metaphorical land mine","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/2142-kyman201","name":"Kyman201","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2142_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"4086"}]},"thankedby":[]},{"date":"2018-01-31T15:54:13-08:00","id":1181256,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Dataweaver</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1181251#post1181251\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">It seems to me that if it's possible for a mortal to acquire something that would be a Birthright to a post-Visitation Scion, so can a pre-Visitation Scion. The only question to my mind is whether or not doing so would trigger her Visitation. Traditionally, a Visitation is when a god shows up and tells you what you are; but I'm not sure if that's a <i>necessary</i> condition, or merely the most common one.</div> </div> </div> </div>At one point the text refers to it as a ritual, so I would guess that it has to be an intentional effort on your divine parent's part even if they use a messenger to deliver the news.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8375-vonpenguin","name":"vonpenguin","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"246"}]},"thankedby":[]},{"date":"2018-01-31T16:44:26-08:00","id":1181274,"title":"","content":"Hey Neall, is there any way to determine which pieces of mundane equipment you can/can\u2019t have at character creation?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8959-prototype00","name":"prototype00","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar8959_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"964"}]},"thankedby":[]},{"date":"2018-01-31T19:16:35-08:00","id":1181311,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>prototype00</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/518351-ask-neall?p=1181274#post1181274\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hey Neall, is there any way to determine which pieces of mundane equipment you can/can\u2019t have at character creation?</div> </div> </div> </div>&quot;Does my Path account for this y/n&quot;<br /> <br /> That's, seriously, all there is to it. <img src=\"https://forum.theonyxpath.com/core/images/smilies/smile.png\" border=\"0\" alt=\"\" title=\"Smile\" smilieid=\"1\" class=\"inlineimg\" />","signature":"<hr class=\"b-divider\"/><br/><b><span style=\"color:#B22222\">Neall Raemonn Price</span><br /> Beleaguered Scion Developer</b>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":6}],"user":{"link":"https://forum.theonyxpath.com/member/137-neall","name":"Neall","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar137_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1204"}]},"thankedby":[]},{"date":"2018-01-31T19:47:16-08:00","id":1181315,"title":"","content":"Hey, Neall. I guess my question was lost in the press:<br /> <br /> How do shields work? Do they count as weapons, or armor? Could they be one or the other as you see fit?","signature":"<hr class=\"b-divider\"/><br/>I'm feeling bluuuueeeee~","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/175-prometheus878","name":"Prometheus878","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar175_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1477"}]},"thankedby":[]},{"date":"2018-02-01T06:23:28-08:00","id":1181374,"title":"","content":"If my Origins character is a therianthrope, can they already change shape or is that something that comes with &quot;Visitation&quot; (not sure how that works for non-Scion mythological characters)? Do Origins characters start with Legend or is that something they pick up in Hero? Couldn't find a clear reference in the text.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/18560-saedar","name":"saedar","avatar":"data:image/svg+xml;base64,","title":"Member","r