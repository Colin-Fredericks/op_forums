core/avatars/0/0/6/0/4/5/avatar5627_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"309"}]},"thankedby":[]},{"date":"2016-10-04T22:10:16-07:00","id":981963,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>Purple Snit</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/1377-fan-written-scion-material?p=909889#post909889\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Does anyone know of any good character sheets that don't have all of the extra artwork on them? Mr. Gone's sheets are great, but killer on the printer cartridge.</div> </div> </div> </div>If you're still looking for a character sheet I was going through my pdfs and found a character sheet that may suit you needs: it doesn't have the fancy borders, but it's 6 pages. It is also editable.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/7395-meribson","name":"Meribson","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar7395_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2015"},{"key":"Posts:","value":"30"}]},"thankedby":[]},{"date":"2016-10-18T22:21:02-07:00","id":989728,"title":"","content":"That would be cool. Any way you can PM it to me?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/5627-purple-snit","name":"Purple Snit","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar5627_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Apr 2015"},{"key":"Posts:","value":"309"}]},"thankedby":[]},{"date":"2016-10-23T18:59:37-07:00","id":992166,"title":"","content":"Huh... here I am dusting off my old Scion books because of the Kickstarter, and what do you know... most of the old stuff I wrote all those years ago is still saved somewhere. Pretty cool.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/4637-demonchilde","name":"demonchilde","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar4637_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Dec 2014"},{"key":"Posts:","value":"28"}]},"thankedby":[]},{"date":"2016-12-19T13:07:36-08:00","id":1019386,"title":"","content":"Hi there! I'm writing a Valar (Tolkien) Pantheon and was wondering, how would I submit it here?","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/11866-thescottishfianna","name":"TheScottishFianna","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar11866_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"May 2016"},{"key":"Posts:","value":"46"}]},"thankedby":[]},{"date":"2016-12-19T16:59:14-08:00","id":1019487,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>TheScottishFianna</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/1377-fan-written-scion-material?p=1019386#post1019386\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\">Hi there! I'm writing a Valar (Tolkien) Pantheon and was wondering, how would I submit it here?</div> </div> </div> </div>Pretty sure you'd just share a link to it, however you choose to do that.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12300-crying","name":"Crying","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12300_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Aug 2016"},{"key":"Posts:","value":"151"}]},"thankedby":[]},{"date":"2018-02-01T09:51:21-08:00","id":1181425,"title":"","content":"I found some more pantheons.<br /> <br /> Anasazi pantheon (by Toni D) - <a href=\"https://web.archive.org/web/20120920014032/http://wiki.white-wolf.com:80/whitewolf/index.php?title=The_Anasazi_%28Fan%29\" target=\"_blank\">https://web.archive.org/web/20120920...sazi_%28Fan%29</a><br /> <br /> Elohim (Abrahamic) (by Justin Cognito) - <a href=\"https://web.archive.org/web/20100701092118/http://wiki.white-wolf.com:80/whitewolf/index.php?title=The_Elohim_%28Fan%29\" target=\"_blank\">https://web.archive.org/web/20100701...ohim_%28Fan%29</a><br /> <br /> Ani-matsu pantheon (anime conversion) (Not sure who wrote it) - <a href=\"https://web.archive.org/web/20120506062640/http://wiki.white-wolf.com/whitewolf/index.php?title=Ani-matsu\" target=\"_blank\">https://web.archive.org/web/20120506...itle=Ani-matsu</a><br /> <br /> Indigites Dii - <a href=\"http://dawnofanewage.pbworks.com/w/page/16968300/Indigites%20Dii\" target=\"_blank\">http://dawnofanewage.pbworks.com/w/p...ndigites%20Dii</a><br /> <br /> Chaos Gods (Warhammer) (by Chattering Mimir, in thread) - <a href=\"https://web.archive.org/web/20121108041755/http://forums.white-wolf.com/default.aspx?g=posts&amp;t=66432\" target=\"_blank\">https://web.archive.org/web/20121108...=posts&amp;t=66432</a><br /> <br /> Authors Pantheon (by Wraithstrike) - <a href=\"https://forum.rpg.net/index.php?threads/work-in-progress-scion-pantheon-authors.363081/\" target=\"_blank\">https://forum.rpg.net/index.php?thre...uthors.363081/</a><br /> <br /> Postmodern Pantheon (by cappadocius) - <a href=\"https://forum.rpg.net/index.php?threads/scion-operation-mindfuck.325153/\" target=\"_blank\">https://forum.rpg.net/index.php?thre...ndfuck.325153/</a><br /> <br /> Toho Pantheon (Godzilla-based) (byWraithstrike) - <a href=\"https://forum.rpg.net/index.php?threads/scion-behold-the-product-of-my-boredom.324904/\" target=\"_blank\">https://forum.rpg.net/index.php?thre...oredom.324904/</a><br /> <br /> Scion Exalted Conversion (by Benjamin Beard) - <a href=\"https://forum.rpg.net/index.php?threads/scion-the-exalted-pantheon.322289/\" target=\"_blank\">https://forum.rpg.net/index.php?thre...ntheon.322289/</a><br /> <br /> Another Abrahamic pantheon (by Spikey, in thread) - <a href=\"http://shadownessence.org/index.php?/topic/24368-christianity/&amp;page=2\" target=\"_blank\">http://shadownessence.org/index.php?...ianity/&amp;page=2</a><br /> <br /> Lux Veritas (Rationalist) (by Grim) - <a href=\"https://postmortemstudios.wordpress.com/2008/03/11/scion-lux-veritas/\" target=\"_blank\">https://postmortemstudios.wordpress....n-lux-veritas/</a><br /> <br /> Expanded French pantheon (by Kebhab 2.0) (in French) - <a href=\"http://forum.tenebrae-mundis.com/read.php?23,33459\" target=\"_blank\">http://forum.tenebrae-mundis.com/read.php?23,33459</a> <br /> <br /> New Gods (as in American Gods) (not sure who wrote it) - <a href=\"https://web.archive.org/web/20100616001654/http://colugo.org/jmcmurra/scion/pantheons/american.html\" target=\"_blank\">https://web.archive.org/web/20100616.../american.html</a><br /> <br /> Greek Titans (by Asklepios) - <a href=\"https://web.archive.org/web/20071121214659/http://wiki.white-wolf.com/whitewolf/index.php/The_Titans_-_Greek_%28Fan%29\" target=\"_blank\">https://web.archive.org/web/20071121...reek_%28Fan%