:","value":"Nov 2013"},{"key":"Posts:","value":"987"}]},"thankedby":[]},{"date":"2019-06-05T16:33:49-07:00","id":1316724,"title":"","content":"Origins and Hero are also currently the top sellers on Drive Thru RPG.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/12628-yukikaze","name":"yukikaze","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar12628_2.jpeg","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2016"},{"key":"Posts:","value":"83"}]},"thankedby":[]},{"date":"2019-06-05T16:57:22-07:00","id":1316732,"title":"","content":"Congrats to the crew! Go forth, believers who missed the Kickstarter!<br /> <br /> And make an offering* to your personal God or Pantheon of choice<br /> <br /> *for legal reasons I must specify that you should probably only like pour out a drink for the God in question, user does not condone ritual sacrifice of animals and definitely not of people","signature":"<hr class=\"b-divider\"/><br/>Disclaimer: In favor of fun and enjoyment, but may speak up to warn you that you're gonna step on a metaphorical land mine","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":2}],"user":{"link":"https://forum.theonyxpath.com/member/2142-kyman201","name":"Kyman201","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2142_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"4086"}]},"thankedby":[]},{"date":"2019-06-05T23:12:28-07:00","id":1316772,"title":"","content":"Kitsune, Therianthrope and Satyr origin paths...<br /> <br /> Added to wishlist!","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1394-nyrufa","name":"Nyrufa","avatar"