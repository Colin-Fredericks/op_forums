rs/0/0/6/0/4/5/avatar11312_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Feb 2016"},{"key":"Posts:","value":"719"}]},"thankedby":[]},{"date":"2020-05-30T13:17:17-07:00","id":1392888,"title":"","content":"Monsters and Magicians is not a bad idea... or Denizens and Dweomers","signature":"<hr class=\"b-divider\"/><br/><a href=\"https://www.drivethrurpg.com/en/product/481584/house-rules-bundle-bundle\" target=\"_blank\">House Rules - The Bundle</a> - House Rules for Everyone<br /> <a href=\"https://www.drivethrurpg.com/en/product/481581/powered-inspiration-bundle\" target=\"_blank\">Powered Inspired</a> - Powered Characters using Inspiration and Gifts<br /> <a href=\"https://www.drivethrurpg.com/product/413362/Fists-and-Tomes-BUNDLE\" target=\"_blank\">Fists and Tomes</a> - Inspired Martial Arts and Mysticism for Talents<br /> <a href=\"https://www.drivethrurpg.com/en/product/492147/supertech\" target=\"_blank\">Supertech</a> - Super Science in the hands of Talents","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24985-mateus-luz","name":"Mateus Luz","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar24985_3.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2019"},{"key":"Posts:","value":"2950"}]},"thankedby":[]},{"date":"2020-06-01T03:12:39-07:00","id":1393383,"title":"","content":"It's worth remembering that even non-denizens can perform magic through rituals and ceremonies through the occult skill.","signature":"<hr class=\"b-divider\"/><br/><a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/demon-the-descent/904596-geniuses-and-gramarie\" target=\"_blank\">Genius templates</a>: Super Science Mini-Template for Demon: the Descent<br /> <br /> <a href=\"http://forum.theonyxpath.com/forum/main-category/main-forum/the-new-world-of-darkness/1337874-oracle-the-endbringers-fan-splat\" target=\"_blank\">Oracle the Endbringers</a>: Time-Manipulator Fan-Splat","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/8331-milo-v3","name":"milo v3","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar8331_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Oct 2015"},{"key":"Posts:","value":"1505"}]},"thankedby":[]},{"date":"2020-06-07T08:51:52-07:00","id":1394784,"title":"","content":"If I remember correctly from the 2nd edition books, Sorcery is what happens when mortals siphon power from the gods to wield their purviews for themselves.<br /> <br /> If you're playing as a Scion, then this becomes somewhat redundant. You already have an inherent ability to wield divine power. You're basically stealing from your own banking account at that point.","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/26211-newnyrufa","name":"NewNyrufa","avatar":"data:image/svg+xml;base64,","title":"Banned","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Jun 2020"},{"key":"Posts:","value":"13"}]},"thankedby":[]}]}