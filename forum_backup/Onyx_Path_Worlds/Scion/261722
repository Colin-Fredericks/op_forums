splay = ''; this.innerText = ''; this.value = 'Hide'; } else { this.parentNode.parentNode.getElementsByTagName('div')[1].getElementsByTagName('div')[0].style.display = 'none'; this.innerText = ''; this.value = 'Show'; }\" /> </div> <div style=\" margin: 0px; padding: 6px; border: 3px groove blue; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -webkit-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); -moz-box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75); box-shadow: 1px 1px 5px rgba(50, 50, 50, 0.75);\"> <div style=\"display: none;\"><div style=\"background: rgba(255, 255, 255, 0.8); padding: 6px; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;\"><img src=\"http://terralthra.net/sdnet/rifts/R_CosK1.bmp\" class=\"bbcode-attachment bbcode-attachment--lightbox js-lightbox\" border=\"0\" alt=\"\" itemprop=\"image\" loading=\"lazy\"/></div></div> </div> </div><br /> <br /> Something I don't think you want.","signature":"<hr class=\"b-divider\"/><br/><i>Mankind was once an endangered species. It will likely be so again. And mankind will only have itself to blame.</i>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/144-shadowflame","name":"Shadowflame","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar144_2.png","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"1223"}]},"thankedby":[]}]}