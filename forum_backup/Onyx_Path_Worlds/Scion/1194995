=\"0\" alt=\"\" />","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/1153-prince-of-the-night","name":"Prince of the Night","avatar":"data:image/svg+xml;base64,","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"4205"}]},"thankedby":[]},{"date":"2018-03-14T08:31:19-07:00","id":1195305,"title":"","content":"<div class=\"bbcode_container\"> <div class=\"bbcode_quote\"> <div class=\"quote_container\"> <div class=\"bbcode_quote_container b-icon b-icon__ldquo-l--gray\"></div> <div class=\"bbcode_postedby\"> Originally posted by <strong>marin</strong> <a href=\"https://forum.theonyxpath.com/forum/main-category/main-forum/scion/1194995-my-thoughts-on-hero?p=1195281#post1195281\" rel=\"nofollow\" title=\"View Post\" class=\"b-icon b-icon__double-arrow-right--blue animate-scroll\">View Post</a> </div> <div class=\"message\"><br /> ...I notice Kerberos Hounds have Being A Good Boy. One of yours as well?</div> </div> </div> </div>Nope! I am not the only dog person on Team Scion.","signature":"<hr class=\"b-divider\"/><br/>Developer for Exalted<br /> <br /> Want to write for Exalted? Look at the <a href=\"http://theonyxpath.com/submission-guidelines/\" target=\"_blank\">freelancer submission guidelines.</a><br /> <br /> <a href=\"https://www.patreon.com/user?u=451515\" target=\"_blank\">Robert Vance's Patreon</a>","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[{"type":"\ud83d\udc4d","count":1}],"user":{"link":"https://forum.theonyxpath.com/member/527-robert-vance","name":"Robert Vance","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar527_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2013"},{"key":"Posts:","value":"10044"}]},"thankedby":[]},{"date":"2018-03-14T08:32:24-07:00","id":1195307,"title":"","content":"<div c