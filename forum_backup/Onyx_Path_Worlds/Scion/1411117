.com/core/avatars/0/0/6/0/4/5/avatar2142_2.jpeg","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Jan 2014"},{"key":"Posts:","value":"4086"}]},"thankedby":[]},{"date":"2020-08-31T00:54:48-07:00","id":1411177,"title":"","content":"In the brief attempts our group made at Scion 2E, we used somewhat modified wracks and conditions from Chronicles of Darkness and the other 2E New World of Darkness books. That seemed to work relatively well, but we ended up going with another system so there might be some problems somewhere down the line that we didn't get to.","signature":"","edited":{"userid":2433,"user_link":"https://forum.theonyxpath.com/member/2433-highpriest","user":"HighPriest","date":". 08-31-2020, 04:16 AM"},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/2433-highpriest","name":"HighPriest","avatar":"https://forum.theonyxpath.com/core/avatars/0/0/6/0/4/5/avatar2433_2.png","title":"Member","rank":5,"rank-name":"","custom":[{"key":"Join Date:","value":"Mar 2014"},{"key":"Posts:","value":"360"}]},"thankedby":[]},{"date":"2020-09-01T18:27:20-07:00","id":1411449,"title":"","content":"Thank you all for the help","signature":"","edited":{"userid":0,"user_link":"","user":"","date":""},"attachments":[],"reactions":[],"user":{"link":"https://forum.theonyxpath.com/member/24818-viper285","name":"Viper285","avatar":"data:image/svg+xml;base64,","title":"Member","rank":0,"rank-name":"","custom":[{"key":"Join Date:","value":"Nov 2018"},{"key":"Posts:","value":"2"}]},"thankedby":[]}]}